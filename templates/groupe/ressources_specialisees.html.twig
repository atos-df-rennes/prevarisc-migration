{% extends 'layouts/admin.html.twig' %}

{% block title %}Administration / Gestion des groupes / Gérer les droits / Ressources spécialisées{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script type="text/javascript">
        $(document).ready(function() {
            $('.bouton-suppression-ressource').click(function() {
                const textRessource = $(this).attr('data-text')
                const url = $(this).attr('data-url')

                $('#modal-suppression-ressource #text-ressource').html(textRessource)
                $('#supprimer-ressource').click(function() {
                    $.ajax({
                        type: "DELETE",
                        url: url,
                        success: function() {
                            window.location.reload()
                        },
                        error: function() {
                            window.location.reload()
                        }
                    })
                })
            })
        })
    </script>
{% endblock %}

{% block body %}
    {{ include('utilisateurs/_topbar.html.twig') }}

    {{ include('groupe/_menu_droits.html.twig') }}

    <article>
        <button type="button" onclick='$("#resource-ets-modal").modal({show: true});' class='btn btn-default btn-small pull-right'>Ajouter une ressource</button>

        <h4>Ressources liées aux établissements</h4>

        {{ include('groupe/_table_ressources_specialisees.html.twig', {ressources: ressources_etablissement}) }}
    </article>

    <article>
        <button type="button" onclick='$("#resource-dossier-modal").modal({show: true});' class='btn btn-default btn-small pull-right'>Ajouter une ressource</button>

        <h4>Ressources liées aux dossiers</h4>

        {{ include('groupe/_table_ressources_specialisees.html.twig', {ressources: ressources_dossier}) }}
    </article>

    {{ include('groupe/_modal_suppression_ressource.html.twig') }}
{% endblock %}
