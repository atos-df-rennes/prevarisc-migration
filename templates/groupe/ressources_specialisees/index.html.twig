{% extends 'layouts/admin.html.twig' %}

{% block title %}Administration / Gestion des groupes / Gérer les droits / Ressources spécialisées{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script type="text/javascript">
        $(document).ready(function() {
            $('.bouton-suppression-ressource').click(function() {
                const textRessource = $(this).attr('data-text')
                const url = $(this).attr('data-url')

                $('#modal-suppression-ressource #text-ressource').html(textRessource)
                $('#supprimer-ressource').click(function() {
                    $.ajax({
                        type: "DELETE",
                        url: url,
                        success: function() {
                            window.location.reload()
                        },
                        error: function() {
                            window.location.reload()
                        }
                    })
                })
            })

            // @todo: Faire plutôt un Tom Select (après avoir validé l'ajout)
            $("#ressource_specialisee_dossier_natures").multiselect({header: false, noneSelectedText: "Toutes les natures"});
        })
    </script>
{% endblock %}

{% block body %}
    {{ include('utilisateurs/_topbar.html.twig') }}

    {{ include('groupe/_menu_droits.html.twig') }}

    <article>
        <button type="button" class='btn btn-default btn-small pull-right' data-toggle="modal" data-target="#resource-ets-modal">Ajouter une ressource</button>

        <h4>Ressources liées aux établissements</h4>

        {{ include('groupe/ressources_specialisees/_table_ressources_specialisees.html.twig', {ressources: ressources_etablissement}) }}
    </article>

    <article>
        <button type="button" class='btn btn-default btn-small pull-right' data-toggle="modal" data-target="#resource-dossier-modal">Ajouter une ressource</button>

        <h4>Ressources liées aux dossiers</h4>

        {{ include('groupe/ressources_specialisees/_table_ressources_specialisees.html.twig', {ressources: ressources_dossier}) }}
    </article>

    {{ include('groupe/ressources_specialisees/_modal_suppression_ressource.html.twig') }}
    {{ include('groupe/ressources_specialisees/_form_ajout_ressource_dossier.html.twig') }}
{% endblock %}
