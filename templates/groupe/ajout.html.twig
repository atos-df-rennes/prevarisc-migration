{% extends 'layouts/admin.html.twig' %}

{% block title %}Administration / Gestion des utilisateurs / Ajouter un groupe{% endblock %}

{% block body %}
    {{ include('utilisateurs/_topbar.html.twig') }}

    <h4>Ajout d'un groupe</h4>

    {{ form_start(form) }}
        {{ form_errors(form) }}

        <dl class='dl-horizontal row row-no-gutters'>
		    <div class="form-group col-md-4">
                <dt>{{ form_label(form.libelle) }}</dt>
                <dd>
                    {{ form_widget(form.libelle) }}
                    {{ form_errors(form.libelle) }}
                </dd>
            </div>
            <div>
                <dt>{{ form_label(form.description) }}</dt>
                <dd>
                    {{ form_widget(form.description) }}
                    {{ form_errors(form.description) }}
                </dd>
            </div>
        </dl>

        <div class='pull-right'>
            <input type='submit' class="btn btn-success" value="Ajouter le groupe">
        </div>
    {{ form_end(form) }}
{% endblock %}