{% extends 'layouts/admin.html.twig' %}

{% block title %}Administration / Gestion des prescriptions / Gestion des articles{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-md-12">
            <a href="/gestion-prescriptions">Gestion des prescriptions types</a> <span class="glyphicon glyphicon-chevron-right"></span> Gestion des articles
        </div>
    </div>

    <h3 class="page-header">
        Gestion des articles
    </h3>

    <div class="row">
        <div class="col-md-12 text-right">
            <a class="btn btn-default" href="{{ path('admin_prescriptions_articles_add') }}"><span class="glyphicon glyphicon-plus"></span>&nbsp;Ajouter un article</a>
        </div>
    </div>

    <br/>

    {% for article in liste_articles %}
        {% if article.id != 1 %}
            <div class="row">
                <div class="col-md-12">
                    {% if article.visible == 1 %}
                        <img src="{{ asset('images/visible.gif') }}" alt="visible" />
                    {% else %}
                        <img src="{{ asset('images/nonvisible.gif') }}" alt="non visible" />
                    {% endif %}
                    <a class="btn btn-default" href="{{ path('admin_prescriptions_articles_edit', {articleListe: article.id} ) }}"><span class="glyphicon glyphicon-pencil"></span>&nbsp;Modifier</a>

                    {{ article.libelle }}
                </div>
            </div>
            <br/>
        {% endif %}
    {% endfor %}
{% endblock %}