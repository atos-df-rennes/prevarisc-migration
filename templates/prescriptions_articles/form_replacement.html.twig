{% extends 'layouts/admin.html.twig' %}

{% set articleListe = app.request.get('articleListe') %}
{% form_theme form '_form_theme.html.twig' %}

{% block title %}Administration / Gestion des prescriptions / Gestion des articles / Remplacer et supprimer un article existant {% endblock %}

{% block body %}

    <div class="row">
        <div class="col-md-12">
            <a href="/gestion-prescriptions">Gestion des prescriptions types</a> <span class="glyphicon glyphicon-chevron-right"></span> <a href="{{ path('admin_prescriptions_articles') }}">Gestion des articles</a>
            <span class="glyphicon glyphicon-chevron-right"></span> <a href="{{ path('admin_prescriptions_articles_edit', {articleListe: articleListe.id}) }}">Modification d'un article existant</a><span class="glyphicon glyphicon-chevron-right"></span> Remplacer et supprimer un article existant
        </div>
    </div>

    <h3 class="page-header">Remplacer et supprimer un article existant </h3>

    <h3>Article que vous allez supprimer</h3>

    <dl class="dl-horizontal">
        <dt>Libellé :</dt>
        <dd>{{ articleListe.libelle }}</dd>
        <dt>Visibilité :</dt>
        <dd>{{ articleListe.visible ? 'Affiché' : 'Masqué' }}</dd>
    </dl>

    <p class="alert alert-warning">
        Dans l'ensemble des prescriptions existantes, cet article sera remplacé par celui que vous allez choisir ci-dessous
    </p>

    <h3>Choisissez dans la liste l'article que vous souhaitez utiliser en remplacement</h3>

    {{ form_start(form) }}

    <div class="row">
        <div class="col-md-8">
            {{ form_row(form.replacementArticle) }}
        </div>
    </div>

    <div class="row text-right">
        <div class="col-sm-12">
            <p class="text-danger">
                <span class="glyphicon glyphicon-warning-sign"></span>
                Cette action est irréversible.
            </p>
            <a class="btn btn-default" href="{{ path('admin_prescriptions_articles_edit', {articleListe: articleListe.id}) }}">
                Annuler la suppression
            </a>
            <button type="submit" class="btn btn-danger">Supprimer l'article</button>
        </div>
    </div>
    {{ form_end(form) }}
{% endblock %}