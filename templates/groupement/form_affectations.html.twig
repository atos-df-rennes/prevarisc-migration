{% form_theme form with ['form_div_layout.html.twig'] only %}

{{ form_start(form, {'attr': {'id': 'form-affectations'}, 'action': path('admin_groupement_form_scope', {'id': groupement.id, 'scope': 'affectations'}) }) }}

<div class="form-group">
    {{ form_label(form.preventionnistes) }}
    {{ form_widget(form.preventionnistes, {attr: {class: 'tom-select', size: 10}}) }}
    {{ form_errors(form.preventionnistes) }}
</div>

{{ form_rest(form) }}

<div class="form-group text-right">
    {% if groupement and groupement.preventionnistes|length > 0 %}
        <button
                id="preventionniste"
                class="btn btn-default"
                type="button"
                data-loading-text="Affectation <img src='/images/load.gif' />"
        >
            Affecter aux établissements
        </button>
        <span id="preventionniste-notification" class="ui-state-highlight ui-helper-hidden" style="padding: .5em;">
        Les préventionnistes ont été affectés.
    </span>
    {% endif %}
    <button type="submit" class="btn btn-primary">Sauvegarder</button>
</div>

{{ form_end(form) }}


<script type="text/javascript">
    $(document).ready(function() {
        new TomSelect("#groupement_preventionnistes", {
            plugins: ['remove_button'],
        });

        $("#preventionniste").click(function () {

            $.ajax({
                url: "{{ path('admin_groupement_preventionniste') }}",
                data: "groupement=" + {{ groupement.id }},
                type: "POST",
                beforeSend: function () {
                    $("#preventionniste").button('loading')
                },
                success: function () {
                    $("#preventionniste").button('reset')
                    $("#preventionniste-notification").show()
                    setTimeout(function () {
                        $("#preventionniste-notification").fadeOut();
                    }, 2500)
                },
            })
        });

    });
</script>

