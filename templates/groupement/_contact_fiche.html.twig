<div class="col-sm-6 col-xs-12">
    <div class="panel panel-default">
        <div class="panel-heading clearfix">
            <h4 class="panel-title pull-left mt-2">
                <i class="glyphicon glyphicon-user"></i> {{ contact.nom ~ ' ' ~ contact.prenom }}
            </h4>
            {% if can_edit %}
                <div class="btn-group btn-group-sm pull-right" role="group">
                    <button type="button" class="btn btn-default edit-contact-button" data-toggle="modal" data-target="#ajout-contact" data-id="{{ groupement.id }}" data-contact-id="{{ contact.id }}" title="Modifier">
                        <i class="glyphicon glyphicon-pencil"></i>
                    </button>
                    <button type="button" class="btn btn-danger delete-contact-button" data-toggle="modal" data-target="#dialog-delete-contact" data-id="{{ groupement.id }}" data-contact-id="{{ contact.id }}" title="Supprimer">
                        <i class="glyphicon glyphicon-trash"></i>
                    </button>
                </div>
            {% endif %}
        </div>
        <div class="panel-body">
            {% if contact.fonction or contact.societe %}
                <p class="text-muted" style="margin-bottom: 15px;">
                    <i class="fa fa-briefcase"></i>
                    {% if contact.fonction %}
                        <strong>{{ contact.fonction.libelle }}</strong>
                    {% endif %}
                    {% if contact.societe %}
                        {% if contact.fonction %} - {% endif %}{{ contact.societe }}
                    {% endif %}
                </p>
            {% endif %}

            <dl class="dl-horizontal" style="margin-bottom: 0;">
                {% if contact.telephoneFixe or contact.telephonePortable %}
                    <dt><i class="fa fa-phone"></i> Téléphone</dt>
                    <dd>
                        {{ contact.telephoneFixe }}
                        {% if contact.telephonePortable %}
                            {% if contact.telephoneFixe %}<br>{% endif %}{{ contact.telephonePortable }}
                        {% endif %}
                    </dd>
                {% endif %}

                {% if contact.telephoneFax %}
                    <dt><i class="fa fa-fax"></i> Fax</dt>
                    <dd>{{ contact.telephoneFax }}</dd>
                {% endif %}

                {% if contact.mail %}
                    <dt><i class="fa fa-envelope"></i> Courriel</dt>
                    <dd><a href="mailto:{{ contact.mail }}">{{ contact.mail }}</a></dd>
                {% endif %}

                {% if contact.siteWeb %}
                    <dt><i class="fa fa-globe"></i> Site web</dt>
                    {% set siteWeb = contact.siteWeb %}
                    {% if siteWeb starts with 'http://' or siteWeb starts with 'https://' %}
                        <dd><a href="{{ siteWeb }}" target="_blank">{{ siteWeb }}</a></dd>
                    {% else %}
                        {# URL avec schéma non autorisé : affichage en texte brut sans lien #}
                        <dd>{{ siteWeb }}</dd>
                    {% endif %}
                {% endif %}

                {% if contact.numeroAdresse or contact.rueAdresse or contact.codePostalAdresse or contact.villeAdresse %}
                    <dt><i class="fa fa-map-marker"></i> Adresse</dt>
                    <dd>
                        {{ contact.numeroAdresse }} {{ contact.rueAdresse }}
                        {% if contact.numeroAdresse or contact.rueAdresse %}<br>{% endif %}
                        {{ contact.codePostalAdresse }} {{ contact.villeAdresse }}
                    </dd>
                {% endif %}

                {% if contact.observations %}
                    <dt><i class="fa fa-comment"></i> Observations</dt>
                    <dd>{{ contact.observations }}</dd>
                {% endif %}
            </dl>
        </div>
    </div>
</div>
