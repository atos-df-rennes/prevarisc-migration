<!-- Onglet -->
<div id="tabs">
    <ul class="nav nav-tabs">
        <li id="general" role="presentation" class="active"><a href="#tabs-1" data-toggle="tab" data-scope="general">Général</a></li>
        <li id="prev" role="presentation"><a href="#tabs-2" data-toggle="tab" data-scope="affectations">Préventionnistes affectés</a></li>
        <li id="coordonnee" role="presentation"><a href="#tabs-3" data-toggle="tab" data-scope="coordonnees">Coordonnées</a></li>
        <li id="contact" role="presentation"><a href="#tabs-4" data-toggle="tab">Contacts liés au groupement</a></li>
    </ul>

    <div class="tab-content">
        <!-- Partie générale -->
        <div id="tabs-1" role="tabpanel" class="tab-pane active" data-scope="general">
            <p class="text-center"><i class="fa fa-spinner fa-spin"></i> Chargement...</p>
        </div>

        <!-- Partie des préventionnistes -->
        <div id="tabs-2" role="tabpanel" class="tab-pane" data-scope="affectations">
            <p class="text-center"><i class="fa fa-spinner fa-spin"></i> Chargement...</p>
        </div>

        <!-- Coordonnées -->
        <div id="tabs-3" role="tabpanel" class="tab-pane" data-scope="coordonnees">
            <p class="text-center"><i class="fa fa-spinner fa-spin"></i> Chargement...</p>
        </div>

        <!-- Partie contact -->
        <div id="tabs-4" role="tabpanel" class="tab-pane"></div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function() {
        // Charger le premier onglet par défaut
        loadFormScope('general', {{ groupement.id ?? 0 }});

        // Gérer les changements d'onglets
        $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
            var scope = $(e.target).data('scope');
            if (scope) {
                var tabPane = $($(e.target).attr('href'));
                // Ne charger que si pas déjà chargé
                if (!tabPane.data('loaded')) {
                    loadFormScope(scope, {{ groupement.id ?? 0 }});
                }
            }
        });

        // Fonction pour charger un formulaire par scope en AJAX
        function loadFormScope(scope, groupementId) {
            var tabPane = $('#tabs-' + getScopeTabNumber(scope));
            
            $.ajax({
                url: "{{ path('admin_groupement_form_scope', {'scope': 'general'}) }}".replace('general', scope),
                data: { id: groupementId },
                type: "GET",
                beforeSend: function() {
                    tabPane.html('<p class="text-center"><i class="fa fa-spinner fa-spin"></i> Chargement...</p>');
                },
                success: function(result) {
                    tabPane.html(result);
                    tabPane.data('loaded', true);
                    
                    // Réattacher les handlers pour le scope général
                    if (scope === 'general') {
                        attachGeneralHandlers();
                    }
                    
                    // Gérer la soumission du formulaire en AJAX
                    tabPane.find('form').on('submit', function(e) {
                        e.preventDefault();
                        
                        // Sélectionner toutes les villes pour le scope général
                        if (scope === 'general') {
                            $("#villes_groupement option").each(function(){ 
                                $(this).attr("selected", true); 
                            });
                        }
                        
                        $.ajax({
                            url: $(this).attr('action'),
                            type: "POST",
                            data: $(this).serialize(),
                            success: function(response) {
                                if (response.success) {
                                    notify(response.message);
                                    // Recharger le formulaire pour afficher les données mises à jour
                                    tabPane.data('loaded', false);
                                    loadFormScope(scope, groupementId);
                                }
                            },
                            error: function() {
                                alert('Une erreur est survenue lors de la sauvegarde.');
                            }
                        });
                        
                        // Désélectionner les villes après soumission
                        if (scope === 'general') {
                            $("#villes_groupement option").each(function(){ 
                                $(this).attr("selected", false); 
                            });
                        }
                    });
                },
                error: function() {
                    tabPane.html('<p class="text-danger">Erreur lors du chargement du formulaire.</p>');
                }
            });
        }

        function getScopeTabNumber(scope) {
            switch(scope) {
                case 'general': return '1';
                case 'affectations': return '2';
                case 'coordonnees': return '3';
                default: return '1';
            }
        }

        function attachGeneralHandlers() {
            // Boutons d'ajout/suppression de villes
            $("#add_ville").off('click').on('click', function() {
                $("#liste_villes option:selected").each(function() {
                    var option = $(this).clone();
                    $("#villes_groupement").append(option);
                    $(this).remove();
                });
            });

            $("#remove_ville").off('click').on('click', function() {
                $("#villes_groupement option:selected").each(function() {
                    var option = $(this).clone();
                    $("#liste_villes").append(option);
                    $(this).remove();
                });
            });
        }

        function notify(text) {
            // Utiliser la fonction notify existante du parent
            if (typeof window.parent.notify === 'function') {
                window.parent.notify(text);
            } else if ($('#notif').length) {
                $('#notif').removeClass('hide').html(text);
                setTimeout(() => $('#notif').addClass('hide'), 5000);
            } else {
                alert(text);
            }
        }
    });

    // Partie Contact
    {% if groupement and groupement.id %}
    $("#tabs-4").load("/contact?item=groupement&id={{ groupement.id }}");
    {% endif %}
</script>
