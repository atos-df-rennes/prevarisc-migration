<!-- Onglet -->
<div id="tabs">
    <ul class="nav nav-tabs">
        <li id="general" role="presentation" class="active"><a href="#tabs-1" data-toggle="tab">Général</a></li>
        <li id="prev" role="presentation"><a href="#tabs-2" data-toggle="tab">Préventionnistes affectés</a></li>
        <li id="coordonnee" role="presentation"><a href="#tabs-3" data-toggle="tab">Coordonnées</a></li>
        <li id="contact" role="presentation"><a href="#tabs-4" data-toggle="tab">Contacts liés au groupement</a></li>
    </ul>

    <div class="tab-content">
        <!-- Partie générale -->
        <div id="tabs-1" role="tabpanel" class="tab-pane active" >
            <div class="form-group">
                {{ form_label(form.libelle, null, {label_attr: {class: 'control-label'}}) }}
                {{ form_widget(form.libelle, {attr: {class: 'form-control'}}) }}
                {{ form_errors(form.libelle) }}
            </div>

            <div class="form-group">
                {{ form_label(form.type, null, {label_attr: {class: 'control-label'}}) }}
                {{ form_widget(form.type, {attr: {class: 'form-control'}}) }}
                {{ form_errors(form.type) }}
            </div>


            <div class="form-group">
                {% do form.communes.setRendered %}
                <label class="control-label" for="villes_groupement">Villes du groupement</label>
                <div class="clearfix"></div>

                <select id="liste_villes" multiple size=20 class="pull-left" style="height: 300px; width: 30%;">
                    {% for ville in villes %}
                        <option id="{{ ville.id }}" value="{{ ville.id }}">{{ ville.id }} {{ ville.libelle }}</option>
                    {% endfor %}
                </select>

                <div class="pull-left btn-group btn-group-vertical" style="padding: 20px;">
                    <button id="add_ville" type="button" class="btn"><span class="glyphicon glyphicon-chevron-right"></span></button>
                    <button id="remove_ville" type="button" class="btn"><span class="glyphicon glyphicon-chevron-left"></span></button>
                </div>

                <select id="villes_groupement" name="communes[]" class="pull-left" multiple size=20 style="height: 300px; width: 30%;">
                    {% if groupement.communes is iterable %}
                        {% for ville in groupement.communes %}
                            <option id="{{ ville.id }}" value="{{ ville.id }}">{{ ville.id }} {{ ville.libelle }}</option>
                        {% endfor %}
                    {% endif %}
                </select>
            </div>
{#            <div class="form-group">#}
{#                {{ form_label(form.communes, null, {label_attr: {class: 'control-label'}}) }}#}
{#                {{ form_widget(form.communes, {attr: {class: 'form-control', style: 'height: 300px;'}}) }}#}
{#                {{ form_errors(form.communes) }}#}
{#            </div>#}
        </div>

        <!-- Partie des préventionnistes -->
        <div id="tabs-2" role="tabpanel" class="tab-pane">
            <div class="form-group">
                {{ form_label(form.preventionnistes, null, {label_attr: {class: 'control-label'}}) }}
                {{ form_widget(form.preventionnistes, {attr: {class: 'form-control', size: 10}}) }}
                {{ form_errors(form.preventionnistes) }}
            </div>

            {% if groupement and groupement.preventionnistes|length > 0 %}
                <button
                    id="preventionniste"
                    class="btn btn-info"
                    type="button"
                    style="margin-bottom: 10px;"
                    data-loading-text="Affectation <img src='/images/load.gif' />"
                >
                    Affecter aux établissements
                </button>
                <span id="preventionniste-notification" class="ui-state-highlight ui-helper-hidden" style="padding: .5em;">
                    Les préventionnistes ont été affectés.
                </span>
            {% endif %}
        </div>

        <!-- Coordonnées -->
        <div id="tabs-3" role="tabpanel" class="tab-pane">

            <div class="form-group">
                {{ form_label(form.informations.societe, null, {label_attr: {class: 'control-label'}}) }}
                {{ form_widget(form.informations.societe, {attr: {class: 'form-control'}}) }}
                {{ form_errors(form.informations.societe) }}
            </div>

            <div class="form-group">
                {{ form_label(form.informations.nom, null, {label_attr: {class: 'control-label'}}) }}
                {{ form_widget(form.informations.nom, {attr: {class: 'form-control'}}) }}
                {{ form_errors(form.informations.nom) }}
            </div>

            <div class="form-group">
                {{ form_label(form.informations.prenom, null, {label_attr: {class: 'control-label'}}) }}
                {{ form_widget(form.informations.prenom, {attr: {class: 'form-control'}}) }}
                {{ form_errors(form.informations.prenom) }}
            </div>

            <div class="form-group">
                {{ form_label(form.informations.telephoneFixe, null, {label_attr: {class: 'control-label'}}) }}
                {{ form_widget(form.informations.telephoneFixe, {attr: {class: 'form-control'}}) }}
                {{ form_errors(form.informations.telephoneFixe) }}
            </div>

            <div class="form-group">
                {{ form_label(form.informations.telephonePortable, null, {label_attr: {class: 'control-label'}}) }}
                {{ form_widget(form.informations.telephonePortable, {attr: {class: 'form-control'}}) }}
                {{ form_errors(form.informations.telephonePortable) }}
            </div>

            <div class="form-group">
                {{ form_label(form.informations.telephoneFax, null, {label_attr: {class: 'control-label'}}) }}
                {{ form_widget(form.informations.telephoneFax, {attr: {class: 'form-control'}}) }}
                {{ form_errors(form.informations.telephoneFax) }}
            </div>

            <div class="form-group">
                {{ form_label(form.informations.mail, null, {label_attr: {class: 'control-label'}}) }}
                {{ form_widget(form.informations.mail, {attr: {class: 'form-control'}}) }}
                {{ form_errors(form.informations.mail) }}
            </div>
            <fieldset>
                <div class="form-group">
                    {{ form_label(form.informations.numeroAdresse, null, {label_attr: {class: 'control-label'}}) }}
                    {{ form_widget(form.informations.numeroAdresse, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.informations.numeroAdresse) }}
                </div>

                <div class="form-group">
                    {{ form_label(form.informations.rueAdresse, null, {label_attr: {class: 'control-label'}}) }}
                    {{ form_widget(form.informations.rueAdresse, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.informations.rueAdresse) }}
                </div>

                <div class="form-group">
                    {{ form_label(form.informations.codePostalAdresse, null, {label_attr: {class: 'control-label'}}) }}
                    {{ form_widget(form.informations.codePostalAdresse, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.informations.codePostalAdresse) }}
                </div>

                <div class="form-group">
                    {{ form_label(form.informations.villeAdresse, null, {label_attr: {class: 'control-label'}}) }}
                    {{ form_widget(form.informations.villeAdresse, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.informations.villeAdresse) }}
                </div>
            </fieldset>

            <div class="form-group">
                {{ form_label(form.informations.observations, null, {label: 'Observations'}) }}
                {{ form_widget(form.informations.observations, {attr: {class: 'form-control'}}) }}
                {{ form_errors(form.informations.observations) }}
            </div>

            <div class="form-group">
                {{ form_label(form.informations.siteWeb) }}
                {{ form_widget(form.informations.siteWeb, {attr: {class: 'form-control'}}) }}
                {{ form_errors(form.informations.siteWeb) }}
            </div>

        </div>

        <!-- Partie contact -->
        <div id="tabs-4" role="tabpanel" class="tab-pane"></div>
    </div>
</div>

{{ form_rest(form) }}

<script type="text/javascript">
    //réaffecter un préventionniste
    $("#preventionniste").click(function() {
        $.ajax({
            url: "{{ path('admin_groupement_preventionniste') }}",
            data: "groupement=" + $("#gpt option:selected").text(),
            type: "POST",
            beforeSend: function() {
                $("#preventionniste").button('loading')
            },
            success: function() {
                $("#preventionniste").button('reset')
                $("#preventionniste-notification").show()
                setTimeout(function() {
                    $("#preventionniste-notification").fadeOut();
                }, 2500)
            },
        })
    });

    // Partie Contact ----------------------------------------------------------------------------------------------------------------
    {% if groupement and groupement.id %}
    $("#tabs-4").load("/contact?item=groupement&id={{ groupement.id }}");
    {% endif %}
</script>
