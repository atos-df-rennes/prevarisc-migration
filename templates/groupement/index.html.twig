{% extends 'layouts/admin.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
{% if communes|length > 0 %}

<span id="notif" class="alert alert-info hide"></span>

<div class="pull-right">
    <button id="btn-ajout" class="btn" data-toggle="modal" data-target="#ajout-groupement">Créer un nouveau groupement</button>
</div>

<h3 class="page-header">Groupements de communes</h3>

<div id="save_div" class="row">
    {# Selection du groupement #}
    <div class="form-group col-md-5">
        <select id="gpt" aria-label="Choisir le groupement de communes">
            {% for type in admin_groupement_types %}
                <optgroup id="gpt_{{ type.id }}" label="{{ type.libelle }}">
                    {% for groupement in type.groupements %}
                        <option value="{{ groupement.id }}">{{ groupement.libelle }}</option>
                    {% endfor %}
                </optgroup>
            {% endfor %}
        </select>
    </div>
    {# Boutons d'actions #}
    <div class="form-group col-md-7">
        <a id="save" href="#" class="btn btn-primary">Sauvegarder le groupement</a>
        <a id="delete" href="#" class="btn btn-danger">Supprimer le groupement</a>
    </div>
</div>

{# Zone d'affichage des onglets et de leur contenu #}
<form id="form" method="post">
    <input type="hidden" id="id_gpt" name="id_gpt" value="0" />
{#    {{ include 'groupement/display.html.twig' }}#}
    <div id="content"><p><strong>Pas de groupement disponible ...</strong></p></div>
</form>

<div id="confirm" class="ui-helper-hidden">
    <p>Confirmez vous la suppression du groupement ? (cette action est irreversible)</p>
</div>

<div id="add" class="ui-helper-hidden">
    <form id="add-groupement">
        <dl>
            <!-- Libellé du groupement -->
            <dt>Libellé du groupement</dt>
            <dd><input type="text" id="nom_groupement" name="nom_groupement" size=30 /></dd>

            <!-- Type du groupement-->
            <dt>Type</dt>
            <dd>
                <select id="type_groupement" name="type_groupement">
                {% for type in admin_groupement_types %}
                    <option id="{{ type.id }}" value="{{ type.id }}">{{ type.libelle }}</option>
                {% endfor %}
                </select>
            </dd>
            <input type="hidden" name="id_gpt" value="0" />
        </dl>
    </form>
</div>
{% else %}

<div class="grid_16">
    <h2>
        <i class="sprite sprite-application_view_columns"></i>
        Groupements de communes
    </h2>
    <p><strong>Il n'y a pas de communes dans la base de données.</strong></p>
</div>

{% endif %}

    {{ include('groupement/_modal_ajout.html.twig') }}
{% endblock %}


{% block javascripts %}
    {{ parent() }}
    <script type="text/javascript">

        function notify(text) {
            const notifElement = document.getElementById('notif')

            notifElement.innerHTML = text
            notifElement.classList.remove('hide');

            setTimeout(() => notifElement.classList.add('hide'), 5000)
        }

        document.addEventListener("DOMContentLoaded", function(event) {
            // Your code to run since DOM is loaded and ready
            new TomSelect("#gpt",{
                create: true,
            });

            $("#btn-ajout").click(function(event) {
                const target = event.target.dataset.target;
                $.ajax({
                    type: "GET",
                    url: "{{ path('admin_groupement_creation') }}",
                    success: function(msg){

                        $(target + ' .modal-body').html(msg);
                    },
                });
            });


            $("#confirm").dialog({
                title: "Suppression d'un groupement",
                resizable: false,
                draggable: false,
                height: 'auto',
                width: 500,
                autoOpen: false,
                modal: true,
                buttons: [
                    {
                        text: 'Supprimer le groupement',
                        class: 'btn btn-danger',
                        click: function() {
                            $.ajax({
                                url: "{{ path('admin_groupement_delete') }}?id=" + $("#gpt option:selected").val(),
                                beforeSend: function() {
                                    $("#remove").button("disable");
                                },
                                success: function(result) {
                                    $("#remove").button("enable");
                                    notify("Le groupement a bien été supprimé.")

                                    $("#gpt option:selected").remove();
                                    $("#gpt option:first").attr("selected", "selected");
                                    $("#gpt").change();

                                    $("#confirm").dialog("close");
                                }
                            });
                        }
                    },
                    {
                        text: 'Annuler',
                        class: 'btn',
                        click: function() {
                            $("#confirm").dialog("close");
                        }
                    }
                ]
            });

            // Boutons de la toolbar
            $("#new").button({
                icons: { primary: "ui-icon-plus" }
            }).click(function() {
                $('#add').find("input").val('');
                $("#add").dialog("open");
            });

            $("#save").click(function() {
                // Selection de toutes les villes pour les passer dans le formulaire
                $("#villes_groupement option").each(function(){ $(this).attr("selected", true); });

                // On envoit le tout en ajax
                $.ajax({
                    url: "{{ path('admin_groupement_add') }}",
                    type: "post",
                    data: $("#form").serialize() + "&" + $("#formulaire_contact").serialize(),
                    beforeSend: function() {
                        $("#save").button("disable");
                    },
                    success: function(result) {
                        $("#save").button("enable");
                        notify("Le groupement a bien été mis à jour.");
                        $("select#gpt option:selected").remove();
                        $("select#gpt > optgroup#gpt_" + result["type"]).append($("<option></option>").val(result["id"]).html(result["libelle"]).attr("selected", "selected"));
                        $("select#gpt").change();
                    }
                });

                // On deselectionne les villes
                $("#villes_groupement option").each(function(){ $(this).attr("selected", false); });
            });

            $("#delete").click(function() {
                $("#confirm").dialog("open");
            });

            // Gestion des évenements de la liste déroulante
            $groupementSelect = $("#gpt");
            $groupementSelect.change(function() {
                if($groupementSelect.val() != null) {
                    if($groupementSelect.val() == 0)
                        $("#delete").button("disable");
                    else
                        $("#delete").button("enable");

                    const $content = $("#form > #content");

                    $.ajax({
                        url: "{{ path('admin_groupement_display') }}?id=" + $groupementSelect.val(),
                        beforeSend: function() {
                            $content.css("opacity", 0.5);
                        },
                        success: function(result) {
                            $content.html(result);
                            $content.css("opacity", 1);
                        }
                    });

                    $("#id_gpt").val($groupementSelect.val());
                    $("#save").button("enable");
                } else {
                    $("#save").button("disable");
                }
            });

            $groupementSelect.change();
        })
    </script>
{% endblock %}