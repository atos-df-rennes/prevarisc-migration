{% extends 'base.html.twig' %}

{% block body %}
<h2>
    {{ row.libelle }}
    <small>{{ row.type ? row.type.libelle : '' }}</small>
</h2>

<h3>Coordonnées du groupement</h3>
{% if row.informations is null %}
<hr class='clear' /><p><strong>Pas de coordonnées disponibles.</strong></p>
{% else %}
<dl>
    {% if row.informations.nom %}
    <dt>Nom Prénom du responsable</dt>
    <dd>
        {{ row.informations.nom }} {{ row.informations.prenom }}
    </dd>
    {% endif %}

    {% if row.informations.telephoneFixe or row.informations.telephonePortable or row.informations.telephoneFax %}
    <dt>Numéro de téléphone</dt>
    <dd>
        <ul>
            {% if row.informations.telephoneFixe %}<li>Fixe : {{ row.informations.telephoneFixe }}</li>{% endif %}
            {% if row.informations.telephonePortable %}<li>Portable : {{ row.informations.telephonePortable }}</li>{% endif %}
            {% if row.informations.telephoneFax %}<li>Fax : {{ row.informations.telephoneFax }}</li>{% endif %}
        </ul>
    </dd>
    {% endif %}

    {% if row.informations.mail %}
    <dt>Courriel</dt>
    <dd>
        {{ row.informations.mail }}
    </dd>
    {% endif %}

    {% if row.informations.numeroAdresse or row.informations.rueAdresse or row.informations.codePostalAdresse or row.informations.villeAdresse %}
    <dt>Adresse</dt>
    <dd>
        {{ row.informations.numeroAdresse }} {{ row.informations.rueAdresse }} {{ row.informations.codePostalAdresse }} {{ row.informations.villeAdresse }}
    </dd>
    {% endif %}
</dl>
{% endif %}

<h3>Préventionnistes affectés</h3>
{% if prev|length == 0 %}
    <hr class='clear'><p><strong>Aucun préventionnistes.</strong></p>
{% else %}
    {% for preventionniste in prev %}
        <div class="user-embedded">
            <a href="{{ path('utilisateur_profile', {uid: preventionniste.id}) }}">
                {{ preventionniste.informations.grade }} {{ preventionniste.informations.nom }} {{ preventionniste.informations.prenom }}
            </a>
        </div>
    {% endfor %}
    <div style='clear: both; margin-bottom: 10px;'></div>
{% endif %}

<h3>Contacts du groupement</h3>
<div id='contact-content'></div>
<script type="text/javascript">
    $("#contact-content").load("{{ path('contact_index') }}?item=groupement&id={{ row.id }}&ajax=1&read=1");
</script>
{% endblock %}
