<li class="dossier {% if dossier.nbDossiersLies > 0 %}slide{% endif %}" id="{{ dossier.id }}">

<!-- Icone représentant le dropdown des fils -->
{% if dossier.nbDossiersLies > 0 %}
<span class="icone_enfants" ><i class='ui-icon ui-icon-triangle-1-e' style='position: relative; left: -25px; float: left; margin-right: -25px;' ></i></span>
{% endif %}

<div class="pull-left">
        <span class="doss-nom">
            {% if dossier.verrou %}
                <i class="icon-lock"></i>
            {% endif %}
            {% if dossier.nbPJ > 0 %}
                <!-- TODO : changement d'url lorsque la migration de la partie dossier sera terminée -->
                <a href='/dossier/piece-jointe/id/{{ dossier.id }}'>
                    <i class="icon-file"></i>
                </a>
            {% endif %}
            <a href='/dossier/index/id/{{ dossier.id }}' title='{{ dossier.objet|e('html_attr') }}'>
                {% if dossier.etablissement is not null %}
                    {{ '[' ~ dossier.etablissement ~ '] ' }}
                {% endif %}
                {{ dossier.objet }}
            </a>
        </span>

    <!-- Icone de chargement des enfants (si il y'en a, et si on est en mode niveau -->
    {% if dossier.nbDossiersLies > 0 %}
    <span class='load ui-helper-hidden' ><img src='/images/load.gif' alt='Chargement ...' /></span>
    {% endif %}
</div>

