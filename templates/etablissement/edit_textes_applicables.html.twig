{% extends 'layouts/etablissement.html.twig' %}

{% block title %}{{ parent() }} / Édition des textes applicables{% endblock %}

{% block body %}
    {{ form_start(form) }}
        {{ form_errors(form) }}

        <div class='action-buttons pull-right'>
            <div class="btn-group">
                <a class="btn btn-default" href="{{ path('etablissement_textes_applicables', {id: etablissement.id}) }}">Annuler</a>
                <input type="submit" class="btn btn-success" value="Sauvegarder" />
            </div>
        </div>

        <h3>Modification des Textes applicables</h3>

        {% for texte_applicable in form.textesApplicables %}
            {% if loop.index == 1 or texte_applicable.vars.attr['data-type'] != last_type %}
                <h4>{{ texte_applicable.vars.attr['data-type'] }}</h4>
                {% set last_type = texte_applicable.vars.attr['data-type'] %}
            {% endif %}

            <div class="checkbox">
                {{ form_widget(texte_applicable) }}
                <label for="{{ texte_applicable.vars.id }}" style="{% if texte_applicable.vars.checked %}font-weight: bold{% endif %}">
                    {{ texte_applicable.vars.label }}
                </label>
            </div>
        {% endfor %}
    {{ form_end(form) }}
{% endblock %}
