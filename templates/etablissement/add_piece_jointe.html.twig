<div class="modal-dialog" role="document">
    <form class="modal-content" action="{{ path('etablissement_pieces_jointes_ajouter', {id: etablissement.id}) }}" method="post" enctype="multipart/form-data">
        <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
            <h4 class="modal-title">Ajouter une pièce jointe</h4>
        </div>
        <div class="modal-body">
            <input type="hidden" name="_token" value="{{ csrf_token('add_pj_etablissement') }}" />
            <dl class="dl-horizontal">
                <dt>Libellé</dt>
                <dd><p><input type="text" name="name" class="form-control" /></p></dd>
                <dt>Fichier à envoyer</dt>
                <dd><p><input type="file" name="file" /></p></dd>
                <dt>Mise en avant</dt>
                <dd>
                    <ul class="list-unstyled">
                        <li><input type="radio" name="mise_en_avant" value="0" checked> Seulement dans la liste principale</li>
                        <li><input type="radio" name="mise_en_avant" value="1"> Afficher l'image dans le diaporama</li>
                        <li><input type="radio" name="mise_en_avant" value="2"> Afficher l'image dans les plans</li>
                    </ul>
                    <p class="text-muted"><small>Uniquement pour les images.</small></p>
                </dd>
                <dt>Description</dt>
                <dd><p><textarea name="description" rows="3" class="form-control"></textarea></p></dd>
            </dl>
        </div>
        <div class="modal-footer">
            <a href="#" data-dismiss="modal" class="btn btn-default">Annuler</a>
            <button type="submit" class="btn btn-success">Ajouter</button>
        </div>
    </form>
</div>
