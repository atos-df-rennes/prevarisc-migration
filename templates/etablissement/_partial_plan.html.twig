{#
  _partial_plan.html.twig
  Ligne de tableau pour un plan d'intervention.

  Variables :
    - prototype (bool)          : true = ligne cachée (modèle JS)
    - plan (EtablissementInformationsPlan|null)
    - types_plans (TypePlan[])  : liste des types de plans
#}
{% set is_proto = prototype|default(false) %}
<tr id="{{ is_proto ? 'prototype_plan' : '' }}"
    class="{{ is_proto ? 'hide prototype' : '' }}">
    <td>
        <select class="form-control" name="{{ is_proto ? 'ID_TYPEPLAN[-1]' : 'ID_TYPEPLAN[' ~ (plan.id|default(0)) ~ ']' }}">
            <option value="">— Choisir —</option>
            {% for tp in types_plans %}
                <option value="{{ tp.id }}"
                    {{ (not is_proto and plan is not null and plan.typePlan.id == tp.id) ? 'selected' : '' }}>
                    {{ tp.libelle }}
                </option>
            {% endfor %}
        </select>
    </td>
    <td>
        <input type="text" class="form-control"
               name="{{ is_proto ? 'NUMERO_PLAN[-1]' : 'NUMERO_PLAN[' ~ (plan.id|default(0)) ~ ']' }}"
               value="{{ is_proto ? '' : (plan.numero|default('')) }}"
               style="width: 70px;" />
    </td>
    <td>
        <input type="date" class="form-control"
               name="{{ is_proto ? 'DATE_PLAN[-1]' : 'DATE_PLAN[' ~ (plan.id|default(0)) ~ ']' }}"
               value="{{ is_proto ? '' : (plan.date is not null ? plan.date|date('Y-m-d') : '') }}" />
    </td>
    <td class="text-center">
        <input type="hidden"
               name="{{ is_proto ? 'MAJ_PLAN[-1]' : 'MAJ_PLAN[' ~ (plan.id|default(0)) ~ ']' }}"
               value="0" />
        <input type="checkbox"
               name="{{ is_proto ? 'MAJ_PLAN[-1]' : 'MAJ_PLAN[' ~ (plan.id|default(0)) ~ ']' }}"
               value="1"
               {{ (not is_proto and plan is not null and plan.maj) ? 'checked' : '' }} />
    </td>
    <td>
        <button type="button" class="btn btn-xs btn-danger btn_remove_plan">
            <span class="glyphicon glyphicon-remove"></span>
        </button>
    </td>
</tr>
