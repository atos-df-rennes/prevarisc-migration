{% extends 'layouts/etablissement.html.twig' %}

{% import 'components/_formulaire_personnalise.html.twig' as forms %}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('css/formulaire-bs3/descriptif.css') }}" rel="stylesheet" />
{% endblock %}

{% block title %}{{ parent() }} / Descriptif{% endblock %}

{% block body %}
    <div class="pull-right">
        <a class="btn btn-default" href="/etablissement/edit-descriptif/id/{{ etablissement.id }}">Modifier le descriptif</a>
    </div>

    <h3>{{ capsule ? capsule.nom : 'Descriptif' }}</h3>

    {% if rubriques is empty %}
        <p class="text-muted">
            <em>Aucune rubrique configurée. Contactez un administrateur Prevarisc.</em>
        </p>
    {% else %}
        {{ forms.rubriques(rubriques) }}
    {% endif %}
{% endblock %}
