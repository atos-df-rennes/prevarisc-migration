{% set key_ign = parameter('app.ign_key') %}
{% set key_googlemap = parameter('app.google_map_key') %}
{% set geoconcept_url = parameter('app.geoconcept_url') %}

<!-- Cartes et diaporama -->
<ul id="menu_nav" class="nav nav-tabs" style="margin: 0; padding: 0; border-bottom: none;">
    {% if diapo_plans|length > 0 %}
        <li class="tabs-right"><a href="#plans-tab-pane" data-toggle="tab">Plans</a></li>
    {% endif %}
    {% if diapo|length > 0 %}
        <li class="tabs-right"><a href="#diaporama-tab-pane" data-toggle="tab">Diaporama</a></li>
    {% endif %}
    {% if adresses|length > 0 and key_ign is not empty and adresses[0].latitude is not null and adresses[0].longitude is not null %}
        <li class="tabs-right"><a href="#geoportail" data-toggle="tab">Carte IGN</a></li>
    {% endif %}
    {% if adresses|length > 0 and key_googlemap is not empty and adresses[0].latitude is not null and adresses[0].longitude is not null %}
        <li class="tabs-right"><a href="#googlemap" data-toggle="tab">Carte Google</a></li>
    {% endif %}
    {% if adresses|length > 0 and geoconcept_url is not empty and adresses[0].latitude is not null and adresses[0].longitude is not null %}
        <li class="tabs-right"><a href="#geoconcept" data-toggle="tab">Carte GeoConcept</a></li>
    {% endif %}
</ul>
<div id="reponse-modal" class="modal fade"></div>
<div class="tab-content">
    <!-- Carte IGN -->
    {% if adresses|length > 0 and key_ign is not empty and adresses[0].latitude is not null and adresses[0].longitude is not null %}
        <div id="geoportail" class="tab-pane active" style="height: 350px; max-height: 350px;">
            <div id="geoportail-container" style="height: 100%; max-height: 100%;"></div>

            <script type="text/javascript">
                {# TODO: Pas d'utilisation de parameter(), c'est uniquement une variable d'env #}
                {% set autoconf_path = asset_exist(app.request.server.get('PREVARISC_IGN_AUTOCONF')) ? autoconf_path : '' %}

                viewer = initViewer('geoportail-container',
                    '{{ key_ign }}',
                    [
                        {{ adresses[0].longitude }},
                        {{ adresses[0].latitude }}
                    ],
                    "<b>{{ etablissement.latestInformations.libelle|e('html_attr') }}</b><br/>" +
                    "{{ adresses[0].numero }}, " +
                    "{{ adresses[0].rue.libelle|e('html_attr') }}<br/>" +
                    "{{ adresses[0].commune.codePostal }} " +
                    "{{ adresses[0].commune.libelle }}",
                    '{{ autoconf_path }}'
                );

                viewer.listen('mapLoaded', afterInitMap);

                function afterInitMap () {
                    // Ajout du bouton FullScreen sur la carte
                    var fsControl = new ol.control.FullScreen({});
                    viewer.getLibMap().addControl(fsControl);

                    viewer = addUserLayers(viewer,
                            {{ couches_cartographiques|raw }});
                };
            </script>
        </div>
    {% endif %}

    {% if adresses|length > 0 and geoconcept_url is not empty and adresses[0].latitude is not null and adresses[0].longitude is not null %}
        {% set projection = parameter('app.geoconcept_projection') %}
        {% set token = parameter('app.geoconcept_token') %}
        {% set app_id = parameter('app.geoconcept_app_id') %}

        <div id="geoconcept" class="tab-pane in" style="height: 350px; max-height: 350px;width: 100%">
            <div id="geoconcept-container"  style="height: 100%; max-height: 100%;width: 100%"></div>
            <script type="text/javascript" src="/js/geoconcept/OpenLayers.js"></script>
            <script type="text/javascript" src="/js/geoconcept/proj4js.js"></script>
            <script type="text/javascript" src="/js/geoconcept/htc-lite.js"></script>
            {% if projection is defined and projection == true %}
                <script type="text/javascript" src="/js/geoconcept/defs/{{ projection }}.js"></script>
            {% endif %}
            <script type="text/javascript" src="/js/geoconcept/geoconcept.js"></script>
            <link rel="stylesheet" href="/css/geoconcept/htc.css"/>
            <script>
                $(document).ready(function() {
                    {% if token and app_id %}
                    initGeoConceptKey('{{ app_id }}', '{{ token }}');
                    {% endif %}

                    var points = [];
                    {% for adresse in adresses %}
                    {% if adresse.latitude and adresse.longitude %}
                    points.push({
                        lat: {{ adresse.latitude }},
                        lon: {{ adresse.longitude }},
                        description: "{{ adresse.numero ~ ' ' ~ adresse.rue.libelle ~ ' ' ~ adresse.commune.codePostal ~ ' ' ~ adresse.commune.libelle|e('html_attr') }} <br />"
                            + "long={{ adresse.longitude }}, lat={{ adresse.latitude }}"
                    });
                    {% endif %}
                    {% endfor %}
                    map = initGeoConceptViewer('geoconcept-container',
                        "{{ geoconcept_url }}",
                        "{{ parameter('app.geoconcept_layer') }}",
                        points,
                            {{ couches_cartographiques|json_encode|raw }}
                    );
                });
            </script>
        </div>
    {% endif %}

    {% if adresses|length > 0 and key_googlemap is not empty and adresses[0].latitude is not null and adresses[0].longitude is not null %}
        <div id="googlemap" class="tab-pane in" style="height: 350px; max-height: 350px;">
            <div id="googlemap-container"  style="height: 100%; max-height: 100%;"></div>
            <script type="text/javascript"
                    src="https://maps.googleapis.com/maps/api/js?key={{ key_googlemap }}&sensor=false">
            </script>
            <script type="text/javascript">
                function initialize() {
                    var point = new google.maps.LatLng({{ adresses[0].latitude }}, {{ adresses[0].longitude }});
                    var map = new google.maps.Map(document.getElementById("googlemap-container"), {
                        center: point,
                        zoom: 12
                    });
                    var marker = new google.maps.Marker({
                        position: point,
                        map: map,
                        title: "{{ etablissement.latestInformations.libelle }}"
                    });

                    var infowindow = new google.maps.InfoWindow({
                        content:
                            "{{ adresses[0].numero }}, " +
                            "{{ adresses[0].rue.libelle }} <br />" +
                            "{{ adresses[0].commune.codePostal }} " +
                            "{{ adresses[0].commune.libelle }} "
                    });
                    infowindow.open(map,marker);
                };

                google.maps.event.addDomListener(window, 'load', initialize);
            </script>
        </div>
    {% endif %}

    {% if diapo|length > 0 %}
        <div id="diaporama-tab-pane" class="tab-pane">
            <div id="diaporama" class="carousel slide">
                <ol class="carousel-indicators">
                    {% for item in diapo %}
                        <li class="{{ loop.first ? 'active' }}" data-target="#{{ item.id }}" data-slide-to="{{ loop.index0 }}"></li>
                    {% endfor %}
                </ol>
                <!-- Carousel items -->
                <div class="carousel-inner" style="background-color: #333">
                    {% for item in etablissement.diapo %}
                        <div class="item {{ loop.first ? 'active' }}">
                            {# {% set EXTENSION_PIECEJOINTE == '.jpg' %} #}
                            <img style="margin: 0 auto; width: auto; height: 350px; max-height: 350px;"
                                 src="{{ store.getURLPath(item, 'etablissement_miniature', etablissement.general.id) }}"
                                 alt="{{ item.nom|e('html_attr') }}"
                            />
                            <div class="carousel-caption">
                                <h4>{{ item.nom }}</h4>
                                <p>{{ item.description }}</p>
                            </div>
                        </div>
                    {% endfor %}
                </div>
                <!-- Carousel nav -->
                <a class="carousel-control left" href="#diaporama" data-slide="prev" style="box-sizing: content-box;">&lsaquo;</a>
                <a class="carousel-control right" href="#diaporama" data-slide="next" style="box-sizing: content-box;">&rsaquo;</a>
            </div>
        </div>
    {% endif %}

    {% if diapo_plans|length > 0 %}
        <div id="plans-tab-pane" class="tab-pane">
            <div id="plans" class="carousel slide">
                <ol class="carousel-indicators">
                    {% for item in diapo_plans %}
                        <li class="{{ loop.first ? 'active' }}" data-target="#{{ item.id }}" data-slide-to="{{ loop.index0 }}"></li>
                    {% endfor %}
                </ol>
                <!-- Carousel items -->
                <div class="carousel-inner" style="background-color: #333">
                    {% for item in etablissement.diapo_plans %}
                        <div class="item {{ loop.first ? 'active' }}" >
                            {# {% set item.EXTENSION_PIECEJOINTE = '.jpg' %} #}
                            <img style="margin: 0 auto; width: auto; height: 350px; max-height: 350px;"
                                 src="{{ store.getURLPath(item, 'etablissement_miniature', etablissement.general.id) }}"
                                 alt="{{ item.nom|e('html_attr') }}"
                            />
                            <div class="carousel-caption">
                                <h4>{{ item.nom }}</h4>
                                <p>{{ item.description }}</p>
                            </div>
                        </div>
                    {% endfor %}
                </div>
                <!-- Carousel nav -->
                <a class="carousel-control left" href="#plans" data-slide="prev" style="box-sizing: content-box;">&lsaquo;</a>
                <a class="carousel-control right" href="#plans" data-slide="next" style="box-sizing: content-box;">&rsaquo;</a>
            </div>
        </div>
    {% endif %}
</div>

{% if adresses|length > 0 %}
    <h4 class="h4_subtitle">Adresse</h4>
    <dl class="dl-horizontal">
        <dt>Adresses</dt>
        <dd>
            <table class="table table-condensed champ_adresse champs">
                <thead>
                <tr>
                    <th>Localisation</th>
                    <th>Type</th>
                </tr>
                </thead>
                <tbody>
                {% for adresse in adresses %}
                    <tr>
                        <td>{{ '%s %s %s %s '|format(adresse.numero, adresse.rue.libelle, adresse.complement, adresse.commune.codePostal)|lower ~ adresse.commune.libelle|capitalize }}</td>
                        <td>Adresse postale</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </dd>

        {% if groupements_de_communes|length > 0 %}
            <dt>Groupements</dt>
            <dd>
                <ul class="list-unstyled">
                    {% for groupement in groupements_de_communes %}
                        <li>
                            <a href="/groupement/view?id={{ (groupement|first).id }}">{{ (groupement|first).libelle }} ({{ groupement.libelle }})</a>
                        </li>
                    {% endfor %}
                </ul>
            </dd>
        {% endif %}
    </dl>
{% endif %}

{% if etablissement.telephone is not empty or etablissement.fax is not empty or etablissement.courriel is not empty %}
    <h4 class="h4_subtitle">Coordonnées</h4>
    <dl class="dl-horizontal">
        <!-- Téléphone -->
        {% if etablissement.telephone is not empty %}
            <dt>Téléphone</dt>
            <dd>
                <p>{{ etablissement.telephone }}</p>
            </dd>
        {% endif %}

        <!-- Fax -->
        {% if etablissement.fax is not empty %}
            <dt>Fax</dt>
            <dd>
                <p>{{ etablissement.fax }}</p>
            </dd>
        {% endif %}

        <!-- Courriel -->
        {% if etablissement.courriel is not empty %}
            <dt>Courriel</dt>
            <dd>
                <p>
                    <a href="mailto:{{ etablissement.courriel }}">{{ etablissement.courriel }}</a>
                </p>
            </dd>
        {% endif %}
    </dl>
{% endif %}

<h4 class="h4_subtitle">Données prévention</h4>
<dl class="dl-horizontal">
    <!-- Commission compétente -->
    {% if etablissement.latestInformations.genre.id in [2, 5] %}
        <dt>Commission</dt>
        <dd>
            <p>{{ etablissement.latestInformations.commission.libelle }} ({{ etablissement.latestInformations.commission.type.libelle }})</p>
    {% endif %}

    <!-- Préventionnistes -->
    <dt>Préventionnistes</dt>
    <dd>
        {% if etablissement.latestInformations.preventionnistes|length == 0 %}
            <p class="text-muted">Aucun préventionniste lié.</p>
        {% else %}
            {% for preventionniste in etablissement.latestInformations.preventionnistes %}
                {{ include('utilisateurs/_user_card.html.twig', {user: preventionniste}) }}
                <div style="clear: both; margin-bottom: 10px;"></div>
            {% endfor %}
        {% endif %}
    </dd>

    <!-- Date de dernière visite -->
    {% if last_visite is not empty %}
        <dt>Dernière VP</dt>
        <dd><p>{{ last_visite|date('d/m/Y') }}</p></dd>
    {% endif %}

    <!-- Date de prochaine visite-->
    {% if next_visite is not empty %}
        <dt>Prochaine VP</dt>
        <dd><p>{{ next_visite|date('d/m/Y') }}</p></dd>
    {% endif %}

    <!-- Date de PC initial -->
    {% if pc_initial is not empty %}
        <dt>Date PC Initial</dt>
        <dd><p>{{ pc_initial|date('d/m/Y') }}</p></dd>
    {% endif %}

    <!-- Présence DUS -->
    <dt>Présence d'un DUS</dt>
    <dd><p>{{ presence_dus ? 'Oui' : 'Non' }}</p></dd>

    <!-- Données pratiques -->
    {% if etablissement.latestInformations.genre.id in [1, 2, 3, 5] %}
        <dt>Données pratiques</dt>
        <dd>
            <p>
                {% if etablissement.latestInformations.genre.id != 1 %}
                    Nb. de préventionnistes/visite : {{ donnees_pratiques.nbPreventionnistes }}<br/>
                {% endif %}
                {% if donnees_pratiques.dureeVisite is not null %}
                    Durée d'une visite : {{ donnees_pratiques.dureeVisite|date('H:i') }}
                {% else %}
                    Durée d'une visite : -
                {% endif %}
            </p>
        </dd>
    {% endif %}
</dl>
