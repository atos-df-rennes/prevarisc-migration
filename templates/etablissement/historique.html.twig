{% extends 'layouts/etablissement.html.twig' %}

{% block title %}Historique{% endblock %}

{% block body %}
    <h3>Historique</h3>
    {% if historique.avis is defined %}
        <h4>Historique des avis d'exploitation</h4>
        {{ include('etablissement/sectionHistorique.html.twig', {datas: historique.avis}) }}
    {% endif %}

    <h4>Historique du libellé</h4>
        {% if historique.libelle is defined %}
            {{ include('etablissement/sectionHistorique.html.twig', {datas: historique.libelle}) }}
        {% else %}
            <p class='muted'>Pas d'historique disponible.</p>
        {% endif %}

