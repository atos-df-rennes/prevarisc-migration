{% extends 'layouts/etablissement.html.twig' %}

{% block title %}{{ parent() }} / Gestion des pièces jointes{% endblock %}

{% block body %}
    <div class='pull-right'>
        <button type="button" id="addPJQuick" class="btn btn-default"><span class="glyphicon glyphicon-upload"></span> Ajout rapide</button>
        <a href="{{ path('etablissement_pieces_jointes_ajouter_formulaire', {id: etablissement.id}) }}" class="btn btn-default" data-toggle="modal" data-backdrop="false" data-target="#reponse-modal"><span class="glyphicon glyphicon-upload"></span> Ajouter une pièce jointe</a>
        <a class='btn btn-default' href="{{ path('etablissement_pieces_jointes', {id: etablissement.id}) }}">Revenir sur l'affichage des pièces jointes</a>
    </div>

    <h3>Gestion des pièces jointes</h3>

    <div id="dropzone" class="dropzone" style="display:none"></div>

    {% if image_pjs is empty and doc_pjs is empty %}
        <p class='text-muted'>Il n'y a pas de pièce jointe.</p>
    {% else %}
        <table id="table-pieces-jointes" class='table table-bordered table-condensed table-hover'>
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Description</th>
                    <th>Date d'ajout</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for pj in image_pjs %}
                    <tr>
                        <td>
                            <a href="{{ path('piece_jointe_get_etablissement', {id: etablissement.id, idpj: pj.0.pieceJointe.id}) }}" target='_blank' rel="noopener noreferrer">{{ pj.0.pieceJointe.nom }}</a>
                        </td>
                        <td>
                            {% if pj.0.pieceJointe.description is not empty %}
                                {{ pj.0.pieceJointe.description|nl2br }}
                            {% else %}
                                Aucune description.
                            {% endif %}
                        </td>
                        <td>
                            {% if pj.0.pieceJointe.date is not null %}
                                {{ pj.0.pieceJointe.date|date('d/m/Y') }}
                            {% endif %}
                        </td>
                        <td>
                            <a href="{{ path('etablissement_pieces_jointes_edit', {id: etablissement.id, idpj: pj.0.pieceJointe.id}) }}" class="btn btn-link btn-sm">Modifier la pièce jointe</a>
                            <form method="post" action="{{ path('etablissement_pieces_jointes_supprimer', {id: etablissement.id}) }}" style="display:inline">
                                <input type="hidden" name="id_pj" value="{{ pj.0.pieceJointe.id }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_pj_' ~ pj.0.pieceJointe.id) }}">
                                <button type="submit" class="btn btn-link btn-sm" onclick="return confirm('Supprimer cette pièce jointe ?')">Supprimer la pièce jointe</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
                {% for pj in doc_pjs %}
                    <tr>
                        <td>
                            <a href="{{ path('piece_jointe_get_etablissement', {id: etablissement.id, idpj: pj.0.pieceJointe.id}) }}" target='_blank' rel="noopener noreferrer">{{ pj.0.pieceJointe.nom }}</a>
                        </td>
                        <td>
                            {% if pj.0.pieceJointe.description is not empty %}
                                {{ pj.0.pieceJointe.description|nl2br }}
                            {% else %}
                                Aucune description.
                            {% endif %}
                        </td>
                        <td>
                            {% if pj.0.pieceJointe.date is not null %}
                                {{ pj.0.pieceJointe.date|date('d/m/Y') }}
                            {% endif %}
                        </td>
                        <td>
                            <a href="{{ path('etablissement_pieces_jointes_edit', {id: etablissement.id, idpj: pj.0.pieceJointe.id}) }}" class="btn btn-link btn-sm">Modifier la pièce jointe</a>
                            <form method="post" action="{{ path('etablissement_pieces_jointes_supprimer', {id: etablissement.id}) }}" style="display:inline">
                                <input type="hidden" name="id_pj" value="{{ pj.0.pieceJointe.id }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_pj_' ~ pj.0.pieceJointe.id) }}">
                                <button type="submit" class="btn btn-link btn-sm" onclick="return confirm('Supprimer cette pièce jointe ?')">Supprimer la pièce jointe</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    <div id="reponse-modal" class="modal fade" tabindex="-1" role="dialog"></div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script type="text/javascript">
        Dropzone.autoDiscover = false;
        $(document).ready(function() {
            $("a[data-toggle='modal']").click(function() {
                var target = $(this).attr("data-target");
                var url = $(this).attr("href");
                $(target).load(url);
            });

            $("#addPJQuick").click(function() {
                $('#dropzone').toggle();
            });

            var myDropzone = new Dropzone("#dropzone", {
                url: "{{ path('etablissement_pieces_jointes_ajouter', {id: etablissement.id}) }}",
                paramName: "file",
                params: {
                    _token: "{{ csrf_token('add_pj_etablissement') }}"
                }
            });
            myDropzone.on("success", function() {
                document.location.reload();
            });
        });
    </script>
{% endblock %}
