{% extends 'layouts/etablissement.html.twig' %}

{% block title %}{{ parent() }} / Historique{% endblock %}

{% block body %}
    <div id="etablissement">
        <div class="pull-right">
            <a class="btn btn-default" href="{{ path('edit') }}">Modifier la fiche</a>
        </div>

        <h3>Fiche d'informations générales</h3>

        <div class="row">
            <!-- Informations générales de l'établissement -->
            <div class="col-md-6">
                <!-- Classement de l'établissement -->
                <h4 class="h4_subtitle">Classement</h4>
                <dl class="dl-horizontal">
                    <dt>Genre</dt>
                    <dd>
                        <p>
                            <strong>{{ etablissement.informations.LIBELLE_GENRE }}</strong>
                            {% if etablissement.informations.ICPE_ETABLISSEMENTINFORMATIONS %}
                                <span class="badge badge-info">ICPE</span>
                            {% endif %}
                        </p>
                    </dd>

                    {% if etablissement.informations.ID_GENRE in [2, 3] %}
                        <dt>Catégorie</dt>
                        <dd>
                            <p>{{ etablissement.informations.LIBELLE_CATEGORIE }}</p>
                        </dd>
                    {% endif %}

                    {% if etablissement.informations.ID_GENRE == 4 %}
                        <dt>Famille</dt>
                        <dd>
                            <p>{{ etablissement.informations.LIBELLE_FAMILLE }}</p>
                        </dd>
                    {% endif %}

                    {% if etablissement.informations.ID_GENRE == 5 %}
                        <dt>Classe</dt>
                        <dd>
                            <p>{{ etablissement.informations.LIBELLE_CLASSE }}</p>
                        </dd>
                    {% endif %}

                    {% if etablissement.informations.ID_GENRE == 10 %}
                        <dt>Classement</dt>
                        <dd>
                            <p>{{ etablissement.informations.LIBELLE_CLASSEMENT }}</p>
                        </dd>
                    {% endif %}

                    {% if etablissement.informations.ID_GENRE in [1, 2, 3, 5] and etablissement.informations.PERIODICITE_ETABLISSEMENTINFORMATIONS is not null %}
                        <dt>Périodicité</dt>
                        <dd>
                            <p>
                                {% if etablissement.informations.ID_GENRE == 1 %}
                                    <i class="glyphicon glyphicon-info-sign" title="Périodicité la plus contraignante des fils ERP"></i>
                                {% endif %}
                                {% if etablissement.informations.ID_GENRE in [2, 5] and etablissement.informations.PERIODICITE_ETABLISSEMENTINFORMATIONS != default_periodicite %}
                                    <i class="glyphicon glyphicon-exclamation-sign" title="Periodicite non standard"></i>
                                {% endif %}
                                {{ periodicity }}
                            </p>
                        </dd>
                    {% endif %}
                </dl>

                <!-- Activités de l'établissement -->
                {% if etablissement.informations.ID_GENRE in [2, 3] %}
                    <h4 class="h4_subtitle">Activités {% if etablissement.informations.LOCALSOMMEIL_ETABLISSEMENTINFORMATIONS and etablissement.informations.ID_GENRE == 2 %}
                            <span class="badge badge-info pull-right">Présence de locaux à sommeil</span>
                        {% endif %}</h4>
                    <dl class="dl-horizontal">
                        <!-- Type et activités -->
                        <dt>Types & activités</dt>
                        <dd>
                            <ul class="list-unstyled">
                                <li>
                                    <strong>
                                        {% if file_exists(SYMFONY_APPLICATION_PATH ~ '/public/images/types/b/icone-type-' ~ etablissement.informations.LIBELLE_TYPE_PRINCIPAL ~ '.png') %}
                                            <img src="/images/types/b/icone-type-{{ etablissement.informations.LIBELLE_TYPE_PRINCIPAL }}.png" title="{{ etablissement.informations.LIBELLE_TYPE_PRINCIPAL }}" />&nbsp;-&nbsp;
                                        {% else %}
                                            {{ etablissement.informations.LIBELLE_TYPE_PRINCIPAL }}&nbsp;-&nbsp;
                                        {% endif %}
                                        {{ etablissement.informations.LIBELLE_TYPEACTIVITE_PRINCIPAL }}
                                    </strong>
                                </li>
                                {% for type_activite in etablissement.types_activites_secondaires %}
                                    <li>
                                        {% if file_exists(SYMFONY_APPLICATION_PATH ~ '/public/images/types/b/icone-type-' ~ type_activite.LIBELLE_TYPE ~ '.png') %}
                                            <img src="/images/types/b/icone-type-{{ type_activite.LIBELLE_TYPE }}.png" title="{{ type_activite.LIBELLE_TYPE }}" />&nbsp;-&nbsp;
                                        {% else %}
                                            {{ type_activite.LIBELLE_TYPE }}&nbsp;-&nbsp;
                                        {% endif %}
                                        {{ type_activite.LIBELLE_ACTIVITE }}
                                    </li>
                                {% endfor %}
                            </ul>
                            {% if etablissement.informations.R14320_ETABLISSEMENTINFORMATIONS %}
                                <p>Le <strong>R143-20</strong> est appliqué sur cet établissement.</p>
                            {% endif %}
                            {% if etablissement.informations.ID_GENRE in [2] %}
                                {% if etablissement.informations.DROITPUBLIC_ETABLISSEMENTINFORMATIONS %}
                                    <p>Le <strong>R143-16</strong> est appliqué sur cet établissement (droit public).</p>
                                {% endif %}
                            {% endif %}
                        </dd>
                    </dl>
                {% endif %}

                <!-- Rubriques -->
                {% if etablissement.informations.ICPE_ETABLISSEMENTINFORMATIONS %}
                    <h4 class="h4_subtitle">Rubriques ICPE</h4>
                    {% if etablissement.rubriques|length == 0 %}
                        <p class="text-muted text-center">Pas de rubriques disponible</p>
                    {% else %}
                        <table class="table table-condensed">
                            <thead>
                            <tr>
                                <th>Rubrique</th>
                                <th>Numéro</th>
                                <th>Nom</th>
                                <th>Valeur</th>
                                <th>Classement</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for rubrique in etablissement.rubriques %}
                                <tr>
                                    <td>{{ rubrique.ID_RUBRIQUE == 1 ? 'Substance' : (rubrique.ID_RUBRIQUE == 2 ? 'Activité' : (rubrique.ID_RUBRIQUE == 3 ? 'IED' : 'Produits dangereux')) }}</td>
                                    <td>{{ rubrique.NUMERO_ETABLISSEMENTINFORMATIONSRUBRIQUE }}</td>
                                    <td>{{ rubrique.NOM_ETABLISSEMENTINFORMATIONSRUBRIQUE }}</td>
                                    <td>{{ rubrique.VALEUR_ETABLISSEMENTINFORMATIONSRUBRIQUE }}</td>
                                    <td>{{ rubrique.CLASSEMENT_ETABLISSEMENTINFORMATIONSRUBRIQUE }}</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    {% endif %}
                {% endif %}

                {% if etablissement.informations.ID_GENRE in [7] %}
                    <h4 class="h4_subtitle">Nombre d'emplacements</h4>
                    <dl class="dl-horizontal champ_effectif_camping index_camping">
                        <dt>Mobil-homes ou habitations</dt>
                        <dd>
                            <p>{{ etablissement.informations.EFFECTIFHABITATION_ETABLISSEMENTINFORMATIONS }}</p>
                        </dd>

                        <dt>Autocaravanes</dt>
                        <dd>
                            <p>{{ etablissement.informations.EFFECTIFCARAVANE__ETABLISSEMENTINFORMATIONS }}</p>
                        </dd>

                        <dt>Emplacements nus</dt>
                        <dd>
                            <p>{{ etablissement.informations.EFFECTIFEMPLACEMENTNU_ETABLISSEMENTINFORMATIONS }}</p>
                        </dd>

                        <dt>Autres emplacements</dt>
                        <dd>
                            <p>{{ etablissement.informations.EFFECTIFDIVERS_ETABLISSEMENTINFORMATIONS }}</p>
                        </dd>

                        <dt>&nbsp;</dt><dd><hr></dd>

                        <dt>Total</dt>
                        <dd>
                            <p>{{ etablissement.informations.EFFECTIFHABITATION_ETABLISSEMENTINFORMATIONS + etablissement.informations.EFFECTIFCARAVANE__ETABLISSEMENTINFORMATIONS + etablissement.informations.EFFECTIFEMPLACEMENTNU_ETABLISSEMENTINFORMATIONS + etablissement.informations.EFFECTIFDIVERS_ETABLISSEMENTINFORMATIONS }}</p>
                        </dd>
                    </dl>
                {% endif %}

                <!-- Les effectifs -->
                {% if etablissement.informations.ID_GENRE in [2, 3, 5, 6] %}
                    <h4 class="h4_subtitle">Les effectifs</h4>
                    <dl class="dl-horizontal">
                        <!-- Effectif public -->
                        {% if etablissement.informations.ID_GENRE in [2, 3, 5] %}
                            <dt>Public</dt>
                            <dd>
                                <p>{{ etablissement.informations.EFFECTIFPUBLIC_ETABLISSEMENTINFORMATIONS }}</p>
                            </dd>
                        {% endif %}

                        <!-- Effectif personnel -->
                        <dt>Personnel</dt>
                        <dd>
                            <p>{{ etablissement.informations.EFFECTIFPERSONNEL_ETABLISSEMENTINFORMATIONS }}</p>
                        </dd>

                        <!-- Effectif hebergé -->
                        {% if etablissement.informations.LOCALSOMMEIL_ETABLISSEMENTINFORMATIONS and etablissement.informations.ID_GENRE == 2 %}
                            <dt>Dont hebergé</dt>
                            <dd>
                                <p>{{ etablissement.informations.EFFECTIFHEBERGE_ETABLISSEMENTINFORMATIONS }}</p>
                            </dd>
                        {% endif %}

                        <dt>&nbsp;</dt><dd><hr></dd>

                        <!-- Effectif total -->
                        <dt>Total</dt>
                        <dd>
                            <p>{{ etablissement.informations.EFFECTIFPUBLIC_ETABLISSEMENTINFORMATIONS + etablissement.informations.EFFECTIFPERSONNEL_ETABLISSEMENTINFORMATIONS }}</p>
                        </dd>

                        <!-- Effectif justifant le classement (que pour les 5ème catégorie) -->
                        {% if etablissement.informations.ID_CATEGORIE == 5 %}
                            <dt>Justifiant le classement</dt>
                            <dd>
                                <p>{{ etablissement.informations.EFFECTIFJUSTIFIANTCLASSEMENT_ETABLISSEMENTINFORMATIONS }}</p>
                            </dd>
                        {% endif %}
                    </dl>
                {% endif %}

                <!-- Plan -->
                {% if etablissement.informations.ID_GENRE in [2, 3, 5, 6] %}
                    <h4 class="h4_subtitle">Plans d'intervention</h4>
                    {% if etablissement.plans|length == 0 %}
                        <p class="text-muted text-center">Pas de plans disponible</p>
                    {% else %}
                        <table class="table table-condensed">
                            <thead>
                            <tr>
                                <th>Type de plan</th>
                                <th>Numéro du plan</th>
                                <th>Date</th>
                                <th>A mettre à jour</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for plan in etablissement.plans %}
                                <tr>
                                    <td>{{ plan.LIBELLE_TYPEPLAN }}</td>
                                    <td>{{ plan.NUMERO_ETABLISSEMENTPLAN }}</td>
                                    <td>{{ plan.DATE_ETABLISSEMENTPLAN|date('d/m/Y') }}</td>
                                    <td>{{ plan.MISEAJOUR_ETABLISSEMENTPLAN ? 'A jour' : 'Pas à jour' }}</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    {% endif %}
                {% endif %}

                <!-- Etablissement lié -->
                {% if etablissement.etablissement_lies|length > 0 %}
                    <h4 class="h4_subtitle">Établissements liés <small>{{ etablissement.etablissement_lies|length > 0 ? "(" ~ etablissement.etablissement_lies|length ~ ")" }}</small>
                        <input type="text" class="pull-right form-control input-medium" id="filterLinkedEts" placeholder="Filtrer les établissements" />
                        <script>
                            $(document).ready(function(){
                                $('#filterLinkedEts').keyup(function() {
                                    var searchString = $(this).val().toLowerCase();
                                    $(this).parent().next().find('li').each(function(i, elem) {
                                        if ($(elem).text().toLowerCase().indexOf(searchString) !== -1) {
                                            $(elem).show();
                                        } else {
                                            $(elem).hide();
                                        }
                                    });
                                });
                            });
                        </script>
                    </h4>
                    <ul class="recherche_liste list-unstyled no_slide" style="max-height: 500px; overflow-y: scroll;">
                        {{ include('search/results/etablissement.twig', { 'etablissement_lies': etablissement.etablissement_lies }) }}
                    </ul>
                {% endif %}
            </div>

            <!-- Carte de l'emplacement de l'établissement / informations  -->
            <div class="col-md-6">
                <!-- Cartes et diaporama -->
                <ul id="menu_nav" class="nav nav-tabs" style="margin: 0; padding: 0; border-bottom: none;">
                    {% if etablissement.diapo_plans|length > 0 %}
                        <li class="tabs-right"><a href="#plans-tab-pane" data-toggle="tab">Plans</a></li>
                    {% endif %}
                    {% if etablissement.diapo|length > 0 %}
                        <li class="tabs-right"><a href="#diaporama-tab-pane" data-toggle="tab">Diaporama</a></li>
                    {% endif %}
                    {% if etablissement.adresses|length > 0 and key_ign is not null and etablissement.adresses[0].LAT_ETABLISSEMENTADRESSE is not null and etablissement.adresses[0].LON_ETABLISSEMENTADRESSE is not null %}
                        <li class="tabs-right"><a href="#geoportail" data-toggle="tab">Carte IGN</a></li>
                    {% endif %}
                    {% if etablissement.adresses|length > 0 and key_googlemap is not null and etablissement.adresses[0].LAT_ETABLISSEMENTADRESSE is not null and etablissement.adresses[0].LON_ETABLISSEMENTADRESSE is not null %}
                        <li class="tabs-right"><a href="#googlemap" data-toggle="tab">Carte Google</a></li>
                    {% endif %}
                    {% if etablissement.adresses|length > 0 and geoconcept_url is not null and etablissement.adresses[0].LAT_ETABLISSEMENTADRESSE is not null and etablissement.adresses[0].LON_ETABLISSEMENTADRESSE is not null %}
                        <li class="tabs-right"><a href="#geoconcept" data-toggle="tab">Carte GeoConcept</a></li>
                    {% endif %}
                </ul>
                <div id="reponse-modal" class="modal fade"></div>
                <div class="tab-content">
                    <!-- Carte IGN -->
                    {% if etablissement.adresses|length > 0 and key_ign is not null and etablissement.adresses[0].LAT_ETABLISSEMENTADRESSE is not null and etablissement.adresses[0].LON_ETABLISSEMENTADRESSE is not null %}
                        <div id="geoportail" class="tab-pane active" style="height: 350px; max-height: 350px;">
                            <div id="geoportail-container" style="height: 100%; max-height: 100%;"></div>

                            <script type="text/javascript">
                                {% set public_dir = app.request.server.get('DOCUMENT_ROOT') %}
                                {% set autoconf_path = app.request.server.get('PREVARISC_IGN_AUTOCONF') %}
                                {% set autoconf_path = file_exists(public_dir ~ autoconf_path) ? autoconf_path : "" %}

                                viewer = initViewer('geoportail-container',
                                    '{{ key_ign }}',
                                    [{{ etablissement.adresses[0].LON_ETABLISSEMENTADRESSE }},
                                        {{ etablissement.adresses[0].LAT_ETABLISSEMENTADRESSE }}],
                                    "<b>{{ etablissement.informations.LIBELLE_ETABLISSEMENTINFORMATIONS|e('html_attr') }}</b><br/>"+
                                    "{{ etablissement.adresses[0].NUMERO_ADRESSE }}, "
                                    +"{{ etablissement.adresses[0].LIBELLE_RUE|e('html_attr') }}<br/>"+
                                    "{{ etablissement.adresses[0].CODEPOSTAL_COMMUNE }} "+
                                    "{{ etablissement.adresses[0].LIBELLE_COMMUNE }}",
                                    '{{ autoconf_path }}');

                                viewer.listen('mapLoaded', afterInitMap);

                                function afterInitMap () {
                                    // Ajout du bouton FullScreen sur la carte
                                    var fsControl = new ol.control.FullScreen({});
                                    viewer.getLibMap().addControl(fsControl);

                                    viewer = addUserLayers(viewer,
                                            {{ couches_cartographiques|json_encode|raw }});
                                };
                            </script>
                        </div>
                    {% endif %}

                    {% if etablissement.adresses|length > 0 and geoconcept_url is not null and etablissement.adresses[0].LAT_ETABLISSEMENTADRESSE is not null and etablissement.adresses[0].LON_ETABLISSEMENTADRESSE is not null %}
                        <div id="geoconcept" class="tab-pane in" style="height: 350px; max-height: 350px;width: 100%">
                            <div id="geoconcept-container"  style="height: 100%; max-height: 100%;width: 100%"></div>
                            <script type="text/javascript" src="/js/geoconcept/OpenLayers.js"></script>
                            <script type="text/javascript" src="/js/geoconcept/proj4js.js"></script>
                            <script type="text/javascript" src="/js/geoconcept/htc-lite.js"></script>
                            {% if projection = app.request.server.get('PREVARISC_PLUGIN_GEOCONCEPT_PROJECTION') %}
                                <script type="text/javascript" src="/js/geoconcept/defs/{{ projection }}.js"></script>
                            {% endif %}
                            <script type="text/javascript" src="/js/geoconcept/geoconcept.js"></script>
                            <link rel="stylesheet" href="/css/geoconcept/htc.css"/>
                            <script>
                                $(document).ready(function() {
                                    {% if token = app.request.server.get('PREVARISC_PLUGIN_GEOCONCEPT_TOKEN') and app_id = app.request.server.get('PREVARISC_PLUGIN_GEOCONCEPT_APP_ID') %}
                                    initGeoConceptKey('{{ app_id }}', '{{ token }}');
                                    {% endif %}

                                    var points = [];
                                    {% for adresse in etablissement.adresses %}
                                    {% if adresse.LAT_ETABLISSEMENTADRESSE and adresse.LON_ETABLISSEMENTADRESSE %}
                                    points.push({
                                        lat: {{ adresse.LAT_ETABLISSEMENTADRESSE }},
                                        lon: {{ adresse.LON_ETABLISSEMENTADRESSE }},
                                        description: "{{ adresse.NUMERO_ADRESSE ~ ' ' ~ adresse.LIBELLE_RUE ~ ' ' ~ adresse.CODEPOSTAL_COMMUNE ~ ' ' ~ adresse.LIBELLE_COMMUNE|e('html_attr') }} <br />"
                                            + "long={{ adresse.LON_ETABLISSEMENTADRESSE }}, lat={{ adresse.LAT_ETABLISSEMENTADRESSE }}"
                                    });
                                    {% endif %}
                                    {% endfor %}
                                    map = initGeoConceptViewer('geoconcept-container',
                                        "{{ geoconcept_url }}",
                                        "{{ app.request.server.get('PREVARISC_PLUGIN_GEOCONCEPT_LAYER') }}",
                                        points,
                                            {{ couches_cartographiques|json_encode|raw }}
                                    );
                                });
                            </script>
                        </div>
                    {% endif %}

                    {% if etablissement.adresses|length > 0 and key_googlemap is not null and etablissement.adresses[0].LAT_ETABLISSEMENTADRESSE is not null and etablissement.adresses[0].LON_ETABLISSEMENTADRESSE is not null %}
                        <div id="googlemap" class="tab-pane in" style="height: 350px; max-height: 350px;">
                            <div id="googlemap-container"  style="height: 100%; max-height: 100%;"></div>
                            <script type="text/javascript"
                                    src="https://maps.googleapis.com/maps/api/js?key={{ key_googlemap }}&sensor=false">
                            </script>
                            <script type="text/javascript">
                                function initialize() {
                                    var point = new google.maps.LatLng({{ etablissement.adresses[0].LAT_ETABLISSEMENTADRESSE }}, {{ etablissement.adresses[0].LON_ETABLISSEMENTADRESSE }});
                                    var map = new google.maps.Map(document.getElementById("googlemap-container"), {
                                        center: point,
                                        zoom: 12
                                    });
                                    var marker = new google.maps.Marker({
                                        position: point,
                                        map: map,
                                        title: "{{ etablissement.informations.LIBELLE_ETABLISSEMENTINFORMATIONS }}"
                                    });

                                    var infowindow = new google.maps.InfoWindow({
                                        content:
                                            "{{ etablissement.adresses[0].NUMERO_ADRESSE }}, "+
                                            "{{ etablissement.adresses[0].LIBELLE_RUE }} <br />"+
                                            "{{ etablissement.adresses[0].CODEPOSTAL_COMMUNE }} "+
                                            "{{ etablissement.adresses[0].LIBELLE_COMMUNE }} "
                                    });
                                    infowindow.open(map,marker);
                                };

                                google.maps.event.addDomListener(window, 'load', initialize);
                            </script>
                        </div>
                    {% endif %}

                    {% if etablissement.diapo|length > 0 %}
                        <div id="diaporama-tab-pane" class="tab-pane">
                            <div id="diaporama" class="carousel slide">
                                <ol class="carousel-indicators">
                                    {% for item in etablissement.diapo %}
                                        <li class="{{ loop.first ? 'active' }}" data-target="#{{ item.ID_PIECEJOINTE }}" data-slide-to="{{ loop.index0 }}"></li>
                                    {% endfor %}
                                </ol>
                                <!-- Carousel items -->
                                <div class="carousel-inner" style="background-color: #333">
                                    {% for item in etablissement.diapo %}
                                        <div class="item {{ loop.first ? 'active' }}"  >
                                            {% set item.EXTENSION_PIECEJOINTE = '.jpg' %}
                                            <img style="margin: 0 auto; width: auto; height: 350px; max-height: 350px;"
                                                 src="{{ store.getURLPath(item, 'etablissement_miniature', etablissement.general.ID_ETABLISSEMENT) }}"
                                                 alt="{{ item.NOM_PIECEJOINTE|e('html_attr') }}"
                                            />
                                            <div class="carousel-caption">
                                                <h4>{{ item.NOM_PIECEJOINTE }}</h4>
                                                <p>{{ item.DESCRIPTION_PIECEJOINTE }}</p>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                                <!-- Carousel nav -->
                                <a class="carousel-control left" href="#diaporama" data-slide="prev" style="box-sizing: content-box;">&lsaquo;</a>
                                <a class="carousel-control right" href="#diaporama" data-slide="next" style="box-sizing: content-box;">&rsaquo;</a>
                            </div>
                        </div>
                    {% endif %}

                    {% if etablissement.diapo_plans|length > 0 %}
                        <div id="plans-tab-pane" class="tab-pane">
                            <div id="plans" class="carousel slide">
                                <ol class="carousel-indicators">
                                    {% for item in etablissement.diapo_plans %}
                                        <li class="{{ loop.first ? 'active' }}" data-target="#{{ item.ID_PIECEJOINTE }}" data-slide-to="{{ loop.index0 }}"></li>
                                    {% endfor %}
                                </ol>
                                <!-- Carousel items -->
                                <div class="carousel-inner" style="background-color: #333">
                                    {% for item in etablissement.diapo_plans %}
                                        <div class="item {{ loop.first ? 'active' }}" >
                                            {% set item.EXTENSION_PIECEJOINTE = '.jpg' %}
                                            <img style="margin: 0 auto; width: auto; height: 350px; max-height: 350px;"
                                                 src="{{ store.getURLPath(item, 'etablissement_miniature', etablissement.general.ID_ETABLISSEMENT) }}"
                                                 alt="{{ item.NOM_PIECEJOINTE|e('html_attr') }}"
                                            />
                                            <div class="carousel-caption">
                                                <h4>{{ item.NOM_PIECEJOINTE }}</h4>
                                                <p>{{ item.DESCRIPTION_PIECEJOINTE }}</p>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                                <!-- Carousel nav -->
                                <a class="carousel-control left" href="#plans" data-slide="prev" style="box-sizing: content-box;">&lsaquo;</a>
                                <a class="carousel-control right" href="#plans" data-slide="next" style="box-sizing: content-box;">&rsaquo;</a>
                            </div>
                        </div>
                    {% endif %}
                </div>

                {% if etablissement.adresses|length > 0 %}
                    <h4 class="h4_subtitle">Adresse</h4>
                    <dl class="dl-horizontal">
                        <dt>Adresses</dt>
                        <dd>
                            <table class="table table-condensed champ_adresse champs">
                                <thead>
                                <tr>
                                    <th>Localisation</th>
                                    <th>Type</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for adresse in etablissement.adresses %}
                                    <tr>
                                        <td>{{ adresse.NUMERO_ADRESSE ~ ' ' ~ adresse.LIBELLE_RUE ~ ' ' ~ adresse.COMPLEMENT_ADRESSE ~ ' ' ~ adresse.CODEPOSTAL_COMMUNE ~ ' ' ~ adresse.LIBELLE_COMMUNE|lower }}</td>
                                        <td>Adresse postale</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </dd>

                        {% if groupements_de_communes|length > 0 %}
                            <dt>Groupements</dt>
                            <dd>
                                <ul class="list-unstyled">
                                    {% for groupement in groupements_de_communes %}
                                        <li>
                                            <a href="{{ path('groupement_view', { 'id': groupement.ID_GROUPEMENT }) }}">{{ groupement.LIBELLE_GROUPEMENT }} ({{ groupement.LIBELLE_GROUPEMENTTYPE }})</a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </dd>
                        {% endif %}
                    </dl>
                {% endif %}

                {% if etablissement.general.TELEPHONE_ETABLISSEMENT is not empty or etablissement.general.FAX_ETABLISSEMENT is not empty or etablissement.general.COURRIEL_ETABLISSEMENT is not empty %}
                    <h4 class="h4_subtitle">Coordonnées</h4>
                    <dl class="dl-horizontal">
                        <!-- Téléphone -->
                        {% if etablissement.general.TELEPHONE_ETABLISSEMENT is not empty %}
                            <dt>Téléphone</dt>
                            <dd>
                                <p>{{ etablissement.general.TELEPHONE_ETABLISSEMENT }}</p>
                            </dd>
                        {% endif %}

                        <!-- Fax -->
                        {% if etablissement.general.FAX_ETABLISSEMENT is not empty %}
                            <dt>Fax</dt>
                            <dd>
                                <p>{{ etablissement.general.FAX_ETABLISSEMENT }}</p>
                            </dd>
                        {% endif %}

                        <!-- Courriel -->
                        {% if etablissement.general.COURRIEL_ETABLISSEMENT is not empty %}
                            <dt>Courriel</dt>
                            <dd>
                                <p>
                                    <a href="mailto:{{ etablissement.general.COURRIEL_ETABLISSEMENT }}">{{ etablissement.general.COURRIEL_ETABLISSEMENT }}</a>
                                </p>
                            </dd>
                        {% endif %}
                    </dl>
                {% endif %}

                <h4 class="h4_subtitle">Données prévention</h4>
                <dl class="dl-horizontal">
                    <!-- Commission compétente -->
                    {% if etablissement.informations.ID_GENRE in [2, 5] %}
                        <dt>Commission</dt>
                        <dd>
                            <p>{{ etablissement.informations.LIBELLE_COMMISSION }} ({{ etablissement.informations.LIBELLE_COMMISSION_TYPE }})</p>
                        </dd>
                    {% endif %}

                    <!-- Préventionnistes -->
                    <dt>Préventionnistes</dt>
                    <dd>
                        {% if etablissement.preventionnistes|length == 0 %}
                            <p class="text-muted">Aucun préventionniste lié.</p>
                        {% else %}
                            {{ include('users/embedded/user.twig', { 'preventionnistes': etablissement.preventionnistes }) }}
                            <div style="clear: both; margin-bottom: 10px;"></div>
                        {% endif %}
                    </dd>

                    <!-- Date de dernière visite -->
                    {% if etablissement.last_visite is not empty %}
                        <dt>Dernière VP</dt>
                        <dd><p>{{ etablissement.last_visite }}</p></dd>
                    {% endif %}

                    <!-- Date de prochaine visite-->
                    {% if etablissement.next_visite is not empty %}
                        <dt>Prochaine VP</dt>
                        <dd><p>{{ etablissement.next_visite }}</p></dd>
                    {% endif %}

                    <!-- Date de PC initial -->
                    {% if etablissement.pc_initial is not empty %}
                        <dt>Date PC Initial</dt>
                        <dd><p>{{ etablissement.pc_initial }}</p></dd>
                    {% endif %}

                    <!-- Présence DUS -->
                    <dt>Présence d'un DUS</dt>
                    <dd><p>{{ etablissement.presence_dus ? 'Oui' : 'Non' }}</p></dd>

                    <!-- Données pratiques -->
                    {% if etablissement.informations.ID_GENRE in [1, 2, 3, 5] %}
                        <dt>Données pratiques</dt>
                        <dd>
                            <p>
                                {% if etablissement.informations.ID_GENRE != 1 %}
                                    Nb. de préventionnistes/visite : {{ etablissement.donnees_pratiques.NBPREV_ETABLISSEMENT }}<br/>
                                {% endif %}
                                {% if etablissement.donnees_pratiques.DUREEVISITE_ETABLISSEMENT is defined %}
                                    Durée d'une visite : {{ etablissement.donnees_pratiques.DUREEVISITE_ETABLISSEMENT|date('H:i') }}
                                {% else %}
                                    Durée d'une visite : -
                                {% endif %}
                            </p>
                        </dd>
                    {% endif %}
                </dl>
            </div>
        </div>
    </div>

    <!-- Boite de confirmation de la suppression (cachée par défaut) -->
    <div id="confirm-modal" class="modal fade">
        <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
            <h3>Confirmation de la suppression</h3>
        </div>

        <div class="modal-body">
            <p> Etes-vous sûr de vouloir supprimer l'établissement ? </p>
        </div>

        <div class="modal-footer">
            <a href="#" data-dismiss="modal" class="btn btn-default">Annuler</a>
            <a href="{{ path('delete', { 'id': idEtablissement }) }}" class="btn btn-success">Confirmer</a>
        </div>
    </div>

    <script type="text/javascript">
        $(document).ready(function() {
            // Par défaut, on montre le premier onglet disponible (carte, diapo, ou plans) sinon rien
            $('#menu_nav a:last').tab('show');

            $(".alerte-link").click(function() {
                var idEts = "{{ etablissement.general.ID_ETABLISSEMENT }}";
                var changement = $(this).attr("data-value");
                var dialogAlerte = $('<div style="display:none;"></div>').appendTo('body');

                dialogAlerte.dialog({
                    title: "Alerte",
                    modal: true,
                    autoOpen: false,
                    width: 600,
                    height: 'auto',
                    buttons: [{
                        text: "Envoyer",
                        "id": "mail-button-envoi",
                        click: function() {
                            tinymce.triggerSave();
                            if ($("#mail-button-envoi").text() === "Envoyer") {
                                $.ajax({
                                    type: "POST",
                                    url: "/changement/sendmailalerte",
                                    data: $("#formAlerte").serialize()
                                });
                            }

                            tinymce.remove();
                            dialogAlerte.html("");
                            dialogAlerte.dialog("close");
                            dialogAlerte.remove();
                        }
                    }],
                    close: function(event, ui){
                        tinymce.remove();
                        dialogAlerte.html("");
                        dialogAlerte.dialog("close");
                        dialogAlerte.remove();
                    }
                });

                $.ajax({
                    type: "POST",
                    url: "/changement/alerteform",
                    data: { "id_etablissement": idEts, "changement": changement },
                    success: function(msg) {
                        dialogAlerte.html(msg);
                        tinymce.init({
                            selector: '.tinyarea',
                            language: 'fr_FR',
                            height: 220,
                            menubar: false,
                            statusbar: false,
                            toolbar: false,
                            plugins: [
                                'advlist autolink lists link image charmap print preview anchor',
                                'searchreplace visualblocks code fullscreen',
                                'insertdatetime media table contextmenu paste code'
                            ],
                            content_css: [
                                '//fast.fonts.net/cssapi/e6dc9b99-64fe-4292-ad98-6974f93cd2a2.css',
                                '//www.tinymce.com/css/codepen.min.css'
                            ]
                        });
                        dialogAlerte.dialog("open");
                    },
                });

                return false;
            });

            // fenetre de confirmation de la suppression
            $("#suppressionEtablissement").click(function(){
                $('#confirm-modal').modal({show:true});
            });
        });
    </script>
{% endblock %}