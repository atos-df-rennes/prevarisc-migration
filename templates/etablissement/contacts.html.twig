{% extends 'layouts/etablissement.html.twig' %}

{% block title %}{{ parent() }} / Contacts{% endblock %}

{% block body %}
    <h3>Liste des contacts</h3>

    <div class="btn-group pull-right" role="group">
        <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#ajout-contact-existant">Ajouter un contact existant</button>
        <button type="button" class="btn btn-default" id="ajout-contact-bouton" data-toggle="modal" data-target="#ajout-contact">Ajouter un nouveau contact</button>
    </div>

    <div class="clearfix mb-4"></div>

    {% if contacts_parents|length == 0 and contacts|length == 0 %}
        <p>Aucun contact</p>
    {% else %}
        {% if contacts_parents|length > 0 %}
            <div class="row">
                <div class="col-xs-12">
                    <h4>Contacts des établissements parents</h4>

                    <div class="panel-list">
                        {% for contact_parent in contacts_parents %}
                            {{ include('contact/_fiche.html.twig', {can_edit: false, contact: contact_parent}) }}
                        {% endfor %}
                    </div>
                </div>
            </div>
        {% endif %}

        {% if contacts|length > 0 %}
            <div class="row">
                <div class="col-xs-12">
                    {% if contacts_parents|length > 0 %}
                        <hr />

                        <h4>Contacts de l'établissement</h4>
                    {% endif %}

                    <div class="panel-list">
                        {% for contact in contacts %}
                            {{ include('contact/_fiche.html.twig', {can_edit: true, contact: contact}) }}
                        {% endfor %}
                    </div>
                </div>
            </div>
        {% endif %}
    {% endif %}

    {{ include('contact/_modal_ajout.html.twig') }}
    {{ include('contact/_modal_existant.html.twig', {
        action_url: path('etablissement_contacts_add_existing', {id: etablissement.id}),
        csrf_token_id: 'etablissement_contacts_add_existing_' ~ etablissement.id,
    }) }}
    {{ include('contact/_modal_suppression.html.twig') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script type="text/javascript">
        $(document).ready(function() {
            $('#ajout-contact-bouton').click(function () {
                $.ajax({
                    url: "{{ path('etablissement_contacts_add', {id: etablissement.id}) }}",
                    success: function (result) {
                        $('#ajout-contact .modal-body').html(result)
                    }
                })
            })

            const etablissementId = "{{ etablissement.id }}"
            let contactId

            $('.delete-contact-button').on('click', function () {
                contactId = $(this).attr('data-contact-id')

                // Charger le formulaire de suppression dans la modal
                $.ajax({
                    type: "GET",
                    url: Routing.generate('etablissement_contacts_delete', {id: etablissementId, contact: contactId}),
                    success: function(html) {
                        $('#modal-suppression-contact .modal-content').html(html);
                        $('#modal-suppression-contact').modal('show');
                    },
                    error: function() {
                        $.toast.error("Erreur lors du chargement du formulaire de suppression.");
                    }
                });
            })

            $('.edit-contact-button').on('click', function () {
                contactId = $(this).attr('data-contact-id')

                $.ajax({
                    url: Routing.generate('contact_edit', {id: contactId, elementLie: 'etablissement', elementId: etablissementId}),
                    success: function (result) {
                        $('#ajout-contact #ajout-contact-label').html('Modifier un contact')
                        $('#ajout-contact .modal-body').html(result)
                    }
                })
            })

            new TomSelect('#contact-select', {
                valueField: 'id',
                labelField: 'name',
                searchField: 'name',
                plugins: ['remove_button'],
                maxOptions: 100,
                shouldLoad: function(query) {
                    return query.length > 2;
                },
                load: function(query, callback) {
                    fetch(Routing.generate('contact_autocomplete', {search: encodeURIComponent(query)}))
                    .then(response => response.json())
                    .then(json => {
                        callback(json.map(contact => {
                            // Concaténation conditionnelle
                            let nameParts = []

                            if (contact.societe) {
                                nameParts.push(contact.societe)
                            }
                            if (contact.nom) {
                                nameParts.push(contact.nom)
                            }
                            if (contact.prenom) {
                                nameParts.push(contact.prenom)
                            }

                            return {
                                id: contact.id,
                                name: nameParts.join(" ") // Concatène les parties non nulles
                            }
                        }))
                    }).catch(() => {
                        callback()
                    })
                },
            })
        })
    </script>
{% endblock %}
