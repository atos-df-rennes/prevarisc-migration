{% extends 'layouts/etablissement.html.twig' %}

{% block title %}{{ parent() }} / Pièces jointes / Modifier{% endblock %}

{% block body %}
    <h3>Modifier la pièce jointe</h3>

    {{ form_start(form) }}
        {{ form_row(form.nom) }}
        {{ form_row(form.description) }}
        {{ form_row(form.date) }}

        <button type="submit" class="btn btn-success">
            <span class="glyphicon glyphicon-ok"></span> Enregistrer
        </button>
        <a href="{{ path('etablissement_pieces_jointes_modifier', {id: etablissement.id}) }}" class="btn btn-default">Annuler</a>
    {{ form_end(form) }}
{% endblock %}
