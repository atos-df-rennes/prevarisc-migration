{% extends 'layouts/etablissement.html.twig' %}

{% block title %}{{ parent() }} / Pièces jointes{% endblock %}

{% block body %}
    <div class='pull-right' >
        <a class='btn btn-default' href="{{ path('etablissement_edit_pieces_jointes', {id: etablissement.id}) }}">Gestion des pièces jointes</a>
    </div>

    <h3>Pièces jointes</h3>

    {% if doc_pjs is empty and image_pjs is empty %}
        <div class='well well-large text-center'>
            <p class='lead'>Il n'y a pas de pièce jointe.</p>
            <p><a href="{{ path('etablissement_edit_pieces_jointes', {id: etablissement.id}) }}" class='btn btn-default'>Ajouter une pièce jointe</a></p>
        </div>
    {% else %}
        {% if doc_pjs is not empty %}
            <h4>Documents</h4>

            <table class='table table-bordered table-condensed table-striped'>
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Description</th>
                        <th>Date d'ajout</th>
                    </tr>
                </thead>
                <tbody>
                    {% for piecejointe in doc_pjs %}
                        <tr>
                            <td>
                                <a href="{{ path('piece_jointe_get_etablissement', {id: etablissement.id, idpj: piecejointe.0.pieceJointe.id}) }}" target='_blank' rel="noopener noreferrer">
                                    {{ piecejointe.0.pieceJointe.nom }}{{ piecejointe.0.pieceJointe.extension }}
                                </a>
                            </td>
                            <td>
                                {% if piecejointe.0.pieceJointe.description is not empty %}
                                    {{ piecejointe.0.pieceJointe.description|nl2br }}
                                {% else %}
                                    Aucune description
                                {% endif %}
                            </td>
                            <td>
                                {{ piecejointe.0.pieceJointe.date|date('d/m/Y') }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}

        {% if image_pjs is not empty %}
            <h4>Images</h4>

            <div class="row">
                {% for piecejointe in image_pjs %}
                    <div class="col-md-3">
                        <a href='{{ absolute_url(piecejointe.1) }}' data-fancybox="pj-gallery" data-caption="{{ piecejointe.0.pieceJointe.nom }}" class="thumbnail">
                        <img src="{{ absolute_url(piecejointe.2) }}" alt="{{ piecejointe.0.pieceJointe.nom }}">
                        <h5>{{ piecejointe.0.pieceJointe.nom }}</h5>
                        <p>{{ piecejointe.0.pieceJointe.description }}</p>
                    </a>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script>
        $(document).ready(function() {
            $('[data-fancybox="pj-gallery"]').fancybox({
                animationEffect : 'zoom',
                buttons         : ['zoom', 'slideShow', 'fullScreen', 'download', 'close'],
                // Échappement explicite : data-caption est décodé par le navigateur,
                // puis injecté via .html() par FancyBox — on crée un nœud texte pour éviter toute XSS.
                caption : function() {
                    return $('<span>').text($(this).data('caption'))[0].innerHTML;
                },
            });
        });
    </script>
{% endblock %}
