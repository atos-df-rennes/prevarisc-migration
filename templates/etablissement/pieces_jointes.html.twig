{% extends 'layouts/etablissement.html.twig' %}

{% block title %}{{ parent() }} / Pièces jointes{% endblock %}

{% block body %}
    <div class='pull-right' >
        <a class='btn btn-default' href="{{ '/etablissement/edit-pieces-jointes/id/' ~ etablissement.id }}">Gestion des pièces jointes</a>
    </div>

    <h3>Pièces jointes</h3>

    {% if doc_pjs is empty and image_pjs is empty %}
        <div class='well well-large text-center'>
            <p class='lead'>Il n'y a pas de pièce jointe.</p>
            <p><a href="{{ '/etablissement/edit-pieces-jointes/id/' ~ etablissement.id }}" class='btn btn-default'>Ajouter une pièce jointe</a></p>
        </div>
    {% else %}
        {% if doc_pjs is not empty %}
            <h4>Documents</h4>

            <table class='table table-bordered table-condensed table-striped'>
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Description</th>
                        <th>Date d'ajout</th>
                    </tr>
                </thead>
                <tbody>
                    {% for piecejointe in doc_pjs %}
                        <tr>
                            <td>
                                <a href="{{ '/piece-jointe/get/id/' ~ etablissement.id ~ '/idpj/' ~ piecejointe.0.pieceJointe.id ~ '/type/etablissement' }}" target='_blank' rel="noopener noreferrer">
                                    {{ piecejointe.0.pieceJointe.nom }}{{ piecejointe.0.pieceJointe.extension }}
                                </a>
                            </td>
                            <td>
                                {% if piecejointe.0.pieceJointe.description is not empty %}
                                    {{ piecejointe.0.pieceJointe.description|nl2br }}
                                {% else %}
                                    Aucune description
                                {% endif %}
                            </td>
                            <td>
                                {{ piecejointe.0.pieceJointe.date|date('d/m/Y') }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}

        {% if image_pjs is not empty %}
            <h4>Images</h4>

            <div class="row">
                {% for piecejointe in image_pjs %}
                    <div class="col-md-3">
                        <a href='{{ absolute_url(piecejointe.1) }}' class="thumbnail">
                            <h5>{{ piecejointe.0.pieceJointe.nom }}</h5>
                            <p>{{ piecejointe.0.pieceJointe.description }}</p>
                        </a>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script>
        $(document).ready(function() {
            $('a[href$=png], a[href$=jpg], a[href$=jpeg]').fancybox({
                'transitionIn'    :    'elastic',
                'transitionOut'    :    'elastic',
                'speedIn'        :    600,
                'speedOut'        :    200,
            });
        });
    </script>
{% endblock %}
