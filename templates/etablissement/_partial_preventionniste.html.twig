{#
  _partial_preventionniste.html.twig
  Ligne de tableau pour un préventionniste lié à l'établissement.

  Variables :
    - prototype (bool)                        : true = ligne cachée (modèle JS)
    - prev (Utilisateur|null)                 : préventionniste en mode édition
#}
{% set is_proto = prototype|default(false) %}
<tr id="{{ is_proto ? 'prototype_preventionniste' : '' }}"
    class="{{ is_proto ? 'hide prototype' : '' }}">
    <td>
        {# F2 : ID_PREVENTIONNISTE → ID_UTILISATEUR (alignement avec Service/Etablissement.php $data['ID_UTILISATEUR']) #}
        <input type="hidden"
               name="{{ is_proto ? 'ID_UTILISATEUR[-1]' : 'ID_UTILISATEUR[' ~ (prev.id|default(0)) ~ ']' }}"
               value="{{ is_proto ? '' : (prev.id|default('')) }}" />
        <span class="prev_libelle">
            {{ is_proto ? '' : (prev is not null and prev.informations is not null ? prev.informations.prenom ~ ' ' ~ prev.informations.nom : '') }}
        </span>
    </td>
    <td>
        <button type="button" class="btn btn-xs btn-danger btn_remove_preventionniste">
            <span class="glyphicon glyphicon-remove"></span>
        </button>
    </td>
</tr>
