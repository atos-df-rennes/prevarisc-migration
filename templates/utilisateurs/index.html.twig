{% extends 'layouts/admin.html.twig' %}

{% block title %}Administration / Gestion des utilisateurs / Liste des utilisateurs{% endblock %}

{% block body %}
    <h3 class='page-header'>Gestion des utilisateurs</h3>

    <ul class="nav nav-pills">
        <li {% if app.request.get('_route') is same as('admin_utilisateurs') %}class="active"{% endif %}>
            <a href="{{ path('admin_utilisateurs') }}">Général</a>
        </li>
        <li>
            <a href="/users/add">Ajouter un utilisateur</a>
        </li>
        <li>
            <a href="/users/add-group">Créer un groupe</a>
        </li>
        <li>
            <a href="/users/matrice-des-droits">Gérer les droits des groupes</a>
        </li>
    </ul>

    <div class='mt-4'>
        <ul class="col-md-2 nav nav-pills nav-stacked">
            <li {% if not groupe_id %}class='active'{% endif %}><a href="{{ path('admin_utilisateurs') }}">Tous les utilisateurs</a></li>
            {% for groupe in groupes %}
                <li {% if groupe_id and groupe_id == groupe.id %}class='active'{% endif %}>
                    <a href="{{ path('admin_utilisateurs', {gid: groupe.id}) }}">{{ groupe.libelle }}</a>
                </li>
            {% endfor %}
        </ul>

        <div class='col-md-10'>
            {{ include('utilisateurs/_liste.html.twig', {
                type: 'actifs',
                utilisateurs: utilisateurs_actifs
            }) }}

            {{ include('utilisateurs/_liste.html.twig', {
                type: 'inactifs',
                utilisateurs: utilisateurs_inactifs
            }) }}
        </div>
    </div>
{% endblock %}