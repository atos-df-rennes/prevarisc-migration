<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Accueil{% endblock %}</title>
        {# Run `composer require symfony/webpack-encore-bundle`
           and uncomment the following Encore helpers to start using Symfony UX #}
        {% block stylesheets %}
            {# {{ encore_entry_link_tags('app') }} #}

            <link href="{{ asset('css/bootstrap-3.min.css') }}" rel="stylesheet" />
            <link href="{{ asset('css/main-bs3.css') }}" rel="stylesheet" />
            <link href="{{ asset('css/tom-select.default.min.css') }}" rel="stylesheet" />
            <link href="{{ asset('css/login.css') }}" rel="stylesheet" />
            <link href="{{ asset('css/utilities.css') }}" rel="stylesheet" />
            <link href="{{ asset('css/toast-notifications.css') }}" rel="stylesheet" />
            <link href="{{ asset('css/chosen.min.css') }}" rel="stylesheet" />
            <link href="{{ asset('css/jquery/jquery-ui-1.8.11.custom.css') }}" rel="stylesheet" />
            <link href="{{ asset('css/jquery/jquery.tablesorter.css') }}" rel="stylesheet" />
            <link href="{{ asset('css/jquery/jquery.multiselect.css') }}" rel="stylesheet" />
            <link href="{{ asset('css/jquery/jquery.fullcalendar.css') }}" rel="stylesheet" />
            <link href="{{ asset('css/jquery/jquery.fancybox-1.3.4.css') }}" rel="stylesheet" />
            <link href="{{ asset('css/jquery/jquery.tipsy.css') }}" rel="stylesheet" />
            <link href="{{ asset('css/dropzone/basic.css') }}" rel="stylesheet" />
            <link href="{{ asset('css/dropzone/dropzone.css') }}" rel="stylesheet" />
            <link href="{{ asset('css/components/button.css') }}" rel="stylesheet" />
            <link href="{{ asset('css/components/calendrier.css') }}" rel="stylesheet" />
            <link href="{{ asset('css/components/list.css') }}" rel="stylesheet" />
            <link href="{{ asset('css/components/thumbnail.css') }}" rel="stylesheet" />
        {% endblock %}

        {% block javascripts %}
            {# {{ encore_entry_script_tags('app') }} #}

            <script src="{{ asset('js/jquery-1.10.2.min.js') }}"></script>
            <script src="{{ asset('js/jquery-migrate-1.2.1.min.js') }}"></script>
            <script src="{{ asset('js/jquery-ui.min.js') }}"></script>
            <script src="{{ asset('js/jquery.fullcalendar.js') }}"></script>
            <script src="{{ asset('js/jquery.autocomplete.min.js') }}"></script>
            <script src="{{ asset('js/jquery.timeentry.js') }}"></script>
            <script src="{{ asset('js/jquery.elastic.js') }}"></script>
            <script src="{{ asset('js/jquery.toggletext.js') }}"></script>
            <script src="{{ asset('js/jquery.multiselect.min.js') }}"></script>
            <script src="{{ asset('js/jquery.tablesorter.js') }}"></script>
            <script src="{{ asset('js/jquery.tablesorter.pager.js') }}"></script>
            <script src="{{ asset('js/jquery.tipsy.js') }}"></script>
            <script src="{{ asset('js/jquery.fancybox-1.3.4.js') }}"></script>
            <script src="{{ asset('js/dropzone.min.js') }}"></script>
            <script src="{{ asset('js/chosen.jquery.min.js') }}"></script>
            <script src="{{ asset('js/jquery.dateentry.js') }}"></script>
            <script src="{{ asset('js/jquery-ui.datepicker.fr.js') }}"></script>
            <script src="{{ asset('js/jquery.marquee.min.js') }}"></script>
            <script src="{{ asset('js/jquery.hoverintent.js') }}"></script>
            <script src="{{ asset('js/bootstrap-3.min.js') }}"></script>
            <script src="{{ asset('js/tom-select.complete.min.js') }}"></script>
            <script src="{{ asset('js/toast-notifications.js') }}"></script>
            <script src="{{ asset('js/main-bs3.js') }}"></script>
            <script src="{{ asset('bundles/fosjsrouting/js/router.min.js') }}"></script>
            <script src="{{ path('fos_js_routing_js', {callback: 'fos.Router.setData'}) }}"></script>
        {% endblock %}
    </head>
    {% block main %}
        <body>
            {{ include('_header.html.twig') }}

            {% block content %}
                <div class="container-fluid main-container-f">
                    {% block body %}{% endblock %}
                </div>
            {% endblock %}

            {{ render_esi(controller(
                'App\\Controller\\IndexController::footer',
            )) }}
        </body>
    {% endblock %}
</html>
