<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Accueil{% endblock %}</title>
        {# Run `composer require symfony/webpack-encore-bundle`
           and uncomment the following Encore helpers to start using Symfony UX #}
        {% block stylesheets %}
            {# {{ encore_entry_link_tags('app') }} #}

            <link href="{{ asset('vendor/bootstrap.css') }}" rel="stylesheet" />
            <link href="{{ asset('styles/main-bs3.css') }}" rel="stylesheet" />
            <link href="{{ asset('vendor/tom-select.css') }}" rel="stylesheet" />
            <link href="{{ asset('styles/login.css') }}" rel="stylesheet" />
            <link href="{{ asset('styles/utilities.css') }}" rel="stylesheet" />
            <link href="{{ asset('styles/toast-notifications.css') }}" rel="stylesheet" />

            <link href="{{ asset('vendor/jquery-ui.css') }}" rel="stylesheet" />
            <link href="{{ asset('css/jquery/jquery.fullcalendar.css') }}" rel="stylesheet" />
            <link href="{{ asset('css/jquery/jquery.fancybox.min.css') }}" rel="stylesheet" />
            <link href="{{ asset('css/dropzone/basic.css') }}" rel="stylesheet" />
            <link href="{{ asset('css/dropzone/dropzone.css') }}" rel="stylesheet" />
            <link href="{{ asset('css/components/button.css') }}" rel="stylesheet" />
            <link href="{{ asset('css/components/calendrier.css') }}" rel="stylesheet" />
            <link href="{{ asset('css/components/list.css') }}" rel="stylesheet" />
            <link href="{{ asset('css/components/thumbnail.css') }}" rel="stylesheet" />
            <link href="{{ asset('css/components/changelog.css') }}" rel="stylesheet" />
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
            {# {{ encore_entry_script_tags('app') }} #}

            <script src="{{ asset('vendor/jquery.js') }}"></script>
            <script src="{{ asset('vendor/jquery-migrate.js') }}"></script>
            <script src="{{ asset('vendor/jquery-ui.js') }}"></script>
            <script src="{{ asset('js/jquery.fullcalendar.js') }}"></script>
            <script src="{{ asset('js/jquery.autocomplete.min.js') }}"></script>
            <script src="{{ asset('js/jquery.timeentry.js') }}"></script>
            <script src="{{ asset('js/jquery.elastic.js') }}"></script>
            <script src="{{ asset('js/jquery.toggletext.js') }}"></script>
            <script src="{{ asset('js/jquery.fancybox.min.js') }}"></script>
            <script src="{{ asset('js/dropzone.min.js') }}"></script>
            <script src="{{ asset('js/jquery.dateentry.js') }}"></script>
            <script src="{{ asset('js/jquery-ui.datepicker.fr.js') }}"></script>
            <script src="{{ asset('js/jquery.marquee.min.js') }}"></script>
            <script src="{{ asset('js/jquery.hoverintent.js') }}"></script>
            <script src="{{ asset('vendor/bootstrap.js') }}"></script>
            <script src="{{ asset('vendor/tom-select.js') }}"></script>
            <script src="{{ asset('toast-notifications.js') }}"></script>
            <script src="{{ asset('main-bs3.js') }}"></script>
            <script src="{{ asset('bundles/fosjsrouting/js/router.min.js') }}"></script>
            <script src="{{ asset('js/fos_js_routes.js') }}"></script>
            <script src="{{ asset('js/tinymce.min.js') }}"></script>
            <script src="{{ asset('js/alerte/alerte.js') }}"></script>
        {% endblock %}
    </head>
    {% block main %}
        <body>
            {{ include('_header.html.twig') }}
            {{ render(controller('App\\Controller\\ChangelogController::banner')) }}

            {% block content %}
                <div class="container-fluid main-container-f">
                    {% block body %}{% endblock %}
                </div>
            {% endblock %}

            {{ render_esi(controller(
                'App\\Controller\\IndexController::footer',
            )) }}
        </body>
    {% endblock %}
</html>
