{% extends 'layouts/admin.html.twig' %}

{% block title %}Administration / Gestion des éléments supprimés{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    <link href="{{ asset('css/elements-supprimes.css') }}" rel="stylesheet" />
{% endblock %}

{% block body %}
    <h3>Gestion des éléments supprimés</h3>

    <ul class="nav nav-tabs" role="tablist">
        <li role="presentation" class="active"><a href="#dossiers" data-toggle="tab" aria-controls="dossiers">Dossiers</a></li>
        <li role="presentation"><a href="#etablissements" data-toggle="tab" aria-controls="etablissements">Établissements</a></li>
    </ul>

    <div class="tab-content">
        {% if is_granted('delete_dossier') %}
            <div role="tabpanel" id="dossiers" class="tab-pane fade in active">
                {{ include('elements_supprimes/_dossiers.html.twig', {
                    dossiers: dossiers_supprimes
                }) }}
            </div>
        {% endif %}

        {% if is_granted('delete_etablissement') %}
            <div role="tabpanel" id="etablissements" class="tab-pane fade">
                {{ include('elements_supprimes/_etablissements.html.twig', {
                    etablissements: etablissements_supprimes
                }) }}
            </div>
        {% endif %}
    </div>
{% endblock %}
