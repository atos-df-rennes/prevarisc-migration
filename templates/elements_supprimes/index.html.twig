{% extends 'layouts/admin.html.twig' %}

{% block title %}Administration / Gestion des éléments supprimés{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    <link href="{{ asset('styles/elements-supprimes.css') }}" rel="stylesheet" />
{% endblock %}

{% block body %}
    <h3 class="page-header">Gestion des éléments supprimés</h3>

    {% set can_delete_dossier = is_granted('delete_dossier') %}
    {% set can_delete_etablissement = is_granted('delete_etablissement') %}

    {% if can_delete_dossier or can_delete_etablissement %}
        <ul class="nav nav-tabs" role="tablist">
            {% if can_delete_dossier %}
                <li role="presentation" class="active"><a href="#dossiers" data-toggle="tab" aria-controls="dossiers">Dossiers</a></li>
            {% endif %}
            {% if can_delete_etablissement %}
                <li role="presentation"{% if not can_delete_dossier %} class="active"{% endif %}><a href="#etablissements" data-toggle="tab" aria-controls="etablissements">Établissements</a></li>
            {% endif %}
        </ul>

        <div class="tab-content">
            {% if can_delete_dossier %}
                <div role="tabpanel" id="dossiers" class="tab-pane fade in active">
                    {{ include('elements_supprimes/_dossiers.html.twig', {
                        dossiers: dossiers_supprimes,
                    }) }}
                </div>
            {% endif %}

            {% if can_delete_etablissement %}
                <div role="tabpanel" id="etablissements" class="tab-pane fade{% if not can_delete_dossier %} in active{% endif %}">
                    {{ include('elements_supprimes/_etablissements.html.twig', {
                        etablissements: etablissements_supprimes,
                    }) }}
                </div>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}
