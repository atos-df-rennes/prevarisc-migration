<small class="text-muted">Nombre total d'éléments : {{ etablissements|length }}</small>

{% if etablissements|length > 0 %}
    <table class="table table-hover">
        <thead>
        <tr>
            <th class="whitespace-nowrap">Supprimé par</th>
            <th>Nom de l'établissement</th>
        </tr>
        </thead>
        <tbody>
            {% for etablissement in etablissements %}
                <tr>
                    <td class="whitespace-nowrap">
                        <div class="deleted-element__deleted-by">
                            <div class="deleted-element__deleted-by_informations">
                                {{ etablissement.deletedBy.username|default('Inconnu') }}
                                {{ avatar(etablissement.deletedBy.id|default(null), constant('App\\Service\\Avatar::SMALL_DIRECTORY'), 'border-radius: 50%;') }}
                            </div>

                            <small class="text-muted">
                                Le {{ etablissement.dateSuppression|date('d/m/Y') }}
                            </small>
                        </div>
                    </td>

                    <td>
                        <div class="deleted-element__name">
                            <div class="deleted-element__name_informations">
                                {{ etablissement.informations|first.libelle }}

                                {% for adresse in etablissement.adresses %}
                                    <span class="label label-primary">
                                        <span class="glyphicon glyphicon-map-marker" aria-hidden="true"></span>
                                        {{ adresse.commune.libelle }}
                                    </span>
                                {% endfor %}
                            </div>

                            <a
                                class='btn btn-default btn-sm deleted-element__restore-button'
                                href="{{ path('admin_elements_supprimes_restore_etablissement', {id: etablissement.id}) }}"
                            >
                                <span class="glyphicon glyphicon-ok" aria-hidden="true"></span>
                                Rétablir l'établissement
                            </a>
                        </div>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endif %}
