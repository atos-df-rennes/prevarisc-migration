<small class="text-muted">Nombre total d'éléments : {{ dossiers|length }}</small>

{% if dossiers|length > 0 %}
    <table class="table table-hover">
        <thead>
        <tr>
            <th class="whitespace-nowrap">Supprimé par</th>
            <th>Nom du dossier</th>
        </tr>
        </thead>
        <tbody>
            {% for dossier in dossiers %}
                <tr>
                    <td class="whitespace-nowrap">
                        <div class="deleted-element__deleted-by">
                            <div class="deleted-element__deleted-by_informations">
                                {{ dossier.deletedBy.username|default('Inconnu') }}
                                {{ avatar(dossier.deletedBy.id|default(null), constant('App\\Service\\Avatar::SMALL_DIRECTORY'), 'border-radius: 50%;') }}
                            </div>

                            <small class="text-muted">
                                Le {{ dossier.dateSuppression|date('d/m/Y') }}
                            </small>
                        </div>
                    </td>

                    <td>
                        {% set objet_tronque = dossier.objet %}

                        {% if dossier.objet|length > 70 %}
                            {% set objet_tronque = dossier.objet[:70] ~ ' (...)' %}
                        {% endif %}

                        {% set libelle_complet = [dossier.type.libelle, dossier.nature.libelle, objet_tronque]|filter(v => '' != v) %}

                        <div class="deleted-element__name">
                            <div class="deleted-element__name_informations">
                                <a
                                        href="{{ path('dossier_index', {id: dossier.id}) }}"
                                        {% if dossier.objet|length > 70 %}
                                            title="{{ dossier.objet }}"
                                        {% endif %}
                                >
                                    {{ libelle_complet|join(' - ') }}
                                </a>

                                {% for etablissement in dossier.etablissements %}
                                    <span class="label label-primary">
                                        <span class="glyphicon glyphicon-home" aria-hidden="true"></span>
                                        {{ etablissement.informations|first.libelle }}
                                    </span>
                                {% endfor %}
                            </div>

                            {# @todo: Faire le rétablissement #}
                            <a
                                class="btn btn-sm btn-default deleted-element__restore-button"
                                href="{{ '/dossier/retablir-dossier/idDossier/' ~ dossier.id }}"
                            >
                                <span class="glyphicon glyphicon-ok" aria-hidden="true"></span>
                                Rétablir le dossier
                            </a>
                        </div>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endif %}
