{% extends 'layouts/admin.html.twig' %}

{% block title %}
    Administration / Gestion des documents manquants
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script type="text/javascript">
        $(document).ready(function() {
            $(".createDocumentManquant").click(function() {
                $('#documentManquantModalLabel').text("Ajouter un document manquant");
                $.ajax({
                    type: "GET",
                    url: "/admin/documents-manquants/add",
                    success: function(msg) {
                        $('#documentManquantModal .modal-body').html(msg);
                    },
                });
            });
            $(".editDocumentManquant").click(function() {
                const id = $(this).data("doc-id");
                $('#documentManquantModalLabel').text("Modifier un document manquant");
                $.ajax({
                    type: "GET",
                    url: "/admin/documents-manquants/" + id + "/edit",
                    success: function(msg) {
                        $('#documentManquantModal .modal-body').html(msg);
                    },
                });
            });
        });
    </script>
{% endblock %}

{% block body %}
    <h3 class="page-header">Gestion des documents manquants</h3>

    <button class="btn btn-primary mb-4 createDocumentManquant" data-toggle="modal" data-target="#documentManquantModal">
        <span class="glyphicon glyphicon-plus" aria-hidden="true"></span>&nbsp;Ajouter un document manquant
    </button>

    <ul class="list-unstyled container-fluid" id="listeDocumentsManquants">
        {% for dm in documentsManquants %}
            <li class="row" style="margin-top:10px; margin-bottom:10px; padding:10px; border-bottom:1px solid #eee;"
                id="docManquant_{{ dm.id }}">
                <div class="col-xs-1 text-muted">
                    <strong>{{ dm.id }}</strong>
                </div>

                <div class="col-xs-7">
                    {{ dm.libelle }}
                </div>

                <div class="col-xs-4 text-right">
                    <div class="row">
                        <div class="col-xs-6" style="padding-right:5px;">
                            <button class="editDocumentManquant btn btn-default btn-block"
                                    data-doc-id="{{ dm.id }}"
                                    data-toggle="modal"
                                    data-target="#documentManquantModal">
                                <span class="glyphicon glyphicon-pencil" aria-hidden="true"></span> Éditer
                            </button>
                        </div>

                        <div class="col-xs-6" style="padding-left:5px;">
                            <form method="post"
                                  action="{{ path('admin_documents_manquants_delete', {'id': dm.id}) }}"
                                  onsubmit="return confirm('Voulez-vous vraiment supprimer ce document ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('supprimer' ~ dm.id) }}">
                                <button class="btn btn-danger btn-block" type="submit">
                                    <span class="glyphicon glyphicon-trash" aria-hidden="true"></span> Supprimer
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </li>
        {% else %}
            <li class="alert alert-info">Aucun document manquant trouvé.</li>
        {% endfor %}
    </ul>

    {{ include('documents_manquants/_modal.html.twig') }}
{% endblock %}
