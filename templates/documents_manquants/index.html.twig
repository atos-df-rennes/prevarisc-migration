{% extends 'layouts/admin.html.twig' %}

{% block title %}
    Administration / Gestion des documents manquants
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script type="text/javascript">
        $(document).ready(function() {
            $(".createDocumentManquant").click(function() {
                $('#documentManquantModalLabel').text("Ajouter un document manquant");
                $.ajax({
                    type: "GET",
                    url: "/admin/documents-manquants/add",
                    success: function(msg) {
                        $('#documentManquantModal .modal-body').html(msg);
                    },
                });
            });
        });
    </script>
{% endblock %}

{% block body %}
    <h3 class="page-header">Gestion des documents manquants</h3>

    <button id="createDocumentManquant" class="btn btn-primary mb-4 createDocumentManquant" data-toggle="modal" data-target="#documentManquantModal">
        <span class="glyphicon glyphicon-plus" aria-hidden="true"></span>&nbsp;Ajouter un document manquant
    </button>

    <ul class="list-unstyled container-fluid" id="listeDocumentsManquants">
        {% for dm in documentsManquants %}
            <li class="row" style="margin-top:15px; margin-bottom:10px;" id="docManquant_{{ dm.id }}">
                <div class="col-xs-8">
                    {{ dm.id }} - {{ dm.libelle }}
                </div>
            </li>
        {% else %}
            <li>Aucun document manquant trouvé.</li>
        {% endfor %}
    </ul>

    {{ include('documents_manquants/_modal.html.twig') }}
{% endblock %}
