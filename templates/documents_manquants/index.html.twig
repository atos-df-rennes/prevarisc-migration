

    {% extends 'layouts/admin.html.twig' %}

    {% block title %}
        Administration / Gestion des documents manquants
    {% endblock %}

    {% block body %}
        <div class="container">
            <div class="page-header">
                <h3>Gestion des documents manquants</h3>
            </div>

            {% if documentsManquants is empty %}
                <div class="alert alert-info">
                    <strong>Information :</strong> Aucun document manquant non reçu.
                </div>
            {% else %}
                <div class="panel panel-default">
                    <ul class="list-group">
                        {% for dm in documentsManquants %}
                            <li class="list-group-item">
                                {{ dm.id }} - {{ dm.libelle }}
                            </li>
                        {% else %}
                            <li class="list-group-item text-muted">
                                Aucun domaine métier trouvé.
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        </div>
    {% endblock %}


