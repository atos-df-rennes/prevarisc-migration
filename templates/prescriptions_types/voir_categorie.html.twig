
<div id="accordion_categorie_{{ categorie.id }}"
     class="panel-group"
     role="tablist"
     aria-multiselectable="true"
>
    {% for prescription_texte in prescription_textes %}
        {% if prescription_texte.libelle is not empty %}
            <div class="panel panel-default">
                <div class="panel-heading" role="tab" id="text_header_{{ prescription_texte.id }}">
                    <div class="row">
                        <div class="col-xs-10">
                            <a role="button" data-toggle="collapse" data-parent="#tab_categorie_{{ categorie.id }}" href="#text_content_{{ prescription_texte.id }}" aria-controls="#text_content_{{ prescription_texte.id }}">
                                {{ prescription_texte.libelle }}
                            </a>
                        </div>
                        <div class="col-xs-2 text-right">
                            <button class="btn btn-info btn-icon ajax-modal-trigger"
                                    data-content="{{ path("admin_prescriptions_types_article_ajouter", {categorie: categorie.id, texte: prescription_texte.id}) }}"
                                    data-target="#modal-prescription" title="Ajouter un article">
                                <span class="glyphicon glyphicon-plus"></span>
                            </button>
                            <button class="btn btn-info btn-icon ajax-modal-trigger"
                                    data-content="{{ path("admin_prescriptions_types_textes_modifier", {categorie: categorie.id, texte: prescription_texte.id}) }}"
                                    data-target="#modal-prescription" title="Modifier le texte">
                                <span class="glyphicon glyphicon-pencil"></span>
                            </button>
                        </div>
                    </div>
                </div>
                <div
                    id="text_content_{{ prescription_texte.id }}"
                    class="panel-collapse collapse"
                    role="tabpanel"
                    aria-labelledby="text_header_{{ prescription_texte.id }}"
                    data-content="{{ path('admin_prescriptions_types_texte_voir_articles', {categorie: prescription_texte.categorie.id, texte: prescription_texte.id }) }}"
                >
                    <div class="panel-body">

                    </div>
                </div>
            </div>
        {% endif %}
    {% endfor %}
</div>