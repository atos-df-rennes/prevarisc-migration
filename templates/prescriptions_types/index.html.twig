{% extends 'layouts/admin.html.twig' %}

{% block title %}Administration / Gestion des prescriptions{% endblock %}


{% block body %}
    <ul class="nav nav-pills nav-justified">
        <li role="presentation"><a href="{{ path('admin_prescriptions_rappels') }}">Gestion des rappels réglementaires</a></li>
        <li role="presentation"><a href="{{ path('admin_prescriptions_textes') }}">Gestion des textes</a></li>
        <li role="presentation"><a href="{{ path('admin_prescriptions_articles') }}">Gestion des articles</a></li>
    </ul>

    <h3 class="page-header">
        Gestion des prescriptions types
    </h3>

    <div class="row mb-4">
        <div class="col-md-12 text-right">
            <button type="button" class="btn btn-default ajouter-categorie" data-target="#ajout-prescription-categorie">Ajouter une catégorie</button>
        </div>
    </div>

    <div class="classement">
        {% for category in categories %}
            <div class="panel panel-default" data-id="{{ category.id }}">
                <div class="panel-heading">
                    <div class="row">
                        <div class="col-xs-6">
                            <h4 class="panel-title">
                                <span class="handle glyphicon glyphicon-move"></span>
                                {{ category.libelle }}
                            </h4>
                        </div>
                        <div class="col-xs-6 text-right">
                            <button class="btn btn-sm btn-default">Modifier</button>
                        </div>
                    </div>
                </div>
                <div class="panel-body">

                </div>
            </div>
        {% endfor %}
    </div>

    <hr>

    <div class="panel panel-default">
        <div class="panel-heading">
            <h4 class="panel-title">Sans catégories</h4>
        </div>
        <div class="panel-body">
            {% for prescription in sans_categories %}
                {% for association in prescription %}
                    <p>{{ association.prescriptionType.libelle|nl2br }}</p>
                    {{ association.texte.libelle|nl2br }}
                    {{ association.texte.libelle|nl2br }}
                {% endfor %}
            {% endfor %}
        </div>
    </div>

    {{ include('prescriptions_types/_modal_ajout.html.twig') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="text/javascript">
        $(document).ready(function() {
            $(".ajouter-categorie").click(function () {
                const $target = $($(this).context.dataset.target);

                $.ajax({
                    type: "GET",
                    url: "/admin/prescriptions/categorie/ajouter",
                    success: function (msg) {
                        $target.find('.modal-body').html(msg);
                    },
                    error: function () {
                        $target.find('.modal-body').html(`<div class="alert alert-danger">Une erreur est survenue. Veuillez réessayer</div>`);
                    },
                    complete: function () {
                        $target.modal('show');
                    }
                });
            });

            $(".classement").sortable({
                handle: '.handle',
                update: function(event, ui) {

                    let list = []
                    $(this).find('.panel').each(function (index, el) {
                        list.push(el.dataset.id)
                    })

                    var data = {
                        "type": "categorie",
                        "order": list
                    }

                    $.ajax({
                        type: "POST",
                        url: "/admin/prescriptions/changement-ordre",
                        data: data,
                        beforeSend: function(){
                            $(this).disableSelection();
                        },
                        success: function(msg){
                            $(this).enableSelection();
                        }
                    });
                }
            });
        });
    </script>
{% endblock %}