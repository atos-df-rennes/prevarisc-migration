
<div class="panel-group classement-article" id="accordion_texte_{{ texte.id }}" role="tablist" aria-multiselectable="true">
    {% for article in articles %}
        <div class="panel panel-default" data-id="{{ article.id }}">
            <div class="panel-heading" role="tab" id="headingOne">
                <div class="panel-title">
                    <div class="row">
                        <div class="col-xs-10">
                            <span class="glyphicon glyphicon-move handle"></span>
                            <a id="btn-article-view-content-{{ article.id }}"
                               role="button"
                               data-toggle="collapse"
                               data-parent="#accordion_texte_{{ texte.id }}"
                               href="#article-view-content-{{ article.id }}"
                               aria-expanded="true"
                               aria-controls="collapseOne"
                            >
                                <em>Article</em> - {{ article.libelle }}
                            </a>
                        </div>
                        <div class="col-xs-2 text-right">
                            <button class="btn btn-info btn-icon mb-2 ajax-modal-trigger"
                                    data-content="{{ path('admin_prescriptions_types_prescriptions_ajouter', {categorie: categorie.id, texte: texte.id, article: article.id}) }}"
                                    data-target="#modal-prescription" title="Ajouter une prescription type">
                                <span class="glyphicon glyphicon-plus"></span>
                            </button>
                            <button class="btn btn-info btn-icon mb-2 ajax-modal-trigger"
                                    data-content="{{ path('admin_prescriptions_types_articles_modifier', {categorie: categorie.id, texte: texte.id, article: article.id}) }}"
                                    data-target="#modal-prescription" title="Modifier le texte">
                                <span class="glyphicon glyphicon-pencil"></span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div id="article-view-content-{{ article.id }}"
                 class="panel-collapse collapse" role="tabpanel" aria-labelledby="btn-article-view-content-{{ article.id }}"
                 data-content="{{ path('admin_prescriptions_types_texte_voir_article_contenu', {categorie: categorie.id, texte: texte.id, article: article.id}) }}"
            >
                <div class="panel-body"></div>
            </div>
        </div>
    {% endfor %}

    {% if sans_articles|length > 0 %}
        <div class="panel panel-default">
            <div class="panel-heading">
                <h4 class="panel-title">Sans Articles</h4>
            </div>
            <div class="panel-body">
                {{ include('prescriptions_types/_voir_prescriptions_type.html.twig', {
                    prescriptions_associations: sans_articles,
                    url_modifier: 'admin_prescriptions_types_prescriptions_texte_modifier',
                    url_supprimer: 'admin_prescriptions_types_prescriptions_texte_supprimer',
                }) }}
            </div>
        </div>
    {% endif %}
</div>
<script type="text/javascript">
    $(".classement-article").sortable({
        handle: ".handle",
        axis: 'y',
        update: function(event, ui) {

            let list = []
            $(this).find('> div').each(function (index, el) {
                list.push(el.dataset.id)
            })

            var data = {
                "type": "article",
                "order": list
            }

            $.ajax({
                type: "POST",
                url: "/admin/prescriptions/changement-ordre",
                data: data,
                beforeSend: function(){
                    $(this).disableSelection();
                },
                success: function(msg){
                    $(this).enableSelection();
                }
            });
        }
    });
</script>
