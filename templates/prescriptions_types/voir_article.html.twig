<table class="table">
<thead>
<tr>
    <th>Texte</th>
    <th>Article</th>
    <th>Contenu</th>
    <th>Édition</th>
</tr>
</thead>
<tbody>
    {% for association in prescription_associations %}
        {% set nb_assoc = association|length %}
        {% for prescription_association in association %}
            <tr>
                <td class="col-xs-2">{{ prescription_association.texte.libelle }}</td>
                <td class="col-xs-2">{{ prescription_association.article.libelle }}</td>
                {% if loop.first %}
                    <td class="col-xs-7" rowspan="{{ nb_assoc }}">
                        {{ prescription_association.prescriptionType.libelle|nl2br }}
                    </td>
                    <td class="col-xs-1" rowspan="{{ nb_assoc }}">
                        <a class="btn btn-default" href="#" title="Modifier"><span class="glyphicon glyphicon-edit"></span></a>
                    </td>
                {% endif %}
            </tr>
        {% endfor %}
    {% endfor %}
</tbody>
</table>