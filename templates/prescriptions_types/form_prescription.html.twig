<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal" aria-label="Fermer">
        <span aria-hidden="true">&times;</span>
    </button>
    <h3 class="modal-title">
        {% if prescription.id is null %}
            Ajouter un article dans l'article "{{ article.libelle }}"
        {% else %}
            Modifier un article
        {% endif %}
    </h3>
</div>

<div class="modal-body">
    {{ form_start(form) }}
        {{ form_row(form.libelle) }}

        {% do form.associations.setRendered %}
        <fieldset>
            <legend>Associations</legend>

            <ul id="prescription_reglementaire_associations"
                class="list-unstyled mt-4"
                data-prototype="{{ form_widget(form.associations.vars.prototype)|e }}"
                data-widget-tags="{{ '<li></li>'|e }}"
                data-widget-counter="{{ form.associations|length }}">
                {% for associationField in form.associations %}
                    <li>
                        {{ form_errors(associationField) }}
                        {{ form_widget(associationField) }}
                    </li>
                {% endfor %}
            </ul>

            <div class="clearfix"></div>

            <div class="text-center">
                <button type="button"
                        class="btn btn-default add-collection-widget"
                        data-list-selector="#prescription_reglementaire_associations">Ajouter une association</button>
            </div>
        </fieldset>

        <div class="modal-footer">
            <button type="button" class="btn btn-default" data-dismiss="modal">Fermer</button>
            <button type="submit" class="btn btn-primary">Sauvegarder</button>
        </div>
    {{ form_end(form) }}
</div>
