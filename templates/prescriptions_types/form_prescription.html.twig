<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal" aria-label="Fermer">
        <span aria-hidden="true">&times;</span>
    </button>
    <h3 class="modal-title">
        {% if prescription.id is null %}
            Ajouter une association dans l'article "{{ article.libelle }}"
        {% else %}
            Modifier une association
        {% endif %}
    </h3>
</div>

<div class="modal-body">
    {{ form_start(form) }}
        {{ form_row(form.libelle) }}

        {% do form.associations.setRendered %}
        <fieldset>
            <legend>Associations</legend>

            <ul id="prescription_reglementaire_associations"
                class="list-unstyled mt-4 remove-collection-widget"
                data-prototype="{{ form_widget(form.associations.vars.prototype)|e }}"
                data-widget-tags="{{ '<li></li>'|e }}"
                data-widget-counter="{{ form.associations|length }}">
                {% for association_field in form.associations %}
                    <li>
                        {{ form_errors(association_field) }}
                        {{ form_widget(association_field) }}
                    </li>
                {% endfor %}
            </ul>

            <div class="text-center">
                <button type="button"
                        class="btn btn-default add-collection-widget"
                        data-list-selector="#prescription_reglementaire_associations">Ajouter une association</button>
            </div>
        </fieldset>

        <div class="modal-footer">
            <button type="button" class="btn btn-default" data-dismiss="modal">Fermer</button>
            <button type="submit" class="btn btn-success">Sauvegarder</button>
        </div>
    {{ form_end(form) }}
</div>
<script>
    // Permet de gérer l'affichage du bouton de suppression pour les éléments déjà
    const collection = document.querySelector('.remove-collection-widget').children;
    if(collection.length > 0 && "function" === typeof addTagFormDeleteLink){
        for (let item of collection) {
            addTagFormDeleteLink(item)
        }
    }
</script>
