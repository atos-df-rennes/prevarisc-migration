{# Onglet Document type de la commission (Compte Rendu type) #}
<div class="panel panel-default">
    <div class="panel-heading">
        <h4 class="panel-title">
            <span class="glyphicon glyphicon-file" aria-hidden="true"></span>
            Compte Rendu type
        </h4>
    </div>
    <div class="panel-body">
        {% if documentCrExists %}
            <div class="media">
                <div class="media-left">
                    <span class="glyphicon glyphicon-file commission-doc-icon-lg" aria-hidden="true"></span>
                </div>
                <div class="media-body">
                    <a href="{{ documentsCommissionDataPath ~ commission.documentCr }}" class="media-heading commission-doc-link commission-doc-link-lg">
                        {{ commission.documentCr }}
                    </a>
                    <form method="post"
                          action="{{ path('admin_commissions_documents_delete', {id: commission.id}) }}"
                          class="commission-doc-delete-form-spaced">
                        <input type="hidden" name="_method" value="DELETE" />
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_commission_document_' ~ commission.id) }}" />
                        <button type="submit"
                                class="btn btn-link btn-sm commission-doc-delete-btn"
                                onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce document ?');">
                            <span class="glyphicon glyphicon-trash" aria-hidden="true"></span> Supprimer
                        </button>
                    </form>
                </div>
            </div>
            <hr />
            <p class="text-muted"><small>Pour remplacer le document, sélectionnez un nouveau fichier ODT ci-dessous.</small></p>
        {% else %}
            <p class="text-muted">Aucun document défini.</p>
        {% endif %}

        {{ form_start(uploadForm, {attr: {id: 'form-upload-document-cr', enctype: 'multipart/form-data'}}) }}
            {{ form_errors(uploadForm) }}
            {{ form_widget(uploadForm.documentCr, {attr: {accept: '.odt'}}) }}
            {{ form_errors(uploadForm.documentCr) }}
        {{ form_end(uploadForm) }}
    </div>
</div>

<script type="text/javascript">
$(document).ready(function() {
    document.getElementById('commission_document_cr_documentCr').addEventListener('change', function () {
        document.getElementById('form-upload-document-cr').submit();
    });
})
</script>
