{# Onglet Document type de la commission (Compte Rendu type) #}

{% for message in app.flashes('success') %}
    <div class="alert alert-success">{{ message }}</div>
{% endfor %}
{% for message in app.flashes('error') %}
    <div class="alert alert-danger">{{ message }}</div>
{% endfor %}

<table class="table table-condensed">
    <thead>
        <tr>
            <th>Compte Rendu type de la commission</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td style="text-align: center;">
                <p style="line-height: 37px; padding-top: 16px;">
                    {% if commission.documentCr is not null %}
                        <span>
                            <span class="glyphicon glyphicon-file" aria-hidden="true"></span>
                        </span>
                        <span style="vertical-align: top;">
                            <strong style="font-size: 1.3em;">
                                <a href="{{ documentsCommissionDataPath ~ commission.documentCr }}" style="color: #0174A7">
                                    {{ commission.documentCr }}
                                </a>
                            </strong>
                            <form method="post"
                                  action="{{ path('admin_commissions_documents_delete', {id: commission.id}) }}"
                                  style="display: inline;"
                                  onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce document ?');">
                                <button type="submit" class="btn btn-link" style="color: #c9302c; padding: 0; vertical-align: top;">
                                    supprimer
                                </button>
                            </form>
                        </span>
                    {% else %}
                        <strong>Aucun document défini.</strong>
                    {% endif %}
                </p>
                <p>
                    <form action="{{ path('admin_commissions_documents_upload', {id: commission.id}) }}"
                          enctype="multipart/form-data"
                          method="post"
                          id="form-upload-document-cr">
                        <input id="document-cr-file"
                               type="file"
                               name="document_cr"
                               accept=".odt" />
                    </form>
                </p>
            </td>
        </tr>
    </tbody>
</table>

<script type="text/javascript">
    document.getElementById('document-cr-file').addEventListener('change', function () {
        document.getElementById('form-upload-document-cr').submit();
    });
</script>
