{% do form.membres.setRendered %}

<div class="text-right mb-4">
    <button type="button" class="btn btn-primary btn-sm add-membre-btn">
        <span class="glyphicon glyphicon-plus" aria-hidden="true"></span> Ajouter un membre
    </button>
</div>

{# Le container est toujours rendu pour que le prototype soit accessible même sans membres #}
<div class="panel-group membres-collection"
     id="membres-accordion"
     role="tablist"
     aria-multiselectable="true"
     data-prototype="{{ _self.membre_panel(form.membres.vars.prototype, natures_by_type)|e('html_attr') }}">
    {% if form.membres|length == 0 %}
        <div class="no-membres-message">
            <p class="text-muted"><em>Aucun membre défini pour cette commission.</em></p>
        </div>
    {% else %}
        {% for membre_form in form.membres %}
            {{ _self.membre_panel(membre_form, natures_by_type) }}
        {% endfor %}
    {% endif %}
</div>

<div class="text-center mt-5">
    <button type="submit" class="btn btn-success save-membres-btn">
        <span class="glyphicon glyphicon-floppy-disk"></span> Sauvegarder les membres
    </button>
</div>

{# Macro : rendu d'un panel membre #}
{% macro membre_panel(membre_form, natures_by_type) %}
    {% import _self as macros %}
    {% set name = membre_form.vars.name %}
    {% set libelle = membre_form.libelle.vars.value ?: 'Nouveau membre' %}

    <div class="panel panel-default membre-rule">
        <div class="panel-heading" role="tab" id="heading-membre-{{ name }}">
            <h4 class="panel-title">
                <a role="button"
                   class="panel-title__link"
                   data-toggle="collapse"
                   data-parent="#membres-accordion"
                   href="#collapse-membre-{{ name }}"
                   aria-expanded="true"
                   aria-controls="collapse-membre-{{ name }}">
                    <span class="caret-toggle glyphicon glyphicon-chevron-down" aria-hidden="true"></span>
                    <span class="membre-libelle-display">{{ libelle }}</span>
                </a>
                <button type="button" class="btn btn-danger btn-xs pull-right remove-membre-btn">
                    <span class="glyphicon glyphicon-trash" aria-hidden="true"></span> Supprimer
                </button>
            </h4>
        </div>
        <div id="collapse-membre-{{ name }}"
             class="panel-collapse collapse in"
             role="tabpanel"
             aria-labelledby="heading-membre-{{ name }}">
            <div class="panel-body">

                {# Ligne 1 : libellé + présence #}
                <div class="row">
                    <div class="col-sm-6">
                        <div class="form-group">
                            {{ form_label(membre_form.libelle) }}
                            {{ form_widget(membre_form.libelle, {attr: {class: 'form-control membre-libelle-input'}}) }}
                            {{ form_errors(membre_form.libelle) }}
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            {{ form_label(membre_form.presence) }}
                            {{ form_widget(membre_form.presence, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(membre_form.presence) }}
                        </div>
                    </div>
                </div>

                {# Ligne 2 : type de membre + widget conditionnel #}
                <div class="row">
                    <div class="col-sm-4">
                        <div class="form-group">
                            {{ form_label(membre_form.typeMembre) }}
                            {{ form_widget(membre_form.typeMembre, {attr: {class: 'form-control type-membre-select'}}) }}
                        </div>
                    </div>
                    <div class="col-sm-8">
                        {# Groupement — affiché si typeMembre = 1 #}
                        <div class="form-group type-membre-widget type-membre-groupement" style="display:none;">
                            {{ form_label(membre_form.groupement) }}
                            {{ form_widget(membre_form.groupement) }}
                            {{ form_errors(membre_form.groupement) }}
                        </div>
                        {# Contact — affiché si typeMembre = 2 #}
                        <div class="form-group type-membre-widget type-membre-contact" style="display:none;">
                            {{ form_label(membre_form.utilisateurInformations) }}
                            {{ form_widget(membre_form.utilisateurInformations) }}
                            {{ form_errors(membre_form.utilisateurInformations) }}
                        </div>
                    </div>
                </div>

                <hr/>

                {# Section ERP — Catégories + Classes sur la même ligne #}
                <div class="row">
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label><strong>Catégories ERP</strong></label>
                            <div class="mb-2">
                                <button type="button"
                                        class="btn btn-xs btn-default select-all-checkbox-btn"
                                        data-target="{{ membre_form.categories.vars.id }}">
                                    <span class="glyphicon glyphicon-check" aria-hidden="true"></span> Tout
                                </button>
                            </div>
                            <div id="{{ membre_form.categories.vars.id }}" class="checkbox-scrollable-area">
                                {{ form_widget(membre_form.categories) }}
                            </div>
                            {{ form_errors(membre_form.categories) }}
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="form-group">
                            <label><strong>Classes IGH</strong></label>
                            <div class="mb-2">
                                <button type="button"
                                        class="btn btn-xs btn-default select-all-checkbox-btn"
                                        data-target="{{ membre_form.classes.vars.id }}">
                                    <span class="glyphicon glyphicon-check" aria-hidden="true"></span> Tout
                                </button>
                            </div>
                            <div id="{{ membre_form.classes.vars.id }}" class="checkbox-scrollable-area">
                                {{ form_widget(membre_form.classes) }}
                            </div>
                            {{ form_errors(membre_form.classes) }}
                        </div>
                    </div>
                </div>

                {#
                    Activités ERP groupées par type ERP — grille 3 colonnes.
                    On utilise membre_form.types.vars.choices (ChoiceGroupView[])
                    produit par le group_by du FormType — label et choices garantis corrects.
                    Chaque ChoiceGroupView a : label (libellé du type ERP), choices (ChoiceView[]).
                    Le widget est accessible directement via membre_form.types[choice.value].
                #}
                <div class="form-group">
                    <label><strong>Types d'activité ERP</strong></label>
                    {% do membre_form.types.setRendered %}
                    <div class="row">
                        {% for group in membre_form.types.vars.choices %}
                            {% set group_key = name ~ '-act-' ~ loop.index %}
                            <div class="col-sm-4 col-xs-12 mb-3">
                                <div class="activite-group-block">
                                    <div class="activite-group-header">
                                        <label class="activite-group-label">
                                            <input type="checkbox"
                                                   class="activite-group-toggle"
                                                   data-group="{{ group_key }}"
                                                   aria-label="Tout sélectionner {{ group.label }}">
                                            <strong>{{ group.label }}</strong>
                                        </label>
                                    </div>
                                    <ul class="list-unstyled activites-list"
                                        id="activite-group-{{ group_key }}">
                                        {% for choice in group.choices %}
                                            <li class="activite-item" data-group="{{ group_key }}">
                                                {{ form_widget(membre_form.types[choice.value]) }}
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                    {{ form_errors(membre_form.types) }}
                </div>

                <hr/>

                {#
                    Types et natures de dossier imbriqués.
                    natures_by_type = array<string typeId, DossierNatureListe[]>  (clés string)
                    membre_form.naturesDossier[nature_id] accède directement au widget par valeur de choix.
                #}
                <div class="form-group">
                    <label><strong>Types et natures de dossier</strong></label>
                    {% do membre_form.typesDossier.setRendered %}
                    {% do membre_form.naturesDossier.setRendered %}
                    <div class="row">
                        {% for type_widget in membre_form.typesDossier %}
                            {% set type_id = type_widget.vars.value ~ '' %}
                            <div class="col-sm-4 col-xs-6 mb-3">
                                <div class="dossier-type-block">
                                    {# Checkbox du type de dossier = header du groupe #}
                                    <div class="dossier-type-header">
                                        <label class="dossier-type-label">
                                            {{ form_widget(type_widget, {attr: {class: 'dossier-type-checkbox', 'data-type-id': type_id}}) }}
                                            <strong>{{ type_widget.vars.label }}</strong>
                                        </label>
                                    </div>
                                    {# Natures imbriquées pour ce type #}
                                    {% if natures_by_type[type_id] is defined %}
                                        <ul class="list-unstyled dossier-natures-list"
                                            id="natures-list-{{ name }}-{{ type_id }}">
                                            {% for nature in natures_by_type[type_id] %}
                                                {% set nature_id = nature.id ~ '' %}
                                                <li class="dossier-nature-item" data-type-id="{{ type_id }}">
                                                    {{ form_widget(membre_form.naturesDossier[nature_id]) }}
                                                </li>
                                            {% endfor %}
                                        </ul>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                    {{ form_errors(membre_form.typesDossier) }}
                    {{ form_errors(membre_form.naturesDossier) }}
                </div>

            </div>{# /panel-body #}
        </div>{# /panel-collapse #}
    </div>{# /panel #}
{% endmacro %}

<script>
$(document).ready(function() {
    const $collection = $('#membres-accordion');
    let index = {{ form.membres|length }};

    // Initialise TomSelect sur les champs groupement/contact d'un container
    function initTomSelect($container) {
        $container.find('.tom-select').each(function(_i, el) {
            if (!el.tomselect) {
                new TomSelect(el, { plugins: ['remove_button'], maxOptions: null });
            }
        });
    }

    // Affichage conditionnel groupement/contact/commune selon le select typeMembre
    function initTypeMembre($panel) {
        const $typeSelect = $panel.find('.type-membre-select');

        function updateTypeMembre() {
            const val = parseInt($typeSelect.val(), 10);
            $panel.find('.type-membre-widget').hide();
            if (val === 1) {
                $panel.find('.type-membre-groupement').show();
            } else if (val === 2) {
                $panel.find('.type-membre-contact').show();
            }
        }

        $typeSelect.on('change', updateTypeMembre);
        updateTypeMembre();
    }

    // Mise à jour du libellé dans le header du panel lors de la saisie
    function initLibelleSync($panel) {
        $panel.find('.membre-libelle-input').on('input', function() {
            const val = $(this).val().trim() || 'Nouveau membre';
            $panel.find('.membre-libelle-display').text(val);
        });
    }

    // Met à jour l'état d'un bouton "Tout" simple (catégories, classes)
    function updateSelectAllBtn($btn) {
        const targetId = $btn.data('target');
        const $checkboxes = $('#' + targetId + ' input[type="checkbox"]');
        const allChecked = $checkboxes.length > 0 && $checkboxes.filter(':checked').length === $checkboxes.length;
        if (allChecked) {
            $btn.html('<span class="glyphicon glyphicon-unchecked" aria-hidden="true"></span> Tout');
        } else {
            $btn.html('<span class="glyphicon glyphicon-check" aria-hidden="true"></span> Tout');
        }
    }

    // Met à jour l'état de la checkbox de groupe activités (activite-group-toggle)
    function updateActiviteGroupToggle($panel, groupKey) {
        const $toggle = $panel.find('.activite-group-toggle[data-group="' + groupKey + '"]');
        const $checkboxes = $panel.find('#activite-group-' + groupKey + ' input[type="checkbox"]');
        if ($checkboxes.length === 0) { return; }
        const checkedCount = $checkboxes.filter(':checked').length;
        $toggle.prop('checked', checkedCount === $checkboxes.length);
        $toggle.prop('indeterminate', checkedCount > 0 && checkedCount < $checkboxes.length);
    }

    // Met à jour la checkbox d'un type de dossier en fonction de ses natures
    function updateDossierTypeCheckbox($panel, typeId) {
        const $typeCheckbox = $panel.find('.dossier-type-checkbox[data-type-id="' + typeId + '"]');
        const $natures = $panel.find('#natures-list-' + $panel.find('.membre-rule').length + '-' + typeId + ' input[type="checkbox"]');
        // Cherche les natures par data-type-id
        const $natureItems = $panel.find('.dossier-nature-item[data-type-id="' + typeId + '"] input[type="checkbox"]');
        if ($natureItems.length === 0) {
            // Pas de natures : la checkbox type gère elle-même son état
            return;
        }
        const checkedCount = $natureItems.filter(':checked').length;
        $typeCheckbox.prop('checked', checkedCount === $natureItems.length);
        $typeCheckbox.prop('indeterminate', checkedCount > 0 && checkedCount < $natureItems.length);
    }

    // Init d'un panel complet
    function initPanel($panel) {
        initTomSelect($panel);
        initTypeMembre($panel);
        initLibelleSync($panel);

        // État initial des boutons "Tout" simples (catégories, classes)
        $panel.find('.select-all-checkbox-btn').each(function() { updateSelectAllBtn($(this)); });

        // État initial des toggles de groupe activités
        $panel.find('.activite-group-toggle').each(function() {
            const groupKey = $(this).data('group');
            updateActiviteGroupToggle($panel, groupKey);
        });

        // État initial des checkboxes de types de dossier
        $panel.find('.dossier-type-checkbox').each(function() {
            const typeId = $(this).data('type-id');
            updateDossierTypeCheckbox($panel, typeId);
        });
    }

    // Init des panels existants
    $collection.find('.membre-rule').each(function() { initPanel($(this)); });

    // Ferme tous les panels existants sauf le premier
    $collection.find('.membre-rule:not(:first-child) .panel-collapse').removeClass('in');
    $collection.find('.membre-rule:not(:first-child) .panel-title__link').attr('aria-expanded', 'false').addClass('collapsed');

    // Tout sélectionner / désélectionner - checkboxes simples (catégories, classes)
    $(document).on('click', '.select-all-checkbox-btn', function() {
        const $btn = $(this);
        const targetId = $btn.data('target');
        const $checkboxes = $('#' + targetId + ' input[type="checkbox"]');
        const allChecked = $checkboxes.filter(':checked').length === $checkboxes.length;
        $checkboxes.prop('checked', !allChecked);
        updateSelectAllBtn($btn);
    });

    // Mise à jour bouton "Tout" quand une checkbox individuelle change (catégories, classes)
    $(document).on('change', '.checkbox-scrollable-area input[type="checkbox"]', function() {
        const $area = $(this).closest('.checkbox-scrollable-area');
        const $btn = $('[data-target="' + $area.attr('id') + '"]');
        if ($btn.length) { updateSelectAllBtn($btn); }
    });

    // Toggle de groupe activités → coche/décoche toutes les activités du groupe
    $(document).on('change', '.activite-group-toggle', function() {
        const $toggle = $(this);
        const groupKey = $toggle.data('group');
        const $panel = $toggle.closest('.membre-rule');
        const checked = $toggle.prop('checked');
        $panel.find('#activite-group-' + groupKey + ' input[type="checkbox"]').prop('checked', checked);
        $toggle.prop('indeterminate', false);
    });

    // Checkbox activité individuelle → met à jour le toggle du groupe
    $(document).on('change', '.activite-item input[type="checkbox"]', function() {
        const groupKey = $(this).closest('.activite-item').data('group');
        const $panel = $(this).closest('.membre-rule');
        updateActiviteGroupToggle($panel, groupKey);
    });

    // Checkbox type de dossier → coche/décoche toutes ses natures
    $(document).on('change', '.dossier-type-checkbox', function() {
        const $cb = $(this);
        const typeId = $cb.data('type-id');
        const $panel = $cb.closest('.membre-rule');
        const checked = $cb.prop('checked');
        $cb.prop('indeterminate', false);
        $panel.find('.dossier-nature-item[data-type-id="' + typeId + '"] input[type="checkbox"]').prop('checked', checked);
    });

    // Checkbox nature individuelle → met à jour la checkbox du type parent
    $(document).on('change', '.dossier-nature-item input[type="checkbox"]', function() {
        const typeId = $(this).closest('.dossier-nature-item').data('type-id');
        const $panel = $(this).closest('.membre-rule');
        updateDossierTypeCheckbox($panel, typeId);
    });

    // Ajout d'un membre via prototype
    $(document).on('click', '.add-membre-btn', function() {
        const prototype = $collection.data('prototype');
        if (!prototype) { return; }

        const newForm = prototype.replace(/__name__/g, index);
        $collection.find('.no-membres-message').remove();
        $collection.find('.panel-collapse.in').removeClass('in');
        $collection.append(newForm);

        const $newPanel = $collection.find('.membre-rule:last');
        initPanel($newPanel);
        index++;
    });

    // Suppression d'un membre — retire du DOM uniquement
    $(document).on('click', '.remove-membre-btn', function() {
        const $panel = $(this).closest('.membre-rule');
        // Détruit TomSelect avant suppression
        $panel.find('.tom-select').each(function(_i, el) {
            if (el.tomselect) { el.tomselect.destroy(); }
        });
        $panel.remove();

        if ($collection.find('.membre-rule').length === 0) {
            $collection.html('<div class="no-membres-message"><p class="text-muted"><em>Aucun membre défini pour cette commission.</em></p></div>');
        }
    });

    // Indicateur de chargement sur soumission
    $('#membres-form').on('submit', function() {
        const $btn = $(this).find('.save-membres-btn');
        $btn.prop('disabled', true).html(
            '<span class="glyphicon glyphicon-refresh spinning" aria-hidden="true"></span> Sauvegarde en cours...'
        );
    });
});
</script>
