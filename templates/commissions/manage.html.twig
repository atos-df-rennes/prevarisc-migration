{% extends 'layouts/admin.html.twig' %}

{% block title %}Administration / Gestion des commissions / Édition{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('scripts/formulaire/add-collection-widget.js') }}"></script>
{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-md-12">
            <a href="{{ path('admin_commissions_index') }}">Gestion des commissions</a>
            <span class="glyphicon glyphicon-chevron-right" aria-hidden="true"></span> Édition en masse
        </div>
    </div>

    <h3 class="page-header">Édition des commissions</h3>

    {{ form_start(form) }}

    {% do form.commissions.setRendered %}

    <div class="panel panel-default">
        <div class="panel-heading">
            <h3 class="panel-title">Liste des commissions</h3>
        </div>
        <div class="panel-body">
            <ul id="commissions-list"
                class="list-unstyled remove-collection-widget"
                data-prototype="{{ form_widget(form.commissions.vars.prototype)|e }}"
                data-widget-tags="{{ '<li></li>'|e }}"
                data-widget-counter="{{ form.commissions|length }}">
                {% for commission_field in form.commissions %}
                    <li>
                        {{ form_widget(commission_field, {attr: {class: 'collection-item-wrapper'}}) }}
                        {{ form_errors(commission_field) }}
                    </li>
                {% endfor %}
            </ul>

            <div class="text-center mt-3">
                <button type="button"
                    class="btn btn-default add-collection-widget"
                    data-list-selector="#commissions-list">
                    <span class="glyphicon glyphicon-plus" aria-hidden="true"></span> Ajouter une commission
                </button>
            </div>
        </div>
    </div>

    <div class="row text-right mt-4">
        <div class="col-sm-12">
            <a class="btn btn-default" href="{{ path('admin_commissions_index') }}">
                Annuler
            </a>
            <button type="submit" class="btn btn-success">
                <span class="glyphicon glyphicon-ok" aria-hidden="true"></span> Sauvegarder
            </button>
        </div>
    </div>

    {{ form_end(form) }}
{% endblock %}
