<div class="commission-competences">
    {% if regles|length == 0 %}
        <div class="alert alert-info mt-3">
            <p><strong>Aucune règle définie pour cette commission.</strong></p>
            <p>
                <button class="btn btn-primary" disabled title="Prochainement disponible">
                    <span class="glyphicon glyphicon-plus" aria-hidden="true"></span> Ajouter une règle
                </button>
            </p>
        </div>
    {% else %}
        <div class="text-right mt-3 mb-3">
            <button class="btn btn-primary" disabled title="Prochainement disponible">
                <span class="glyphicon glyphicon-plus" aria-hidden="true"></span> Ajouter une règle
            </button>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-condensed">
                <thead>
                    <tr>
                        <th rowspan="2">Zone géographique</th>
                        <th colspan="2">ERP</th>
                        <th colspan="1">IGH</th>
                        <th rowspan="2">Local Sommeil</th>
                        <th rowspan="2">Étude / visite</th>
                        <th rowspan="2">Actions</th>
                    </tr>
                    <tr>
                        <th>Catégorie</th>
                        <th>Type</th>
                        <th>Classe</th>
                    </tr>
                </thead>
                <tbody>
                    {% for regle in regles %}
                        <tr>
                            {# Zone géographique #}
                            <td style="width: 250px;">
                                {% if regle.commune %}
                                    <strong>Commune :</strong> {{ regle.commune.libelle }}
                                    {% if regle.commune.numInsee %}
                                        <br><small class="text-muted">({{ regle.commune.numInsee }})</small>
                                    {% endif %}
                                {% elseif regle.groupement %}
                                    <strong>Groupement :</strong> {{ regle.groupement.libelle }}
                                {% else %}
                                    <span class="text-muted">Non défini</span>
                                {% endif %}
                            </td>

                            {# Catégories ERP #}
                            <td>
                                {% if regle.categories|length > 0 %}
                                    <ul class="list-unstyled mb-0">
                                        {% for categorie in regle.categories %}
                                            <li>
                                                <span class="glyphicon glyphicon-ok text-success"></span>
                                                {{ categorie.libelle }}
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% else %}
                                    <span class="text-muted">Toutes</span>
                                {% endif %}
                            </td>

                            {# Types ERP #}
                            <td>
                                {% if regle.types|length > 0 %}
                                    <ul class="list-unstyled mb-0">
                                        {% for type in regle.types %}
                                            <li>
                                                <span class="glyphicon glyphicon-ok text-success"></span>
                                                {{ type.libelle }}
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% else %}
                                    <span class="text-muted">Tous</span>
                                {% endif %}
                            </td>

                            {# Classes IGH #}
                            <td>
                                {% if regle.classes|length > 0 %}
                                    <ul class="list-unstyled mb-0">
                                        {% for classe in regle.classes %}
                                            <li>
                                                <span class="glyphicon glyphicon-ok text-success"></span>
                                                {{ classe.libelle }}
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% else %}
                                    <span class="text-muted">Toutes</span>
                                {% endif %}
                            </td>

                            {# Local sommeil #}
                            <td>
                                {% set local_sommeil_values = [] %}
                                {% for ls in regle.localSommeil %}
                                    {% set local_sommeil_values = local_sommeil_values|merge([ls.localSommeil]) %}
                                {% endfor %}

                                {% if local_sommeil_values|length > 0 %}
                                    <ul class="list-unstyled mb-0">
                                        {% if 1 in local_sommeil_values %}
                                            <li><span class="glyphicon glyphicon-ok text-success"></span> Oui</li>
                                        {% endif %}
                                        {% if 0 in local_sommeil_values %}
                                            <li><span class="glyphicon glyphicon-ok text-success"></span> Non</li>
                                        {% endif %}
                                    </ul>
                                {% else %}
                                    <span class="text-muted">Tous</span>
                                {% endif %}
                            </td>

                            {# Étude/Visite #}
                            <td>
                                {% set etude_visite_values = [] %}
                                {% for ev in regle.etudeVisite %}
                                    {% set etude_visite_values = etude_visite_values|merge([ev.etudeVisite]) %}
                                {% endfor %}

                                {% if etude_visite_values|length > 0 %}
                                    <ul class="list-unstyled mb-0">
                                        {% if 1 in etude_visite_values %}
                                            <li><span class="glyphicon glyphicon-ok text-success"></span> Étude</li>
                                        {% endif %}
                                        {% if 0 in etude_visite_values %}
                                            <li><span class="glyphicon glyphicon-ok text-success"></span> Visite</li>
                                        {% endif %}
                                    </ul>
                                {% else %}
                                    <span class="text-muted">Tous</span>
                                {% endif %}
                            </td>

                            {# Actions #}
                            <td class="text-center">
                                <button class="btn btn-danger btn-sm" disabled title="Prochainement disponible">
                                    <span class="glyphicon glyphicon-trash"></span>
                                </button>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="text-center mt-3">
            <button class="btn btn-success" disabled title="Prochainement disponible">
                <span class="glyphicon glyphicon-floppy-disk"></span> Sauvegarder les règles
            </button>
            <button class="btn btn-primary" disabled title="Prochainement disponible">
                <span class="glyphicon glyphicon-ok"></span> Appliquer les règles
            </button>
        </div>

        <div class="alert alert-warning mt-3">
            <span class="glyphicon glyphicon-info-sign"></span>
            <strong>Mode lecture seule :</strong> L'édition et la gestion des règles seront disponibles prochainement.
        </div>
    {% endif %}
</div>

<style>
    .commission-competences .table > tbody > tr > td {
        vertical-align: top;
    }
    .commission-competences .list-unstyled li {
        padding: 2px 0;
    }
    .commission-competences .mb-0 {
        margin-bottom: 0;
    }
    .commission-competences .mt-3 {
        margin-top: 15px;
    }
    .commission-competences .mb-3 {
        margin-bottom: 15px;
    }
</style>
