{% do form.regles.setRendered %}

<div class="competence-actions text-right" style="margin-bottom: 15px;">
    <button type="button" class="btn btn-primary btn-sm add-regle-btn">
        <span class="glyphicon glyphicon-plus"></span> Ajouter une règle
    </button>
</div>

{# Le container est toujours rendu pour que le prototype soit accessible même sans règles #}
<div class="panel-group regles-collection"
     id="competences-accordion"
     role="tablist"
     aria-multiselectable="true"
     data-prototype="{{ form_widget(form.regles.vars.prototype)|e('html_attr') }}">
    {% if form.regles|length == 0 %}
        <div class="no-competences-message">
            <p class="text-muted"><em>Aucune règle de compétence définie pour cette commission.</em></p>
        </div>
    {% else %}
        {% for regle_form in form.regles %}
            {% set index = loop.index0 %}
            <div class="panel panel-default competence-rule">
                <div class="panel-heading" role="tab" id="heading-regle-{{ index }}">
                    <h4 class="panel-title">
                        <a role="button"
                           data-toggle="collapse"
                           data-parent="#competences-accordion"
                           href="#collapse-regle-{{ index }}"
                           aria-expanded="{% if loop.first %}true{% else %}false{% endif %}"
                           aria-controls="collapse-regle-{{ index }}">
                            <span class="caret-toggle glyphicon glyphicon-chevron-down {% if not loop.first %}collapsed{% endif %}"></span>
                            Règle de compétence #{{ loop.index }}
                        </a>
                        <button type="button" class="btn btn-danger btn-xs pull-right remove-regle-btn" style="margin-top: 5px;">
                            <span class="glyphicon glyphicon-trash"></span> Supprimer
                        </button>
                    </h4>
                </div>
                <div id="collapse-regle-{{ index }}"
                     class="panel-collapse collapse {% if loop.first %}in{% endif %}"
                     role="tabpanel"
                     aria-labelledby="heading-regle-{{ index }}">
                    <div class="panel-body">
                        {# Zone géographique #}
                        <div class="form-group">
                            {% if regle_form.commune is defined %}
                                {{ form_row(regle_form.commune) }}
                            {% elseif regle_form.groupement is defined %}
                                {{ form_row(regle_form.groupement) }}
                            {% endif %}
                        </div>

                        {# Catégories ERP - Checkbox avec bouton "Tout sélectionner" #}
                        <div class="form-group">
                            {{ form_label(regle_form.categories) }}
                            <div style="margin-bottom: 10px;">
                                <button type="button" class="btn btn-xs btn-default select-all-checkbox-btn" data-target="{{ regle_form.categories.vars.id }}">
                                    <span class="glyphicon glyphicon-check"></span> Tout sélectionner
                                </button>
                            </div>
                            <div id="{{ regle_form.categories.vars.id }}-container" class="checkbox-container">
                                {{ form_widget(regle_form.categories) }}
                            </div>
                            {{ form_errors(regle_form.categories) }}
                        </div>

                        {# Types ERP - Select multiple avec bouton "Tout sélectionner" #}
                        <div class="form-group">
                            {{ form_label(regle_form.types) }}
                            <div style="margin-bottom: 10px;">
                                <button type="button" class="btn btn-xs btn-default select-all-select-btn" data-target-field="{{ regle_form.types.vars.id }}">
                                    <span class="glyphicon glyphicon-check"></span> Tout sélectionner
                                </button>
                            </div>
                            {{ form_widget(regle_form.types) }}
                            {{ form_errors(regle_form.types) }}
                        </div>

                        {# Classes IGH - Select multiple avec bouton "Tout sélectionner" #}
                        <div class="form-group">
                            {{ form_label(regle_form.classes) }}
                            <div style="margin-bottom: 10px;">
                                <button type="button" class="btn btn-xs btn-default select-all-select-btn" data-target-field="{{ regle_form.classes.vars.id }}">
                                    <span class="glyphicon glyphicon-check"></span> Tout sélectionner
                                </button>
                            </div>
                            {{ form_widget(regle_form.classes) }}
                            {{ form_errors(regle_form.classes) }}
                        </div>

                        {# Local Sommeil - Checkbox #}
                        <div class="form-group">
                            {{ form_row(regle_form.localSommeil) }}
                        </div>

                        {# Étude/Visite - Checkbox #}
                        <div class="form-group">
                            {{ form_row(regle_form.etudeVisite) }}
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    {% endif %}
</div>

<div class="competence-actions text-center" style="margin-top: 20px;">
    <button type="submit" class="btn btn-success save-competences-btn">
        <span class="glyphicon glyphicon-floppy-disk"></span> Sauvegarder les règles
    </button>
</div>

<script>
$(document).ready(function() {
    var $collection = $('#competences-accordion');
    var index = {{ form.regles|length }};

    function initTomSelect($container) {
        $container.find('.tom-select').each(function() {
            if (!this.tomselect) {
                new TomSelect(this, { plugins: ['remove_button'], maxOptions: null });
            }
        });
    }

    function updateSelectAllButton($btn) {
        var targetId = $btn.data('target');
        if (targetId) {
            // Bouton checkbox
            var $checkboxes = $('#' + targetId + '-container input[type="checkbox"]');
            if ($checkboxes.length > 0 && $checkboxes.filter(':checked').length === $checkboxes.length) {
                $btn.html('<span class="glyphicon glyphicon-unchecked"></span> Tout désélectionner');
            } else {
                $btn.html('<span class="glyphicon glyphicon-check"></span> Tout sélectionner');
            }
        } else {
            // Bouton select multiple (TomSelect)
            var fieldId = $btn.data('target-field');
            var $select = $('#' + fieldId);
            if ($select.length && $select[0].tomselect) {
                var ts = $select[0].tomselect;
                var optionCount = Object.keys(ts.options).length;
                if (optionCount > 0 && ts.items.length === optionCount) {
                    $btn.html('<span class="glyphicon glyphicon-unchecked"></span> Tout désélectionner');
                } else {
                    $btn.html('<span class="glyphicon glyphicon-check"></span> Tout sélectionner');
                }
            }
        }
    }

    initTomSelect($collection);
    $collection.find('.select-all-checkbox-btn, .select-all-select-btn').each(function() {
        updateSelectAllButton($(this));
    });

    // Tout sélectionner/désélectionner - checkboxes
    $(document).on('click', '.select-all-checkbox-btn', function() {
        var targetId = $(this).data('target');
        var $checkboxes = $('#' + targetId + '-container input[type="checkbox"]');
        var allChecked = $checkboxes.filter(':checked').length === $checkboxes.length;
        $checkboxes.prop('checked', !allChecked);
        updateSelectAllButton($(this));
    });

    // Tout sélectionner/désélectionner - select multiple (TomSelect)
    $(document).on('click', '.select-all-select-btn', function() {
        var fieldId = $(this).data('target-field');
        var $select = $('#' + fieldId);
        if ($select.length && $select[0].tomselect) {
            var ts = $select[0].tomselect;
            var options = Object.keys(ts.options);
            if (ts.items.length === options.length) {
                ts.clear();
            } else {
                ts.setValue(options);
            }
            updateSelectAllButton($(this));
        }
    });

    // Ajout d'une règle via prototype
    $(document).on('click', '.add-regle-btn', function() {
        var prototype = $collection.data('prototype');
        if (!prototype) { return; }

        var newForm = prototype.replace(/__name__/g, index);
        var collapseId = 'collapse-regle-' + index;
        var headingId  = 'heading-regle-' + index;
        var ruleNum    = $collection.find('.competence-rule').length + 1;

        var panelHtml =
            '<div class="panel panel-default competence-rule">' +
            '<div class="panel-heading" role="tab" id="' + headingId + '">' +
            '<h4 class="panel-title">' +
            '<a role="button" data-toggle="collapse" data-parent="#competences-accordion"' +
            ' href="#' + collapseId + '" aria-expanded="true" aria-controls="' + collapseId + '">' +
            '<span class="caret-toggle glyphicon glyphicon-chevron-down"></span>' +
            ' R\u00e8gle de comp\u00e9tence #' + ruleNum + '</a>' +
            '<button type="button" class="btn btn-danger btn-xs pull-right remove-regle-btn" style="margin-top:5px;">' +
            '<span class="glyphicon glyphicon-trash"></span> Supprimer</button>' +
            '</h4></div>' +
            '<div id="' + collapseId + '" class="panel-collapse collapse in" role="tabpanel"' +
            ' aria-labelledby="' + headingId + '">' +
            '<div class="panel-body">' + newForm + '</div>' +
            '</div></div>';

        var $panel = $(panelHtml);
        $collection.find('.no-competences-message').remove();
        $collection.find('.panel-collapse.in').removeClass('in');
        $collection.append($panel);
        initTomSelect($panel);
        index++;
    });

    // Suppression d'une règle - retire du DOM uniquement
    $(document).on('click', '.remove-regle-btn', function() {
        if (!confirm('Êtes-vous sûr de vouloir supprimer cette règle ?')) { return; }

        var $panel = $(this).closest('.competence-rule');
        $panel.find('.tom-select').each(function() {
            if (this.tomselect) { this.tomselect.destroy(); }
        });
        $panel.remove();

        if ($collection.find('.competence-rule').length === 0) {
            $collection.html('<div class="no-competences-message"><p class="text-muted"><em>Aucune règle de compétence définie pour cette commission.</em></p></div>');
        }
    });

    // Indicateur de chargement sur soumission
    $('form').on('submit', function() {
        var $btn = $(this).find('.save-competences-btn');
        $btn.prop('disabled', true).html(
            '<span class="glyphicon glyphicon-refresh spinning"></span> Sauvegarde en cours...'
        );
    });
});
</script>
