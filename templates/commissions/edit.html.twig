{% extends 'layouts/admin.html.twig' %}

{% block title %}Administration / Gestion des commissions / {{ commission.libelle }} — {{ active_tab|capitalize }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('css/commission/champ_competence.css') }}" rel="stylesheet" />
    <link href="{{ asset('css/commission/membres.css') }}" rel="stylesheet" />
    <link href="{{ asset('css/commission/documents.css') }}" rel="stylesheet" />
{% endblock %}

{% block body %}
    {# Fil d'Ariane #}
    <ol class="breadcrumb">
        <li><a href="{{ path('admin_commissions_index') }}">Commissions</a></li>
        {% if commission.type %}
            <li>{{ commission.type.libelle }}</li>
        {% endif %}
        <li class="active">{{ commission.libelle }}</li>
    </ol>

    <div class="row">
        <div class="col-md-12">
            <div class="pull-right">
                <a href="{{ path('admin_commissions_index') }}" class="btn btn-default">
                    <span class="glyphicon glyphicon-arrow-left" aria-hidden="true"></span> Retour à la liste
                </a>
            </div>
            <h3 class="page-header">
                {{ commission.libelle }}
                {% if commission.type %}
                    <small>{{ commission.type.libelle }}</small>
                {% endif %}
            </h3>
        </div>
    </div>

    {# Onglets de navigation #}
    {% set tabs = [
        {key: 'competences', label: 'Compétences', icon: 'list-alt', route: 'admin_commissions_competences'},
        {key: 'membres', label: 'Membres', icon: 'user', route: 'admin_commissions_membres'},
        {key: 'contacts', label: 'Contacts', icon: 'envelope', route: 'admin_commissions_contacts'},
        {key: 'courriers', label: 'Courriers', icon: 'print', route: 'admin_commissions_courriers'},
        {key: 'documents', label: 'Document type', icon: 'folder-open', route: 'admin_commissions_documents'},
    ] %}
    <ul class="nav nav-tabs mb-4">
        {% for tab in tabs %}
            <li{% if active_tab == tab.key %} class="active"{% endif %}>
                <a href="{{ path(tab.route, {id: commission.id}) }}">
                    <span class="glyphicon glyphicon-{{ tab.icon }}"></span>
                    {{ tab.label }}
                </a>
            </li>
        {% endfor %}
    </ul>

    {# Contenu selon l'onglet actif #}
    {% if active_tab == 'competences' %}
        {% form_theme form 'commissions/_commission_regle_theme.html.twig' %}
        {{ form_start(form, {attr: {id: 'competences-form'}}) }}
            {{ include('commissions/_competences.html.twig', {form: form, commission: commission}) }}
        {{ form_end(form) }}

        <div class="text-center mt-3">
            <form method="post" action="{{ path('admin_commissions_apply_regles', {id: commission.id}) }}" id="apply-regles-form">
                <button type="submit" class="btn btn-warning apply-competences-btn">
                    <span class="glyphicon glyphicon-flash" aria-hidden="true"></span> Appliquer les règles à tous les établissements
                </button>
            </form>
        </div>
    {% elseif active_tab == 'membres' %}
        {{ form_start(form, {attr: {id: 'membres-form'}}) }}
            {{ include('commissions/_membres.html.twig', {
                form: form,
                commission: commission,
                natures_by_type: natures_by_type,
            }) }}
        {{ form_end(form) }}
    {% elseif active_tab == 'courriers' %}
        {{ include('commissions/_courriers.html.twig', {membres_with_forms: membres_with_forms, courriersMembresDataPath: courriersMembresDataPath}) }}
    {% elseif active_tab == 'contacts' %}
        {{ include('components/_contacts_panel.html.twig', {
            entity_id: commission.id,
            contacts: contacts,
            no_contacts_msg: 'Aucun contact lié à cette commission',
            url_add_existing: path('admin_commissions_contacts_add_existing', {id: commission.id}),
            url_add: path('admin_commissions_contacts_add', {id: commission.id}),
            route_delete: 'admin_commissions_contacts_delete',
            element_lie: 'commission',
        }) }}
    {% elseif active_tab == 'documents' %}
        {{ include('commissions/_document_type.html.twig', {commission: commission, documentsCommissionDataPath: documentsCommissionDataPath, uploadForm: uploadForm}) }}
    {% else %}
        <div class="panel panel-default">
            <div class="panel-body commission-placeholder-body">
                <span class="glyphicon glyphicon-wrench commission-placeholder-icon"></span>
                <h4 class="commission-placeholder-title">
                    Section <strong>{{ active_tab|capitalize }}</strong> — en cours de développement
                </h4>
                <p class="text-muted">Cette fonctionnalité sera disponible prochainement.</p>
            </div>
        </div>
    {% endif %}

    {% if active_tab == 'courriers' %}
        <script type="text/javascript">
            $(document).ready(function() {
                $('.courrier-file-input').on('change', function() {
                    $(this).closest('form').submit();
                });
            });
        </script>
    {% endif %}
{% endblock %}
