{% extends 'layouts/admin.html.twig' %}

{% block title %}Administration / Gestion des commissions{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-md-12">
            <div class="pull-right">
                <a href="{{ path('admin_commissions_manage') }}" class="btn btn-primary">
                    <span class="glyphicon glyphicon-cog"></span> Gérer les commissions
                </a>
            </div>
        </div>
    </div>

    <h3 class="page-header">Gestion des commissions</h3>

    {% if commission_types|length == 0 %}
        <div class="alert alert-info">
            <p>Aucun type de commission n'est défini dans le système.</p>
        </div>
    {% else %}
        {% for type in commission_types %}
            {% set commissions = type.commissions %}
            <div class="panel panel-default" style="margin-bottom: 20px;">
                <div class="panel-heading">
                    <h4 class="panel-title">{{ type.libelle }}
                        <span class="badge">{{ commissions|length }}</span>
                    </h4>
                </div>
                <div class="panel-body" style="padding: 0;">
                    {% if commissions|length == 0 %}
                        <p class="text-muted" style="padding: 15px; margin: 0;">
                            Aucune commission de ce type.
                        </p>
                    {% else %}
                        <table class="table table-hover" style="margin-bottom: 0;">
                            <thead>
                                <tr>
                                    <th>Commission</th>
                                    <th class="text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for commission in commissions %}
                                    <tr>
                                        <td>{{ commission.libelle }}</td>
                                        <td class="text-right">
                                            <a href="{{ path('admin_commissions_competences', {id: commission.id}) }}"
                                               class="btn btn-sm btn-default">
                                                <span class="glyphicon glyphicon-pencil"></span>
                                                Modifier les compétences
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    {% endif %}
{% endblock %}
