{% extends 'layouts/admin.html.twig' %}

{% block title %}Administration / Gestion des commissions{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('css/commission/index_admin.css') }}" rel="stylesheet" />
{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-md-12">
            <div class="pull-right">
                <a href="{{ path('admin_commissions_manage') }}" class="btn btn-primary">
                    <span class="glyphicon glyphicon-cog" aria-hidden="true"></span> Gérer les commissions
                </a>
            </div>
        </div>
    </div>

    <h3 class="page-header">Gestion des commissions</h3>

    {% if commission_types|length == 0 %}
        <div class="alert alert-info">
            <p>Aucun type de commission n'est défini dans le système.</p>
        </div>
    {% else %}
        {% for type in commission_types %}
            {% set commissions = type.commissions %}
            <div class="panel panel-default panel--type-commission">
                <div class="panel-heading">
                    <h4 class="panel-title">{{ type.libelle }}</h4>
                </div>
                <div class="panel-body">
                    {% if commissions|length == 0 %}
                        <p class="panel-body__aucune-commission text-muted">
                            Aucune commission de ce type.
                        </p>
                    {% else %}
                        <table class="panel-body__table-commission table table-hover">
                            <thead>
                                <tr>
                                    <th>Commission</th>
                                    <th class="text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for commission in commissions %}
                                    <tr>
                                        <td>
                                            {{ commission.libelle }}
                                            <span class="label label-info">
                                                {{ commission.regles|length }} règle{% if commission.regles|length > 1 %}s{%endif %}
                                            </span>
                                        </td>
                                        <td class="text-right">
                                            <a href="{{ path('admin_commissions_show', {id: commission.id}) }}"
                                               class="btn btn-sm btn-default">
                                                <span class="glyphicon glyphicon-pencil" aria-hidden="true"></span>
                                                Modifier les informations
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    {% endif %}
{% endblock %}
