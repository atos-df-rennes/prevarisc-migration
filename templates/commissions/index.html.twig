{% extends 'layouts/admin.html.twig' %}

{% block title %}Administration / Gestion des commissions{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-md-12">
            <div class="pull-right">
                <a href="{{ path('admin_commissions_manage') }}" class="btn btn-primary">
                    <span class="glyphicon glyphicon-cog"></span> Gestion des commissions
                </a>
            </div>
        </div>
    </div>

    <h3 class="page-header">Gestion des commissions</h3>

    {% if commission_types|length > 0 %}
        <!-- Onglets des types de commissions -->
        <ul class="nav nav-tabs" id="commission-types-tabs" role="tablist">
            {% for type in commission_types %}
                <li role="presentation"{% if type.id == selected_type_id %} class="active"{% endif %}>
                    <a href="#"
                       data-type-id="{{ type.id }}"
                       data-url="{{ path('admin_commissions_list', {typeId: type.id}) }}"
                       role="tab">
                        {{ type.libelle }}
                    </a>
                </li>
            {% endfor %}
        </ul>

        <!-- Contenu des commissions -->
        <div id="commissions-content" class="mt-3">
            {% if selected_type_id %}
                {{ render(controller('App\\Controller\\CommissionsController::getCommissions', {typeId: selected_type_id})) }}
            {% endif %}
        </div>
    {% else %}
        <div class="alert alert-info">
            <p>Aucun type de commission n'est défini dans le système.</p>
        </div>
    {% endif %}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    <link href="{{ asset('css/commission/champ_competence.css') }}" rel="stylesheet" />
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $(document).ready(function() {
            // Gestion des onglets
            $('#commission-types-tabs a').on('click', function(e) {
                e.preventDefault();

                var $link = $(this);
                var url = $link.data('url');

                // Mise à jour de l'onglet actif
                $('#commission-types-tabs li').removeClass('active');
                $link.parent().addClass('active');

                // @todo: mettre ce loader dans un bloc à part à réutiliser partout
                // Chargement du contenu via AJAX
                $('#commissions-content').html('<div class="text-center"><span class="glyphicon glyphicon-refresh spinning" aria-hidden="true"></span> Chargement...</div>');

                $.ajax({
                    url: url,
                    method: 'GET',
                    success: function(html) {
                        $('#commissions-content').html(html);
                    },
                    error: function() {
                        $('#commissions-content').html('<div class="alert alert-danger">Erreur lors du chargement des commissions.</div>');
                    }
                });
            });
        });
    </script>
{% endblock %}
