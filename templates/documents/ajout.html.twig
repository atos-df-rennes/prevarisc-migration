{{ form_start(form) }}
    <dl class="dl-horizontal">
        <div class="form-group">
            <dt>{{ form_label(form.commissions) }}</dt>
            <dd>{{ form_widget(form.commissions) }}</dd>
        </div>

        <dt>{{ form_label(form.file) }}</dt>
        <dd>{{ form_widget(form.file) }}</dd>
    </dl>

    <div class="modal-footer">
        {{ form_widget(form.close) }}
        {{ form_widget(form.submit) }}
    </div>
{{ form_end(form) }}
