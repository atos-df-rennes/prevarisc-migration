{% extends 'layouts/admin.html.twig' %}

{% block title %}Administration / Gestion des documents{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script type="text/javascript">
        $(document).ready(function() {
            $(".ajouter-document").click(function() {
                $.ajax({
                    type: "GET",
                    url: Routing.generate('admin_documents_add'),
                    success: function(msg){
                        $('#ajout-document .modal-body').html(msg);
                    },
                });
            });

            $(".supp").click(function() {
                const elementDoc = $(this)
                const nomFichier = elementDoc.attr('id')
                const idCommission = elementDoc.attr('data-comm-id')

                $("#dialog-supp #name-doc").html(nomFichier)
                $("#supp-doc").click(function() {
                    $.ajax({
                        type: "POST",
                        url: Routing.generate('admin_documents_delete'),
                        data:{
                            nomFichier: nomFichier,
                            idCommission: idCommission
                        },
                        success: function() {
                            window.location.reload()
                        },
                        error: function() {
                            window.location.reload()
                        }
                    });
                })
            });
        });
    </script>
{% endblock %}

{% block body %}
    <button type="button" class="btn btn-default pull-right ajouter-document" data-toggle="modal" data-target="#ajout-document">Ajouter un document</button>
    <h3 class='page-header'>Gestion des documents</h3>

    <div class="panel panel-default">
        <div class="panel-heading" role="tab">
            <h4 class="panel-title">
                <a role="button"
                   class="panel-title__link"
                   data-toggle="collapse"
                   data-target="#collapse-doc-transversal"
                   aria-expanded="true"
                   aria-controls="collapse-doc-transversal">
                    Visibles après verrouillage <span class="badge">{{ visibles_apres_verrouillage|length }}</span>
                    <span class="pull-right caret-toggle glyphicon glyphicon-chevron-down" aria-hidden="true"></span>
                </a>
            </h4>
        </div>
        <div id="collapse-doc-transversal" class="panel-collapse collapse in">
            <div class="panel-body">
                {% if visibles_apres_verrouillage|length > 0 %}
                    <ul class="list-unstyled">
                        {% for document in visibles_apres_verrouillage %}
                            <li class="clearfix" style="padding: 4px 0; border-bottom: 1px solid #f4f4f4;">
                                {{ document.filename }}
                                <div class="pull-right">
                                    <a href="{{ document.filepath }}" class="btn btn-xs btn-default">
                                        <span class="glyphicon glyphicon-download-alt" aria-hidden="true"></span> Télécharger
                                    </a>
                                    <button type="button" class="btn btn-xs btn-danger supp" id="{{ document.filename }}" data-comm-id="0" data-toggle="modal" data-target="#dialog-supp">
                                        <span class="glyphicon glyphicon-trash" aria-hidden="true"></span> Supprimer
                                    </button>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <p class="text-muted">Aucun document disponible.</p>
                {% endif %}
            </div>
        </div>
    </div>

    {% set type_commission = null %}
    {% for informations_commission in commissions %}
        {% if informations_commission.type is not same as(type_commission) %}
            <h4>{{ informations_commission.type }}</h4>

            {% set type_commission = informations_commission.type %}
        {% endif %}

        <div class="panel panel-default">
            <div class="panel-heading" role="tab">
                <h4 class="panel-title">
                    <a role="button"
                       class="panel-title__link"
                       data-toggle="collapse"
                       data-target="#collapse-doc-{{ informations_commission.id }}"
                       aria-expanded="true"
                       aria-controls="collapse-doc-{{ informations_commission.id }}">
                        {{ informations_commission.nom }}

                        {% if informations_commission.documents is not null %}
                            <span class="badge">{{ informations_commission.documents|length }}</span>
                        {% endif %}
                        <span class="pull-right caret-toggle glyphicon glyphicon-chevron-down" aria-hidden="true"></span>
                    </a>
                </h4>
            </div>
            <div id="collapse-doc-{{ informations_commission.id }}" class="panel-collapse collapse in">
                <div class="panel-body">
                    {% if informations_commission.documents is not null %}
                        {% if informations_commission.documents|length > 0 %}
                            <ul class="list-unstyled">
                                {% for document in informations_commission.documents %}
                                    <li class="clearfix" style="padding: 4px 0; border-bottom: 1px solid #f4f4f4;">
                                        {{ document.filename }}
                                        <div class="pull-right">
                                            <a href="{{ document.filepath }}" class="btn btn-xs btn-default">
                                                <span class="glyphicon glyphicon-download-alt" aria-hidden="true"></span> Télécharger
                                            </a>
                                            <button type="button" class="btn btn-xs btn-danger supp" id="{{ document.filename }}" data-comm-id="{{ informations_commission.id }}" data-toggle="modal" data-target="#dialog-supp">
                                                <span class="glyphicon glyphicon-trash" aria-hidden="true"></span> Supprimer
                                            </button>
                                        </div>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% else %}
                            <p class="text-muted">Aucun document disponible.</p>
                        {% endif %}
                    {% else %}
                        <div class="alert alert-danger alert-dismissible" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Fermer"><span aria-hidden="true">&times;</span></button>
                            <strong>Erreur d'accès !</strong> Le répertoire de cette commission n'existe pas ou n'est pas accessible.
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    {% endfor %}

    {{ include('documents/_modal_ajout.html.twig') }}
    {{ include('documents/_modal_suppression.html.twig') }}
{% endblock %}
