{% extends 'layouts/admin.html.twig' %}

{% block title %}Administration / Ajout d'une couche IGN{% endblock %}

{% block body %}
    <div class='pull-right btn-group'>
        <a class='btn btn-default' href="{{ path('couches_cartographiques') }}">Revenir sur la liste des couches cartographiques</a>
    </div>

    <h3>Ajout d'une couche cartographique IGN</h3>

    <div class="panel-group" id="ign-accordion" role="tablist" aria-multiselectable="true">
        {% for format, couches in couchesIGN %}
            <div class="panel panel-default">
                <div class="panel-heading" role="tab" id="heading-{{ format }}">
                    <h4 class="panel-title">
                        <a role="button" data-toggle="collapse" data-parent="#ign-accordion" href="#{{ format|replace({' ': '-'}) }}" aria-controls="{{ format|replace({' ': '-'}) }}" {% if loop.first %}aria-expanded="true" {% endif %}>
                            {{ format|upper }}
                        </a>
                    </h4>
                </div>
                <div id="{{ format|replace({' ': '-'}) }}" class="panel-collapse collapse {% if loop.first %}in{% endif %}" role="tabpanel" aria-labelledby="heading-{{ format }}">
                    <div class="panel-body">
                        <table class="table table-hover table-condensed">
                            <thead>
                            <tr>
                                <th scope="col">Nom de la couche</th>
                                <th scope="col">Nom de la couche dans le flux</th>
                                <th scope="col">Format de l'image dans le flux</th>
                                <th scope="col">Couche masquée ?</th>
                                <th scope="col"></th>
                            </tr>
                            </thead>
                            <tbody>
                                {% for couche in couches %}
                                    <tr>
                                        <td>
                                            <form method="post" action="{{ path('couches_cartographiques_add_IGN') }}" id="form-{{ couche.layers }}-{{ format }}">
                                                <input type="hidden" name="token" value="{{ csrf_token('ajouter-IGN-' ~ couche.nom) }}">
                                                <input type="hidden" name="nom" value="{{ couche.nom }}">
                                                <input type="hidden" name="type" value="{{ couche.type }}">
                                                <input type="hidden" name="layer" value="{{ couche.layers }}">
                                                <input type="hidden" name="url" value="{{ couche.url }}">
                                                <input type="hidden" name="format" value="{{ couche.format }}">
                                            </form>
                                            {{ couche.nom }}
                                        </td>
                                        <td>
                                            {{ couche.layers }}
                                        </td>
                                        <td>
                                            {{ couche.format }}
                                        </td>
                                        <td>
                                            <input form="form-{{ couche.layers }}-{{ format }}" name="transparent" type="checkbox" />
                                        </td>
                                        <td>
                                            <input form="form-{{ couche.layers }}-{{ format }}" type="submit" class="btn btn-success" value="Ajouter" />
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}
