{# Modale d'ajout via formulaire — sera déplacée vers <body> via JS pour éviter les modales imbriquées #}
<div class="modal fade" id="modal-add-pj" tabindex="-1" role="dialog" aria-labelledby="modal-add-pj-label">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" id="btn-close-add-pj" aria-label="Fermer">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title" id="modal-add-pj-label">Ajouter une pièce jointe</h4>
            </div>
            <div class="modal-body" id="modal-add-pj-body">
                <div class="text-center"><span class="glyphicon glyphicon-refresh spinning"></span></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" id="btn-cancel-add-pj">Annuler</button>
                <button type="button" class="btn btn-primary" id="btn-submit-pj">
                    <span class="glyphicon glyphicon-upload"></span> Ajouter
                </button>
            </div>
        </div>
    </div>
</div>

{# Modale de modification — également déplacée vers <body>, pour la même raison (pas de modales imbriquées) #}
<div class="modal fade" id="modal-edit-pj" tabindex="-1" role="dialog" aria-labelledby="modal-edit-pj-label">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" id="btn-close-edit-pj" aria-label="Fermer">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title" id="modal-edit-pj-label">Modifier la pièce jointe</h4>
            </div>
            <div class="modal-body" id="modal-edit-pj-body">
                <div class="text-center"><span class="glyphicon glyphicon-refresh spinning"></span></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" id="btn-cancel-edit-pj">Annuler</button>
                <button type="button" class="btn btn-primary" id="btn-submit-edit-pj">
                    <span class="glyphicon glyphicon-ok"></span> Enregistrer
                </button>
            </div>
        </div>
    </div>
</div>

<h3>
    Liste de pièces jointes

    <button type="button" class="btn btn-default" id="btn-add-pj">
        <span class="glyphicon glyphicon-paperclip"></span> Ajouter une pièce jointe
    </button>
    <button type="button" class="btn btn-default" id="btn-toggle-dropzone">
        <span class="glyphicon glyphicon-cloud-upload"></span> Ajout rapide
    </button>
</h3>

<div id="dropzone-pj" class="dropzone" style="display:none; border: 2px dashed #ccc; padding: 20px; text-align: center; margin-bottom: 15px; cursor: pointer;">
    <p><span class="glyphicon glyphicon-upload"></span> Glissez-déposez vos fichiers ici ou cliquez pour sélectionner</p>
</div>

{% if piecesJointes is empty %}
    <div class="well text-center" id="pj-empty-msg">
        <p class="lead">Il n'y a pas de pièce jointe pour cette date de commission.</p>
    </div>
    <table class="table table-striped table-condensed" id="pj-table" style="display:none">
{% else %}
    <div id="pj-empty-msg" style="display:none">
        <div class="well text-center"><p class="lead">Il n'y a pas de pièce jointe pour cette date de commission.</p></div>
    </div>
    <table class="table table-striped table-condensed" id="pj-table">
{% endif %}
    <thead>
        <tr>
            <th>Nom</th>
            <th>Description</th>
            <th>Date d'ajout</th>
            <th></th>
        </tr>
    </thead>
    <tbody id="pj-tbody">
        {% for pj in piecesJointes %}
            {{ include('calendrier_des_commissions/_piece_jointe_row.html.twig', {pj: pj, dateCommission: dateCommission}) }}
        {% endfor %}
    </tbody>
</table>

<script>
(function () {
    var addUrl      = {{ path('calendrier_des_commissions_pj_ajouter', {id: dateCommission.id})|json_encode|raw }};
    var formUrl     = {{ path('calendrier_des_commissions_pj_formulaire', {id: dateCommission.id})|json_encode|raw }};
    var dropzoneUrl = {{ path('calendrier_des_commissions_pj_ajouter', {id: dateCommission.id})|json_encode|raw }};
    var csrfToken   = {{ csrf_token('calendrier_commissions_pj')|json_encode|raw }};
    var $addModal   = $('#modal-add-pj');
    var $editModal  = $('#modal-edit-pj');

    /* ── Déplacement des modales enfants vers <body> ────────────────────────── */
    /* Bootstrap 3 ne supporte pas les modales imbriquées.                       */
    /* Déplacer les modales hors du parent évite les conflits de backdrop/dismiss. */
    $addModal.appendTo('body');
    $editModal.appendTo('body');

    /* Nettoyage quand la modale parente se ferme */
    $('#modal-pieces-jointes').on('hidden.bs.modal', function () {
        $addModal.modal('hide').remove();
        $editModal.modal('hide').remove();
    });

    /* ── Bouton "Ajouter une pièce jointe" ──────────────────────────────────── */
    $('#btn-add-pj').on('click', function () {
        $('#modal-add-pj-body').html('<div class="text-center"><span class="glyphicon glyphicon-refresh spinning"></span></div>');
        $.get(formUrl, function (html) {
            $('#modal-add-pj-body').html(html);
        });
        $addModal.modal('show');
    });

    /* ── Fermeture de la modale enfant uniquement ───────────────────────────── */
    /* Namespace obligatoire : même raison que click.pj-delete (injection AJAX) */
    $(document).off('click.pj-modal').on('click.pj-modal', '#btn-cancel-add-pj, #btn-close-add-pj', function () {
        $addModal.modal('hide');
    });

    /* ── Bouton "Modifier" d'une ligne ───────────────────────────────────────── */
    /* Namespace obligatoire : ce JS est injecté en AJAX à chaque ouverture de la modale parente */
    $(document).off('click.pj-edit-open').on('click.pj-edit-open', '.btn-edit-pj', function () {
        var editUrl = $(this).data('url');
        $editModal.data('pj-id', $(this).data('pj-id'));
        $('#modal-edit-pj-body').html('<div class="text-center"><span class="glyphicon glyphicon-refresh spinning"></span></div>');
        $.get(editUrl, function (html) {
            $('#modal-edit-pj-body').html(html);
        });
        $editModal.modal('show');
    });

    /* ── Fermeture de la modale de modification ─────────────────────────────── */
    $(document).off('click.pj-edit-modal').on('click.pj-edit-modal', '#btn-cancel-edit-pj, #btn-close-edit-pj', function () {
        $editModal.modal('hide');
    });

    /* ── Soumission du formulaire de modification via AJAX ──────────────────── */
    $(document).off('click.pj-edit-submit').on('click.pj-edit-submit', '#btn-submit-edit-pj', function () {
        var form = $('#formEditPj')[0];
        if (!form) {
            return;
        }
        var data = new FormData(form);
        var editActionUrl = form.getAttribute('action');
        $.ajax({
            url: editActionUrl,
            type: 'POST',
            data: data,
            processData: false,
            contentType: false,
            success: function (result) {
                if (result.success) {
                    $('#pj-row-' + $editModal.data('pj-id')).replaceWith(result.html);
                    $editModal.modal('hide');
                    $.toast.success('La pièce jointe a bien été modifiée.');
                } else if (result.formHtml) {
                    /* Erreurs de validation : on réaffiche le formulaire avec ses erreurs, la modale reste ouverte */
                    $('#modal-edit-pj-body').html(result.formHtml);
                } else {
                    $.toast.error(result.message || 'Erreur lors de la modification.');
                }
            },
            error: function () {
                $.toast.error('Une erreur s\'est produite lors de l\'envoi.');
            }
        });
    });

    /* ── Soumission du formulaire via AJAX ──────────────────────────────────── */
    $(document).off('click.pj-submit').on('click.pj-submit', '#btn-submit-pj', function () {
        var form = $('#formUploadPj')[0];
        if (!form) {
            return;
        }
        var data = new FormData(form);
        data.append('_csrf_token', csrfToken);
        $.ajax({
            url: addUrl,
            type: 'POST',
            data: data,
            processData: false,
            contentType: false,
            success: function (result) {
                if (result.success) {
                    appendRow(result.html);
                    $addModal.modal('hide');
                } else {
                    $.toast.error(result.message || 'Erreur lors de l\'ajout.');
                }
            },
            error: function () {
                $.toast.error('Une erreur s\'est produite lors de l\'envoi.');
            }
        });
    });

    /* ── Ajout rapide Dropzone ──────────────────────────────────────────────── */
    $('#btn-toggle-dropzone').on('click', function () {
        $('#dropzone-pj').toggle();
    });

    Dropzone.autoDiscover = false;
    new Dropzone('#dropzone-pj', {
        url: dropzoneUrl,
        paramName: 'fichier',
        maxFilesize: 50,
        dictDefaultMessage: 'Glissez-déposez vos fichiers ici ou cliquez pour sélectionner',
        headers: { 'X-CSRF-Token': csrfToken },
        success: function (file, response) {
            if (response && response.success) {
                appendRow(response.html);
                this.removeFile(file);
            }
        },
        error: function (file, message) {
            $.toast.error(typeof message === 'string' ? message : (message.message || 'Erreur lors de l\'upload.'));
            this.removeFile(file);
        }
    });

    /* ── Suppression (bouton à deux états — évite window.confirm() bloqué) ───── */
    /* Namespace obligatoire : ce JS est injecté en AJAX ; sans .off(), chaque  */
    /* rechargement empilarait un nouveau handler sur $(document).              */
    $(document).off('click.pj-delete').on('click.pj-delete', '.btn-delete-pj', function () {
        var btn = $(this);

        if (!btn.hasClass('confirming')) {
            btn.addClass('confirming btn-danger').removeClass('btn-default');
            btn.html('<span class="glyphicon glyphicon-trash"></span> Confirmer ?');
            setTimeout(function () {
                if (btn.hasClass('confirming')) {
                    btn.removeClass('confirming btn-danger').addClass('btn-default');
                    btn.html('<span class="glyphicon glyphicon-trash"></span>');
                }
            }, 3000);
            return;
        }

        var deleteUrl = btn.data('url');
        btn.prop('disabled', true);
        $.ajax({
            url: deleteUrl,
            type: 'POST',
            data: { _csrf_token: csrfToken },
            success: function (result) {
                if (result.success) {
                    btn.closest('tr').remove();
                    updateEmptyState();
                } else {
                    btn.prop('disabled', false);
                    btn.removeClass('confirming btn-danger').addClass('btn-default');
                    btn.html('<span class="glyphicon glyphicon-trash"></span>');
                }
            },
            error: function () {
                btn.prop('disabled', false);
                btn.removeClass('confirming btn-danger').addClass('btn-default');
                btn.html('<span class="glyphicon glyphicon-trash"></span>');
            }
        });
    });

    /* ── Helpers ────────────────────────────────────────────────────────────── */
    function appendRow(html) {
        $('#pj-tbody').prepend(html);
        $('#pj-table').show();
        $('#pj-empty-msg').hide();
    }

    function updateEmptyState() {
        if ($('#pj-tbody tr').length === 0) {
            $('#pj-table').hide();
            $('#pj-empty-msg').show();
        }
    }
}());
</script>
