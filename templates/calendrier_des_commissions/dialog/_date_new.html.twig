<ul class='list-unstyled row' style='text-align:center;font-weight:bold;float:left;padding:3px 0 3px 0;'>
    <li class='col-md-6'>{{ dateAjoutee }}</li>
    <li class='col-md-2'><input type='text' size='8' class='time form-control' id='D_{{ dateAjouteeInput }}' name='D_{{ dateAjouteeInput }}' value='09:00'/></li>
    <li class='col-md-2'><input type='text' size='8' class='time form-control' id='F_{{ dateAjouteeInput }}' name='F_{{ dateAjouteeInput }}' value='18:00'/></li>
    <li class='col-md-2'>
        <button class='suppression btn btn-default'><span class='glyphicon glyphicon-trash'></span>&nbsp;</button>
    </li>
</ul>
