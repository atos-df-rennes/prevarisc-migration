<form name='formDateComm' id='formDateComm' methode='POST'>
    <input type='hidden' name='dateCommission' id='dateCommission' value='{{ idMaster }}' />
    <input type='hidden' name='dateClick' id='dateClick' value='{{ dateCommission.id }}' />
    <input type='hidden' name='_csrf_dialog' id='csrf_token_dialog' value='{{ csrf_token('calendrier_commissions_dialog') }}' />
    <p>
        <div id='div_libelleCom'>
            Libelle de la commission : {{ dateCommission.libelle }}
            <button id='edit_libelleCom' class='edition btn btn-default'><span class='glyphicon glyphicon-pencil'></span>&nbsp;</button>
        </div>
    </p>
    <p>
        <div id='div_typeCom'>
            Le type de commission est : {{ dateCommission.typeEvenement is not null ? dateCommission.typeEvenement.libelle : '' }}
            <button id='edit_typeCom' class='edition btn btn-default'><span class='glyphicon glyphicon-pencil'></span>&nbsp;</button>
        </div>
    </p>

    <div class='container-fluid' id='listeDates'>
        <ul class='list-unstyled row' style='text-align:center;font-weight:bold;border-bottom:1px solid black;padding:3px 0 3px 0;'>
            <li class='col-md-6'>Date</li>
            <li class='col-md-2'>Heure début</li>
            <li class='col-md-2'>Heure fin</li>
            <li class='col-md-2'>
                <button class='addDate btn btn-default'><span class='glyphicon glyphicon-plus'></span>&nbsp;</button>
            </li>
        </ul>
        {% for liste_date in listeDates %}
            <ul class='list-unstyled row' id='ligne_{{ liste_date.ID_DATECOMMISSION }}' style='text-align:center;font-weight:bold;padding:3px 0 3px 0;'>
                <li class='col-md-6'>{{ liste_date.DATE_COMMISSION|date('d/m/Y') }}</li>
                <li class='col-md-2'>{{ liste_date.HEUREDEB_COMMISSION|slice(0, 5) }}</li>
                <li class='col-md-2'>{{ liste_date.HEUREFIN_COMMISSION|slice(0, 5) }}</li>
                <li class='col-md-2'>
                    <button class='edition btn btn-default' name='edition' id='edit_dateComm_{{ liste_date.ID_DATECOMMISSION }}'><span class='glyphicon glyphicon-pencil'></span>&nbsp;</button>
                    {% if liste_date.DATECOMMISSION_LIEES %}
                        <button class='suppression btn btn-default' id='supp_dateComm_{{ liste_date.ID_DATECOMMISSION }}'><span class='glyphicon glyphicon-trash'></span>&nbsp;</button>
                        <button style='float:right;' class='dateDefaut btn btn-default' id='defaut_dateComm_{{ liste_date.ID_DATECOMMISSION }}'><span class='glyphicon glyphicon-check'></span>&nbsp;</button>
                    {% endif %}
                </li>
            </ul>
        {% endfor %}
    </div>

    <div id='divAddDate' style='display:none;'>
        &nbsp;&nbsp;
        <ul class='list-unstyled row' style='text-align:center;font-weight:bold;padding:3px 0 3px 0;'>
            <li class='col-md-6'>
                Selectionnez la date <input type='text' class='date form-control' id='addDate' />
            </li>
            <li class='col-md-4'>
                <button class='validAddDate btn btn-default'><span class='glyphicon glyphicon-plus'></span>&nbsp;</button>
                <button class='cancelAddDate btn btn-default'><span class='glyphicon glyphicon-remove'></span>&nbsp;</button>
            </li>
        </ul>
    </div>

</form>
