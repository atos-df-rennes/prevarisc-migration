<form id="formUploadPj" enctype="multipart/form-data">
    <div class="form-group">
        <label for="fichierPj">Fichier à envoyer <span class="text-danger">*</span></label>
        <input type="file" name="fichier" id="fichierPj" class="form-control" required />
    </div>
    <div class="form-group">
        <label for="nomFichier">Libellé <small class="text-muted">(laisser vide pour conserver le nom du fichier)</small></label>
        <input type="text" name="nomFichier" id="nomFichier" class="form-control" />
    </div>
    <div class="form-group">
        <label for="descriptionFichier">Description</label>
        <textarea name="descriptionFichier" id="descriptionFichier" class="form-control" rows="3"></textarea>
    </div>
</form>
