{{ form_start(form, {attr: {id: 'formDateComm'}}) }}
    <section>
        <div class="panel panel-default">
            <div class="panel-heading">Informations générales</div>
            <div class="panel-body">
                {{ form_row(form.libelle) }}
                {{ form_row(form.typeEvenement) }}
                {{ form_row(form.commission) }}
            </div>
        </div>
    </section>

    {% do form.dates.setRendered %}
    <section>
        <div class="panel panel-default">
            <div class="panel-heading">Dates</div>
            <div class="panel-body">
                <ul id="liste_dates"
                    class="list-unstyled mt-4 remove-collection-widget"
                    data-prototype="{{ form_widget(form.dates.vars.prototype)|e }}"
                    data-widget-tags="{{ '<li></li>'|e }}"
                    data-widget-counter="{{ form.dates|length }}"
                >
                    {% for date in form.dates %}
                        <li>
                            {{ form_errors(date) }}
                            {{ form_widget(date, {attr: {class: 'collection-item-wrapper'}}) }}
                        </li>
                    {% endfor %}
                </ul>

                <div class="text-center">
                    <button type="button"
                            class="btn btn-info add-collection-widget"
                            data-list-selector="#liste_dates"
                    >
                        Ajouter une date
                    </button>
                </div>
            </div>
        </div>
    </section>

    {# #addReapeat masqué si 2+ dates pré-remplies — iso legacy afficheDivPeriodicite($countLigne > 1) #}
    <div id="addReapeat"{% if form.dates|length > 1 %} style="display:none;"{% endif %}>
        <div class="form-group">
            {{ form_label(form.withPeriodicite, null, {id: 'repeat'}) }}
            {{ form_widget(form.withPeriodicite, {id: 'repeat'}) }}
            {{ form_errors(form.withPeriodicite) }}
        </div>
    </div>
    <div id="planification" style="display:none;">
        {{ form_row(form.dateFin) }}
        {{ form_row(form.periodicite) }}
    </div>

    {% if show_footer is not defined or show_footer %}
    <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Fermer</button>
        <button type="submit" class="btn btn-success">Enregistrer dans le calendrier</button>
    </div>
    {% endif %}
{{ form_end(form) }}
