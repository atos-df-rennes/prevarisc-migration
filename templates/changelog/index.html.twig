{% extends 'base.html.twig' %}

{% block title %}Nouveautés{% endblock %}

{% block body %}
<div class="container changelog-index">
    <h1><span class="glyphicon glyphicon-list-alt" aria-hidden="true"></span> Nouveautés &amp; corrections</h1>

    {% if sections is empty %}
        <p class="text-muted">Aucun changelog disponible.</p>
    {% else %}
        {# Navigation par version majeure #}
        <ul class="nav nav-pills" id="changelog-nav">
            {% for major_version, minor_versions in sections %}
                <li{% if loop.first %} class="active"{% endif %}>
                    <a href="#changelog-{{ major_version|replace({'.': '-'}) }}" data-toggle="tab">
                        {{ major_version }}
                    </a>
                </li>
            {% endfor %}
        </ul>

        {# Contenu par version majeure puis mineure #}
        <div class="tab-content">
            {% for major_version, minor_versions in sections %}
                <div class="tab-pane{% if loop.first %} active{% endif %}" id="changelog-{{ major_version|replace({'.': '-'}) }}">
                    <ul class="nav nav-tabs changelog-minor-nav">
                        {% for minor_version, entries in minor_versions %}
                            <li{% if loop.first %} class="active"{% endif %}>
                                <a href="#changelog-{{ major_version|replace({'.': '-'}) }}-{{ minor_version|replace({'.': '-'}) }}" data-toggle="tab">
                                    {{ minor_version }}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>

                    <div class="tab-content">
                        {% for minor_version, entries in minor_versions %}
                            <div class="tab-pane{% if loop.first %} active{% endif %}" id="changelog-{{ major_version|replace({'.': '-'}) }}-{{ minor_version|replace({'.': '-'}) }}">
                                {% for entry in entries %}
                                    <div class="panel panel-default">
                                        <div class="panel-heading">
                                            <strong>{{ entry.version }}</strong>
                                            <span class="text-muted">{{ entry.date }}</span>
                                        </div>
                                        <div class="panel-body changelog-content">
                                            {{ entry.html|raw }}
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
