{% if show %}
<div id="changelog-banner" class="alert alert-info alert-dismissible" style="margin: 50px 0 0; border-radius: 0; border-left: none; border-right: none;">
    <div class="container-fluid">
        <strong>Mise à jour {{ currentVersion }}.</strong>
        <a href="{{ path('changelog_index') }}">Voir les nouveautés &raquo;</a>
        <button type="button" class="close" id="changelog-dismiss" aria-label="Fermer">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
</div>

<style>
    #changelog-toast {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 9999;
        min-width: 280px;
        max-width: 380px;
        display: none;
        box-shadow: 0 4px 12px rgba(0,0,0,.2);
        border-radius: 4px;
    }
    #changelog-toast .alert {
        margin: 0;
        padding: 12px 16px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    #changelog-toast .glyphicon {
        flex-shrink: 0;
    }
</style>

<div id="changelog-toast" role="alert" aria-live="polite">
    <div class="alert alert-success">
        <span class="glyphicon glyphicon-ok-circle" aria-hidden="true"></span>
        <span>Préférence enregistrée. Vous ne verrez plus ce bandeau pour la version {{ currentVersion }}.</span>
    </div>
</div>

<script>
    document.getElementById('changelog-dismiss').addEventListener('click', function () {
        const csrfToken = '{{ csrf_token('changelog_dismiss') }}';
        fetch('{{ path('changelog_dismiss') }}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest',
            },
            body: '_token=' + encodeURIComponent(csrfToken),
        }).then(function (response) {
            document.getElementById('changelog-banner').remove();

            if (response.ok) {
                const toast = document.getElementById('changelog-toast');
                toast.style.display = 'block';
                setTimeout(function () {
                    toast.style.display = 'none';
                }, 4000);
            }
        });
    });
</script>
{% endif %}
