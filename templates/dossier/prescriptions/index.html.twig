{% extends 'layouts/dossier.html.twig' %}

{% block title %}{{ parent() }} / Prescriptions{% endblock %}

{% block body %}
    {# Champ caché utilisé par le JS des phases ultérieures (ordonnancement, modales) #}
    <input type="hidden" id="idDossier" value="{{ dossier.id }}">

    <h3>Gestion des prescriptions</h3>

    {% if not dossier.verrou %}
        <div class="mb-3">
            <button id="btn-ouvrir-modal-presc-type" class="btn btn-default">
                Ajouter une prescription type
            </button>
            <a class="btn btn-default ml-2"
               href="{{ path('dossier_prescriptions_ajouter', {id: dossier.id}) }}">
                Ajouter une prescription
            </a>
            {% if dossier.etablissements|length == 1 %}
                <button id="btn-ouvrir-modal-reprise" class="btn btn-default ml-3">
                    Reprendre les prescriptions d'autres dossiers
                </button>
            {% endif %}
        </div>
    {% endif %}

    {# Conteneur de la modale prescription type (contenu chargé par AJAX) #}
    <div id="modal-ajout-prescription-type" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="modalPrescTypeLabel">
        <div id="modal-ajout-prescription-type-content"></div>
    </div>

    {# Conteneur de la modale reprise prescriptions (contenu chargé par AJAX) #}
    <div id="modal-reprise-prescriptions" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="modalRepriseLabel">
        <div id="modal-reprise-prescriptions-content"></div>
    </div>

    <section>
        <h3 id="prescRappelRegTitle">Rappels réglementaires</h3>
        <div class="row">
            <div class="col-xs-12">
                <ul id="prescRappelReg" class="listePrescriptions list-unstyled">
                    {% if prescriptionsRegl is empty %}
                        <em class="listePrescriptions--no-result">Actuellement aucune prescription dans cette catégorie</em>
                    {% else %}
                        {% for prescription in prescriptionsRegl %}
                            {{ include('dossier/prescriptions/_prescription_item.html.twig', {prescription: prescription, dossier: dossier}) }}
                        {% endfor %}
                    {% endif %}
                </ul>
            </div>
        </div>
    </section>

    <section>
        <h3>Prescriptions liées à l'exploitation</h3>
        <div class="row">
            <div class="col-xs-12">
                <ul id="prescExploitation" class="listePrescriptions list-unstyled">
                    {% if prescriptionsExploitation is empty %}
                        <em class="listePrescriptions--no-result">Actuellement aucune prescription dans cette catégorie</em>
                    {% else %}
                        {% for prescription in prescriptionsExploitation %}
                            {{ include('dossier/prescriptions/_prescription_item.html.twig', {prescription: prescription, dossier: dossier}) }}
                        {% endfor %}
                    {% endif %}
                </ul>
            </div>
        </div>
    </section>

    <section>
        <h3>Recommandations liées à l'amélioration du niveau de sécurité</h3>
        <div class="row">
            <div class="col-xs-12">
                <ul id="prescAmelioration" class="listePrescriptions list-unstyled">
                    {% if prescriptionsAmelioration is empty %}
                        <em class="listePrescriptions--no-result">Actuellement aucune prescription dans cette catégorie</em>
                    {% else %}
                        {% for prescription in prescriptionsAmelioration %}
                            {{ include('dossier/prescriptions/_prescription_item.html.twig', {prescription: prescription, dossier: dossier}) }}
                        {% endfor %}
                    {% endif %}
                </ul>
            </div>
        </div>
    </section>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    <link href="{{ asset('css/dossier/prescriptions.css') }}" rel="stylesheet" />
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script type="text/javascript">
        $(document).ready(function() {
            $('[data-toggle="popover"]').popover();

            {% if not dossier.verrou %}
            const reorderUrl = '{{ path('dossier_prescriptions_reordonner', {id: dossier.id}) }}';
            const reorderCsrfToken = '{{ csrf_token('reorder_prescriptions') }}';

            function refreshSortable() {
                $('.listePrescriptions').sortable('refresh');
            }

            $('.listePrescriptions').sortable({
                update: function() {
                    const idsRegl = [];
                    const idsAutres = [];
                    let num;

                    num = 1;
                    $('#prescRappelReg > li').each(function() {
                        const id = $(this).attr('id').split('_')[1];
                        $(this).find('.numPresc').html(num);
                        idsRegl.push(id);
                        num++;
                    });

                    num = 1;
                    $('#prescExploitation > li, #prescAmelioration > li').each(function() {
                        const id = $(this).attr('id').split('_')[1];
                        $(this).find('.numPresc').html(num);
                        idsAutres.push(id);
                        num++;
                    });

                    $.ajax({
                        type: 'POST',
                        url: reorderUrl,
                        data: { idsRegl: idsRegl.join(','), idsAutres: idsAutres.join(','), _token: reorderCsrfToken },
                        success: function() {
                            $.toast.success("L'ordre des prescriptions a bien été mis à jour.");
                        },
                        error: function() {
                            $.toast.error("Erreur lors de la sauvegarde de l'ordre des prescriptions. Veuillez recharger la page.");
                        }
                    });
                }
            });
            {% endif %}

            {% if not dossier.verrou %}
            // ── Modale "Ajouter une prescription type" ──────────────────────────────

            const urlModalType = '{{ path('dossier_prescriptions_modal_type', {id: dossier.id}) }}';
            const urlRechercheClassement = '{{ path('dossier_prescriptions_recherche_classement', {id: dossier.id}) }}';
            const urlRechercheMotsCles = '{{ path('dossier_prescriptions_recherche_mots_cles', {id: dossier.id}) }}';

            // Ouverture de la modale : charge le HTML par AJAX puis affiche
            $('#btn-ouvrir-modal-presc-type').on('click', function() {
                $.ajax({
                    type: 'GET',
                    url: urlModalType,
                    success: function(html) {
                        $('#modal-ajout-prescription-type-content').html(html);
                        $('#modal-ajout-prescription-type').modal('show');
                    },
                    error: function() {
                        $.toast.error('Impossible de charger la modale. Veuillez réessayer.');
                    }
                });
            });

            // Toggle classement / mots-clés
            $(document).on('click', '#btn-mode-classement', function() {
                $(this).addClass('active');
                $('#btn-mode-motscles').removeClass('active');
                $('#zone-motscles').toggleClass('hidden');
                $('#zone-classement').toggleClass('hidden');
                $('#listePrescriptionTypeSearch').toggleClass('hidden').empty();
            });

            $(document).on('click', '#btn-mode-motscles', function() {
                $(this).addClass('active');
                $('#btn-mode-classement').removeClass('active');
                $('#zone-classement').toggleClass('hidden');
                $('#zone-motscles').toggleClass('hidden');
                $('#listePrescriptionType').empty();
            });

            // Recherche par mots-clés
            $(document).on('click', '#btn-recherche-motscles', function() {
                lancerRechercheMotsCles();
            });

            $(document).on('keypress', '#inputMotsCles', function(e) {
                if (13 === e.keyCode) {
                    e.preventDefault();
                    lancerRechercheMotsCles();
                }
            });

            function lancerRechercheMotsCles() {
                const motsCles = $('#inputMotsCles').val();
                $.ajax({
                    type: 'POST',
                    url: urlRechercheMotsCles,
                    data: { motsCles: motsCles },
                    beforeSend: function() {
                        $('#listePrescriptionTypeSearch').html('<span class="glyphicon glyphicon-refresh spinning"></span> Recherche en cours...')
                    },
                    success: function(html) {
                        $('#listePrescriptionTypeSearch').html(html).removeClass('hidden');
                    },
                    error: function() {
                        $.toast.error('Erreur lors de la recherche. Veuillez réessayer.');
                    }
                });
            }

            // Navigation par classement
            $(document).on('click', '.btn-nav-classement', function() {
                const categorieId = $(this).data('categorie-id') || 0;
                const texteId = $(this).data('texte-id') || 0;
                const articleId = $(this).data('article-id') || 0;

                $.ajax({
                    type: 'POST',
                    url: urlRechercheClassement,
                    data: { categorieId: categorieId, texteId: texteId, articleId: articleId },
                    success: function(html) {
                        $('#selectEmplacement').html(html);
                    },
                    error: function() {
                        $.toast.error('Erreur lors du chargement. Veuillez réessayer.');
                    }
                });
            });

            // Ajout d'une prescription type depuis la modale
            $(document).on('click', '.btn-ajouter-presc-type', function() {
                const $btn = $(this);
                const url = $btn.data('url');
                const csrfToken = $btn.data('csrf-token');
                const typePrescription = $('#typePrescriptionDossier').val();

                $btn.prop('disabled', true);

                $.ajax({
                    type: 'POST',
                    url: url,
                    data: { typePrescriptionDossier: typePrescription, _token: csrfToken },
                    success: function(html) {
                        const $html = $(html);
                        let $list;

                        if (0 === parseInt(typePrescription)) {
                            $list = $('#prescRappelReg');
                        } else if (1 === parseInt(typePrescription)) {
                            $list = $('#prescExploitation');
                        } else {
                            $list = $('#prescAmelioration');
                        }

                        $list.children('.listePrescriptions--no-result').remove();
                        $list.append($html);

                        refreshSortable();
                        $('[data-toggle="popover"]').popover();
                        $.toast.success('La prescription type a bien été ajoutée.');
                        $btn.prop('disabled', false);
                    },
                    error: function() {
                        $.toast.error("Erreur lors de l'ajout. Veuillez réessayer.");
                        $btn.prop('disabled', false);
                    }
                });
            });
            // ── Modale "Reprendre les prescriptions d'autres dossiers" ───────────────

            {% if dossier.etablissements|length == 1 %}
            const urlModalReprise = '{{ path('dossier_prescriptions_modal_reprise', {id: dossier.id}) }}';

            $('#btn-ouvrir-modal-reprise').on('click', function() {
                $.ajax({
                    type: 'GET',
                    url: urlModalReprise,
                    success: function(html) {
                        $('#modal-reprise-prescriptions-content').html(html);
                        $('#modal-reprise-prescriptions').modal('show');
                    },
                    error: function() {
                        $.toast.error('Impossible de charger la modale. Veuillez réessayer.');
                    }
                });
            });
            {% endif %}

            {% endif %}
        });
    </script>
{% endblock %}
