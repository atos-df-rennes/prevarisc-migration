{#
    Variables attendues :
    - prescription : PrescriptionDossier
    - dossier      : Dossier
#}
{% set associations = prescription.prescriptionType
    ? prescription.prescriptionType.associations
    : prescription.associations %}
{% set nb_assoc = associations|length %}

{% if nb_assoc > 0 %}
<li class="table-responsive" id="prescriptionDossier_{{ prescription.id }}" style="list-style-type: none; margin-bottom: 15px;">
    <table class="table">
        {% for assoc in associations %}
            <tr>
                <td class="col-sm-3">{{ assoc.texte ? assoc.texte.libelle : '' }}</td>
                <td class="col-sm-2">{{ assoc.article ? assoc.article.libelle : '' }}</td>

                {% if loop.first %}
                    {% if prescription.type != 0 %}
                        <td rowspan="{{ nb_assoc }}" class="col-sm-1 numPresc">
                            {{ prescription.numero }}
                        </td>
                    {% endif %}

                    <td rowspan="{{ nb_assoc }}" class="col-sm-{{ prescription.type != 0 ? 5 : 6 }}">
                        {% if prescription.dossierReprise is not null %}
                            <div>
                                <span class="label label-warning">
                                    Reprise du dossier
                                    <a href="{{ path('dossier_index', {id: prescription.dossierReprise.id}) }}" target="_blank">
                                        {% if prescription.dossierReprise.objet %}
                                            {{ prescription.dossierReprise.objet }}
                                        {% else %}
                                            {{ prescription.dossierReprise.type.libelle }}{% if prescription.dossierReprise.nature %} - {{ prescription.dossierReprise.nature.libelle }}{% endif %}
                                        {% endif %}
                                    </a>
                                    <br>
                                    créé le {{ prescription.dossierReprise.dateInsert|date('d/m/Y') }}
                                </span>
                            </div>
                        {% endif %}

                        {% if prescription.dateLevee is not null %}
                            <span class="label label-info">
                                Levée le {{ prescription.dateLevee|date('d/m/Y') }}
                            </span>
                        {% endif %}

                        {% if prescription.justificatif %}
                            <i
                                class="glyphicon glyphicon-info-sign"
                                data-toggle="popover"
                                data-placement="top"
                                data-content="{{ prescription.justificatif|nl2br|e('html_attr') }}"
                                data-html="true"
                                title="Justification"
                            ></i>
                        {% endif %}

                        <p>
                            {% if prescription.prescriptionType %}
                                {{ prescription.prescriptionType.libelle|nl2br }}
                            {% else %}
                                {{ prescription.libelle|nl2br }}
                            {% endif %}
                        </p>
                    </td>

                    {% if not dossier.verrou %}
                        <td rowspan="{{ nb_assoc }}" class="col-sm-1">
                            {# Placeholder — Phase 3 : modification #}
                            <a class="btn btn-default btn-sm disabled">Modifier</a>
                        </td>
                    {% endif %}
                {% endif %}
            </tr>
        {% endfor %}
    </table>
</li>
{% endif %}
