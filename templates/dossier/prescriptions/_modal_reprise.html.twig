{#
    Contenu de la modale "Reprendre les prescriptions d'autres dossiers".
    Variables attendues :
    - dossier  : Dossier
    - etudes   : Dossier[]
    - visites  : Dossier[]
    - autres   : Dossier[]
#}
{% set has_dossiers = etudes is not empty or visites is not empty or autres is not empty %}

{#
    Macro : affiche un groupe de dossiers avec titre et séparateur.
    - titre   : string
    - items   : Dossier[]
    - premier : bool (pas de <hr> avant le premier groupe)
#}
{% macro groupe(titre, items, premier) %}
    {% if items is not empty %}
        {% if not premier %}<hr>{% endif %}
        <h5><strong>{{ titre }}</strong></h5>
        <ul class="list-unstyled ml-3">
            {% for source in items %}
                {# Libellé : type - nature - objet (tronqué à 70 car) #}
                {% set objet_tronque = source.objet|length > 70 ? source.objet[:70] ~ ' (...)' : source.objet %}
                {% set libelle_parts = [source.type.libelle, source.nature ? source.nature.libelle : null, objet_tronque ?: null]|filter(v => v is not empty) %}
                {% set libelle = libelle_parts|join(' - ') %}

                {# Date : dateVisite > dateCommission > dateInsert #}
                {% if source.dateVisite %}
                    {% set date_label = 'date de visite le' %}
                    {% set date_val = source.dateVisite|date('d/m/Y') %}
                {% elseif source.dateCommission %}
                    {% set date_label = 'date de commission le' %}
                    {% set date_val = source.dateCommission %}
                {% else %}
                    {% set date_label = 'créé le' %}
                    {% set date_val = source.dateInsert|date('d/m/Y') %}
                {% endif %}

                <li>
                    <div class="checkbox">
                        <label>
                            <input type="checkbox" name="dossierIds[]" value="{{ source.id }}">
                            <a href="{{ path('dossier_index', {id: source.id}) }}" target="_blank">{{ libelle }}</a>
                            <small class="text-muted">— {{ date_label }} {{ date_val }}</small>

                            {% if source.incomplet %}
                                <span class="avis" style="background-color: #f89406;">Dossier incomplet</span>
                            {% elseif source.avisDiffere %}
                                <span class="avis" style="background-color: #3a87ad;">Avis différé</span>
                            {% elseif source.avis %}
                                <span class="avis {{ source.avis.libelle[:1] }}">
                                    {{ source.avis.libelle }}
                                    {{ include('dossier/_precision_libelle_avis.html.twig', {dossier: source}) }}
                                </span>
                            {% else %}
                                <span class="avis">Avis indisponible</span>
                            {% endif %}

                            {% if source.echeancierTravaux is not null %}
                                <span class="avis" style="background-color: #3a87ad;">Fait l'objet d'un échéancier de travaux</span>
                            {% endif %}

                            {% if source.consultationPlatau is not null %}
                                <span class="label label-info">CONSULTATION PLATAU : {{ source.consultationPlatau.identifiant }}</span>
                                {% if not source.incomplet %}
                                    <span class="label label-info">EN ATTENTE DE PEC</span>
                                {% endif %}
                            {% endif %}
                        </label>
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endmacro %}

<div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
        <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-label="Fermer">
                <span aria-hidden="true">&times;</span>
            </button>
            <h4 class="modal-title" id="modalRepriseLabel">
                Reprendre les prescriptions d'autres dossiers
            </h4>
        </div>

        <div class="modal-body">
            {% if not has_dossiers %}
                <div class="well well-sm text-center">
                    <p class="lead">Aucun autre dossier disponible pour cet établissement.</p>
                </div>
            {% else %}
                <p>
                    Sélectionnez les dossiers dont vous souhaitez reprendre les prescriptions.<br>
                    <small class="text-muted">Plusieurs sélections sont possibles. Seules les prescriptions non levées seront copiées.</small>
                </p>

                <form id="form-reprise-prescriptions"
                      action="{{ path('dossier_prescriptions_reprendre', {id: dossier.id}) }}"
                      method="post">
                    <input type="hidden" name="_token" value="{{ csrf_token('reprendre_prescriptions_' ~ dossier.id) }}">

                    {{ _self.groupe('Visites', visites, true) }}
                    {{ _self.groupe('Études', etudes, visites is empty) }}
                    {{ _self.groupe('Autres', autres, visites is empty and etudes is empty) }}
                </form>
            {% endif %}
        </div>

        <div class="modal-footer">
            <button type="button" class="btn btn-default" data-dismiss="modal">Annuler</button>
            {% if has_dossiers %}
                <button type="submit" form="form-reprise-prescriptions" class="btn btn-primary">
                    Reprendre les prescriptions
                </button>
            {% endif %}
        </div>
    </div>
</div>
