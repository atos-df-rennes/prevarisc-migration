{% if natureId in [1, 2, 3, 14, 15, 30, 62]%}
    <li class="row" style="margin-bottom: 20px;" id="NUMDOCURBA">
        <div class="col-sm-3" style="float:left;">Numéro document d'urbanisme</div>
        <div class="col-sm-6">
            <div id="listeDocUrba">
                <div class="docurba-form form-inline" style="margin-top: 10px;">
                    <span id='docurbaVal'></span>
                    <input type="text" name="NUM_DOCURBA" id="NUM_DOCURBA" class="form-control" />
                    <button id="addNumDoc" class="btn btn-primary" type="button">  
                        <i class="glyphicon glyphicon-plus"></i>&nbsp;Ajouter le numéro de document d'urbanisme
                    </button>
                </div>
                {% for docurba in numDocurba %}
                    <div class="docurba">
                        <input 
                            type="hidden" 
                            name="docUrba[]" 
                            value="{{ docurba.numDocurba }}" 
                            id="urba_{{ docurba.id }}"
                        />
                        {{ docurba.numDocurba }}
                        <a href="#" 
                        class="suppDocUrba" 
                        idDocUrba="{{ docurba.id }}"
                        >&times;</a>
                    </div>
                {% endfor %}
            </div>
        </div>
    </li>
{% endif %}

{% if natureId in [1, 2, 3, 14, 30, 61, 62, 63]  %}
    <li class="row" style="margin-bottom: 20px;" id="SERVICEINSTRUC">
        <div class="col-sm-3" style='float:left;'>Service instructeur</div>
        <div class="col-sm-9">
            <div class="form-inline" style="display: flex; gap: 10px; align-items: center;">

                    <label >
                        <input type="radio" name="servInst" value="servInstGrp" 
                            {% if typeServiceInstructeur == 'servInstGrp' or typeServiceInstructeur is null %}
                                checked="checked"
                            {% endif %}>
                    </label>
                    
                        {{ include('dossier/_groupement_servinstruc.html.twig', {
                            selected: serviceInstructeur,
                            typeSelected: typeServiceInstructeur,
                            idTypeGroupement: 10,
                        }) }}

                    <label style="font-size: 3px;">
                        <input type="radio" name="servInst" value="servInstCommune"
                            {% if typeServiceInstructeur == 'servInstCommune' %}
                                checked="checked"
                            {% endif %}>
                    </label>

                    <input type="text" name="servInstVille" id="servInstVille"
                        class="form-control"
                        {% if typeServiceInstructeur != 'servInstCommune' %}
                            disabled="disabled"
                        {% endif %}
                        value="{{ typeServiceInstructeur == 'servInstCommune' ? ServiceInstructeur : '' }}">
            </div>
        </div>
    </li>
{% endif %}



{% if natureId != 19 %}
    <li class="row" style="margin-bottom: 20px;" id="INCOMPLET">
        <div class="col-sm-3" style="float:left;">Etat dossier</div> 

        <div class="col-sm-9">
            <div id="dossierIncomplet">
                {% set cptDocManquant = dossierDocManquant|length %}
                {% for ue in dossierDocManquant %}
                    {% set cptDocManquant = cptDocManquant - 1 %}
                    {% set dateDocManquant = ue.dateDocsManquant is not empty ? ue.dateDocsManquant|date('d/m/Y') : '' %}
                    {% set dateReceptionDoc = ue.dateReceptionDoc is not empty ? ue.dateReceptionDoc|date('d/m/Y') : '' %}
                    {% set readonlyTextArea = ue.dateReceptionDoc is not empty ? 'readonly' : '' %}
                    {% set readonlyInput = ue.dateReceptionDoc is not empty ? 'readonly' : 'class="date"' %}

                    <div style="margin-bottom: 15px;">
                        Dossier incomplet le
                        <input type="text" name="dateDocManquant[]" id="dateDocManquant_{{ ue.numDocsManquant }}"
                            value="{{ dateDocManquant }}"
                            {{ ue.dateReceptionDoc is not empty ? 'readonly' : 'class="date"' }}
                        />

                        {% if cptDocManquant == 0 and ue.dateReceptionDoc is empty %}
                            <button class="today btn" type="button">
                                <i class="glyphicon glyphicon-calendar"></i> Aujourd'hui
                            </button>
                        {% endif %}

                        <textarea name="docManquant[]" id="docManquant_{{ ue.numDocsManquant }}" class="docManquant" rows="5" cols="100" style="margin-top: 10px;" {{ readonlyTextArea }}>
                            {{ ue.docManquant|trim }}
                        </textarea>

                        <div class="form-inline" style="margin-bottom: 10px;">
                            <label>Document(s) réceptionné(s) le</label>
    
                            <div class="input-group" style="margin-top: 10px;">
                                <input 
                                    class="date form-control" 
                                    type="text" 
                                    name="dateReceptionDocManquant[]" 
                                    id="dateReceptionDocManquant_{{ ue.numDocsManquant }}" 
                                    value="{{ dateReceptionDoc }}"
                                    {{ readonlyInput }}
                                        readonly
                                    style="pointer-events: none; background-color: #eee;"
                                />
                                <span class="input-group-btn">
                                    <button 
                                        type="button" 
                                        class="today btn btn-default"
                                        style="{{ ue.dateReceptionDoc is not empty ? 'display:none;' : '' }}"
                                    >
                                        <em class="glyphicon glyphicon-calendar"></em>&nbsp;Aujourd'hui
                                    </button>
                                </span>
                            </div>
                        </div>

                    <button 
                        type="button" 
                        class="btn btn-success validDocManquant"
                        style="{{ ue.dateReceptionDoc is not empty ? 'display:none;' : '' }}"
                    >
                        <em class="glyphicon glyphicon-lock"></em>&nbsp;Valider la réception de document
                    </button>

                    <span 
                        style="{{ (ue.dateReceptionDoc is empty or cptDocManquant != 0) ? 'display:none;' : '' }}"
                    >
                        <button 
                            type="button" 
                            class=" cancelDateRecep btn"
                        >
                            <i class="glyphicon glyphicon-remove"></i>&nbsp;Modifier
                        </button>
                    </span>

                {% endfor %}
            </div>

            <div id="inputComplet" {% if etatDossier == 1 %}style="display:none;"{% endif %}>
                <label>
                    <input type="radio" class="incomplet" name="INCOMPLET_DOSSIER" value="0"
                        {{ etatDossier == 0 ? 'checked' : '' }}> Complet
                </label>
                <label>
                    <input type="radio" class="incomplet" name="INCOMPLET_DOSSIER" value="1"
                        {{ etatDossier == 1 ? 'checked' : '' }}> Incomplet
                </label>
            </div>
        </div>

    </li>
{% endif %}

{% if natureId != 10 %}
    <li class="row" style="margin-bottom: 20px;" id="DATESECRETARIAT">
        <div class="col-sm-3" style="float: left;">Date réception secrétariat commission</div>
        <div class="col-sm-3">
            <div class="input-group">
                <input type="text" class="form-control date" name="DATESECRETARIAT_DOSSIER" id="DATESECRETARIAT_INPUT"
                    value="{{ dateSecretariat ? dateSecretariat|date('d/m/Y') : '' }}" />
                <span class="input-group-btn">
                    <button type="button" class="btn btn-default today">
                        <i class="glyphicon glyphicon-calendar" aria-hidden="true"></i>&nbsp;Aujourd'hui
                    </button>
                </span>
            </div>
        </div>
    </li>
{% endif %}

{% if natureId != 19 and not etatDossier %}
    <li class="row" style="margin-bottom: 20px;" id="HORSDELAI">
        <div class="col-sm-3" style='float:left;'>Hors délai</div>
        <div class="col-sm-9">
            <input type="checkbox" class="horsdelai hideavis" name="HORSDELAI_DOSSIER"
            {% if horsDelai %}checked{% endif %}>
        </div>
    </li>
{% endif %}


{% if natureId == 3 %}
    <li class="row" style="margin-bottom: 20px;" id="MESURESCOMPENS">
        <div class="col-sm-3" style='float:left;'>Mesures compensatoires proposées</div>
        <div class="col-sm-9">
            <textarea name="MESURESCOMPENS_DOSSIER"
                id="MESURESCOMPENS_DOSSIER"
                rows="3"
                cols="100">{{ mesuresCompensatoires|e }}
            </textarea>
        </div>
    </li>
{% endif %}

{% if natureId == 3 %}
    <li class="row" style="margin-bottom: 20px;" id="MESURESCOMPLE">
        <div class="col-sm-3" style='float:left;'>Mesures complémentaires à respecter</div>
        <div class="col-sm-9">
            <textarea name="MESURESCOMPLE_DOSSIER"
                id="MESURESCOMPLE_DOSSIER"
                rows="3"
                cols="100">{{ mesuresComplementaires|e }}
            </textarea>
        </div>
    </li>
{% endif %}

{% if natureId == 3 %}
    <li class="row" style="margin-bottom: 20px;" id="REGLEDEROG">
        <div class="col-sm-3" style='float:left;'>Règles auxquelles il est demandé de déroger</div>
        <div class="col-sm-9">
            <textarea name="REGLEDEROG_DOSSIER"
                id="REGLEDEROG_DOSSIER"
                rows="3"
                cols="100">{{ reglesADeroger|e }}
            </textarea>
        </div>
    </li>
{% endif %}

{% if natureId == 3 %}
    <li class="row" style="margin-bottom: 20px;" id="JUSTIFDEROG">
        <div class="col-sm-3" style='float:left;'>Justification de la dérogation</div>
        <div class="col-sm-9">
            <textarea name="JUSTIFDEROG_DOSSIER"
                id="JUSTIFDEROG_DOSSIER"
                rows="3"
                cols="100">{{ justificatifDerogation|e }}
            </textarea>
        </div>
    </li>
{% endif %}

{% if natureId in [8, 10, 11, 16] %}
    <li class="row" style="margin-bottom: 20px;" id="DATEPREF">
        <div class="col-sm-3" style="float:left;">Date réception préfecture</div>
        <div class="col-sm-3">
            <div class="input-group">
                <input type="text" class="form-control date" id="DATEPREF_DOSSIER" name="DATEPREF_DOSSIER"
                    value="{{ datePrefecture ? datePrefecture|date('d/m/Y') : '' }}" />
                <span class="input-group-btn">
                    <button type="button" class="today btn btn-default">
                        <i class="glyphicon glyphicon-calendar" aria-hidden="true"></i>&nbsp;Aujourd'hui
                    </button>
                </span>
            </div>
        </div>
    </li>
{% endif %}

{% if natureId == 6 %}
    <li class="row" style="margin-bottom: 20px;" id="CHARGESEC">
        <div class="col-sm-3" style='float:left;'>Chargé de sécurité (T)</div>
        <div class="col-sm-9">
        <input type="text" id="CHARGESEC_DOSSIER" name="CHARGESEC_DOSSIER"
                value="{{ chargeSecurite }}">
        </div>
    </li>
{% endif %}


{% block javascripts %}
<script>
    // Déclaration des constantes
    var listeDoc = {
        1: "PC",
        2: "AT",
        14: "PA",
        30: "DP",
        62: "CU"
    };

    // Fonctions
    function updateDocurbaLabel() {
        const selected = $("#selectNature").val();
        if (listeDoc[selected]) {
            $("#docurbaVal").html('');
            var docurbaVal = listeDoc[selected];
            $("#docurbaVal").prepend(docurbaVal);
        } else {
            $("#docurbaVal").html('');
        }
    }

    // Document ready
    $(document).ready(function () {
        // Initialisations
        updateDocurbaLabel();

        var incomplet = $("input[name=INCOMPLET_DOSSIER]:checked").val();

        // Autocomplétion ville
        $("#servInstVille").autocomplete("/api/1.0/adresse/get_communes", {
            minChars: 3,
            cacheLength: 0,
            parse: function(data) {
                return $.map(data["response"], function(row) {
                    return {
                        data: row,
                        value: row.LIBELLE_COMMUNE,
                        result: row.LIBELLE_COMMUNE
                    }
                });
            },
            formatItem: function(item) {
                return item.LIBELLE_COMMUNE + " (" + item.NUMINSEE_COMMUNE + ")";
            }
        });

        // Événements
        $("#selectNature").on('change', function () {
            updateDocurbaLabel();
        });

        $(document).on("click", ".cancelDateRecep", function () {
            const $btn = $(this);

            const $container = $btn.closest("div"); 
            const $input = $container.find('input[name="dateReceptionDocManquant[]"]');

            $input.prop("readonly", false)
                .css({
                    "pointer-events": "auto",
                    "background-color": "#fff"
                })
                .focus();

            // Afficher le bouton Valider 
            $btn.parent().prevAll(".validDocManquant:first").show();

            $(".incomplet").addClass("hideavis").val(['1']);
            $("#inputComplet").hide();

            if (typeof afficherCacherAvis === 'function') {
                afficherCacherAvis(0);
            }

            return false;
        });

        $(document).on('click', "input[name=servInst]:radio", function() {
            if ($(this).val() == 'servInstCommune') {
                $("#servInstVille").removeAttr('disabled');
                $("#servInstGrp").attr('disabled', 'disabled');
            } else if ($(this).val() == 'servInstGrp') {
                $("#servInstGrp").removeAttr('disabled');
                $("#servInstVille").attr('disabled', 'disabled');
            }
        });
        
        afficherCacherAvis = function() {
            var typeDossier = $("#TYPE_DOSSIER").val();
            var $hideAvis = $(".hideavis:checked");

            if ($hideAvis.length == 0) {
                //act = 0 on affiche
                if (typeDossier == 1) {
                    $("#AVIS").show();
                    $("#AVIS_COMMISSION").show();
                    $("#DATECOMM").show();
                } else if (typeDossier == 2) {
                    $("#AVIS_COMMISSION").show();
                } else if (typeDossier == 3) {
                    $("#AVIS").show();
                    $("#AVIS_COMMISSION").show();
                    $("#DATECOMM").show();
                }
            } else {
                if ($hideAvis.not('.absquorum').not('.npsp').length > 0) {
                    /* On ne cache pas l'avis du rapporteur pour certains types de dossiers*/
                   $("#AVIS").hide();
                    $("#AVIS_DOSSIER option[value='0']").attr('selected', true);
                } else {
                    $("#AVIS").show();
                }
                $("#AVIS_COMMISSION").hide();
                $("#AVIS_DOSSIER_COMMISSION option[value='0']").attr('selected', true);
                $("#DATECOMM").hide();
                $("#DATECOMM_INPUT").val('');
                $("#ID_AFFECTATION_DOSSIER_COMMISSION").val('');
            }
        };

        $(".incomplet").click(function() {
            if ($(this).val() == 1) {
                $(this).addClass('hideavis');
                afficherCacherAvis();
                $("#HORSDELAI").hide();
                $("#inputComplet").hide();

                var numDivDocManquant = $('.docManquant').length;
                numDivDocManquant++;
                $.ajax({
                    url: "/dossier/formdocmanquant",
                    data: "numDoc=" + numDivDocManquant + "&idDossier=" + $("#idDossier").val(),
                    type: "POST",
                    beforeSend: function() {},
                    success: function(msg) {
                        $("#dossierIncomplet").append(msg);
                         
                        $("#dossierIncomplet").find('input.date').datepicker({
                            dateFormat: 'dd/mm/yy'
                        });
                            $("#inputComplet").appendTo("#dossierIncomplet");

                    }
                });
            } else {
                $(this).removeClass('hideavis');
                afficherCacherAvis();
            }
        });
    });

    $("#addNumDoc").on('click', function() {
        
        const num = $("#NUM_DOCURBA").val().trim();
        const prefix = $("#docurbaVal").text().trim(); 

        if (num !== '') {
            const fullNum = prefix + num;

            $("#listeDocUrba").append(
                "<div class='docurba'>" +
                    "<input type='hidden' name='docUrba[]' value='" + fullNum + "'/>" +
                    fullNum +
                    " <a href='' class='suppDocUrba'>&times;</a>" +
                "</div>"
            );
            $("#NUM_DOCURBA").val('');
        }
        return false;
    });

    $(document).on('click', '.suppDocUrba', function(e) {
        e.preventDefault();
        $(this).closest('.docurba').remove();
    });

</script>
{% endblock %}
