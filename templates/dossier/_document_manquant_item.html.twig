{# Template pour un document manquant individuel #}
<div class='doc-manquant-item' style='margin-bottom: 20px; padding: 15px; border: 1px solid #ddd; border-radius: 4px; background: #f9f9f9;'>
    <div class='row'>
        <div class='col-md-6'>
            {{ form_row(form.date) }}
        </div>
    </div>
    
    <div class='row'>
        <div class='col-md-12'>
            {{ form_row(form.documentManquant) }}
        </div>
    </div>
    
    <div class='row'>
        <div class='col-md-6 date-reception-container'>
            {{ form_row(form.dateReception, {
                'attr': {'class': 'form-control date-reception'}
            }) }}
            {% if form.dateReception.vars.value %}
                <div class='reception-confirmed text-success' style='margin-top: 10px;'>
                    <i class='glyphicon glyphicon-ok'></i> 
                    Document reçu le {{ form.dateReception.vars.value|date('d/m/Y') }}
                </div>
            {% endif %}
        </div>
        <div class='col-md-6' style='padding-top: 25px;'>
            {% if form.dateReception.vars.value %}
                {# Document déjà validé - Pas de boutons #}
            {% else %}
                {# Document actif - Boutons Valider et Annuler #}
                <button type='button' class='btn btn-sm btn-success validate-reception' style='margin-right: 5px;'>
                    <i class='glyphicon glyphicon-ok'></i> Valider la réception
                </button>
                <button type='button' class='btn btn-sm btn-danger cancel-incomplet'>
                    <i class='glyphicon glyphicon-remove'></i> Annuler
                </button>
            {% endif %}
        </div>
    </div>
</div>
