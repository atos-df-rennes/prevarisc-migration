{# Template pour un document manquant individuel #}
<div class='doc-manquant-item' style='margin-bottom: 20px; padding: 15px; border: 1px solid #ddd; border-radius: 4px; background: #f9f9f9;'>
    {# Ligne 1 : Date incomplet (Bouton Annuler ajouté en JS pour nouveaux blocs) #}
    <div class='row'>
        <div class='col-md-12'>
            <label>Dossier incomplet le</label>
            <div>
                {{ form_widget(form.date, {
                    'attr': {'style': 'width: 150px; display: inline-block;'}
                }) }}
            </div>
            {{ form_errors(form.date) }}
        </div>
    </div>
    
    {# Ligne 2 : Documents manquants (textarea) #}
    <div class='row' style='margin-top: 10px;'>
        <div class='col-md-12'>
            {{ form_row(form.documentManquant) }}
        </div>
    </div>
    
    {# Ligne 3 : Date réception + Bouton Valider / Modifier #}
    <div class='row' style='margin-top: 10px;'>
        <div class='col-md-6'>
            <label>Date de réception des pièces</label>
            {{ form_widget(form.dateReception) }}
            {{ form_errors(form.dateReception) }}
            
            {% if form.dateReception.vars.value %}
                <div class='reception-confirmed text-success' style='margin-top: 10px;'>
                    <i class='glyphicon glyphicon-ok'></i> 
                    Document reçu le {{ form.dateReception.vars.value|date('d/m/Y') }}
                </div>
            {% endif %}
        </div>
        <div class='col-md-6' style='padding-top: 25px;'>
            {% if form.dateReception.vars.value %}
                {# Document validé - Bouton Modifier (si 1 seul document validé, géré par JS) #}
                <button type='button' class='btn btn-sm btn-warning modifier-reception' style='display: none;'>
                    <i class='glyphicon glyphicon-pencil'></i> Modifier
                </button>
            {% else %}
                {# Document non validé - Bouton Valider #}
                <button type='button' class='btn btn-sm btn-success validate-reception'>
                    <i class='glyphicon glyphicon-ok'></i> Valider la réception
                </button>
            {% endif %}
        </div>
    </div>
</div>
