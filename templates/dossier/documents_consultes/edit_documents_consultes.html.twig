{% extends 'layouts/dossier.html.twig' %}

{% block title %}
    {{ parent() }} / Documents consultés
{% endblock %}

{% block body %}
    <h4 class="editDocConsulteTitre">Modification du document "{{ libelle }}"</h4>

    {{ form_start(form) }}
        <div class="row">
            <div class="col-md-4">
                {{ form_row(form.reference) }}
                {{ form_row(form.date) }}
            </div>
        </div>

        <div class="row">
            <div class="col-md-4">
                <button type="submit" class="btn btn-success ml-2">
                    <span class="glyphicon glyphicon-ok" aria-hidden="true"></span> Sauvegarder
                </button>
                <a href="{{ path('dossier_documents_consultes', {id: dossier.id}) }}" class="btn btn-default">Annuler</a>
            </div>
        </div>

    {{ form_end(form) }}

{% endblock %}

{% block javascripts %}
    {{ parent() }}

{% endblock %}
