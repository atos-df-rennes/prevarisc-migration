{% extends 'layouts/dossier.html.twig' %}

{% block title %}
    {{ parent() }} / {% if documentAjoute.libelle is not empty %}Modification du document{% else %}Ajout d'un document{% endif %}
{% endblock %}

{% block body %}
    {% if documentAjoute.libelle is not empty %}
        <h4 class="h4_subtitle">Modification du document "{{ documentAjoute.libelle }}"</h4>
    {% else %}
        <h4 class="h4_subtitle">Ajout d'un document</h4>
    {% endif %}

    {{ form_start(form) }}
        <div class="row">
            <div class="col-md-4">
                {{ form_row(form.libelle) }}
                {{ form_row(form.reference) }}
                {{ form_row(form.date) }}
            </div>
        </div>

        <div class="row">
            <div class="col-xs-12">
                <button type="submit" class="btn btn-success">
                    <span class="glyphicon glyphicon-ok" aria-hidden="true"></span> Sauvegarder
                </button>
                <a href="{{ path('dossier_documents_consultes', {id: dossier.id}) }}" class="btn btn-default">Annuler</a>
            </div>
        </div>
    {{ form_end(form) }}
{% endblock %}
