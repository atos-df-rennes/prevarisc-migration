{% extends 'layouts/dossier.html.twig' %}

{% block title %}
    {{ parent() }} / Documents consultés
{% endblock %}

{% block body %}
    <div id='dossier_Pdroite' class='divDocConsulte'>
            <div class='nature row-fluid'>
                <h4 class='hideDocConsulte' >Liste des documents consultés concernant la nature {{ dossier.nature.libelle }}</h4>
                <p class='span5 col-md-4' style='padding-left:20px;'><strong>Libelle</strong></p>
                <div class='span6 col-md-8'>
                    <p class='span5 col-md-6'><strong>Référence</strong></p>
                    <p class='span2 col-md-6'><strong>Date</strong></p>
                </div>
                <br class='clear' />
                <ul class="list-unstyled">
{# //on boucle sur les documents ajoutés à afficher #}
                    {% for doc_ajoute in dossier.documentsAjoutes %}
                        <li class="row">
                            <div class="col-md-4">
                                <div class="col-md-1"><input type="checkbox" name="ajout-{{ doc_ajoute.id }}" checked disabled></div>
                                <div class="col-md-11"><label for="ajout-{{ doc_ajoute.id }}">{{ doc_ajoute.libelle }}</label></div>
                            </div>
                            <div class="col-md-8">
                                <div class="col-md-6">{{ doc_ajoute.reference }}</div>
                                <div class="col-md-3">{{ doc_ajoute.date is empty or doc_ajoute.date.timestamp < 0 ? '' : doc_ajoute.date|date('d/m/Y') }}</div>
                                <div class="col-md-3">
                                    <a href="{{ path('dossier_documents_ajoutes_edit', {id: dossier.id, idDocumentAjoute: doc_ajoute.id}) }}" class="btn btn-default btn-sm"><span class="glyphicon glyphicon-pencil" aria-hidden="true"></span></a>
                                    <a href="{{ path('dossier_documents_ajoutes_delete', {id: dossier.id, idDocumentAjoute: doc_ajoute.id}) }}" class="btn btn-default btn-sm"><span class="glyphicon glyphicon-trash" aria-hidden="true"></span></a>
                                </div>
                            </div>
                        </li>
                    {% endfor %}

{# //on boucle sur les documents de base à afficher #}
                    {% for doc in documentsConsultables %}
                        {% set document_consulte = documentsConsultes[doc.id] ?? null %}
                            <li class="row">
                                <div class="col-md-4">
                                    <div class="col-md-1"><input type="checkbox" name="consulte-{{ doc.id }}" {% if document_consulte %}checked disabled{% else %}onclick="ajoutDocConsultable({{ dossier.id }},{{ doc.id }})"{% endif %}></div>
                                    <div class="col-md-11"><label for="consulte-{{ doc.id }}">{{ doc.libelle }}</label></div>
                                </div>
                                <div class="col-md-8">
                                    <div class="col-md-6">{% if document_consulte %}{{ document_consulte.reference }}{% endif %}</div>
                                    <div class="col-md-3">{% if document_consulte %}{{ document_consulte.date is empty or document_consulte.date.timestamp < 0 ? '' : document_consulte.date|date('d/m/Y') }}{% endif %}</div>
                                    <div class="col-md-3">
                                        {% if document_consulte %}
                                            <a href="{{ path('dossier_documents_consultes_edit', {id: dossier.id, idDocumentConsulte: document_consulte.id}) }}" class="btn btn-default btn-sm"><span class="glyphicon glyphicon-pencil" aria-hidden="true"></span></a>
                                            <a href="{{ path('dossier_documents_consultes_delete', {id: dossier.id, idDocumentConsulte: document_consulte.id}) }}" class="btn btn-default btn-sm"><span class="glyphicon glyphicon-trash" aria-hidden="true"></span></a>
                                        {% endif %}
                                    </div>
                                </div>
                            </li>
                    {% endfor %}
                </ul>
                <hr class='clear' />
                <p>
                    <a href='{{ path('dossier_documents_ajoutes_add', {id: dossier.id}) }}' class='docAjout' >+ Ajouter un nouveau document</a>
                </p>
            </div>
            <hr class='clear' />
        </form>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script type="text/javascript">
        function ajoutDocConsultable(id, idDocumentConsultable) {
            let pathToReplace = "";
            pathToReplace = "{{ path('dossier_documents_consultes_add', {id: 'dossierid', idDocumentConsultable: 'idDocumentConsultable'}) }}";
            pathToReplace = pathToReplace.replace('dossierid', id);
            pathToReplace = pathToReplace.replace('idDocumentConsultable', idDocumentConsultable);
            window.location.replace(pathToReplace);
        }
    </script>
{% endblock %}
