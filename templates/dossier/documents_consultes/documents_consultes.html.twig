{% extends 'layouts/dossier.html.twig' %}

{% block title %}
    {{ parent() }} / Documents consultés
{% endblock %}

{% block body %}
    <div id="dossier_Pdroite">
        <div class="nature">
            <h4 class="h4_subtitle">Liste des documents consultés concernant la nature {{ dossier.nature.libelle }}</h4>

            <div class="row">
                <div class="col-xs-4"><strong>Libellé</strong></div>
                <div class="col-xs-8">
                    <div class="col-xs-5"><strong>Référence</strong></div>
                    <div class="col-xs-7"><strong>Date</strong></div>
                </div>
            </div>

            <ul class="list-unstyled mt-2">
                {# Documents consultés : ajoutés manuellement + consultables déjà renseignés #}
                {% set has_consultes = dossier.documentsAjoutes is not empty or documentsConsultes is not empty %}
                {% if has_consultes %}
                    <li class="row mt-2 mb-1">
                        <div class="col-xs-12"><strong>Documents consultés</strong></div>
                    </li>

                    {% for doc_ajoute in dossier.documentsAjoutes %}
                        <li class="row mb-2">
                            <div class="col-xs-4">{{ doc_ajoute.libelle }}</div>
                            <div class="col-xs-8">
                                <div class="col-xs-5">{{ doc_ajoute.reference }}</div>
                                <div class="col-xs-3">
                                    {% if doc_ajoute.date is not null and doc_ajoute.date.timestamp >= 0 %}
                                        {{ doc_ajoute.date|date('d/m/Y') }}
                                    {% endif %}
                                </div>
                                <div class="col-xs-4">
                                    <a href="{{ path('dossier_documents_ajoutes_edit', {id: dossier.id, idDocumentAjoute: doc_ajoute.id}) }}" class="btn btn-default btn-sm">
                                        <span class="glyphicon glyphicon-pencil" aria-hidden="true"></span>
                                    </a>
                                    <button type="button" class="btn btn-default btn-sm js-confirme_delete"
                                            data-url="{{ path('dossier_documents_ajoutes_delete', {id: dossier.id, idDocumentAjoute: doc_ajoute.id}) }}"
                                            data-toggle="modal" data-target="#modalConfirmationSuppression">
                                        <span class="glyphicon glyphicon-trash" aria-hidden="true"></span>
                                    </button>
                                </div>
                            </div>
                        </li>
                    {% endfor %}

                    {% for item in documentsConsultes %}
                        <li class="row mb-4">
                            <div class="col-xs-4">{{ item.doc.libelle }}</div>
                            <div class="col-xs-8">
                                <div class="col-xs-5">{{ item.documentConsulte.reference }}</div>
                                <div class="col-xs-3">
                                    {% if item.documentConsulte.date is not null and item.documentConsulte.date.timestamp >= 0 %}
                                        {{ item.documentConsulte.date|date('d/m/Y') }}
                                    {% endif %}
                                </div>
                                <div class="col-xs-4">
                                    <a href="{{ path('dossier_documents_consultes_edit', {id: dossier.id, idDocumentConsulte: item.documentConsulte.id}) }}" class="btn btn-default btn-sm">
                                        <span class="glyphicon glyphicon-pencil" aria-hidden="true"></span>
                                    </a>
                                    <button type="button" class="btn btn-default btn-sm js-confirme_delete"
                                            data-url="{{ path('dossier_documents_consultes_delete', {id: dossier.id, idDocumentConsulte: item.documentConsulte.id}) }}"
                                            data-toggle="modal" data-target="#modalConfirmationSuppression">
                                        <span class="glyphicon glyphicon-trash" aria-hidden="true"></span>
                                    </button>
                                </div>
                            </div>
                        </li>
                    {% endfor %}
                {% endif %}

                {# Documents consultables non encore renseignés #}
                {% if documentsNonConsultes is not empty %}
                    <li class="row mt-2 mb-1">
                        <div class="col-xs-12"><strong>Documents consultables</strong></div>
                    </li>
                    {% for doc in documentsNonConsultes %}
                        <li class="row mb-4">
                            <div class="col-xs-4">{{ doc.libelle }}</div>
                            <div class="col-xs-8">
                                <div class="col-xs-4 col-xs-offset-8">
                                    <a href="{{ path('dossier_documents_consultes_add', {id: dossier.id, idDocumentConsultable: doc.id}) }}" class="btn btn-default btn-sm">
                                        <span class="glyphicon glyphicon-plus-sign" aria-hidden="true"></span>
                                    </a>
                                </div>
                            </div>
                        </li>
                    {% endfor %}
                {% endif %}
            </ul>

            <hr />
            <p>
                <a href="{{ path('dossier_documents_ajoutes_add', {id: dossier.id}) }}" class="docAjout">+ Ajouter un nouveau document</a>
            </p>
            <hr />
        </div>
    </div>

    {# Modale de confirmation de suppression #}
    <div class="modal fade" id="modalConfirmationSuppression" tabindex="-1" role="dialog" aria-labelledby="modalSuppressionLabel">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Fermer">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    <h4 class="modal-title" id="modalSuppressionLabel">Confirmer la suppression</h4>
                </div>
                <div class="modal-body">
                    Êtes-vous sûr de vouloir supprimer ce document ?
                </div>
                <div class="modal-footer">
                    <form id="formSuppressionDocument" method="post" action="">
                        <input type="hidden" name="_method" value="DELETE">
                        <input type="hidden" name="token" value="{{ csrf_token('delete_document') }}">
                        <button type="button" class="btn btn-default" data-dismiss="modal">Annuler</button>
                        <button type="submit" class="btn btn-danger">
                            <span class="glyphicon glyphicon-trash" aria-hidden="true"></span>
                            Supprimer
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $(document).ready(function () {
            $('#modalConfirmationSuppression').on('show.bs.modal', function (e) {
                const url = $(e.relatedTarget).data('url');
                $('#formSuppressionDocument').attr('action', url);
            });
        });
    </script>
{% endblock %}
