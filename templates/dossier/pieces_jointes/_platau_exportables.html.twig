{# Fragment HTML : liste des pièces jointes exportables vers Plat'AU #}
{# Port de piece-jointe/export.phtml (legacy) #}
<li id="PIECESJOINTES" class="row" style="margin-bottom: 20px;" tabindex="0">
    <div class="col-md-3 pull-left">
        <span class="glyphicon glyphicon-warning-sign"></span>
        Liste des pièces jointes pouvant être envoyées vers Plat'AU
    </div>
    <div class="col-md-9">
        {% for piece_jointe in piecesJointes %}
            <div class="row">
                <div class="col-md-10">
                    {{ piece_jointe.nom }}{{ piece_jointe.extension }}
                </div>
                <div class="col-md-2">
                    <input type="checkbox" name="export-pj-platau[{{ piece_jointe.id }}]" />
                </div>
            </div>
        {% endfor %}
    </div>
</li>
