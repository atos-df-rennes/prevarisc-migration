*/
           $(".cancelIncomplet").on('click', function() {
                $(this).parent().remove();
                $("#inputComplet").show();
                $(".incomplet").val(['0']);
                $(".incomplet").removeClass('hideavis');
                afficherCacherAvis(0);
                return false;
            });

            $(".hideavis").click(function() {
                afficherCacherAvis();
            });

            //Selection d'une nature et affichage des champs en fonction de la ou des natures
            $(document).on('change', '#selectNature', function() {
                var idNature = $(this).val();
                $(".docurba").remove();
                if (idNature != 0) {
                    var listeNature = $("#listeNature").recupNatures();
                //    $("#InfosDossier").afficheChamps(idNature);
                    $("#selectNature option[value='0']").remove();
                    majAvisSelect();
                }
            });
                const idType = $(this).val();


            // Gestion du changement de type de dossier
            $("#TYPE_DOSSIER").change(function() {
                const idType = $(this).val();
                $("#InfosDossier > li").hide();
                $(".docurba").remove();

                if (idType == 0) {
                    $("#nature").hide();
                } else {
                    const labelText = (idType == 3) ? "Avis du groupe de visite" : "Avis du rapporteur";
                    $("#AVIS_DOSSIER").closest('div.form-group').find('label').text(labelText);

                    if (isDossierPlatau()) {
                        (idType == 1) ? gestionAffichageInfosPlatau() : gestionMasquageInfosPlatau();
                    }

                    $.ajax({
                        url: "/dossier/shownature",
                        data: { idType: idType },
                        type: "POST",
                        beforeSend: function() {
                            $("#chargement").html("<img src='/images/load.gif' />");
                        },
                        success: function(response) {
                            $("#nature > .form").html(response);
                            $("#nature").show();
                            $("#chargement").html("");
                        },
                        error: function() {
                            alert("Erreur lors du chargement des natures");
                        }
                    });

                    majAvisSelect();
                }
            });

           
            $(document).on('click', '.today', function() {
                var objetDate = new Date();
                $(this).closest('.input-group').find('input[type="text"]').val($("#dateToday").val());
                return false;
            });

            //Permet dans le cas d'édition d'empécher la suppression de toutes les natures. Cache les .suppNature quand il n'en reste qu'une
            $.fn.gestionSuppNature = function() {
                if ($("#listeNature > .nature").length == 1) {
                    $(".suppNature").hide();
                } else {
                    $(".suppNature").show();
                }
            };

            //Action lorsque l'on appuie sur le bouton modifier MODE EDITION
            $('#modificationDossier').on('click', function() {
                $(this).hide();
                $("#save_div").hide();

                $("#InfosDossier > li").hide();
                $("#TYPE_DOSSIER option[value='0']").remove();

                $("#rapport").hide();
                $("#VERROU").hide();
                $("#validModification").show();
                $("#annulModification").show().button().off('click').on('click', function() {
                    window.location.reload();
                });

                $("#InfosDossier > li > .value").hide();
                $("#InfosDossier > li > .form").show();

                // On fait apparaître la liste des natures puis on réactive le select
                $("#selectNature").removeAttr('disabled');

                $("#NUM_DOCURBA").show();
                $("#addNumDoc").show();

                $(".suppDocUrba").show();
                if ($("#do").val() == 'edit') {
                    $("#listeNature").gestionSuppNature();
                }

            //    $("#InfosDossier").afficheChamps($("#selectNature").val());

                // Gestion des cas calendrier commission / visite en fonction du type de dossier
                $(".hideCalendar").hide();

                if (isDossierPlatau() && $('#TYPE_DOSSIER').val() === '1') {
                    gestionAffichageInfosPlatau();
                }

                return false;
            });

            //Action lorsque l'on valide les modifications apportées à un dossier
           $("#validModification").on('click', function() {
                if (!verifDossier()) {
                    return false;
                }

                if ($("#NUM_DOCURBA").val() != '') {
                    $("#addNumDoc").click();
                }

                var data = $("#editDossier").serialize();
                $.ajax({
                    url: "/dossier/save",
                    data: data,
                    type: "POST",
                    dataType: "json",
                    beforeSend: function() {
                        $("#annulModification").hide();
                        $("#validModification").hide();
                        $("#modificationDossier").show();
                        $("#chargement").html("<img src='/images/load.gif' />");
                    },
                    success: function(affichageResultat) {
                        try {
                            window.location = '/dossier/' + affichageResultat.id;
                        } catch (e) {
                            window.location.reload();
                        }
                    },
                    error: function(xhr, ajaxOptions, thrownError) {
                        alert(xhr.status + " - " + thrownError);
                        return false;
                    }
                });
                return false;
            });


            $(".validDocManquant").live('click', function() {
                if ($(this).prev().prev().val() == '') {
                    $(this).prev().click();
                    $(this).click();
                    return false;
                } else {
                    $(this).prev().prev().removeClass('date').attr('readonly', 'readonly');
                    $(this).prev().prev().prev().prev().prev().removeClass('date').attr('readonly', 'readonly');
                    $(this).prev().prev().prev().attr('readonly', 'readonly');
                    $(this).hide();
                    $(this).next().show();
                    $(".incomplet").removeClass('hideavis');
                    afficherCacherAvis();
                    $(".incomplet").val(['0']);
                    $("#inputComplet").show();
                }
                return false;
            });



            // Initialisation des calendriers
            gestionCalendrier("showVisite", "hideVisite", "calendarVisiteAffichage", "month_visite", "year_visite");
            gestionCalendrier("showCommission", "hideCommission", "calendarCommission", "month_comm", "year_comm");

       });
    </script>
{% endblock %}
