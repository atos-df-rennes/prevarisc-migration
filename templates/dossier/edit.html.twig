{% extends 'layouts/dossier.html.twig' %}

{% form_theme form _self '_form_theme_tom_select.html.twig' %}

{# Form theme personnalisé pour documents manquants #}
{% block _dossier_documentsManquants_entry_row %}
    {% include 'dossier/_document_manquant_item.html.twig' with {'form': form} %}
{% endblock %}

{% block title %}{{ parent() }} / Modifier les informations générales{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/formulaire/add-collection-widget.js') }}"></script>
    <script src="{{ asset('js/dossier/form.js') }}"></script>
    <script src="{{ asset('js/dossier/etat-dossier-moderne.js') }}"></script>
{% endblock %}

{% block body %}
<div id='dossierInfos'>
    <h3>Informations générales</h3>

    {# Configuration des champs pour JavaScript #}
    <div data-fields-config='{{ fieldsConfig|raw }}' style="display:none;"></div>

    {{ form_start(form, {attr: {id: 'editDossier', name: 'editDossier'}}) }}

    <section>
        <h4>Type et nature du dossier</h4>
        <ul class='list-unstyled'>
            <li class='row'>
                <div class='left libelle col-md-3'>{{ form_label(form.type) }}</div>
                <div class='right form col-md-9'>
                    {{ form_widget(form.type) }}
                    {{ form_errors(form.type) }}
                </div>
            </li>

            <li class='row'>
                <div class='left libelle col-md-3'>{{ form_label(form.nature) }}</div>
                <div class='right form col-md-9'>
                    {{ form_widget(form.nature) }}
                    {{ form_errors(form.nature) }}
                </div>
            </li>
        </ul>
    </section>

    <section>
        <h4>Informations sur le dossier</h4>
        <ul class='list-unstyled'>
            {{ include('components/date_field_with_today.html.twig', {form_field: form.dateInsert}) }}

            <li class='row' id='field-objet'>
                <div class='left libelle col-md-3'>{{ form_label(form.objet) }}</div>
                <div class='right form col-md-9'>
                    {{ form_widget(form.objet) }}
                    {{ form_errors(form.objet) }}
                </div>
            </li>

            <li class='row' id='field-demandeur'>
                <div class='left libelle col-md-3'>{{ form_label(form.demandeur) }}</div>
                <div class='right form col-md-9'>
                    {{ form_widget(form.demandeur) }}
                    {{ form_errors(form.demandeur) }}
                </div>
            </li>

            <li class='row' id='field-lieuReunion'>
                <div class='left libelle col-md-3'>{{ form_label(form.lieuReunion) }}</div>
                <div class='right form col-md-9'>
                    {{ form_widget(form.lieuReunion) }}
                    {{ form_errors(form.lieuReunion) }}
                </div>
            </li>

            {# Champs spécifiques études (PC/AT) - Ordre selon legacy #}
            {% do form.documentsUrbanisme.setRendered %}
            <li class='row' id='field-documentsUrbanisme'>
                <div class='left libelle col-md-3'>
                    <label>Numéros documents d'urbanisme</label>
                </div>
                <div class='right form col-md-9'>
                    <ul id="dossier_documentsUrbanisme"
                        class="row list-unstyled remove-collection-widget"
                        data-prototype="{{ form_widget(form.documentsUrbanisme.vars.prototype)|e }}"
                        data-widget-tags="{{ '<li></li>'|e }}"
                        data-widget-counter="{{ form.documentsUrbanisme|length }}">
                        {% for document_urbanisme in form.documentsUrbanisme %}
                            <li>
                                {{ form_errors(document_urbanisme) }}
                                {{ form_widget(document_urbanisme, {attr: {class: 'collection-item-wrapper'}}) }}
                            </li>
                        {% endfor %}
                    </ul>

                    <div class="text-center mt-2">
                        <button type="button"
                                class="btn btn-primary add-collection-widget"
                                data-list-selector="#dossier_documentsUrbanisme">
                            <span class="glyphicon glyphicon-plus"></span> Ajouter un numéro
                        </button>
                    </div>
                    {{ form_errors(form.documentsUrbanisme) }}
                </div>
            </li>

            {{ include('components/date_field_with_today.html.twig', {form_field: form.dateMairie}) }}
            {{ include('components/date_field_with_today.html.twig', {form_field: form.dateSecretariat}) }}
            {{ include('components/date_field_with_today.html.twig', {form_field: form.dateEnvoiTransit}) }}
            {{ include('components/date_field_with_today.html.twig', {form_field: form.dateReception}) }}

            {# @fixme: Radio boutons Groupement ou Commune avec JS associé #}
            <li class='row' id='field-serviceInstructeur'>
                <div class='left libelle col-md-3'>{{ form_label(form.serviceInstructeur) }}</div>
                <div class='right form col-md-9'>
                    {{ form_widget(form.serviceInstructeur) }}
                    {{ form_errors(form.serviceInstructeur) }}
                </div>
            </li>

            {# @todo: Ajouter le bouton "Choisir une autre commission" #}
            <li class='row' id='field-commission'>
                <div class='left libelle col-md-3'>{{ form_label(form.commission) }}</div>
                <div class='right form col-md-9'>
                    {{ form_widget(form.commission) }}
                    {{ form_errors(form.commission) }}
                </div>
            </li>

            {# Champs descriptifGeneral, descriptifEffectifs, coordonneesSsi retirés #}
            {# (gérés dans sections séparées ou obsolètes) #}

            {# @todo: Ajouter le calendrier #}
            <li class='row' id='field-dateVisite'>
                <div class='left libelle col-md-3'>{{ form_label(form.dateVisite) }}</div>
                <div class='right form col-md-9'>
                    {{ form_widget(form.dateVisite) }}
                    {{ form_errors(form.dateVisite) }}
                </div>
            </li>

            {# Champs spécifiques visites - date réception RVRAT #}
            {{ include('components/date_field_with_today.html.twig', {form_field: form.dateReceptionRvrat}) }}

            {# @todo: Ajouter le calendrier #}
            <li class='row' id='field-dateCommission'>
                <div class='left libelle col-md-3'>{{ form_label(form.dateCommission) }}</div>
                <div class='right form col-md-9'>
                    {{ form_widget(form.dateCommission) }}
                    {{ form_errors(form.dateCommission) }}
                </div>
            </li>

            {# Champs spécifiques dérogations (nature 3) - Ordre legacy #}
            <li class='row' id='field-reglesDerogation'>
                <div class='left libelle col-md-3'>{{ form_label(form.reglesDerogation) }}</div>
                <div class='right form col-md-9'>
                    {{ form_widget(form.reglesDerogation) }}
                    {{ form_errors(form.reglesDerogation) }}
                </div>
            </li>

            <li class='row' id='field-justificationDerogation'>
                <div class='left libelle col-md-3'>{{ form_label(form.justificationDerogation) }}</div>
                <div class='right form col-md-9'>
                    {{ form_widget(form.justificationDerogation) }}
                    {{ form_errors(form.justificationDerogation) }}
                </div>
            </li>

            <li class='row' id='field-mesuresCompensatoires'>
                <div class='left libelle col-md-3'>{{ form_label(form.mesuresCompensatoires) }}</div>
                <div class='right form col-md-9'>
                    {{ form_widget(form.mesuresCompensatoires) }}
                    {{ form_errors(form.mesuresCompensatoires) }}
                </div>
            </li>

            <li class='row' id='field-mesuresComplementaires'>
                <div class='left libelle col-md-3'>{{ form_label(form.mesuresComplementaires) }}</div>
                <div class='right form col-md-9'>
                    {{ form_widget(form.mesuresComplementaires) }}
                    {{ form_errors(form.mesuresComplementaires) }}
                </div>
            </li>

            {# Champs spécifiques études - État dossier (incomplet) avec documents manquants #}
            <li class='row' id='field-incomplet'>
                <div class='left libelle col-md-3'>{{ form_label(form.incomplet) }}</div>
                <div class='right form col-md-9'>
                    {# Zone documents manquants (collection Symfony) #}
                    <div id='dossierIncomplet' 
                         data-prototype="{{ form_widget(form.documentsManquants.vars.prototype)|e }}"
                         data-index="{{ form.documentsManquants|length }}">
                        {% for documentManquant in form.documentsManquants %}
                            {{ form_row(documentManquant) }}
                        {% endfor %}
                    </div>

                    {# Radios Complet / Incomplet (masqués quand incomplet sélectionné) #}
                    <div id='inputComplet'>
                        {{ form_widget(form.incomplet, {
                            'attr': {'class': 'incomplet'},
                        }) }}
                        {{ form_errors(form.incomplet) }}
                        <p class='help-block'>
                            <small>Si le dossier est incomplet, vous pourrez ajouter des documents manquants</small>
                        </p>
                    </div>
                </div>
            </li>

            <li class='row' id='field-horsDelai'>
                <div class='left libelle col-md-3'></div>
                <div class='right form col-md-9'>
                    <div class='form-check'>
                        {{ form_widget(form.horsDelai) }}
                        {{ form_label(form.horsDelai) }}
                        {{ form_errors(form.horsDelai) }}
                    </div>
                </div>
            </li>

            <li class='row' id='field-avisDiffere'>
                <div class='left libelle col-md-3'></div>
                <div class='right form col-md-9'>
                    {{ form_widget(form.avisDiffere, {
                        attr: {
                            disabled: lastAvisEtab != 'Favorable',
                        },
                    }) }}
                    {{ form_label(form.avisDiffere) }}
                    {% if lastAvisEtab != 'Favorable' %}
                        {{ form_help(form.avisDiffere) }}
                    {% endif %}
                    {{ form_errors(form.avisDiffere) }}
                </div>
            </li>

            {# Champs spécifiques visites - ne peut se prononcer #}
            <li class='row' id='field-nePeutSePrononcer'>
                <div class='left libelle col-md-3'></div>
                <div class='right form col-md-9'>
                    <div class='form-check'>
                        {{ form_widget(form.nePeutSePrononcer) }}
                        {{ form_label(form.nePeutSePrononcer) }}
                        {{ form_errors(form.nePeutSePrononcer) }}
                    </div>
                </div>
            </li>

            <li class='row' id='field-absenceDeQuorum'>
                <div class='left libelle col-md-3'></div>
                <div class='right form col-md-9'>
                    {{ form_widget(form.absenceDeQuorum) }}
                    {{ form_label(form.absenceDeQuorum) }}
                    {{ form_errors(form.absenceDeQuorum) }}
                </div>
            </li>

            <li class='row' id='field-avis'>
                <div class='left libelle col-md-3'>
                    <label class="control-label" for="dossier_avis">
                        {% if dossier.type.id is same as(3) %}
                            Avis du groupe de visite
                        {% else %}
                            Avis du rapporteur
                        {% endif %}
                    </label>
                </div>
                <div class='right form col-md-9'>
                    {{ form_widget(form.avis) }}
                    {{ form_errors(form.avis) }}
                </div>
            </li>

            {{ include('components/date_field_with_today.html.twig', {form_field: form.dateLimitePrescription}) }}

            <li class='row' id='field-avisCommission'>
                <div class='left libelle col-md-3'>{{ form_label(form.avisCommission) }}</div>
                <div class='right form col-md-9'>
                    {{ form_widget(form.avisCommission) }}
                    {{ form_errors(form.avisCommission) }}

                    {{ form_widget(form.repercuterAvis) }}
                    {{ form_errors(form.repercuterAvis) }}
                </div>
            </li>

            {# Champs conditionnels - affichés/masqués par JS selon avis commission #}
            <li class='row' id='field-facteurDangerosite'>
                <div class='left libelle col-md-3'>{{ form_label(form.facteurDangerosite) }}</div>
                <div class='right form col-md-9'>
                    {{ form_widget(form.facteurDangerosite) }}
                    {{ form_errors(form.facteurDangerosite) }}
                </div>
            </li>

            {{ include('components/date_field_with_today.html.twig', {form_field: form.echeancierTravaux, show_today: false}) }}

            {# Analyse de risque : affiché pour types 1, 2, 3 (géré par JS - voir form.js) #}
            <li class='row' id='field-analyseDeRisque' style='display:none;'>
                <div class='left libelle col-md-3'>{{ form_label(form.analyseDeRisque) }}</div>
                <div class='right form col-md-9'>
                    {{ form_widget(form.analyseDeRisque) }}
                    {{ form_errors(form.analyseDeRisque) }}
                </div>
            </li>

            <li class='row' id='field-observations'>
                <div class='left libelle col-md-3'>{{ form_label(form.observations) }}</div>
                <div class='right form col-md-9'>
                    {{ form_widget(form.observations) }}
                    {{ form_errors(form.observations) }}
                </div>
            </li>

            {{ include('components/date_field_with_today.html.twig', {form_field: form.datePrefecture}) }}
            {{ include('components/date_field_with_today.html.twig', {form_field: form.dateReponse}) }}
            {{ include('components/date_field_with_today.html.twig', {form_field: form.dateSignature}) }}

            <li class='row' id='field-dateTransfertCommission'>
                <div class='left libelle col-md-3'>{{ form_label(form.dateTransfertCommission) }}</div>
                <div class='right form col-md-9'>
                    {{ form_widget(form.dateTransfertCommission) }}
                    {{ form_errors(form.dateTransfertCommission) }}
                </div>
            </li>

            <li class='row' id='field-dateReceptionCommission'>
                <div class='left libelle col-md-3'>{{ form_label(form.dateReceptionCommission) }}</div>
                <div class='right form col-md-9'>
                    {{ form_widget(form.dateReceptionCommission) }}
                    {{ form_errors(form.dateReceptionCommission) }}
                </div>
            </li>

            <li class='row' id='field-dateReunion'>
                <div class='left libelle col-md-3'>{{ form_label(form.dateReunion) }}</div>
                <div class='right form col-md-9'>
                    {{ form_widget(form.dateReunion) }}
                    {{ form_errors(form.dateReunion) }}
                </div>
            </li>

            <li class='row' id='field-chargeSecurite'>
                <div class='left libelle col-md-3'>{{ form_label(form.chargeSecurite) }}</div>
                <div class='right form col-md-9'>
                    {{ form_widget(form.chargeSecurite) }}
                    {{ form_errors(form.chargeSecurite) }}
                </div>
            </li>

            {# Champs spécifiques interventions (natures 37, 38, 39) #}
            <li class='row' id='field-operationSdis'>
                <div class='left libelle col-md-3'></div>
                <div class='right form col-md-9'>
                    <div class='form-check'>
                        {{ form_widget(form.operationSdis) }}
                        {{ form_label(form.operationSdis) }}
                        {{ form_errors(form.operationSdis) }}
                    </div>
                </div>
            </li>

            <li class='row' id='field-rcci'>
                <div class='left libelle col-md-3'></div>
                <div class='right form col-md-9'>
                    <div class='form-check'>
                        {{ form_widget(form.rcci) }}
                        {{ form_label(form.rcci) }}
                        {{ form_errors(form.rcci) }}
                    </div>
                </div>
            </li>

            <li class='row' id='field-rex'>
                <div class='left libelle col-md-3'>{{ form_label(form.rex) }}</div>
                <div class='right form col-md-9'>
                    {{ form_widget(form.rex) }}
                    {{ form_errors(form.rex) }}
                </div>
            </li>

            <li class='row' id='field-numeroIntervention'>
                <div class='left libelle col-md-3'>{{ form_label(form.numeroIntervention) }}</div>
                <div class='right form col-md-9'>
                    {{ form_widget(form.numeroIntervention) }}
                    {{ form_errors(form.numeroIntervention) }}
                </div>
            </li>

            <li class='row' id='field-dateIntervention'>
                <div class='left libelle col-md-3'>{{ form_label(form.dateIntervention) }}</div>
                <div class='right form col-md-9'>
                    {{ form_widget(form.dateIntervention) }}
                    {{ form_errors(form.dateIntervention) }}
                </div>
            </li>

            <li class='row' id='field-dureeIntervention'>
                <div class='left libelle col-md-3'>{{ form_label(form.dureeIntervention) }}</div>
                <div class='right form col-md-9'>
                    {{ form_widget(form.dureeIntervention) }}
                    {{ form_errors(form.dureeIntervention) }}
                </div>
            </li>

            <li class='row' id='field-preventionnistes'>
                <div class='left libelle col-md-3'>{{ form_label(form.preventionnistes) }}</div>
                <div class='right form col-md-9'>
                    {{ form_widget(form.preventionnistes) }}
                    {{ form_errors(form.preventionnistes) }}
                </div>
            </li>
        </ul>
    </section>

    {# Les champs non rendus explicitement seront affichés ici (hidden, csrf, etc.) #}
    {{ form_rest(form) }}

    <div class='form-actions'>
        <button type='submit' class='btn btn-success'>
            <i class='glyphicon glyphicon-ok'></i> Enregistrer
        </button>
        <a href="{{ path('dossier_index', {id: dossier.id}) }}" class='btn btn-default'>
            <i class='glyphicon glyphicon-remove'></i> Annuler
        </a>
    </div>

    {{ form_end(form) }}
</div>
{% endblock %}
