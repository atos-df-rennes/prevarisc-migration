                            $("#AVIS_COMMISSION").hide();
                            $("#DATECOMM").hide();
                        } else if (absquorum || npsp) {
                            $("#AVIS_COMMISSION").hide();
                            $("#DATECOMM").hide();
                        }
                        if (type == 2 || type == 3) {
                            if ($("#AVIS_DOSSIER_COMMISSION").val() == 2) {
                                $("#FACTDANGE").show();
                                $("#ECHEANCIERTRAV").show();
                            }
                            $("#ANOMALIE").show();
                        } else if (type == 1) {
                            if ($("#selectNature").val() == 19 && $("#AVIS_DOSSIER_COMMISSION").val() == 2) {
                                $("#FACTDANGE").show();
                            }
