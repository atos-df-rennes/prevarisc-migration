{% extends 'layouts/dossier.html.twig' %}

{% block title %}Dossier / Édition{% endblock %} 

{% block body %}
    <div>
        <div class='pull-right'>
            <div class="btn-group">
                <a class="btn btn-primary" href="{{ path('dossier_index', {'id': idDossier}) }}">Annuler la modification</a>  {# A voir mettre un id de button pour le javascript #}
                <button id='validModification' type='submit' class="btn btn-success" >Sauvegarder</button>
            </div>
        </div>
        <div>
            <input type='hidden' name='idDossier' id='idDossier' value='{{idDossier}}' />
            <input type='hidden' name='genreInfo' id='genreInfo' value='{{genre}}' />
            <input type="hidden" id="dateToday" value="{{ "now"|date("d/m/Y") }}">


            <h3 class="text-bold">Informations générales</h3>
            {% if platauConsultation is not null and platauConsultation.id is not null %}
                {% include 'dossier/_platau_infos.html.twig' %}
            {% endif %}
            <h4 class="text-bold h4_subtitle">Type et nature du dossier</h4>
            <ul class="list-unstyled">
                <li class="row" style="margin-bottom: 20px;" id="type">
                    <div class="col-sm-3" style="float: left;">Type</div>
                    <div class="col-sm-3">
                        <select name="TYPE_DOSSIER" id="TYPE_DOSSIER"  class="form-control">
                            <option value="0">Sélectionnez un type</option>
                            {% for value in typesDossier %}
                                <option value="{{ value.id}}"
                                    {% if dossierType.id == value.id %}selected{% endif %}>
                                    {{ value.libelle }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                </li>
                <li class="row" style="margin-bottom: 20px;" id="nature">
                    <div class="col-sm-3 libelle">Nature</div>
                    <div class="col-sm-3 form">
                        <select name="selectNature" id="selectNature" class="form-control">
                            <option value="0">Sélectionnez une nature</option>

                            {% for nature in dossierNatureListe %}
                                <option value="{{ nature.id }}"
                                    {% if nature.id == dossierNature.id %}selected{% endif %}>
                                    {{ nature.libelle }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    <div id="loading" class="col-sm-1" style="display: none;">
                        <img src="/images/load.gif" alt="loading">
                    </div>
                </li>
            </ul>
            {% include 'dossier/_infos_dossier_edit.html.twig' %}
        </div>

    </div>


{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/calendrier/afficheCalendar.js') }}"></script>
    <script src="{{ asset('js/calendrier/gestionCalendar.js') }}"></script>
    <script>

        // Fonctions
        function showCalendar() {
            if ($('#COMMISSION_DOSSIER').val() != '') {
                $('.showCalendar').show();
            }
        };
        function ValidateDate(dateValue) {
            var date_temp = dateValue.split('/');
            if (date_temp[2] && date_temp[1] > 0 && date_temp[1] <= 12 && date_temp[0] > 0 && date_temp[0] <= 31) {
                return true;
            }

            return false;
        }

        function verifDossier() {
            // On ne vérifie pas l'objet dans les cas suivants :
            // visite périodique (21 et 26)
            // arrêté > ouverture (40)
            var nature = $("#selectNature").val();
            if (nature != 21 && nature != 26 && nature != 40 && nature != 41 && nature != 42 && nature != 44) {
                if ($("#OBJET_DOSSIER").val() == '') {
                    $("#OBJET_DOSSIER").focus();
                    $("#OBJET_DOSSIER").css("border-color", "red");
                    return false;
                }
            }

            if ($(".docManquant").val() == '') {
                $(".docManquant").focus();
                $(".docManquant").css("border-color", "red");
                return false;
            }

            if ($("#dateDocManquant_1").val() == '') {
                $("#dateDocManquant_1").focus();
                $("#dateDocManquant_1").css("border-color", "red");
                return false;
            }

            if ($("#DATEINSERT_INPUT").val() == '') {
                $("#DATEINSERT_INPUT").next(".today").click();
                return true;
            } else {
                var valeurDATE = ValidateDate($("#DATEINSERT_INPUT").val());
                if (!valeurDATE) {
                    $("#DATEINSERT_INPUT").focus();
                    $("#DATEINSERT_INPUT").css("border-color", "red");
                    return false;
                } else {
                    return true;
                }
            }
        }

        function isDossierPlatau() {
            return $('.dossier__identifiant-platau').length === 1
        }

        function afficheInfosPlatau(parentRow) {
            $.ajax({
                url: Routing.generate('display_pj_platau'), // Symfony route
                method: 'POST',
                data: {
                    idDossier: $('#idDossier').val()
                },
                success: function(data) {
                    if (data.trim() !== '') {
                        parentRow.after(data);
                        $('.label.label-warning').removeClass('ui-helper-hidden');
                    }
                },
                error: function() {
                    console.error('Erreur lors du chargement des pièces jointes.');
                }
            });
        }


        function masqueInfosPlatau() {
            $('#PIECESJOINTES').remove();
            $('.label.label-warning').addClass('ui-helper-hidden');
        }

        function gestionAffichageInfosPlatau() {
            $('.incomplet').live('click.platau', function() {
                afficheInfosPlatau($('#INCOMPLET'));
            });
            $('.cancelIncomplet').live('click.platau', function() {
                masqueInfosPlatau();
            });
            $('#AVIS_DOSSIER_COMMISSION').on('change.platau', function() {
                const avis = $('#AVIS_DOSSIER_COMMISSION').val();
                const infosPlatauExists = !!document.getElementById('PIECESJOINTES');

                if (avis !== '0') {
                    if (!infosPlatauExists) {
                        afficheInfosPlatau($('#AVIS_COMMISSION'));
                    }
                } else {
                    masqueInfosPlatau();
                }
            });
            $('#select-platau').live('click.platau', function(e) {
                e.preventDefault();
                document.getElementById('PIECESJOINTES').scrollIntoView();
                $('#PIECESJOINTES').focus();
            });

            if ($('#statut-pec').hasClass('text-warning')) {
                afficheInfosPlatau($('#INCOMPLET'));
            }
            if ($('#statut-avis').hasClass('text-warning')) {
                afficheInfosPlatau($('#AVIS_COMMISSION'));
            }
        }

        function gestionMasquageInfosPlatau() {
            $('.incomplet').die('click.platau');
            $('.cancelIncomplet').die('click.platau');
            $('#AVIS_DOSSIER_COMMISSION').die('change.platau');
            $('#select-platau').die('click.platau');
        }

        function majAvisSelect() {
            var genre = $('#genreInfo').val();
            //etablissement
            var typeDossier = $("#TYPE_DOSSIER").val();
            var natureDossier = $("#selectNature").val();
            var addText = "";

            if (typeDossier == 1) {
                //etude
                if (natureDossier == 19 || natureDossier == 7 || natureDossier == 17 || natureDossier == 16) {
                    //levée reserve et avis différé
                    addText = " à l'exploitation";
                } else {
                    addText = " à l'étude";
                }
            } else if (typeDossier == 2 || typeDossier == 3) {
                if (natureDossier == 20 || natureDossier == 25) {
                    addText = " à la réception des travaux";
                } else if (natureDossier == 21 || natureDossier == 23 || natureDossier == 24 || natureDossier == 26 ||
                    natureDossier == 28 || natureDossier == 29) {
                    if (genre == '2') {
                        addText = " à l'exploitation";
                    }
                } else {
                    addText = " à l'exploitation";
                }
            }

            $("#AVIS_DOSSIER option").each(function() {
                if ($(this).val() != 0) {
                    if ($(this).val() == 1) {
                        var text = "Favorable";
                    } else {
                        var text = "Défavorable";
                    }
                    $(this).text(text + addText);
                }
            });

            $("#AVIS_DOSSIER_COMMISSION option").each(function() {
                if ($(this).val() != 0) {
                    if ($(this).val() == 1) {
                        var text = "Favorable";
                    } else {
                        var text = "Défavorable";
                    }
                    $(this).text(text + addText);
                }
            });       
        }


        // Document ready : initialisations et événements
        $(document).ready(function() {
            showCalendar();
            majAvisSelect();

            //Fonction qui retourne la liste des natures sélectionnées ((((Attention ??))))
            $.fn.recupNatures = function() {
                var listeIdNature = "";
                var compteur = 1;
                var idNature;
                $("#listeNature > .nature  input[name='natureId[]']").each(function() {
                    var idSplit = $(this).attr('id').split('_');
                    if (compteur == 1) {
                        listeIdNature += idSplit[1];
                    } else {
                        listeIdNature += "_" + idSplit[1];
                    }
                    compteur++;
                });
                return listeIdNature;
            };

            //Cache les natures de la liste          ((((Attention ??))))
            $.fn.cacherNatureDuSelect = function(listeNatures) {
                //Dans le cas d'une édition on cache dans le select des natures ceux qui sont déjà présentes
                var tabNature = listeNatures.split('_');
                if (tabNature.length > 0) {
                    $("#selectNature [value=0]").text("Ajouter une nature supplémentaire");
                }
                for (var i = 0; i < tabNature.length; i++) {
                    $("#selectNature [value=" + tabNature[i] + "]").hide();
                }
            };

/*
            //Affichage des champs en fonction des natures
