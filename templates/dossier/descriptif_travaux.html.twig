{% extends 'layouts/dossier.html.twig' %}

{% block title %}{{ parent() }} / {% endblock %}

{% block body %}
    <div id='dossierInfos'>
        <h3 float='left' >
            Descriptif
            {% if dossier.nature.id is not null and dossier.nature.id != 19 %}
                des travaux
            {% endif %}
        </h3>

        <!-- Boutons -->
        <div float='right' >
            <div id='boutons' style='float: right'>
                <a href="{{ path('dossier_descriptif_edit', {id: dossier.id}) }}" id='modificationDossier' class='btn btn-default {% if dossier.verrou %}hidden{% endif %}'><span class="glyphicon glyphicon-pencil" aria-hidden="true"></span>&nbsp;Modifier</a>
                <div id='chargement'></div>
            </div>
        </div>

        <br class='clear' />
        <div class="lecture">
            <p>
                {% if dossier.descriptif is not null %}
                    {{ dossier.descriptif|nl2br }}
                {% else %}
                    Aucun descriptif disponible pour ce dossier.
                {% endif %}
            </p>
        </div>

    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

{% endblock %}
