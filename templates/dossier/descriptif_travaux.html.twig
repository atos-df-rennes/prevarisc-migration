{% extends 'layouts/dossier.html.twig' %}

{% block title %}
    {{ parent() }} / Descriptif {% if dossier.nature.id in constant('App\\Constant\\DossierNature::NATURES_DESCRIPTIF_TRAVAUX') %}des travaux{% endif %}
{% endblock %}

{% block body %}
    <div>
        <h3>
            Descriptif
            {% if dossier.nature.id in constant('App\\Constant\\DossierNature::NATURES_DESCRIPTIF_TRAVAUX') %}
                des travaux
            {% endif %}
        </h3>

        <div class="pull-right">
            <a href="{{ path('dossier_descriptif_edit', {id: dossier.id}) }}" class='btn btn-default {% if dossier.verrou %}hidden{% endif %}'>
                <span class="glyphicon glyphicon-pencil" aria-hidden="true"></span> Modifier
            </a>
        </div>

        <div class='clearfix'></div>

        <p>
            {% if dossier.descriptif is not null %}
                {{ dossier.descriptif|nl2br }}
            {% else %}
                Aucun descriptif disponible pour ce dossier.
            {% endif %}
        </p>
    </div>
{% endblock %}
