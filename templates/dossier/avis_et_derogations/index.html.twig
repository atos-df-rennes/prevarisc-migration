{% extends 'layouts/dossier.html.twig' %}

{% block title %}{{ parent() }} / Avis et dérogations{% endblock %}

{% block body %}
    <h3>Avis et dérogations</h3>

    {% if not dossier.verrou %}
    <form class="form-horizontal col-md-8" method="post">
        {{ include('dossier/avis_et_derogations/_form.html.twig', {
            dossier: dossier,
            listeAvis: listeAvis,
            dossiersGroupes: dossiersGroupes,
            avisDerogation: null,
            submitLabel: "Ajouter l'avis",
        }) }}
        <div class="form-group">
            <div class="col-md-offset-3 col-md-9">
                <button type="submit" class="btn btn-success js-submit-label">Ajouter l'avis</button>
            </div>
        </div>
    </form>
    {% endif %}

    <div class="clearfix"></div>

    <div class="row">
        {% for avis_derogation in arrayAvisDerogations %}
            <div class="col-md-6">
                {{ include('dossier/avis_et_derogations/_card.html.twig', {
                    avisDerogation: avis_derogation,
                    dossier: dossier,
                }) }}
            </div>
        {% endfor %}
    </div>

    {# Modale de confirmation de suppression #}
    <div id="modal-suppr-avis-derogation" class="modal fade" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Fermer">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    <h3>Suppression d'un avis ou d'une dérogation</h3>
                </div>
                <div class="modal-body">
                    <p>Vous êtes sur le point de supprimer l'avis ou la dérogation
                        "<strong id="modal-suppr-titre"></strong>".
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Annuler</button>
                    <button type="button" class="btn btn-danger" id="modal-suppr-confirmer">Supprimer</button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/dossier/avisDerogation-bs3.js') }}"></script>
    <script>
        $(document).on('click', '.js-delete-avis-derogation', function () {
            const card = $(this).closest('.js-card-avis-derogation');
            const titre = card.data('titre');
            const deleteUrl = card.data('delete-url');
            const csrfToken = card.data('csrf-token');

            $('#modal-suppr-titre').text(titre);

            $('#modal-suppr-confirmer').off('click').on('click', function () {
                $.ajax({
                    type: 'POST',
                    url: deleteUrl,
                    data: { _token: csrfToken },
                    success: function () {
                        card.closest('.col-md-6').remove();
                        $('#modal-suppr-avis-derogation').modal('hide');
                        $.toast.success("L'avis ou la dérogation a été supprimé(e) avec succès.");
                    },
                    error: function () {
                        $('#modal-suppr-avis-derogation').modal('hide');
                        $.toast.error('Erreur lors de la suppression. Veuillez réessayer.');
                    }
                });
            });

            $('#modal-suppr-avis-derogation').modal('show');
        });
    </script>
{% endblock %}
