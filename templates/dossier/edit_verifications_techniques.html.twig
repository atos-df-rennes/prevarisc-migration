{% extends 'layouts/dossier.html.twig' %}

{% import 'components/_formulaire_personnalise_edit.html.twig' as editForms %}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('css/formulaire-bs3/descriptif.css') }}" rel="stylesheet" />
    <link href="{{ asset('css/formulaire-bs3/edit-table.css') }}" rel="stylesheet" />
    <link href="{{ asset('css/formulaire-bs3/formulaire.css') }}" rel="stylesheet" />
{% endblock %}

{% set nom_capsule = capsule ? capsule.nom : 'Vérifications Techniques' %}

{% block title %}{{ parent() }} / Modifier les {{ nom_capsule|lower }}{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/formulaire/tableau/gestionTableau.js') }}"></script>
    <script src="{{ asset('js/formulaire/descriptif/edit.js') }}"></script>
    <script src="{{ asset('js/calendrier/today.js') }}"></script>
{% endblock %}

{% block body %}
    {{ editForms.form(
        rubriques,
        path('dossier_verifications_techniques_edit', {id: dossier.id}),
        'edit_verifications_techniques_' ~ dossier.id,
        capsule,
    ) }}
{% endblock %}
