{% extends 'layouts/dossier.html.twig' %}
{% import 'dossier/_macros_reprise_dossier.html.twig' as reprise %}

{% block title %}{{ parent() }} / Ajouter un dossier lié{% endblock %}

{% block body %}
    <h3>Ajouter un dossier lié</h3>

    <a href="{{ path('dossier_liees', {id: dossier.id}) }}" class="btn btn-default mb-3">
        <span class="glyphicon glyphicon-arrow-left" aria-hidden="true"></span>
        Retour aux liaisons
    </a>

    {% if grouped is empty %}
        <div class="alert alert-info">
            <p>Aucun dossier disponible à lier.</p>
            <p class="mb-0">
                Tous les dossiers des établissements associés sont déjà liés, ou ce dossier
                n'est associé à aucun établissement.
            </p>
        </div>
    {% else %}
        {{ form_start(form, {attr: {method: 'post', action: path('dossier_liees_doss', {id: dossier.id})}}) }}
        {{ form_errors(form) }}

        <div class="form-group clearfix">
            <button type="submit" class="btn btn-success pull-right">
                <span class="glyphicon glyphicon-ok" aria-hidden="true"></span>
                Enregistrer les liaisons
            </button>
            <a href="{{ path('dossier_liees', {id: dossier.id}) }}" class="btn btn-default pull-right mr-2">
                Annuler
            </a>
        </div>

        {% set field_name = form.dossiersToAdd.vars.full_name ~ '[]' %}
        {% for group in grouped %}
            {% set etab = group.etablissement %}
            {% set info = etab.latestInformations %}
            <h4>{{ info ? info.libelle : '(établissement sans nom)' }}</h4>

            {{ reprise.groupe('Visite(s)', group.visites, true, 'checkbox', field_name) }}
            {{ reprise.groupe('Étude(s)', group.etudes, group.visites is empty, 'checkbox', field_name) }}
            {{ reprise.groupe('Autre(s)', group.autres, group.visites is empty and group.etudes is empty, 'checkbox', field_name) }}
        {% endfor %}

        <div class="form-group clearfix mt-3">
            <button type="submit" class="btn btn-success pull-right">
                <span class="glyphicon glyphicon-ok" aria-hidden="true"></span>
                Enregistrer les liaisons
            </button>
            <a href="{{ path('dossier_liees', {id: dossier.id}) }}" class="btn btn-default pull-right mr-2">
                Annuler
            </a>
        </div>

        {{ form_end(form) }}
    {% endif %}
{% endblock %}

