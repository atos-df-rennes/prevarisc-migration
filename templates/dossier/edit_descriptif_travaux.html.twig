{% extends 'layouts/dossier.html.twig' %}

{% block title %}{{ parent() }} / {% endblock %}

{% block body %}
    <div id='dossierInfos'>
        <h3 float='left' >
            Descriptif
            {% if dossier.nature.id is not null and dossier.nature.id != 19 %}
                des travaux
            {% endif %}
        </h3>

        {{ form_start(form) }}
        <!-- Boutons -->
        <div id='boutons' class='dossier-descriptif-buttons'>
            <div class="form-group">
                <button type="submit" class="btn btn-success">
                    <span class="glyphicon glyphicon-ok"></span> Sauvegarder
                </button>
            </div>
            <div class="form-group">
                <a href="{{ path('dossier_descriptif', {id: dossier.id}) }}" class="btn btn-default">Annuler</a>
            </div>
        </div>

        <br class='clear' />

        {{ form_row(form.descriptif) }}
        {{ form_end(form) }}
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

{% endblock %}
