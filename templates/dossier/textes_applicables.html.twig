{% extends 'layouts/dossier.html.twig' %}

{% block title %}
    {{ parent() }} / Textes applicables
{% endblock %}

{% block body %}
    <div class='action-buttons pull-right'>
        <a class='btn btn-default' href="{{ path('edit_dossier_textes_applicables', {id: dossier.id}) }}">Modifier les textes applicables</a>
    </div>

    <h3>Textes applicables</h3>

    {% if dossier.textesApplicables|length == 0 %}
        <div class='well well-large text-center'>
            <p class='lead'>Il n'y a pas de texte applicable.</p>
            <p><a href='{{ path('edit_dossier_textes_applicables', {id: dossier.id}) }}' class='btn btn-large'>Gérer les textes applicables</a></p>
        </div>
    {% else %}
        <div class='row-fluid'>
            {% for texte_applicable_type in textesApplicables %}
            <h4>{{ texte_applicable_type.titre }}</h4>
            <ul class='list-unstyled'>
                {% for texte_applicable in texte_applicable_type.textes %}
                <li>
                    <span class="glyphicon glyphicon-ok"></span> {{ texte_applicable }}
                </li>
                {% endfor %}
            </ul>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
