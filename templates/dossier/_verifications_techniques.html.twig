{% extends 'layouts/dossier.html.twig' %}

{% import 'components/_formulaire_personnalise.html.twig' as forms %}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('styles/formulaire-bs3/descriptif.css') }}" rel="stylesheet" />
{% endblock %}

{% set nom_capsule = capsule ? capsule.nom : 'Vérifications techniques' %}

{% block title %}{{ parent() }} / {{ nom_capsule }}{% endblock %}

{% block body %}
    <div class="pull-right">
        <a class="btn btn-default" href="{{ path('dossier_verifications_techniques_edit', {id: dossier.id}) }}">Modifier les {{ nom_capsule|lower }}</a>
    </div>

    <h3>{{ nom_capsule }}</h3>

    {% if rubriques is empty %}
        <p class="text-muted">
            <em>Aucune rubrique configurée. Contactez un administrateur Prevarisc.</em>
        </p>
    {% else %}
        {{ forms.rubriques(rubriques) }}
    {% endif %}
{% endblock %}
