{% extends 'layouts/dossier.html.twig' %}

{% import 'components/_formulaire_personnalise.html.twig' as forms %}

{% block title %}{{ parent() }} / Vérifications techniques{% endblock %}

{% block body %}
    <div class="pull-right">
        <a class="btn btn-default" href="/dossier/edit-verifications-techniques/id/{{ dossier.id }}">Modifier les vérifications techniques</a>
    </div>

    <h3>{{ capsule ? capsule.nom : 'Vérifications Techniques' }}</h3>

    {% if rubriques is empty %}
        <p class="text-muted">
            <em>Aucune rubrique configurée. Contactez un administrateur Prevarisc.</em>
        </p>
    {% else %}
        {{ forms.rubriques(rubriques) }}
    {% endif %}
{% endblock %}
