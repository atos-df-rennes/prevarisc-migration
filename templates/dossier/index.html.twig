{% extends 'base.html.twig' %}

{% block title %}Dossier / Informations générales{% endblock %}


{% block body %}
    <div class='page-header'>
    </div>
    <div>
        <a class="btn btn-default pull-right" id="modifierDossier" >Modifier le dossier</a>
        <h3 class="text-bold">Informations générales</h3>
        {% if platauConsultation is not null and platauConsultation.id is not null %}
            <h4 class="text-bold h4_subtitle">Informations sur Plat'AU</h4>
                <ul class="list-unstyled">
                    <li class="row" style="margin-bottom: 20px;" id="type">
                        <div class="col-sm-3" style='float:left;'> Identifiant de la consultation </div>
                        <div class="col-sm-9">
                            {{ platauConsultation.id }}
                        </div>
                    </li>

                    {% if ( platauConsultation.dateReponseAttendue is not null) %}
                    <li class="row" style="margin-bottom: 20px;" id="type">
                        <div class="col-sm-3" style='float:left;'> Temps restant pour une réponse </div>
                        <div class="col-sm-9">
                                <span class="{{couleurTempsRestant}}">{{ tempsRestant }}</span>
                        </div>
                    </li>
                    {% endif %}

                    <li class="row" style="margin-bottom: 20px;" id="type">
                        <div class="col-sm-3" style='float:left;'> Prise en compte métier </div>
                        <div class="col-sm-9">
                            {% if statutPec == pecEnErreur %}
                                <i class="glyphicon glyphicon-warning-sign"></i>                    
                            {% endif %}
                            <span id="statut-pec" class="{{ classPec }}">{{ statutLabelPec}}</span>
                                {% if platauConsultation.datePec %}
                                    le {{platauConsultation.datePec|format_date('full', locale='fr')}}
                                {% endif %}
                            {% if pecEnPriseEncompte == statutPec and platauConsultation.dateAvis == null %}
                                <a id="retry-export-pec" href="#" title="Renvoyer la prise en compte métier" data-id="{{platauConsultation.id}}">
                                    <i class='glyphicon glyphicon-repeat'></i>
                                </a>
                            {% endif %}
                        </div>
                    </li>
                    
                    <li class="row" style="margin-bottom: 20px;" id="type">
                        <div class="col-sm-3" style='float:left;'> Avis </div>
                        <div class="col-sm-9">
                            {% if statutAvis == avisEnErreur %}
                                <i class="glyphicon glyphicon-warning-sign"></i>                    
                            {% endif %}
                            <span id="statut-avis" class="{{ classAvis }}">{{ statutLabelAvis}}</span>
                            {% if platauConsultation.dateAvis  %}
                                le {{platauConsultation.dateAvis|format_date('full', locale='fr')}}
                            {% endif %}
                            {% if avisTraite == statutAvis %}
                                <a id="retry-export-avis" href="#" title="Renvoyer l'avis" data-id="{{platauConsultation.id}}">
                                    <i class='glyphicon glyphicon-repeat'></i>
                                </a>
                            {% endif %}                        
                        </div>
                    </li>
                </ul>
        {% endif %}

        <h4 class="text-bold h4_subtitle">Type et nature du dossier</h4>
        <ul class="list-unstyled">
            <li class="row" style="margin-bottom: 20px;" id="type">
                <div class="col-sm-3" style='float:left;'> Type </div>
                <div class="col-sm-9">
                    {{ libelleType }}
                </div>
            </li>

                <li class="row" style="margin-bottom: 20px;" id="nature" >
                    <div class="col-sm-3" style='float:left;'>Nature</div>
                    <div class="col-sm-9">
                            {{ nature}}
                    </div>
                    
                    <div id="loading" class="left span1" style="display:none;">
                        <img src="/images/load.gif" alt="loading" />
                    </div>
                </li>
        </ul>
        <h4  class="text-bold h4_subtitle">Informations sur le dossier</h4>
        <ul id="InfosDossier" class="list-unstyled" >
            <li  class="row" style="margin-bottom: 20px;" id="DATEINSERT">
                <div class="col-sm-3" style='float:left;' >Date de création du dossier</div>
                <div class="col-sm-9">
                    {{dateCreation|format_date('full', locale='fr')}} 
                    {% if createurDossier is not null and createurDossier.informations is not null %}
                        par : {{ createurDossier.informations.prenom }} {{ createurDossier.informations.nom }}
                    {% endif %}
                    {% if verrouDossier %}
                        - Verrouillé par : {{ verrouUserDossier.informations.prenom }} {{ verrouUserDossier.informations.nom }}
                    {% endif %}
                </div>
            </li>

            {% if objet != '' %}
            <li class="row" style="margin-bottom: 20px;" id="OBJET">
                <div class="col-sm-3" style='float:left;'>Objet</div>
                <div class="col-sm-9">
                    {{ objet  | nl2br }}
                </div>
            </li>
            {% endif %}

            {% if demandeur != '' %}
            <li class="row" style="margin-bottom: 20px;" id="DEMANDEUR">
                <div class="col-sm-3" style='float:left;'>Demandeur</div>
                 <div class="col-sm-9">
                    {{ demandeur }}
                </div>
            </li>
            {% endif %}

            {% if lieuReunion != '' %}
            <li class="row" style="margin-bottom: 20px;" id="LIEUREUNION">
                <div class="col-sm-3" style='float:left;'>Lieu réunion</div>
                <div class="col-sm-9">
                    {{ lieuReunion | nl2br }}
                </div>
            </li>
            {% endif %}

            {% if numDocurba is not empty %}
             <li class="row" style="margin-bottom: 20px;" id="NUMDOCURBA">
                <div class="col-sm-3" style='float:left;'>Numéro document d'urbanisme</div>
                <div class="col-sm-9">
                    <div id="listeDocUrba">
                        {% for docurba in numDocurba %}
                            <div class="docurba">
                                {{ docurba.numDocurba }}
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </li>
            {% endif %}

            {% if dateMairie is not null  %}
            <li class="row" style="margin-bottom: 20px;"  id="DATEMAIRIE">
                <div class="col-sm-3" style='float:left;'>Date réception mairie</div>
                <div class="col-sm-9">
                    {{dateMairie|format_date('full', locale='fr')}}
                </div>
            </li>
            {% endif %}


            {% if dateSecretariat is not null  %}
            <li class="row" style="margin-bottom: 20px;"  id="DATESECRETARIAT">
                <div class="col-sm-3" style='float:left;'>Date réception secrétariat commission</div>
                <div class="col-sm-9">
                    {{dateSecretariat|format_date('full', locale='fr')}}
                </div>
            </li>
            {% endif %}


            {% if dateEnvoiTransit is not null  %}
            <li class="row" style="margin-bottom: 20px;" id="DATEENVTRANSIT">
                <div class="col-sm-3" style='float:left;'>Date d'envoi/transit</div>
                <div class="col-sm-9">
                    {{dateEnvoiTransit|format_date('full', locale='fr')}}
                </div>
            </li>
            {% endif %}


            {% if dateSDIS is not null  %}
            <li class="row" style="margin-bottom: 20px;"  id="DATESDIS">
                <div class="col-sm-3" style='float:left;'>Date de réception SDIS</div>
                <div class="col-sm-9">
                    {{dateSDIS|format_date('full', locale='fr')}}
                </div>
            </li>
            {% endif %}


            {% if serviceInstructeur is not empty and serviceInstructeur != '0'  %}
            <li class="row" style="margin-bottom: 20px;" id="SERVICEINSTRUC">
                <div class="col-sm-3" style='float:left;'>Service instructeur</div>
                <div class="col-sm-9">
                    {{ serviceInstructeur }}
                </div>
            </li>
            {% endif %}

           {% if commissionDossier is not null and commissionDossier.id != 0 %}
            <li class="row" style="margin-bottom: 20px;" id="COMMISSION">
                <div class="col-sm-3" style="float:left;">Commission concernée</div>
                <div class="col-sm-9">
                    {{ commissionDossier.libelle }} {% if typeCommissionDossier is not null  %} ({{ typeCommissionDossier.libelle}}) {% endif %}

                </div>
            </li>
            {% endif %}



            {% if dateVisite is not null  %}
            <li class="row" style="margin-bottom: 20px;"  id="DATEVISITE">
                <div class="col-sm-3" style='float:left;'>Date de visite</div>
                <div class="col-sm-9">
                    {{dateVisite|format_date('full', locale='fr')}}
                </div>
            </li>
            {% endif %}


            {% if dateRVRAT is not null  %}
            <li class="row" style="margin-bottom: 20px;" id="DATERVRAT">
                <div class="col-sm-3" style='float:left;'>Date de réception du RVRAT et attestation solidité et MO</div>
                <div class="col-sm-9">
                    {{dateRVRAT|format_date('full', locale='fr')}}
            </li>
            {% endif %}

            {% if dateCommission is not null and horsDelai == 0 %}
            <li class="row" style="margin-bottom: 20px;" id="DATECOMM">
                <div class="col-sm-3" style='float:left;'>Date de commission en salle</div>
                <div class="col-sm-9">
                    {{dateCommission|format_date('full', locale='fr')}}
                    {% if dateCommissionDossier != "" %}
                        &nbsp;&nbsp;
                        <a href="/calendrier-des-commissions/gestionodj/dateCommId/{{ dateCommissionDossier }}" title="Afficher ordre du jour">
                            <span class="glyphicon glyphicon-calendar" style="color: black;" aria-hidden="true"></span>
                        </a>
                    {% endif %}
                </div>
            </li>
            {% endif %}


            {% if descriptifAnalyseRisque is not null %}
            <li class="row" style="margin-bottom: 20px;" id="DESCANAL">
                <div class="col-sm-3" style='float:left;'>Descriptif analyse de risque</div>
                <div class="col-sm-9">
                    {{ descriptifAnalyseRisque }}
                </div>
            </li>
            {% endif %}

            {% if reglesADeroger is not empty %}
            <li class="row" style="margin-bottom: 20px;" id="REGLEDEROG">
                <div class="col-sm-3" style='float:left;'>Règles auxquelles il est demandé de déroger</div>
                <div class="col-sm-9">
                    {{ reglesADeroger | nl2br }}
                </div>
            </li>
            {% endif %}

            {% if justificatifDerogation is not empty %}
            <li class="row" style="margin-bottom: 20px;" id="JUSTIFDEROG">
                <div class="col-sm-3" style='float:left;'>Justification de la dérogation</div>
                <div class="col-sm-9">
                    {{ justificatifDerogation }}
                </div>
            </li>
            {% endif %}

            {% if mesuresCompensatoires is not empty %}
            <li class="row" style="margin-bottom: 20px;" id="MESURESCOMPENS">
                <div class="col-sm-3" style='float:left;'>Mesures compensatoires proposées</div>
                <div class="col-sm-9">
                    {{ mesuresCompensatoires }}
                </div>
            </li>
            {% endif %}


            {% if mesuresComplementaires is not empty %}
             <li class="row" style="margin-bottom: 20px;" id="MESURESCOMPLE">
                <div class="col-sm-3" style='float:left;'>Mesures complémentaires à respecter</div>
                <div class="col-sm-9">
                    {{ mesuresComplementaires }}
                </div>
            </li>
            {% endif %}

            {% if etatDossier != 0 %}
                <li class="row" style="margin-bottom: 20px;" id="INCOMPLET">
                    <div class="col-sm-3" style='float:left;'>Etat dossier</div>
                    <div class="col-sm-9">
                        <div style="font-weight:bolder;">
                            {% if etatDossier == 0 %}
                                Complet
                            {% else %}
                                Incomplet
                            {% endif %}
                         </div>
                        {% if dossierDocManquant is not empty %}
                            <div style="margin-top:10px;">
                                {% for ue in dossierDocManquant %}
                                    <div style="margin-bottom: 10px;">
                                        <strong>Incomplet le {{ ue.dateDocsManquant|date("d/m/Y") }}</strong>
                                        <p>{{ ue.docManquant }}</p>
                                        {% if ue.dateReceptionDoc %}
                                            <span style="color:green;">Réception document(s) le {{ ue.dateReceptionDoc|date("d/m/Y") }}</span>
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                </li>
            {% endif %}

            {% if horsDelai != 0 %}
            <li class="row" style="margin-bottom: 20px;" id="HORSDELAI">
                <div class="col-sm-3" style='float:left;'>Hors délai</div>
                <div class="col-sm-9">
                    <input type="checkbox" name="HORSDELAI_DOSSIER" {% if horsDelai == 1 %}checked{% endif %} disabled>
                </div>
            </li>
            {% endif %}

            {% if differeAvis != 0 %}
            <li class="row" style="margin-bottom: 20px;" id="DIFFEREAVIS">
                <div class="col-sm-3" style='float:left;'>Differe l'avis</div>
                <div class="col-sm-9">
                    <input type="checkbox" name="DIFFEREAVIS_DOSSIER" {% if differeAvis == 1 %}checked{% endif %} disabled>
                </div>
            </li>
            {% endif %}

            {% if nonPrononce != 0 %}
            <li class="row" style="margin-bottom: 20px;"id="NPSP">
                <div class="col-sm-3" style='float:left;'>Ne peut se prononcer</div>
                <div class="col-sm-9">
                    <input type="checkbox" name="NPSP_DOSSIER" {% if nonPrononce == 1 %}checked{% endif %} disabled>
                </div>
            </li>
            {% endif %}

            {% if absenceQuorum != 0 %}
            <li class="row" style="margin-bottom: 20px;" id="ABSQUORUM">
                <div class="col-sm-3" style='float:left;'>Absence de quorum</div>
                 <div class="col-sm-9">
                    <input type="checkbox" name="ABSQUORUM_DOSSIER" {% if absenceQuorum == 1 %}checked{% endif %} disabled>
                </div>
            </li>
            {% endif %}

            {% if celluleNonExploitée != 0 %}
            <li class="row" style="margin-bottom: 20px;" id="CNE">
                <div class="col-sm-3" style='float:left;'>Cellule non exploitée</div>
                <div class="col-sm-9">
                    <input type="checkbox" name="CNE_DOSSIER" {% if celluleNonExploitée == 1 %}checked{% endif %} disabled>
                </div>
            </li>
            {% endif %}

            {% if avisDossier is not null and avisDossier != 0 and horsDelai != 1 %}
             <li class="row" style="margin-bottom: 20px;" id="AVIS">
                <div class="col-sm-3" style='float:left;'>
                    {% if idType in [1, 2] %}  Avis du rapporteur {% elseif idType == 3 %} Avis du groupe de visite {% endif %}
                </div>
                <div class="col-sm-9">
                    {% include 'dossier/_avis.html.twig' with {'avis': avisDossier, 'idType': idType, 'natureId': natureId} %}
                </div>
            </li>
            {% endif %}

            {% if delaiPrescription is not null %}
            <li class="row" style="margin-bottom: 20px;"  id="DELAIPRESC">
                <div class="col-sm-3" style='float:left;'>Date avant laquelle les prescriptions doivent être levées</div>
                <div class="col-sm-9">
                    {{delaiPrescription|format_date('full', locale='fr')}}
                </div>
            </li>
            {% endif %}

            {% if avisDossierCommission is not null and avisDossierCommission.id != 0 and affichageAvis == 0 %}
            <li class="row" style="margin-bottom: 20px;"  id="AVIS_COMMISSION">
                <div class="col-sm-3" style='float:left;'>Avis de la commission</div>
                <div class="col-sm-9">
                    {% include 'dossier/_avis.html.twig' with {'avis': avisDossierCommission, 'idType': idType, 'natureId': natureId} %}
                </div>
            </li>
            {% endif %}


            {% if facteurDanger is not null and ((isSignalement and avisDossier.id == 2) or facteurDanger > 0)  %}
            <li class="row" style="margin-bottom: 20px;" id="FACTDANGE">
                <div class="col-sm-3" style='float:left;'>Facteur de criticité</div>
                <div class="col-sm-9">
                    <span class="factDange">
                        {% if isSignalement %}
                            {% if facteurDanger == 0 %}
                                Non
                            {% else %}
                                Oui
                            {% endif %}
                        {% else %}
                            {{ facteurDanger }}
                        {% endif %}
                    </span>
               </div>
            </li>
            {% endif %}

            {% if echeancierTravaux is not null %}
            <li class="row" style="margin-bottom: 20px;"  id="ECHEANCIERTRAV">
                <div class="col-sm-3" style='float:left;'>Echéancier de travaux / Schéma de mise en sécurité</div>
                <div class="col-sm-9">
                    {{ echeancierTravaux }}
                </div>
            </li>
            {% endif %}

            {% if anomalie is not null %}
            <li class="row" style="margin-bottom: 20px;" id="ANOMALIE">
                <div class="col-sm-3" style='float:left;'>Analyse de risque</div>
                <div class="col-sm-9">
                    {{ anomalie | nl2br }}
                </div>
            </li>
            {% endif %}

             {% if observations is not empty %}
            <li class="row" style="margin-bottom: 20px;" id="OBSERVATION">
                <div class="col-sm-3" style='float:left;'>Observations</div>
                <div class="col-sm-9">
                    {{observations | nl2br }}
                </div>
            </li>
            {% endif %}

            {% if datePrefecture is not null %}
            <li class="row" style="margin-bottom: 20px;" id="DATEPREF">
                <div class="col-sm-3" style='float:left;'>Date réception préfecture</div>
                <div class="col-sm-9">
                    {{datePrefecture|format_date('full', locale='fr')}}
                </div>
            </li>
            {% endif %}

            {% if dateReponse is not null %}
            <li class="row" style="margin-bottom: 20px;"  id="DATEREP">
                <div class="col-sm-3" style='float:left;'>Date de réponse</div>
                <div class="col-sm-9">
                    {{dateReponse|format_date('full', locale='fr')}}
                </div>
            </li>
            {% endif %}


            {% if dateTransfertCommission is not null %}
            <li class="row" style="margin-bottom: 20px;" id="DATETRANSFERTCOMM">
                <div class="col-sm-3" style='float:left;'>Date de transfert à la commissions compétente</div>
                <div class="col-sm-9">
                    {{dateTransfertCommission|format_date('full', locale='fr')}}
            </li>
            {% endif %}

            {% if dateReceptionCommission is not null %}
            <li class="row" style="margin-bottom: 20px;" id="DATERECEPTIONCOMM">
                <div class="col-sm-3" style='float:left;'>Date de réception à la commissions compétente</div>
                <div class="col-sm-9">
                    {{dateReceptionCommission|format_date('full', locale='fr')}}
                </div>

            </li>
            {% endif %}

            {% if dateReunion is not null %}
            <li class="row" style="margin-bottom: 20px;" id="DATEREUN">
                <div class="col-sm-3" style='float:left;'>Date réunion</div>
                <div class="col-sm-9">
                    {{dateReunion|format_date('full', locale='fr')}}
                </div>
            </li>
            {% endif %}

            {% if operationSDIS is not empty %}
            <li class="row" style="margin-bottom: 20px;" id="OPERSDIS">
                <div class="col-sm-3" style='float:left;'>Opération (intervention) SDIS</div>
                <div class="col-sm-9">
                    {% if operationSDIS == 1 %}
                        oui
                    {% elseif operationSDIS == 0 %}
                        non
                    {% endif %}
                </div>
            </li>
            {% endif %}

            {% if RCCI is not empty %}
            <li class="row" style="margin-bottom: 20px;" id="RCCI">
                <div class="col-sm-3" style='float:left;'>RCCI (oui/non) lien rapport</div>
                <div class="col-sm-9">
                    {% if RCCI == 1 %}
                        oui
                    {% elseif RCCI == 0 %}
                        non
                    {% endif %}
                </div>
            </li>
            {% endif %}

            {% if REX is not empty %}
            <li class="row" style="margin-bottom: 20px;" id="REX">
                <div class="col-sm-3" style='float:left;'>REX</div>
                <div class="col-sm-9">
                    {{ REX }}
                </div>
            </li>
            {% endif %}
            
            {% if chargeSecurite is not empty %}
            <li class="row" style="margin-bottom: 20px;" id="CHARGESEC">
                <div class="col-sm-3" style='float:left;'>Chargé de sécurité (T)</div>
                <div class="col-sm-9">
                    {{ chargeSecurite }}
                </div>
            </li>
            {% endif %}

            {% if dureeDeplacement is not empty %}
            <li class="row" style="margin-bottom: 20px;" id="DUREEDEPL">
                <div class="col-sm-3" style='float:left;'>Durée de déplacement</div>
                <div class="col-sm-9">
                    {{dureeDeplacement}}
                </div>
            </li>
            {% endif %}

            {% if gravitePrescription is not empty %}            
            <li class="row" style="margin-bottom: 20px;" id="GRAVPRESC">
                <div class="col-sm-3" style='float:left;'>Gravité prescription</div>
                <div class="col-sm-9">
                    {{ gravitePrescription }}
                </div>
            </li>
            {% endif %}

            {% if numIntervention is not empty %}            
            <li class="row" style="margin-bottom: 20px;" id="NUMINTERV">
                <div class="col-sm-3" style='float:left;'>Numéro d'intervention</div>
                <div class="col-sm-9">
                    {{ numIntervention }}
                </div>
            </li>
            {% endif %}

            {% if dateIntervention is not null %}
            <li class="row" style="margin-bottom: 20px;"id="DATEINTERV">
                <div class="col-sm-3" style='float:left;'>Date et heure d'intervention</div>
                <div class="col-sm-9">
                    {{dateIntervention|format_date('full', locale='fr')}}
                    {% if heureIntervention is not null %}
                        {{ heureIntervention }}
                    {% endif %}
                </div>
            </li>
            {% endif %}

            {% if dureeIntervention is not null %}
            <li class="row" style="margin-bottom: 20px;"id="DUREEINTERV">
                <div class="col-sm-3" style='float:left;'>Durée intervention</div>
                <div class="col-sm-9">
                    {{dureeIntervention|format_date('full', locale='fr')}}
                </div>
            </li>
            {% endif %}

            {% if dateSignature is not null %}
            <li class="row" style="margin-bottom: 20px;"id="DATESIGN">
                <div class="col-sm-3" style='float:left;'>Date de signature</div>
                <div class="col-sm-9">
                    {{dateSignature|format_date('full', locale='fr')}}
                </div>
            </li>
            {% endif %}


            {% if preventionnisteDossier is not empty %}
            <li class="row" style="margin-bottom: 20px;"id="PREVENTIONNISTE">
                <div class="col-sm-3" style='float:left;'>Préventionniste(s) du dossier</div>
                <div class="col-sm-9">
                    {% for preventionniste in preventionnisteDossier %}
                        {% include 'utilisateurs/_user.html.twig' with { preventionniste: preventionniste } %}
                    {% endfor %}
                </div>   
            </li>
            {% endif %}            
        </ul>  
    </div>



{% endblock %}
