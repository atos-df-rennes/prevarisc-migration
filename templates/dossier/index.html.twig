{% extends 'layouts/dossier.html.twig' %}
{% import 'macros/dossier.html.twig' as dm %}

{% block title %}{{ parent() }} / Informations générales{% endblock %}

{% block body %}
    <div id='dossierInfos'>
        {% if not dossier.verrou %}
            <div class='pull-right'>
                <a class='btn btn-default' href="{{ path('dossier_edit', {id: dossier.id}) }}">Modifier le dossier</a>
            </div>
        {% endif %}

        <h3>Informations générales</h3>

        {% if platau is not null %}
            {# Informations Plat'AU #}
            {{ include('dossier/_platau_info.html.twig', {isEdit: false}) }}
        {% endif %}

        <section>
            <h4>Type et nature du dossier</h4>

            <ul class='list-unstyled'>
                <li class='row'>
                    <div class='left libelle col-md-3'>Type</div>
                    <div class='right value col-md-9'>
                        {{ dossier.type.libelle }}
                    </div>
                </li>

                {% if dossier.nature is not null %}
                    <li class='row'>
                        <div class='left libelle col-md-3'>Nature</div>
                        <div class='right value col-md-9'>
                            {{ dossier.nature.libelle }}
                        </div>
                    </li>
                {% endif %}
            </ul>
        </section>

        <section>
            <h4>Informations sur le dossier</h4>

            <ul class='list-unstyled'>
                {% if dossier|should_display_field('dateInsert') %}
                    <li class='row'>
                        <div class='left libelle col-md-3'>Date de création du dossier</div>
                        <div class='right value col-md-9'>
                            {{ dossier.dateInsert|date('d/m/Y') }}

                            {% if dossier.createur %}
                                par : {{ dossier.createur.informations.nom }} {{ dossier.createur.informations.prenom }}
                            {% endif %}
                        </div>
                    </li>
                {% endif %}

                {{ dm.champ_texte(dossier, 'objet', 'Objet', true) }}
                {{ dm.champ_texte(dossier, 'demandeur', 'Demandeur') }}
                {{ dm.champ_texte(dossier, 'lieuReunion', 'Lieu réunion', true) }}

                {% if dossier|should_display_field('documentsUrbanisme') and dossier.documentsUrbanisme is not empty %}
                    <li class="row">
                        <div class="left libelle col-md-3">Numéro(s) document(s) d'urbanisme</div>
                        <div class="right value col-md-9">
                            <ul id="documents-urbanisme" class="list-unstyled">
                                {% for document in dossier.documentsUrbanisme %}
                                    <li>{{ document.numero }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    </li>
                {% endif %}

                {{ dm.champ_date(dossier, 'dateMairie', 'Date de réception mairie') }}
                {{ dm.champ_date(dossier, 'dateSecretariat', 'Date de réception secrétariat SDIS') }}
                {{ dm.champ_date(dossier, 'dateEnvoiTransit', "Date d'envoi/transit") }}
                {{ dm.champ_date(dossier, 'dateReception', 'Date de réception SDIS') }}
                {{ dm.champ_texte(dossier, 'serviceInstructeur', 'Service instructeur') }}

                {% if dossier|should_display_field('commission') and dossier.commission %}
                    <li class='row'>
                        <div class='left libelle col-md-3'>Commission concernée</div>
                        <div class='right value col-md-9'>
                            {{ dossier.commission.libelle }} ({{ dossier.commission.type.libelle }})
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('dateVisite') and dossier.dateVisite %}
                    <li class='row'>
                        <div class='left libelle col-md-3'>Date de visite</div>
                        <div class='right value col-md-9'>
                            {{ dossier.dateVisite|date('d/m/Y') }}
                        </div>

                        {% if datesCommissionLiees|length > 0 %}
                            {{ include('dossier/_alert_dates_liees.html.twig', {datesLiees: datesCommissionLiees}) }}
                        {% endif %}
                    </li>
                {% endif %}

                {{ dm.champ_date(dossier, 'dateReceptionRvrat', 'Date de réception du RVRAT et attestation solidité et MO') }}

                {% if dossier|should_display_field('dateCommission') and dossier.dateCommission %}
                    <li class='row'>
                        <div class='left libelle col-md-3'>Date de commission en salle</div>
                        <div class='right value col-md-9'>
                            {{ dossier.dateCommission|date('d/m/Y') }}

                            {% if id_date_commission %}
                                <a class="ml-2" href="{{ path('calendrier_des_commissions_gestion_odj', {dateCommId: id_date_commission}) }}" title="Afficher l'ordre du jour">
                                    <span class='glyphicon glyphicon-calendar' aria-hidden="true"></span>
                                </a>
                            {% endif %}
                        </div>
                    </li>
                {% endif %}

                {{ dm.champ_texte(dossier, 'reglesDerogation', 'Règles auxquelles il est demandé de déroger', true) }}
                {{ dm.champ_texte(dossier, 'justificationDerogation', 'Justification de la dérogation', true) }}
                {{ dm.champ_texte(dossier, 'mesuresCompensatoires', 'Mesures compensatoires proposées', true) }}
                {{ dm.champ_texte(dossier, 'mesuresComplementaires', 'Mesures complémentaires à respecter', true) }}

                {% if dossier|should_display_field('incomplet') and dossier.incomplet is not null %}
                    <li class="row">
                        <div class="left libelle col-md-3">État du dossier</div>
                        <div class="right value col-md-9">
                            <strong>{{ dossier.incomplet ? 'Incomplet' : 'Complet' }}</strong>

                            {{ include('dossier/_documents_manquants.html.twig') }}
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('horsDelai') and dossier.horsDelai %}
                    <li class="row">
                        <div class="left libelle col-md-3">Hors délai</div>
                        <div class="right value col-md-9">Oui</div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('avisDiffere') and dossier.avisDiffere %}
                    <li class="row">
                        <div class="left libelle col-md-3">Diffère l'avis</div>
                        <div class="right value col-md-9">Oui</div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('nePeutSePrononcer') and dossier.nePeutSePrononcer %}
                    <li class="row">
                        <div class="left libelle col-md-3">Ne peut se prononcer</div>
                        <div class="right value col-md-9">Oui</div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('absenceDeQuorum') and dossier.absenceDeQuorum %}
                    <li class="row">
                        <div class="left libelle col-md-3">Absence de quorum</div>
                        <div class="right value col-md-9">Oui</div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('avis') and dossier.avis %}
                    <li class='row'>
                        <div class='left libelle col-md-3'>
                            Avis du {% if dossier.type.id == 3 %}groupe de visite{% else %}rapporteur{% endif %}
                        </div>
                        <div class='right value col-md-9'>
                            <span class='avis {{ dossier.avis.libelle[:1] }}'>
                                {{ dossier.avis.libelle }}

                                {{ include('dossier/_precision_libelle_avis.html.twig') }}
                            </span>
                        </div>
                    </li>
                {% endif %}

                {{ dm.champ_date(dossier, 'dateLimitePrescription', 'Date avant laquelle les prescriptions doivent être levées') }}

                {% if dossier|should_display_field('avisCommission') and dossier.avisCommission and afficher_avis %}
                    <li class='row'>
                        <div class='left libelle col-md-3'>Avis de la commission</div>
                        <div class='right value col-md-9'>
                            <span class='avis {{ dossier.avisCommission.libelle[:1] }}'>
                                {{ dossier.avisCommission.libelle }}

                                {{ include('dossier/_precision_libelle_avis.html.twig') }}
                            </span>
                        </div>
                    </li>
                {% endif %}

                {% if dossier.facteurDangerosite > 0 %}
                    <li class="row">
                        <div class="left libelle col-md-3">{{ facteur_criticite_custom_enabled ? 'Signalement' : 'Facteur de criticité' }}</div>
                        <div class="right value col-md-9">
                            {{ dossier.facteurDangerosite }}
                        </div>
                    </li>
                {% endif %}

                {% if dossier.echeancierTravaux %}
                    <li class="row">
                        <div class="left libelle col-md-3">Echéancier de travaux / Schéma de mise en sécurité</div>
                        <div class="right value col-md-9">
                            {{ dossier.echeancierTravaux|date('d/m/Y') }}
                        </div>
                    </li>
                {% endif %}

                {% if dossier.analyseDeRisque %}
                    <li class="row">
                        <div class="left libelle col-md-3">Analyse de risque</div>
                        <div class="right value col-md-9">
                            {{ dossier.analyseDeRisque|nl2br }}
                        </div>
                    </li>
                {% endif %}

                {{ dm.champ_texte(dossier, 'observations', libelle_dossier_observations_custom_enabled ? 'Observations introduction' : 'Observations', true) }}
                {{ dm.champ_date(dossier, 'datePrefecture', 'Date réception préfecture') }}
                {{ dm.champ_date(dossier, 'dateReponse', 'Date de réponse') }}
                {{ dm.champ_date(dossier, 'dateTransfertCommission', 'Date de transfert à la commission compétente') }}
                {{ dm.champ_date(dossier, 'dateReceptionCommission', 'Date de réception à la commission compétente') }}
                {{ dm.champ_date(dossier, 'dateReunion', 'Date réunion') }}

                {% if dossier|should_display_field('operationSdis') and dossier.operationSdis is not null %}
                    <li class="row">
                        <div class="left libelle col-md-3">Opération (intervention) SDIS</div>
                        <div class="right value col-md-9">
                            {{ dossier.operationSdis ? 'Oui' : 'Non' }}
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('rcci') and dossier.rcci is not null %}
                    <li class="row">
                        <div class="left libelle col-md-3">RCCI (oui/non) lien rapport</div>
                        <div class="right value col-md-9">
                            {{ dossier.rcci ? 'Oui' : 'Non' }}
                        </div>
                    </li>
                {% endif %}

                {{ dm.champ_texte(dossier, 'rex', 'REX', true) }}
                {{ dm.champ_texte(dossier, 'chargeSecurite', 'Chargé de sécurité (T)', true) }}
                {{ dm.champ_texte(dossier, 'numeroIntervention', "Numéro d'intervention") }}

                {% if dossier|should_display_field('dateIntervention') and dossier.dateIntervention %}
                    <li class="row">
                        <div class="left libelle col-md-3">Date et heure d'intervention</div>
                        <div class="right value col-md-9">
                            {{ dossier.dateIntervention|date('d/m/Y - H:i') }}
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('dureeIntervention') and dossier.dureeIntervention %}
                    <li class="row">
                        <div class="left libelle col-md-3">Durée intervention</div>
                        <div class="right value col-md-9">
                            {{ dossier.dureeIntervention|date('H:i') }}
                        </div>
                    </li>
                {% endif %}

                {{ dm.champ_date(dossier, 'dateSignature', 'Date de signature') }}

                {% if dossier|should_display_field('preventionnistes') and dossier.preventionnistes is not empty %}
                    <li class='row'>
                        <div class='left libelle col-md-3'>Préventionniste(s) du dossier</div>
                        <div class='right value col-md-9 thumbnail-container'>
                            {% for preventionniste in dossier.preventionnistes %}
                                {{ include('utilisateurs/_user_card.html.twig', {user: preventionniste}) }}
                            {% endfor %}
                        </div>
                    </li>
                {% endif %}
            </ul>
        </section>
    </div>

    <!-- Boite de confirmation de la suppression (cachée par défaut) -->
    <div id="confirm-modal" class="modal fade" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Fermer"><span aria-hidden="true">&times;</span></button>
                    <h3>Confirmation de la suppression</h3>
                </div>

                <div class="modal-body">
                    <p>Êtes-vous sûr de vouloir supprimer le dossier ? </p>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Annuler</button>
                    <form action="{{ path('dossier_supprimer', {id: dossier.id}) }}" method="POST" style="display:inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('dossier_suppression_' ~ dossier.id) }}">
                        <button type="submit" class="btn btn-danger">Supprimer le dossier</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    {{ include('alerte/modal.html.twig') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script type="text/javascript">
        $(document).ready(function() {
            // fenetre de confirmation de la suppression
            $("#suppressionDossier").click(function(e) {
                e.preventDefault()
                $('#confirm-modal').modal({show:true})
            })
        })
    </script>
{% endblock %}
