{% extends 'layouts/dossier.html.twig' %}

{% block title %}{{ parent() }} / Informations générales{% endblock %}

{% block body %}
    <div id='dossierInfos'>
        {% if not dossier.verrou %}
            <div class='pull-right'>
                <a class='btn btn-default' href="{{ path('dossier_edit', {id: dossier.id}) }}">Modifier le dossier</a>
            </div>
        {% endif %}

        <h3>Informations générales</h3>

        {% if platau is not null %}
            <section>
                <h4>Informations sur Plat'AU</h4>

                <ul class='list-unstyled'>
                    <li class='row'>
                        <div class='left libelle col-md-3'>Identifiant de la consultation</div>
                        <div class='right value col-md-9'>
                            {{ platau.identifiant }}
                        </div>
                    </li>

                    {% if platau.temps_restant is not null %}
                        <li class='row'>
                            <div class='left libelle col-md-3'>Temps restant pour une réponse</div>
                            <div class='right value col-md-9'>
                                <span class='label label-{{ platau.couleur_temps_restant }}'>
                                    {{ platau.temps_restant }}
                                </span>
                            </div>
                        </li>
                    {% endif %}

                    <li class='row'>
                        <div class='left libelle col-md-3'>Prise en compte métier</div>
                        <div class='right value col-md-9'>
                            {% include 'dossier/_platau_statut.html.twig' with {
                                'type': 'pec',
                                'statut': platau.statut_pec,
                                'date_pec': platau.date_pec,
                                'dossier_incomplet': dossier.incomplet
                            } %}
                        </div>
                    </li>

                    <li class='row'>
                        <div class='left libelle col-md-3'>Avis</div>
                        <div class='right value col-md-9'>
                            {% include 'dossier/_platau_statut.html.twig' with {
                                'type': 'avis',
                                'statut': platau.statut_avis,
                                'date_avis': platau.date_avis
                            } %}
                        </div>
                    </li>
                </ul>
            </section>
        {% endif %}

        <section>
            <h4>Type et nature du dossier</h4>

            <ul class='list-unstyled'>
                <li class='row'>
                    <div class='left libelle col-md-3'>Type</div>
                    <div class='right value col-md-9'>
                        {{ dossier.type.libelle }}
                    </div>
                </li>

                {% if dossier.nature is not null %}
                    <li class='row'>
                        <div class='left libelle col-md-3'>Nature</div>
                        <div class='right value col-md-9'>
                            <strong>{{ dossier.nature.libelle }}</strong>
                        </div>
                    </li>
                {% endif %}
            </ul>
        </section>

        <section>
            <h4>Informations sur le dossier</h4>

            <ul class='list-unstyled'>
                {% if dossier|should_display_field('DATEINSERT') %}
                    <li class='row'>
                        <div class='left libelle col-md-3'>Date de création du dossier</div>
                        <div class='right value col-md-9'>
                            {{ dossier.dateInsert|date('d/m/Y') }} par : {{ dossier.createur.informations.nom }} {{ dossier.createur.informations.prenom }}
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('OBJET') and dossier.objet %}
                    <li class='row'>
                        <div class='left libelle col-md-3'>Objet</div>
                        <div class='right value col-md-9'>
                            {{ dossier.objet|nl2br }}
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('DEMANDEUR') and dossier.demandeur %}
                    <li class="row">
                        <div class="left libelle col-md-3">Demandeur</div>
                        <div class="right value col-md-9">
                            {{ dossier.demandeur }}
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('LIEUREUNION') and dossier.lieuReunion %}
                    <li class="row">
                        <div class="left libelle col-md-3">Lieu réunion</div>
                        <div class="right value col-md-9">
                            {{ dossier.lieuReunion|nl2br }}
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('NUMDOCURBA') and dossier.documentsUrbanisme is not empty %}
                    <li class="row">
                        <div class="left libelle col-md-3">Numéro(s) document(s) d'urbanisme</div>
                        <div class="right value col-md-9">
                            <ul id="documents-urbanisme" class="list-unstyled">
                                {% for document in dossier.documentsUrbanisme %}
                                    <li>{{ document.numero }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('DATEMAIRIE') and dossier.dateMairie %}
                    <li class="row">
                        <div class="left libelle col-md-3">Date de réception mairie</div>
                        <div class="right value col-md-9">
                            {{ dossier.dateMairie|date('d/m/Y') }}
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('DATESECRETARIAT') and dossier.dateSecretariat %}
                    <li class="row">
                        <div class="left libelle col-md-3">Date de réception secrétariat SDIS</div>
                        <div class="right value col-md-9">
                            {{ dossier.dateSecretariat|date('d/m/Y') }}
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('DATEENVTRANSIT') and dossier.dateEnvoiTransit %}
                    <li class="row">
                        <div class="left libelle col-md-3">Date d'envoi/transit</div>
                        <div class="right value col-md-9">
                            {{ dossier.dateEnvoiTransit|date('d/m/Y') }}
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('DATESDIS') and dossier.dateReception %}
                    <li class="row">
                        <div class="left libelle col-md-3">Date de réception SDIS</div>
                        <div class="right value col-md-9">
                            {{ dossier.dateReception|date('d/m/Y') }}
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('SERVICEINSTRUC') and dossier.serviceInstructeur %}
                    <li class="row">
                        <div class="left libelle col-md-3">Service instructeur</div>
                        <div class="right value col-md-9">
                            {{ dossier.serviceInstructeur }}
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('COMMISSION') and dossier.commission %}
                    <li class='row'>
                        <div class='left libelle col-md-3'>Commission concernée</div>
                        <div class='right value col-md-9'>
                            {{ dossier.commission.libelle }} ({{ dossier.commission.type.libelle }})
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('DATEVISITE') and dossier.dateVisite %}
                    <li class='row'>
                        <div class='left libelle col-md-3'>Date de visite</div>
                        <div class='right value col-md-9'>
                            {{ dossier.dateVisite|date('d/m/Y') }}
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('DATERVRAT') and dossier.dateReceptionRvrat %}
                    <li class="row">
                        <div class="left libelle col-md-3">Date de réception du RVRAT et attestation solidité et MO</div>
                        <div class="right value col-md-9">
                            {{ dossier.dateReceptionRvrat|date('d/m/Y') }}
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('DATECOMM') and dossier.dateCommission %}
                    <li class='row'>
                        <div class='left libelle col-md-3'>Date de commission en salle</div>
                        <div class='right value col-md-9'>
                            {{ dossier.dateCommission|date('d/m/Y') }}

                            {% if id_date_commission %}
                                <a class="ml-2" href="{{ '/calendrier-des-commissions/gestionodj/dateCommId/' ~ id_date_commission }}" title="Afficher l'ordre du jour">
                                    <span class='glyphicon glyphicon-calendar' aria-hidden="true"></span>
                                </a>
                            {% endif %}
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('REGLEDEROG') and dossier.reglesDerogation %}
                    <li class="row">
                        <div class="left libelle col-md-3">Règles auxquelles il est demandé de déroger</div>
                        <div class="right value col-md-9">
                            {{ dossier.reglesDerogation|nl2br }}
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('JUSTIFDEROG') and dossier.justificationDerogation %}
                    <li class="row">
                        <div class="left libelle col-md-3">Justification de la dérogation</div>
                        <div class="right value col-md-9">
                            {{ dossier.justificationDerogation|nl2br }}
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('MESURESCOMPENS') and dossier.mesuresCompensatoires %}
                    <li class="row">
                        <div class="left libelle col-md-3">Mesures compensatoires proposées</div>
                        <div class="right value col-md-9">
                            {{ dossier.mesuresCompensatoires|nl2br }}
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('MESURESCOMPLE') and dossier.mesuresComplementaires %}
                    <li class="row">
                        <div class="left libelle col-md-3">Mesures complémentaires à respecter</div>
                        <div class="right value col-md-9">
                            {{ dossier.mesuresComplementaires|nl2br }}
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('INCOMPLET') and dossier.incomplet is not null %}
                    <li class="row">
                        <div class="left libelle col-md-3">État du dossier</div>
                        <div class="right value col-md-9">
                            <strong>{{ dossier.incomplet ? 'Incomplet' : 'Complet' }}</strong>

                            {{ include('dossier/_documents_manquants.html.twig') }}
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('HORSDELAI') and dossier.horsDelai %}
                    <li class="row">
                        <div class="left libelle col-md-3">Hors délai</div>
                        <div class="right value col-md-9">Oui</div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('DIFFEREAVIS') and dossier.avisDiffere %}
                    <li class="row">
                        <div class="left libelle col-md-3">Diffère l'avis</div>
                        <div class="right value col-md-9">Oui</div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('NPSP') and dossier.nePeutSePrononcer %}
                    <li class="row">
                        <div class="left libelle col-md-3">Ne peut se prononcer</div>
                        <div class="right value col-md-9">Oui</div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('ABSQUORUM') and dossier.absenceDeQuorum %}
                    <li class="row">
                        <div class="left libelle col-md-3">Absence de quorum</div>
                        <div class="right value col-md-9">Oui</div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('AVIS') and dossier.avis %}
                    <li class='row'>
                        <div class='left libelle col-md-3'>
                            Avis du {% if dossier.type.id == 3 %}groupe de visite{% else %}rapporteur{% endif %}
                        </div>
                        <div class='right value col-md-9'>
                            <span class='avis {{ dossier.avis.libelle[:1] }}'>
                                {{ dossier.avis.libelle }}

                                {{ include('dossier/_precision_libelle_avis.html.twig') }}
                            </span>
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('DELAIPRESC') and dossier.dateLimitePrescription %}
                    <li class="row">
                        <div class="left libelle col-md-3">Date avant laquelle les prescriptions doivent être levées</div>
                        <div class="right value col-md-9">
                            {{ dossier.dateLimitePrescription|date('d/m/Y') }}
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('AVIS_COMMISSION') and dossier.avisCommission and afficher_avis %}
                    <li class='row'>
                        <div class='left libelle col-md-3'>Avis de la commission</div>
                        <div class='right value col-md-9'>
                            <span class='avis {{ dossier.avisCommission.libelle[:1] }}'>
                                {{ dossier.avisCommission.libelle }}

                                {{ include('dossier/_precision_libelle_avis.html.twig') }}
                            </span>
                        </div>
                    </li>
                {% endif %}

                {% if dossier.facteurDangerosite > 0 %}
                    <li class="row">
                        <div class="left libelle col-md-3">Facteur de criticité</div>
                        <div class="right value col-md-9">
                            {{ dossier.facteurDangerosite }}
                        </div>
                    </li>
                {% endif %}

                {% if dossier.echeancierTravaux %}
                    <li class="row">
                        <div class="left libelle col-md-3">Echéancier de travaux / Schéma de mise en sécurité</div>
                        <div class="right value col-md-9">
                            {{ dossier.echeancierTravaux|date('d/m/Y') }}
                        </div>
                    </li>
                {% endif %}

                {% if dossier.analyseDeRisque %}
                    <li class="row">
                        <div class="left libelle col-md-3">Analyse de risque</div>
                        <div class="right value col-md-9">
                            {{ dossier.analyseDeRisque|nl2br }}
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('OBSERVATION') and dossier.observations %}
                    <li class="row">
                        <div class="left libelle col-md-3">Observations</div>
                        <div class="right value col-md-9">
                            {{ dossier.observations|nl2br }}
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('DATEPREF') and dossier.datePrefecture %}
                    <li class="row">
                        <div class="left libelle col-md-3">Date réception préfecture</div>
                        <div class="right value col-md-9">
                            {{ dossier.datePrefecture|date('d/m/Y') }}
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('DATEREP') and dossier.dateReponse %}
                    <li class='row'>
                        <div class='left libelle col-md-3'>Date de réponse</div>
                        <div class='right value col-md-9'>
                            {{ dossier.dateReponse|date('d/m/Y') }}
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('DATETRANSFERTCOMM') and dossier.dateTransfertCommission %}
                    <li class="row">
                        <div class="left libelle col-md-3">Date de transfert à la commission compétente</div>
                        <div class="right value col-md-9">
                            {{ dossier.dateTransfertCommission|date('d/m/Y') }}
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('DATERECEPTIONCOMM') and dossier.dateReceptionCommission %}
                    <li class="row">
                        <div class="left libelle col-md-3">Date de réception à la commission compétente</div>
                        <div class="right value col-md-9">
                            {{ dossier.dateReceptionCommission|date('d/m/Y') }}
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('DATEREUN') and dossier.dateReunion %}
                    <li class="row">
                        <div class="left libelle col-md-3">Date réunion</div>
                        <div class="right value col-md-9">
                            {{ dossier.dateReunion|date('d/m/Y') }}
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('OPERSDIS') and dossier.operationSdis is not null %}
                    <li class="row">
                        <div class="left libelle col-md-3">Opération (intervention) SDIS</div>
                        <div class="right value col-md-9">
                            {{ dossier.operationSdis ? 'Oui' : 'Non' }}
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('RCCI') and dossier.rcci is not null %}
                    <li class="row">
                        <div class="left libelle col-md-3">RCCI (oui/non) lien rapport</div>
                        <div class="right value col-md-9">
                            {{ dossier.rcci ? 'Oui' : 'Non' }}
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('REX') and dossier.rex %}
                    <li class="row">
                        <div class="left libelle col-md-3">REX</div>
                        <div class="right value col-md-9">
                            {{ dossier.rex|nl2br }}
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('CHARGESEC') and dossier.chargeSecurite %}
                    <li class="row">
                        <div class="left libelle col-md-3">Chargé de sécurité (T)</div>
                        <div class="right value col-md-9">
                            {{ dossier.chargeSecurite|nl2br }}
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('NUMINTERV') and dossier.numeroIntervention %}
                    <li class="row">
                        <div class="left libelle col-md-3">Numéro d'intervention</div>
                        <div class="right value col-md-9">
                            {{ dossier.numeroIntervention }}
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('DATEINTERV') and dossier.dateIntervention %}
                    <li class="row">
                        <div class="left libelle col-md-3">Date et heure d'intervention</div>
                        <div class="right value col-md-9">
                            {{ dossier.dateIntervention|date('d/m/Y - H:i') }}
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('DUREEINTERV') and dossier.dureeIntervention %}
                    <li class="row">
                        <div class="left libelle col-md-3">Durée intervention</div>
                        <div class="right value col-md-9">
                            {{ dossier.dureeIntervention|date('H:i') }}
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('DATESIGN') and dossier.dateSignature %}
                    <li class="row">
                        <div class="left libelle col-md-3">Date de signature</div>
                        <div class="right value col-md-9">
                            {{ dossier.dateSignature|date('d/m/Y') }}
                        </div>
                    </li>
                {% endif %}

                {% if dossier|should_display_field('PREVENTIONNISTE') and dossier.preventionnistes is not empty %}
                    <li class='row'>
                        <div class='left libelle col-md-3'>Préventionniste(s) du dossier</div>
                        <div class='right value col-md-9'>
                            {% for preventionniste in dossier.preventionnistes %}
                                {{ include('utilisateurs/_user_card.html.twig', {user: preventionniste}) }}
                            {% endfor %}
                        </div>
                    </li>
                {% endif %}
            </ul>
        </section>
    </div>

    <!-- Boite de confirmation de la suppression (cachée par défaut) -->
    <div id="confirm-modal" class="modal fade" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Fermer"><span aria-hidden="true">&times;</span></button>
                    <h3>Confirmation de la suppression</h3>
                </div>

                <div class="modal-body">
                    <p>Êtes-vous sûr de vouloir supprimer le dossier ? </p>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Annuler</button>
                    <a href="/dossier/delete/id/{{ dossier.id }}" class="btn btn-success">Confirmer</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script type="text/javascript">
        $(document).ready(function() {
            // fenetre de confirmation de la suppression
            $("#suppressionDossier").click(function(e) {
                e.preventDefault()
                $('#confirm-modal').modal({show:true})
            })
        })
    </script>
{% endblock %}
