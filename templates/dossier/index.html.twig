{% extends 'layouts/dossier.html.twig' %}

{% block title %}{{ parent() }} / Informations du dossier{% endblock %}

{% block body %}
<div id='dossier'>
    <div class='pull-right'>
        <a class='btn btn-default' href="/dossier/edit/id/{{ dossier.id }}">Modifier la fiche</a>
    </div>

    <h3>Fiche d'informations générales</h3>

    <div class='row'>
        <div class='col-md-12'>
            <dl class='dl-horizontal'>
                <dt>Type</dt>
                <dd><p>{{ dossier.type.libelle }}</p></dd>

                {% if dossier.nature is not null %}
                    <dt>Nature</dt>
                    <dd>
                        <ul class='unstyled'>
                            <li><strong>{{ dossier.nature.libelle }}</strong></li>
                        </ul>
                    </dd>
                {% endif %}

                <dt>Date d'insertion</dt>
                <dd><p>{{ dossier.dateInsert|date('d/m/Y') }}</p></dd>

                {% if dossier.objet %}
                    <dt>Objet</dt>
                    <dd><p>{{ dossier.objet }}</p></dd>
                {% endif %}

                {% if dossier.dateVisite %}
                    <dt>Date de visite</dt>
                    <dd><p>{{ dossier.dateVisite|date('d/m/Y') }}</p></dd>
                {% endif %}

{#                {% if dossier.commission %}#}
{#                    <dt>Commission concernée</dt>#}
{#                    <dd><p>{{ dossier.commission.libelle }} ({{ dossier.commission.type.libelle }})</p></dd>#}
{#                {% endif %}#}

                {% if dossier.avisCommission %}
                    <dt>Avis de la commission</dt>
                    <dd>
                        <span class='avis {{ dossier.avisCommission.libelle[:1]|lower }}'>
                            {{ dossier.avisCommission.libelle }}
                        </span>
                    </dd>
                {% endif %}

                {% if dossier.avisDiffere %}
                    <dt>Avis différé</dt>
                    <dd><p>Oui</p></dd>
                {% endif %}

                {% if dossier.facteurDangerosite is not null %}
                    <dt>Facteur de criticité</dt>
                    <dd><p>{{ dossier.facteurDangerosite }}</p></dd>
                {% endif %}

                {% if dossier.preventionnistes is not empty %}
                    <dt>Préventionniste(s)</dt>
                    <dd>
                        {% for preventionniste in dossier.preventionnistes %}
                            <div class='media' style='display: inline-block; margin-right: 10px;'>
                                <span class='media-object pull-left'>
                                    <img src='/images/avatar.png' alt='Avatar' style='width: 32px; height: 32px;' />
                                </span>
                                <div class='media-body'>
                                    {{ preventionniste.informations.nom }} {{ preventionniste.informations.prenom }}
                                </div>
                            </div>
                        {% endfor %}
                    </dd>
                {% endif %}

                {% if etablissements is not empty %}
                    <dt>Établissement(s) lié(s)</dt>
                    <dd>
                        <ul class='unstyled'>
                            {% for etablissement in etablissements %}
                                <li>
                                    <a href="{{ path('etablissement_informations', {id: etablissement.id}) }}">
                                        {{ etablissement.informations|last.libelle }}
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    </dd>
                {% endif %}
            </dl>
        </div>
    </div>
</div>

<!-- Boite de confirmation de la suppression (cachée par défaut) -->
<div id="confirm-modal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fermer"><span aria-hidden="true">&times;</span></button>
                <h3>Confirmation de la suppression</h3>
            </div>

            <div class="modal-body">
                <p>Êtes-vous sûr de vouloir supprimer le dossier ? </p>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Annuler</button>
                <a href="/dossier/delete/id/{{ dossier.id }}" class="btn btn-success">Confirmer</a>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function() {
        // fenetre de confirmation de la suppression
        $("#suppressionDossier").click(function(){
            $('#confirm-modal').modal({show:true});
        });
    });
</script>
{% endblock %}
