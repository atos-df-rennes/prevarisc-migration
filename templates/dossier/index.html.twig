{% extends 'layouts/dossier.html.twig' %}

{% block title %}Dossier / Informations générales{% endblock %}

{% block body %}
    <div>
        {% if verrouDossier != 1 %}
            <a class="btn btn-default pull-right" id="modifierDossier" >Modifier le dossier</a>
        {% endif %}
        <h3 class="text-bold">Informations générales</h3>
        {% if platauConsultation is not null and platauConsultation.id is not null %}
                {% include 'dossier/_platau_infos.html.twig' %}
        {% endif %}

        <h4 class="text-bold h4_subtitle">Type et nature du dossier</h4>
        <ul class="list-unstyled">
            <li class="row" style="margin-bottom: 20px;" id="type">
                <div class="col-sm-3" style='float:left;'> Type </div>
                <div class="col-sm-9">
                    {{ libelleType }}
                </div>
            </li>

            <li class="row" style="margin-bottom: 20px;" id="nature" >
                <div class="col-sm-3" style='float:left;'>Nature</div>
                <div class="col-sm-9">
                        {{ nature}}
                </div>
                
                <div id="loading" class="left span1" style="display:none;">
                    <img src="/images/load.gif" alt="loading" />
                </div>
            </li>
        </ul>
        {% include 'dossier/_infos_dossier.html.twig' %}
    </div>
{% endblock %}
