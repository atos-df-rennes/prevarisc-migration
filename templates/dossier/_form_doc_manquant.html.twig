<div id="infosIncomplet_{{ numDocManquant }}">
    <label>Dossier incomplet le</label>
    <div class="form-inline" style="margin-bottom: 10px;">
        <input class="date form-control" type="text" name="dateDocManquant[]" id="dateDocManquant_{{ numDocManquant }}" value="{{ dateDay }}" />
        &nbsp;
        <button type="button" class="today btn btn-default">
            <em class="glyphicon glyphicon-calendar"></em>&nbsp;Aujourd'hui
        </button>
        &nbsp;&nbsp;
        <button type="button" class="btn btn-danger cancelIncomplet" id="cancelIncomplet_{{ numDocManquant }}">
            <em class="glyphicon glyphicon-remove"></em>&nbsp;Annuler
        </button>
    </div>

    <textarea name="docManquant[]" class="docManquant form-control" id="docManquant_{{ numDocManquant }}" rows="5" cols="100">{% for doc in listeDoc %}
{{ doc.libelleDocManquant }}
{% endfor %}</textarea>
<div class="form-inline" style="margin-bottom: 10px;">
    <label>Date de réception des pièces</label>
    <div class="input-group">
        <input class="date form-control" type="text" name="dateReceptionDocManquant[]" id="dateReceptionDocManquant_{{ numDocManquant }}" />
        <span class="input-group-btn">
            <button type="button" class="today btn btn-default">
                <em class="glyphicon glyphicon-calendar"></em>&nbsp;Aujourd'hui
            </button>
        </span>
    </div>
</div>

    <button type="button" class="btn btn-success validateDocManquant">
        <em class="glyphicon glyphicon-lock"></em>&nbsp;Valider la réception de document
    </button>
</div>
