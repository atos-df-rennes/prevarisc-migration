{% extends 'layouts/dossier.html.twig' %}

{% import 'components/_formulaire_personnalise.html.twig' as forms %}

{% block title %}{{ parent() }} / Effectifs et Dégagements{% endblock %}

{% block body %}
    <div class="pull-right">
        <a class="btn btn-default" href="/dossier/effectifs-degagements-dossier-edit/id/{{ dossier.id }}">Modifier les effectifs et dégagements</a>
    </div>

    <h3>{{ capsule ? capsule.nom : 'Effectifs et Dégagements' }}</h3>

    {% if rubriques is empty %}
        <p class="text-muted">
            <em>Aucune rubrique configurée. Contactez un administrateur Prevarisc.</em>
        </p>
    {% else %}
        {{ forms.rubriques(rubriques) }}
    {% endif %}
{% endblock %}
