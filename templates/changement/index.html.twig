{% extends 'layouts/admin.html.twig' %}

{% block title %}Administration / Gestion des messages d'alerte{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script src="{{ asset('js/tinymce.min.js') }}"></script>

    <script type='text/javascript'>
      tinymce.init({
        selector: '.tinyarea',
        language: 'fr_FR',
        height: 150,
        menubar: false,
        statusbar: false,
        plugins: [
          'advlist autolink lists link image charmap print preview anchor',
          'searchreplace visualblocks code fullscreen',
          'insertdatetime media table contextmenu paste code'
        ],
        toolbar: 'insertfile undo redo | styleselect | bold italic | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | link',
        content_css: [
          '//fast.fonts.net/cssapi/e6dc9b99-64fe-4292-ad98-6974f93cd2a2.css',
          '//www.tinymce.com/css/codepen.min.css'
        ]
      });

      $(document).ready(function() {
        $(".see-balises").click(function() {
          $.ajax({
            type: "GET",
            url: "/changement/balises",
            success: function(msg){
              $('#liste-balises .modal-body').html(msg);
            },
          });
        });
      });
    </script>
{% endblock %}

{% block body %}
    {{ form_start(form) }}
        {% for message in form.messages %}
            <h3>Message de {{ message.vars.data.libelle|lower }}</h3>

            {{ form_row(message) }}
        {% endfor %}

        <div class='pull-right'>
            <button type='button' class="btn btn-default see-balises" data-toggle="modal" data-target="#liste-balises">Voir les balises disponibles</button>
            <input type='submit' class="btn btn-success" value="Modifier les messages">
        </div>
    {{ form_end(form) }}

    {{ include('changement/_modal_balises.html.twig') }}
{% endblock %}
