{% extends 'layouts/admin.html.twig' %}

{% block title %}Administration / Gestion des configurations{% endblock %}

{% block body %}
    <h3>Configuration de l'application</h3>

    {{ form_start(form) }}
        {{ form_widget(form) }}

        <div class="mt-3 pull-right">
            <a href="{{ path('admin_configuration') }}" class="btn btn-default">Annuler</a>
            <button type="submit" class="btn btn-success">Enregistrer</button>
        </div>
    {{ form_end(form) }}
{% endblock %}
