{% extends 'base.html.twig' %}

{% block title %}Éditer la commission{% endblock %}

{% block body %}
<h2>Édition de la date commission {{ dateClick }}</h2>

<p>Type de commission : {{ typeComLibelle ?: 'Non défini' }}</p>
<p>Libellé : {{ libelleDateComm }}</p>

<form method="post" action="{{ path('route_to_handle_form_submission') }}">
    <input type="hidden" name="idDateComm" value="{{ dateClick }}" />
    <label for="typeSelect">Type de commission :</label>
    <select id="typeSelect" name="typeSelect">
        {% for type in listeDates %}
            <option value="{{ type.id }}" {% if type.id == idTypeSelect %}selected{% endif %}>{{ type.libelle }}</option>
        {% endfor %}
    </select>

    <label for="libelleDateComm">Libellé :</label>
    <input type="text" id="libelleDateComm" name="libelleDateComm" value="{{ libelleDateComm }}" />

    <button type="submit">Enregistrer</button>
</form>

<h3>Dates liées</h3>
<ul>
    {% for date in listeDates %}
        <li>{{ date.libelleDateCommission }} ({{ date.dateCommission|date('d/m/Y') }})</li>
    {% endfor %}
</ul>

{% endblock %}
