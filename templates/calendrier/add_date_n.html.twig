<ul class="list-unstyled row" style=" padding: 3px 0 3px 0;">
    <li class="col-xs-6">
        {{ dateAjoutee|format_date('full', locale='fr')  }}
    </li>
    <li class="col-xs-2">
        <input type="text" size="8" class="time form-control input-sm" id="D_{{ dateAjouteeInput }}" name="D_{{ dateAjouteeInput }}" value="09:00" />
    </li>
    <li class="col-xs-2">
        <input type="text" size="8" class="time form-control input-sm" id="F_{{ dateAjouteeInput }}" name="F_{{ dateAjouteeInput }}" value="18:00" />
    </li>
    <li class="col-xs-2">
        <button type="button" class="btn btn-danger btn-sm suppression">
            <i class="glyphicon glyphicon-trash"></i>
        </button>
    </li>
</ul>
