<div class="form-group">
    <label for="value_libelleCom">Saisissez le libellé de la commission :</label>
    <div class="input-group">
        <input type="text"
               name="value_libelleCom"
               id="value_libelleCom"
               class="form-control"
               value="{{ libelleDateComm|e('html_attr') }}" />

        <span class="input-group-btn">
            <button class="btn btn-success" type="button" id="valid_libelleCom" title="Valider">
                <i class="glyphicon glyphicon-ok"></i>
            </button>
            <button class="btn btn-danger" type="button" id="annule_libelleCom" title="Annuler">
                <i class="glyphicon glyphicon-remove"></i>
            </button>
        </span>
    </div>
</div>
