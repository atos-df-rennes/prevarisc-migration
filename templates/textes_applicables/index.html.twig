{% extends 'layouts/admin.html.twig' %}

{% block title %}Administration / Gestion des textes applicables{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script type='text/javascript'>
        $(document).ready(function() {
            $(".sortTexteAppl").sortable({
                update: function(event, ui) {
                    const id = $(this).attr('id');
                    const listeTexteApplUpdate = [];
                    let listeOrder = '';
                    $("#"+id+" > li").each(function(){
                        //on parcourt les li pour récolter les changements et mettre à jour dans la base
                        //on recupere id du li en cours
                        var liId = $(this).attr('id');
                        listeOrder += liId+",";
                        listeTexteApplUpdate.push(liId);
                    });
                    const enCoursToastId = $.toast.info('Mise à jour de l\'ordre en cours…', { autoClose: false });

                    $.ajax({
                        url: Routing.generate('admin_textes_applicables_updateorder'),
                        data: "tableUpdate="+listeTexteApplUpdate,
                        type: "POST",
                        dataType: "json",
                        success: function(response) {
                            $.toast.close(enCoursToastId);
                            $.toast.fromResponse(response);
                        },
                        error: function(xhr) {
                            $.toast.close(enCoursToastId);
                            let msg = 'Erreur lors de la mise à jour de l\'ordre.';
                            if (xhr.responseJSON && xhr.responseJSON.error) {
                                msg = xhr.responseJSON.error;
                            }
                            $.toast.error(msg);
                        }
                    });
                }
            });

            $(".createTexteAppl").click(function() {
                $.ajax({
                    type: "GET",
                    url: Routing.generate('admin_textes_applicables_add'),
                    success: function(msg){
                        $('#texteApplModal .modal-body').html(msg);
                    },
                });
            });

            $(".editTexteAppl").click(function(){
                idTexteApplicable = this.getAttribute("data-ta-id");
                $.ajax({
                    type: "GET",
                    url: Routing.generate('admin_textes_applicables_edit', {id: idTexteApplicable}),
                    success: function(msg){
                        $('#texteApplModal .modal-body').html(msg);
                    },
                });
            })
        });
    </script>
{% endblock %}

{% block body %}
    <h3 class='page-header'>Gestion des textes applicables</h3>
    <button id='createTexteAppl' class='btn btn-primary mb-4 createTexteAppl' data-toggle="modal" data-target="#texteApplModal">
        <span class='glyphicon glyphicon-plus' aria-hidden="true"></span>&nbsp;Ajouter un texte applicable
    </button>

    {% set last_type_id = textesApplicables[0].typeid %}
    <div class='row'>
        <div class='col-xs-12' style='font-weight:bold;font-size:25px;'>{{ textesApplicables[0].type }}</div>
    </div>
    <ul class='sortTexteAppl list-unstyled container-fluid' id='liste_{{ last_type_id }}'>
        {% for texte_applicable in textesApplicables %}
            {% if texte_applicable.typeid != last_type_id %}
                {% set last_type_id = texte_applicable.typeid %}
                </ul>
                <div class='row'>
                    <div class='col-xs-12' style='font-weight:bold;font-size:25px;'>{{ texte_applicable.type }}</div>
                </div>
                <ul class='sortTexteAppl list-unstyled container-fluid' id='liste_{{ texte_applicable.typeid }}'>
            {% endif %}
            <li class='row' style='margin-top:15px;margin-bottom:10px;' id='{{ texte_applicable.id }}'>
                <div class='col-xs-10'>
                    <span class="glyphicon glyphicon-move" aria-hidden="true"></span>
                    <span class="sr-only">(draggable)</span>

                    {% if texte_applicable.visible %}
                        <img src='{{ asset('images/visible.gif') }}' alt='visible' />
                    {% else %}
                        <img src='{{ asset('images/nonvisible.gif') }}' alt='non visible' />
                    {% endif %}

                    {{ texte_applicable.libelle }}
                </div>
                <div class='col-xs-2'>
                    <button class='editTexteAppl btn btn-default' data-ta-id="{{ texte_applicable.id }}" data-toggle="modal" data-target="#texteApplModal">
                        <span class='glyphicon glyphicon-pencil' aria-hidden="true"></span>&nbsp;Editer
                    </button>
                </div>
            </li>
        {% endfor %}
    </ul>

    {{ include('textes_applicables/_modal.html.twig') }}
{% endblock %}
