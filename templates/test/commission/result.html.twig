{% extends 'base.html.twig' %}

{% block title %}Test - Résultat transformation DTO{% endblock %}

{% block body %}
<div class="container" style="margin-top: 50px;">
    <div class="row">
        <div class="col-md-10 col-md-offset-1">
            <div class="panel panel-success">
                <div class="panel-heading">
                    <h3 class="panel-title">
                        <i class="glyphicon glyphicon-ok"></i>
                        Résultat de la transformation DTO → Entités
                    </h3>
                </div>
                <div class="panel-body">
                    {% for message in app.flashes('success') %}
                        <div class="alert alert-success">
                            {{ message }}
                        </div>
                    {% endfor %}

                    <h4>Commission associée</h4>
                    <div class="well well-sm">
                        <ul>
                            <li><strong>ID :</strong> {{ commission.id }}</li>
                            <li><strong>Libellé :</strong> {{ commission.libelle }}</li>
                        </ul>
                    </div>

                    <h4>DTO source</h4>
                    <div class="well well-sm">
                        <ul>
                            <li><strong>Libellé :</strong> {{ dto.libelle }}</li>
                            <li><strong>Type événement :</strong> {{ dto.typeEvenement.libelle }}</li>
                            <li><strong>Nombre de dates :</strong> {{ dto.dates|length }}</li>
                            <li><strong>Périodicité :</strong> {{ dto.withPeriodicite ? 'Oui (toutes les ' ~ dto.periodicite ~ ' semaines jusqu\'au ' ~ dto.dateFin|date('d/m/Y') ~ ')' : 'Non' }}</li>
                        </ul>
                    </div>

                    <h4>Entités DateCommission générées ({{ dateCommissions|length }})</h4>
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Date</th>
                                <th>Heure début</th>
                                <th>Heure fin</th>
                                <th>Libellé</th>
                                <th>Type événement</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for dateCommission in dateCommissions %}
                                <tr>
                                    <td>{{ loop.index }}</td>
                                    <td>{{ dateCommission.date|date('d/m/Y (l)') }}</td>
                                    <td>{{ dateCommission.heureDebut|date('H:i') }}</td>
                                    <td>{{ dateCommission.heureFin|date('H:i') }}</td>
                                    <td>{{ dateCommission.libelle }}</td>
                                    <td>{{ dateCommission.typeEvenement.libelle }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>

                    <div class="alert alert-warning">
                        <strong>Note :</strong> Ces entités n'ont PAS été persistées en base de données (mode test).
                    </div>

                    <a href="{{ path('commission_form_test') }}" class="btn btn-primary">
                        <i class="glyphicon glyphicon-arrow-left"></i> Retour au formulaire
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
