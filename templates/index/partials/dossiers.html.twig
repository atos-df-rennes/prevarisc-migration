{% if bloc.data is not empty %}
    <ul class="recherche_liste list-unstyled no_slide scroll-bloc-medium">
        {% for dossier in bloc.data %}
            {{ include('search/results/_dossier.html.twig', {item: dossier}) }}
        {% endfor %}
    </ul>
{% else %}
    <small class="text-muted">Aucun dossier.</small>
{% endif %}
