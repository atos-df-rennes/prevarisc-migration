<div id="{{ id }}" class="panel panel-default{{ bloc.width != 'small' ? ' w2' : '' }} empty folded">
    <div class="panel-heading">
        <span class="icon glyphicon glyphicon-chevron-right" aria-hidden="true"></span>
        {{ bloc.title ~ ' (' ~ (bloc.count ?? 0) ~ ')' }}
        <a class="btn btn-xs btn-default pull-right" data-toggle="modal" data-target="#reponse-modal"
           href="{{ path('accueil_add_message') }}">Ajouter un message</a>
    </div>
    <div class="panel-body" style="display:none">
        <img src="/images/load.gif" />
    </div>
</div>
