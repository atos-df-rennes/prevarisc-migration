{% extends 'layouts/search.html.twig' %}

{% block title %}Recherche établissements{% endblock %}

{% block body %}

{% set query_params = app.request.query.all() %}
<h2 class="page-header">Etablissements</h2>
<form method='get'>
    <div class='well well-sm clearfix' style='margin-bottom: 5px;'>
        <div class="input-group pull-left" style="max-width: 340px;">
            <input type="text" name='label' class="form-control search-query"
                   placeholder="Libellé de l'établissement ou son #ID ..."
                   value="{{ app.request.query.get('label', '') }}"
                   onkeypress="masquerBoutonExportCalc()"/>
            <span class="input-group-btn">
                <input type='submit' class="btn btn-default btn_search" name='Rechercher' value="Rechercher" disabled onsubmit="afficherBoutonExportCalc()"/>
            </span>
        </div>
        <input type='hidden' name='page' value="1" />

        <div class="pull-left" style='margin: 9px 0 0 5px'>
            <small>
                <a href="{{ path('search_etablissement', {label: '', page: 1}) }}">
                    Réinitialiser
                </a>
            </small>
        </div>

        <p class='pull-right' style='margin: 9px 0 0 5px'>
            <small>
                Zone de recherche :
                <a href='#' id="zone_de_recherche_edit">
                    <strong class='zone_de_recherche_text'>
                        {{ app.request.query.get('zone_de_recherche_text', '') != '' ? app.request.query.get('zone_de_recherche_text') : 'Département' }}
                    </strong>
                </a>
                <a href='#' id="zone_de_recherche_reset"><i class="glyphicon glyphicon-remove"></i></a>
                <input type='hidden' name='zone_de_recherche_text' value="{{ app.request.query.get('zone_de_recherche_text', '') }}" />
                <input type='hidden' name='city' value="{{ app.request.query.get('city', '') }}" />
                <input type='hidden' name='street' value="{{ app.request.query.get('street', '') }}" />
                <input type='hidden' name='number' value="{{ app.request.query.get('number', '') }}" />
            </small>
        </p>
    </div>

    <div id="filterContainer" class="well" style="margin-left: 0;">
        <div class="row">
            <div class="col-xs-12">
                <div class="row">
                    <div class="col-sm-3 form-group">
                    <select name='statuts[]' multiple onchange="masquerBoutonExportCalc()">
                        {% for statut in DB_statut %}
                            <option value='{{ statut.ID_STATUT }}'
                                {% if statut.ID_STATUT in query_params['statuts']|default([]) %}selected{% endif %}>
                                {{ statut.LIBELLE_STATUT }}
                            </option>
                        {% endfor %}
                    </select>
                    </div>
                    <div class="col-sm-3 form-group">
                    <select name='presences_local_sommeil[]' multiple onchange="masquerBoutonExportCalc()">
                        <option value='true' {% if 'true' in query_params['presences_local_sommeil']|default([]) %}selected{% endif %}>Avec</option>
                        <option value='false' {% if 'false' in query_params['presences_local_sommeil']|default([]) %}selected{% endif %}>Sans</option>
                    </select>
                    </div>
                    <div class="col-sm-3 form-group">
                    <select name='avis[]' multiple onchange="masquerBoutonExportCalc()">
                        <option value='true' {% if 'true' in query_params['avis']|default([]) %}selected{% endif %}>Favorable</option>
                        <option value='false' {% if 'false' in query_params['avis']|default([]) %}selected{% endif %}>Défavorable</option>
                    </select>
                    </div>
                    <div class="col-sm-3 form-group">
                    <select name='commissions[]' multiple onchange="masquerBoutonExportCalc()">
                        {% for commission in DB_commission %}
                            <option value='{{ commission.ID_COMMISSION }}'
                                {% if commission.ID_COMMISSION in query_params['commissions']|default([]) %}selected{% endif %}>
                                {{ commission.LIBELLE_COMMISSION }}
                            </option>
                        {% endfor %}
                    </select>
                    </div>
                </div>
            </div>

            <div class="col-xs-12">
                <div id='criteres_plus' class="row">
                    <div class="col-sm-3 form-group">
                    <select name='genres[]' multiple onchange="masquerBoutonExportCalc()">
                        {% for genre in DB_genre %}
                            <option value='{{ genre.ID_GENRE }}'
                                {% if genre.ID_GENRE in query_params['genres']|default([]) %}selected{% endif %}>
                                {{ genre.LIBELLE_GENRE }}
                            </option>
                        {% endfor %}
                    </select>
                    </div>
                    <div class="col-sm-3 form-group" id='categorie_span' style='display:none'>
                        <select name='categories[]' multiple onchange="masquerBoutonExportCalc()">
                            {% for categorie in DB_categorie %}
                                <option value='{{ categorie.ID_CATEGORIE }}'
                                    {% if categorie.ID_CATEGORIE in query_params['categories']|default([]) %}selected{% endif %}>
                                    {{ categorie.LIBELLE_CATEGORIE }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-sm-3 form-group" id='classe_span' style='display:none'>
                        <select name='classes[]' multiple onchange="masquerBoutonExportCalc()">
                            {% for classe in DB_classe %}
                                <option value='{{ classe.ID_CLASSE }}'
                                    {% if classe.ID_CLASSE in query_params['classes']|default([]) %}selected{% endif %}>
                                    {{ classe.LIBELLE_CLASSE }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-sm-3 form-group" id='famille_span' style='display:none'>
                        <select name='familles[]' multiple onchange="masquerBoutonExportCalc()">
                            {% for famille in DB_famille %}
                                <option value='{{ famille.ID_FAMILLE }}'
                                    {% if famille.ID_FAMILLE in query_params['familles']|default([]) %}selected{% endif %}>
                                    {{ famille.LIBELLE_FAMILLE }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-sm-3 form-group" id='type_span' style='display:none'>
                        <select name='types_activites[]' multiple onchange="masquerBoutonExportCalc()">
                            {% set current_type = null %}
                            {% for activite in DB_typeactivite %}
                                {% if activite.LIBELLE_TYPE != current_type %}
                                    {% if current_type is not null %}</optgroup>{% endif %}
                                    <optgroup label="{{ activite.LIBELLE_TYPE }}">
                                    {% set current_type = activite.LIBELLE_TYPE %}
                                {% endif %}
                                <option value='{{ activite.ID_TYPEACTIVITE }}'
                                    {% if activite.ID_TYPEACTIVITE in query_params['types_activites']|default([]) %}selected{% endif %}>
                                    {{ activite.LIBELLE_ACTIVITE }}
                                </option>
                            {% endfor %}
                            {% if current_type is not null %}</optgroup>{% endif %}
                        </select>
                    </div>
                </div>
            </div>

            <div class="col-xs-12">
                <div class="row">
                    <div class="col-sm-4 form-group">
                        <select name='groupements_territoriaux[]' multiple onchange="masquerBoutonExportCalc()">
                            {% for groupement in DB_groupementterritorial %}
                                {% set selected = false %}
                                {% if user is not null %}
                                    {% for user_groupement in user.groupements %}
                                        {% if groupement.ID_GROUPEMENT == user_groupement.id %}
                                            {% set selected = true %}
                                        {% endif %}
                                    {% endfor %}
                                {% endif %}
                                <option value='{{ groupement.ID_GROUPEMENT }}'
                                    {% if groupement.ID_GROUPEMENT in query_params['groupements_territoriaux']|default([]) or selected %}selected{% endif %}>
                                    {{ groupement.LIBELLE_GROUPEMENT }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-sm-3">
            <select name="preventionniste" class="form-control" data-placeholder='Sélectionnez un préventionniste' onchange="masquerBoutonExportCalc()">
                <option value=''>Sélectionnez un préventionniste</option>
                {% for prev in liste_prev %}
                    <option value='{{ prev.ID_PREVENTIONNISTE }}'
                        {% if app.request.query.get('preventionniste') is not null and prev.ID_PREVENTIONNISTE == app.request.query.get('preventionniste') %}selected{% endif %}>
                        {{ prev.NOM_UTILISATEURINFORMATIONS }} {{ prev.PRENOM_UTILISATEURINFORMATIONS }}
                    </option>
                {% endfor %}
            </select>
            </div>
        </div>
    </div>

    <hr/>

    {% if results is not null and results.totalCount > 0 %}
        <div style='display:inline-block;width: 100%;'>
            <div class='pull-left'>
                <p class='text-muted'><small>Nombre total d'éléments : {{ results.totalCount }}</small></p>
            </div>
            {% if is_allowed_export_calc %}
            <div class='pull-right'>
                {% if results.totalCount <= 10000 %}
                    <input type='submit' class='btn btn-success' id='exporter' name='Exporter' value='Export Calc'>
                {% else %}
                    <small style='font-weight:bold;color:red;'>La fonctionnalité d'export Calc est limitée à 10 000 éléments</small>
                {% endif %}
            </div>
            {% endif %}
        </div>
        <ul class='recherche_liste list-unstyled'>
            {% for item in results.items %}
                {{ include('search/results/_etablissement.html.twig', {item: item}) }}
            {% endfor %}
        </ul>
        <br/>
        <div style='clear: both'></div>
        {{ include('search/_pagination.html.twig', {pagination: results}) }}
    {% elseif results is not null %}
        <p class='text-muted'><small>Aucun résultat disponible.</small></p>
    {% endif %}

</form>

{# Boite modale de la zone de recherche — Bootstrap 3 #}
<div id="zone_de_recherche_modal" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content adresse">

            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h3 class="modal-title">Définir la zone de recherche</h3>
            </div>

            <div class="modal-body">
                <dl class='dl-horizontal'>
                    <dt>Ville</dt>
                    <dd class="mb-3">
                        <input name='commune_ac' type='text' class="form-control" placeholder='Nom de la commune ou code postal ...' />
                        <input name='code_insee' type='hidden' />
                    </dd>

                    <dt>Voie</dt>
                    <dd class="mb-3">
                        <input type='text' name='voie_ac' class="form-control" placeholder='Nom de la voie ...' disabled />
                        <input type='hidden' name='voie' />
                    </dd>

                    <dt>Numéro</dt>
                    <dd class="mb-3">
                        <input name='numero_ac' type='text' class="form-control" placeholder='Numéro de la voie ...' disabled />
                    </dd>
                </dl>
            </div>

            <div class="modal-footer">
                <a href="#" data-dismiss="modal" class="btn btn-default">Annuler</a>
                <a class='submit btn btn-success' onclick="masquerBoutonExportCalc()">Définir la zone de recherche</a>
            </div>
        </div>
    </div>
</div>

<script>
var SEARCH_ETABLISSEMENT_CONFIG = {
    urlAjaxEtablissement: "{{ path('search_ajax_etablissement') }}",
    urlGetCommunes: "{{ path('api_adresse_get_communes') }}",
    urlGetVoies: "{{ path('api_adresse_get_voies') }}"
};
</script>
<script src="{{ asset('js/search-etablissement.js') }}"></script>
{% endblock %}
