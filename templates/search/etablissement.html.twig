{% extends 'layouts/search.html.twig' %}

{% block title %}Recherche établissements{% endblock %}

{% block body %}

<h2 class="page-header">Etablissements</h2>
<form method='get'>
    <div class='well well-sm clearfix' style='margin-bottom: 5px;'>
        <div class="input-group pull-left" style="max-width: 340px;">
            <input type="text" name='label' class="form-control search-query"
                   placeholder="Libellé de l'établissement ou son #ID ..."
                   value="{{ app.request.query.get('label', '') }}"
                   onkeypress="masquerBoutonExportCalc()"/>
            <span class="input-group-btn">
                <input type='submit' class="btn btn-default btn_search" name='Rechercher' value="Rechercher" disabled onsubmit="afficherBoutonExportCalc()"/>
            </span>
        </div>
        <input type='hidden' name='page' value="1" />

        <div class="pull-left" style='margin: 9px 0 0 5px'>
            <small>
                <a href="{{ path('search_etablissement', {label: '', page: 1, Rechercher: 'Rechercher'}) }}">
                    Réinitialiser
                </a>
            </small>
        </div>

        <p class='pull-right' style='margin: 9px 0 0 5px'>
            <small>
                Zone de recherche :
                <a href='#' id="zone_de_recherche_edit">
                    <strong class='zone_de_recherche_text'>
                        {{ app.request.query.get('zone_de_recherche_text', '') != '' ? app.request.query.get('zone_de_recherche_text') : 'Département' }}
                    </strong>
                </a>
                <a href='#' id="zone_de_recherche_reset"><i class="glyphicon glyphicon-remove"></i></a>
                <input type='hidden' name='zone_de_recherche_text' value="{{ app.request.query.get('zone_de_recherche_text', '') }}" />
                <input type='hidden' name='city' value="{{ app.request.query.get('city', '') }}" />
                <input type='hidden' name='street' value="{{ app.request.query.get('street', '') }}" />
                <input type='hidden' name='number' value="{{ app.request.query.get('number', '') }}" />
            </small>
        </p>
    </div>

    <div id="filterContainer" class="well" style="margin-left: 0;">
        <div class="row">
            <div>
                <select name='statuts[]' multiple onchange="masquerBoutonExportCalc()">
                    {% for statut in DB_statut %}
                        <option value='{{ statut.ID_STATUT }}'
                            {% if app.request.query.get('statuts') is not null and statut.ID_STATUT in app.request.query.get('statuts') %}selected{% endif %}>
                            {{ statut.LIBELLE_STATUT }}
                        </option>
                    {% endfor %}
                </select>
                <select name='presences_local_sommeil[]' multiple onchange="masquerBoutonExportCalc()">
                    <option value='true' {% if app.request.query.get('presences_local_sommeil') is not null and 'true' in app.request.query.get('presences_local_sommeil') %}selected{% endif %}>Avec</option>
                    <option value='false' {% if app.request.query.get('presences_local_sommeil') is not null and 'false' in app.request.query.get('presences_local_sommeil') %}selected{% endif %}>Sans</option>
                </select>
                <select name='avis[]' multiple onchange="masquerBoutonExportCalc()">
                    <option value='true' {% if app.request.query.get('avis') is not null and 'true' in app.request.query.get('avis') %}selected{% endif %}>Favorable</option>
                    <option value='false' {% if app.request.query.get('avis') is not null and 'false' in app.request.query.get('avis') %}selected{% endif %}>Défavorable</option>
                </select>
                <select name='commissions[]' multiple onchange="masquerBoutonExportCalc()">
                    {% for commission in DB_commission %}
                        <option value='{{ commission.ID_COMMISSION }}'
                            {% if app.request.query.get('commissions') is not null and commission.ID_COMMISSION in app.request.query.get('commissions') %}selected{% endif %}>
                            {{ commission.LIBELLE_COMMISSION }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div id='criteres_plus' style='margin-top: 4px;'>
                <select name='genres[]' multiple onchange="masquerBoutonExportCalc()">
                    {% for genre in DB_genre %}
                        <option value='{{ genre.ID_GENRE }}'
                            {% if app.request.query.get('genres') is not null and genre.ID_GENRE in app.request.query.get('genres') %}selected{% endif %}>
                            {{ genre.LIBELLE_GENRE }}
                        </option>
                    {% endfor %}
                </select>
                <span id='categorie_span' class='hide'>
                    <select name='categories[]' multiple onchange="masquerBoutonExportCalc()">
                        {% for categorie in DB_categorie %}
                            <option value='{{ categorie.ID_CATEGORIE }}'
                                {% if app.request.query.get('categories') is not null and categorie.ID_CATEGORIE in app.request.query.get('categories') %}selected{% endif %}>
                                {{ categorie.LIBELLE_CATEGORIE }}
                            </option>
                        {% endfor %}
                    </select>
                </span>
                <span id='classe_span' class='hide'>
                    <select name='classes[]' multiple onchange="masquerBoutonExportCalc()">
                        {% for classe in DB_classe %}
                            <option value='{{ classe.ID_CLASSE }}'
                                {% if app.request.query.get('classes') is not null and classe.ID_CLASSE in app.request.query.get('classes') %}selected{% endif %}>
                                {{ classe.LIBELLE_CLASSE }}
                            </option>
                        {% endfor %}
                    </select>
                </span>
                <span id='famille_span' class='hide'>
                    <select name='familles[]' multiple onchange="masquerBoutonExportCalc()">
                        {% for famille in DB_famille %}
                            <option value='{{ famille.ID_FAMILLE }}'
                                {% if app.request.query.get('familles') is not null and famille.ID_FAMILLE in app.request.query.get('familles') %}selected{% endif %}>
                                {{ famille.LIBELLE_FAMILLE }}
                            </option>
                        {% endfor %}
                    </select>
                </span>
                <span id='type_span' class='hide'>
                    <select name='types_activites[]' multiple onchange="masquerBoutonExportCalc()">
                        {% for type in DB_typeactivite %}
                            <optgroup label="{{ type.LIBELLE_TYPE }}">
                                <option value='{{ type.ID_TYPEACTIVITE }}'
                                    {% if app.request.query.get('types_activites') is not null and type.ID_TYPEACTIVITE in app.request.query.get('types_activites') %}selected{% endif %}>
                                    {{ type.LIBELLE_TYPE }} - {{ type.LIBELLE_ACTIVITE }}
                                </option>
                            </optgroup>
                        {% endfor %}
                    </select>
                </span>
            </div>

            <div style='margin-top: 4px;'>
                <select name='groupements_territoriaux[]' multiple onchange="masquerBoutonExportCalc()">
                    {% for groupement in DB_groupementterritorial %}
                        {% set selected = false %}
                        {% if user is not null %}
                            {% for user_groupement in user.groupements %}
                                {% if groupement.ID_GROUPEMENT == user_groupement.id %}
                                    {% set selected = true %}
                                {% endif %}
                            {% endfor %}
                        {% endif %}
                        <option value='{{ groupement.ID_GROUPEMENT }}'
                            {% if (app.request.query.get('groupements_territoriaux') is not null and groupement.ID_GROUPEMENT in app.request.query.get('groupements_territoriaux')) or selected %}selected{% endif %}>
                            {{ groupement.LIBELLE_GROUPEMENT }}
                        </option>
                    {% endfor %}
                </select>
            </div>
        </div>

        <div class="clearfix"></div>

        <div class="row">
            <select name="preventionniste" class='chosen' data-placeholder='Sélectionnez un préventionniste' onchange="masquerBoutonExportCalc()">
                <option value=''></option>
                {% for prev in liste_prev %}
                    <option value='{{ prev.ID_PREVENTIONNISTE }}'
                        {% if app.request.query.get('preventionniste') is not null and prev.ID_PREVENTIONNISTE == app.request.query.get('preventionniste') %}selected{% endif %}>
                        {{ prev.NOM_UTILISATEURINFORMATIONS }} {{ prev.PRENOM_UTILISATEURINFORMATIONS }}
                    </option>
                {% endfor %}
            </select>
        </div>
    </div>

    <hr/>

    {% if results is not null and results.totalCount > 0 %}
        <div style='display:inline-block;width: 100%;'>
            <div class='pull-left'>
                <p class='text-muted'><small>Nombre total d'éléments : {{ results.totalCount }}</small></p>
            </div>
            <div class='pull-right' style="visibility: hidden;">
                {# Export Calc non migré #}
                <input type='submit' class='btn btn-success' id='exporter' name='Exporter' value='Export Calc' style="visibility: hidden;">
            </div>
        </div>
        <ul class='recherche_liste list-unstyled'>
            {% for item in results.items %}
                {{ include('search/results/_etablissement.html.twig', {item: item}) }}
            {% endfor %}
        </ul>
        <br/>
        <div style='clear: both'></div>
        {{ include('search/_pagination.html.twig', {pagination: results}) }}
    {% elseif results is not null %}
        <p class='text-muted'><small>Aucun résultat disponible.</small></p>
    {% endif %}

</form>

{# Boite modale de la zone de recherche — Bootstrap 3 #}
<div id="zone_de_recherche_modal" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content adresse">

            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h3 class="modal-title">Définir la zone de recherche</h3>
            </div>

            <div class="modal-body">
                <dl class='dl-horizontal'>
                    <dt>Ville</dt>
                    <dd>
                        <input name='commune_ac' type='text' class="form-control" placeholder='Nom de la commune ou code postal ...' />
                        <input name='code_insee' type='hidden' />
                    </dd>

                    <dt>Voie</dt>
                    <dd>
                        <input type='text' name='voie_ac' class="form-control" placeholder='Nom de la voie ...' disabled />
                        <input type='hidden' name='voie' />
                    </dd>
                    <dt>Numéro</dt>
                    <dd>
                        <input name='numero_ac' type='text' class="form-control" placeholder='Numéro de la voie ...' disabled />
                    </dd>
                </dl>
            </div>

            <div class="modal-footer">
                <a href="#" data-dismiss="modal" class="btn btn-default">Annuler</a>
                <a class='submit btn btn-success' onclick="masquerBoutonExportCalc()">Définir la zone de recherche</a>
            </div>

        </div>
    </div>
</div>

<script>
    $(document).ready(function() {

        $("input[name='label']").focus();
        $('input[type="submit"]').attr('disabled', false);

        // Gestion des multiselects
        $("select[name='statuts[]']").multiselect({header: false, noneSelectedText: "Tous les statuts"});
        $("select[name='genres[]']").multiselect({header: false, noneSelectedText: "Tous les genres"});
        $("select[name='categories[]']").multiselect({header: false, noneSelectedText: "Toutes les catégories"});
        $("select[name='classes[]']").multiselect({header: false, noneSelectedText: "Toutes les classes"});
        $("select[name='familles[]']").multiselect({header: false, noneSelectedText: "Toutes les familles"});
        $("select[name='types_activites[]']").multiselect({header: false, noneSelectedText: "Tous les types d'activités"});
        $("select[name='avis[]']").multiselect({header: false, noneSelectedText: "Tous les avis"});
        $("select[name='presences_local_sommeil[]']").multiselect({header: false, noneSelectedText: "Qu'importe la présence de local à sommeil", minWidth: 300});
        $("select[name='commissions[]']").multiselect({header: false, noneSelectedText: "Toutes les commissions"});
        $("select[name='groupements_territoriaux[]']").multiselect({header: false, noneSelectedText: "Tous les groupements territoriaux", minWidth: 300});

        // Affichage des critères en fonction du genre
        function display_criteres_by_genres() {
            $("#categorie_span, #classe_span, #famille_span, #type_span").hide();
            var array = $("select[name='genres[]']").multiselect("getChecked").each(function() {
                switch(this.value) {
                    case '2' : $("#type_span, #categorie_span").show(); break;
                    case '3' : $("#type_span, #categorie_span").show(); break;
                    case '4' : $("#famille_span").show(); break;
                    case '5' : $("#classe_span").show(); break;
                }
            });
        }

        $("select[name='genres[]']").bind("multiselectclick", function() {display_criteres_by_genres()});
        display_criteres_by_genres();

        // Slide des établissements enfants
        $("ul.recherche_liste li.slide").live("click", function() {
            if($(this).is('a')) {
                return;
            }
            var container = this;
            if( $(this).hasClass("active") ) {
                $(this).next().slideUp(400, function() {$(container).next().remove()});
                $(this).toggleClass("active");
            }
            else {
                $(container).find(".load").show();
                $.post("{{ path('search_ajax_etablissement') }}", {parent: $(this).attr("id")}, function(html) {
                    $(container).toggleClass("active").find(".load").hide();
                    $(container).after("<li style='display:none; overflow:auto; height:auto;'>" + html + "</li>").next().slideDown();
                });
            }
        });

        $('#zone_de_recherche_edit').click(function(e){
            e.preventDefault();
            $('#zone_de_recherche_modal').modal();
        });

        $('#zone_de_recherche_reset').click(function(e){
            e.preventDefault();
            $("input[name='zone_de_recherche_text']").val("Département");
            $(".zone_de_recherche_text").text("Département");

            $("input[name='city']").val("");
            $("input[name='street']").val("");
            $("input[name='number']").val("");
        });

        // Auto complétion de la ville
        $("#zone_de_recherche_modal input[name='commune_ac']").autocomplete("{{ path('api_adresse_get_communes') }}", {
            minChars: 2,
            cacheLength: 0,
            parse: function(data) {
                return $.map(data["response"], function(row) {return {data: row, value: row.LIBELLE_COMMUNE, result: row.LIBELLE_COMMUNE}});
            },
            formatItem: function(item) {
                return item.LIBELLE_COMMUNE + " (" + item.NUMINSEE_COMMUNE + ")";
            }
        }).result(function(e, item) {
            $("input[name='code_insee']").val( item.NUMINSEE_COMMUNE );
            $("input[name='voie_ac']").removeAttr('disabled');
            $("input[name='numero_ac']").removeAttr('disabled');
        }).click(function() {
            $(this).val("");
            $("input[name='voie_ac']").val("").attr("disabled", true).blur();
            $("input[name='voie']").val("").blur();
            $("input[name='numero_ac']").val("").attr("disabled", true).blur();
            $("input[name='numero_voie']").val("").blur();
        });

        // Auto complétion de la rue
        $("#zone_de_recherche_modal input[name='voie_ac']").autocomplete('{{ path('api_adresse_get_voies') }}', {
            minChars: 2,
            cacheLength: 0,
            extraParams: { code_insee: function(){ return $("input[name='code_insee']").val() } },
            parse: function(data) {
                return $.map(data["response"], function(row) { return {data: row, value: row.LIBELLE_RUE, result: row.LIBELLE_RUE} });
            },
            formatItem: function(item) {
                return item.LIBELLE_RUE;
            }
        }).result(function(e, item) {
            $("input[name='voie']").val( item.ID_RUE );
            $("input[name='numero_ac']").removeAttr('disabled');
        }).click(function() {
            $(this).val("");
            $("input[name='numero_ac']").val("").attr("disabled", true).blur();
            $("input[name='numero_voie']").val("").blur();
        });

        // Validation de la zone de recherche
        $('#zone_de_recherche_modal a.submit').click(function() {
            var text = 'Département';

            if($("input[name='code_insee']").val() != '') {
                var text = $("input[name='commune_ac']").val();
                if($("input[name='voie_ac']").val() != '') {
                    var text = $("input[name='commune_ac']").val() + ', ' + $("input[name='voie_ac']").val();
                    if($("input[name='numero_ac']").val() != '') {
                        var text = $("input[name='commune_ac']").val() + ', ' + $("input[name='voie_ac']").val() + ', ' + $("input[name='numero_ac']").val();
                    }
                }
            }

            $("input[name='zone_de_recherche_text']").val(text);
            $(".zone_de_recherche_text").text(text);

            $("input[name='city']").val($("input[name='code_insee']").val());
            $("input[name='street']").val($("input[name='voie']").val());
            $("input[name='number']").val($("input[name='numero_ac']").val());
            $('#zone_de_recherche_modal').modal('hide');
        });
    });

    // Gestion des select et multiselect
    $(".chosen").chosen({
        allow_single_deselect: true
    });

    function masquerBoutonExportCalc ()
    {
        // Export Calc non migré
    }
    function afficherBoutonExportCalc ()
    {
        // Export Calc non migré
    }
</script>
{% endblock %}
