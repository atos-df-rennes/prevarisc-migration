{% extends 'layouts/search.html.twig' %}

{% block title %}Recherche dossiers{% endblock %}

{% block body %}

{# Traitement pour l'affichage des dates #}
{% set date_creation_start = app.request.query.get('date-creation-start', '') %}
{% set date_creation_end = app.request.query.get('date-creation-end', '') %}
{% set date_reception_start = app.request.query.get('date-reception-start', '') %}
{% set date_reception_end = app.request.query.get('date-reception-end', '') %}
{% set date_reponse_start = app.request.query.get('date-reponse-start', '') %}
{% set date_reponse_end = app.request.query.get('date-reponse-end', '') %}

<h2 class="page-header">Dossiers</h2>
<form method='get'>
    <div class='well well-sm clearfix' style='margin-bottom: 5px;'>
        <div class="input-group pull-left" style="max-width: 340px;">
            <input type="text" name='objet' class="form-control search-query"
                   placeholder="Objet du dossier ..."
                   value="{{ app.request.query.get('objet', '') }}"
                   onkeypress="masquerBoutonExportCalc()"/>
            <span class="input-group-btn">
                <input type='submit' class="btn btn-default" name='Rechercher' value="Rechercher" onsubmit="afficherBoutonExportCalc()" />
            </span>
        </div>
        <input type='hidden' name='page' value="1" />

        <div class="pull-left" style='margin: 9px 0 0 5px'>
            <small>
                <a href="{{ path('search_dossier', {objet: '', page: 1, Rechercher: 'Rechercher'}) }}">
                    Réinitialiser
                </a>
            </small>
        </div>
    </div>

    <div id='filterContainer' class='well' style="margin-left: 0;">
        <div>
            <select name='types[]' style="width: 23%" data-placeholder='Types' multiple onchange="masquerBoutonExportCalc()">
                {% for type in DB_type %}
                    <option value='{{ type.id }}'
                        {% if app.request.query.get('types') is not null and type.id in app.request.query.get('types') %}selected{% endif %}>
                        {{ type.libelle }}
                    </option>
                {% endfor %}
            </select>
            <select name='commissions[]' style="width: 23%" data-placeholder='Commissions' multiple onchange="masquerBoutonExportCalc()">
                {% for array_commission in array_commissions %}
                    <optgroup label="{{ array_commission.LIBELLE|e('html_attr') }}">
                        {% for item in array_commission.ARRAY %}
                            <option value='{{ item.ID_COMMISSION }}'
                                {% if app.request.query.get('commissions') is not null and item.ID_COMMISSION in app.request.query.get('commissions') %}selected{% endif %}>
                                {{ item.LIBELLE_COMMISSION }}
                            </option>
                        {% endfor %}
                    </optgroup>
                {% endfor %}
            </select>
            <select name='groupements_territoriaux[]' style="width: 23%" data-placeholder='Groupements territoriaux' multiple onchange="masquerBoutonExportCalc()">
                {% for groupement in DB_groupementterritorial %}
                    {% set selected = false %}
                    {% if user is not null %}
                        {% for user_groupement in user.groupements %}
                            {% if groupement.ID_GROUPEMENT == user_groupement.id %}
                                {% set selected = true %}
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                    <option value='{{ groupement.ID_GROUPEMENT }}'
                        {% if (app.request.query.get('groupements_territoriaux') is not null and groupement.ID_GROUPEMENT in app.request.query.get('groupements_territoriaux')) or selected %}selected{% endif %}>
                        {{ groupement.LIBELLE_GROUPEMENT }}
                    </option>
                {% endfor %}
            </select>
            <select name='avisCommission[]' style="width: 23%" data-placeholder='Avis de la commission' multiple onchange="masquerBoutonExportCalc()">
                <option value='1' {% if app.request.query.get('avisCommission') is not null and 1 in app.request.query.get('avisCommission') %}selected{% endif %}>Favorable</option>
                <option value='2' {% if app.request.query.get('avisCommission') is not null and 2 in app.request.query.get('avisCommission') %}selected{% endif %}>Défavorable</option>
            </select>
        </div>

        <div style="margin-top: 4px;">
            <select name='avisRapporteur[]' style="width: 23%" data-placeholder='Avis du rapporteur' multiple onchange="masquerBoutonExportCalc()">
                <option value='1' {% if app.request.query.get('avisRapporteur') is not null and 1 in app.request.query.get('avisRapporteur') %}selected{% endif %}>Favorable</option>
                <option value='2' {% if app.request.query.get('avisRapporteur') is not null and 2 in app.request.query.get('avisRapporteur') %}selected{% endif %}>Défavorable</option>
            </select>
            {% if platau_active %}
                <select name='provenance' style="width: 23%" data-placeholder='Provenance' multiple onchange="masquerBoutonExportCalc()">
                    <option value='1' {% if app.request.query.get('provenance') is not null and 1 in app.request.query.get('provenance') %}selected{% endif %}>Provenant de PLATAU</option>
                    <option value='2' {% if app.request.query.get('provenance') is not null and 2 in app.request.query.get('provenance') %}selected{% endif %}>Ne provenant pas de PLATAU</option>
                </select>
            {% endif %}
        </div>

        <div class='row' style="margin-top: 20px;">
            <div class='col-md-7'>
                <div class='row'>
                    <div class='col-md-6'>
                        <select name='commune' class="form-control" data-placeholder='Sélectionner une commune' onchange="masquerBoutonExportCalc()">
                            <option value=''></option>
                            {% for commune in array_communes %}
                                <option value='{{ commune.NUMINSEE_COMMUNE }}'
                                    {% if app.request.query.get('commune') == commune.NUMINSEE_COMMUNE %}selected{% endif %}>
                                    {{ commune.LIBELLE_COMMUNE }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class='col-md-6'>
                        <select name='voie' class="form-control" data-placeholder='Sélectionner une voie' onchange="masquerBoutonExportCalc()">
                            <option value=''></option>
                            {% for voie in array_voies %}
                                <option value='{{ voie.ID_RUE }}'
                                    {% if app.request.query.get('voie') == voie.ID_RUE %}selected{% endif %}>
                                    {{ voie.LIBELLE_RUE }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
                <div class='row' style="margin-top: 4px;">
                    <div class='col-md-6'>
                        <select name='numero' class="form-control" data-placeholder='Sélectionner un numéro' onchange="masquerBoutonExportCalc()">
                            <option value=''></option>
                            {% for numero in array_numeros %}
                                <option value='{{ numero.NUMERO_ADRESSE }}'
                                    {% if app.request.query.get('numero') == numero.NUMERO_ADRESSE %}selected{% endif %}>
                                    {{ numero.NUMERO_ADRESSE }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
                <div class='row' style="margin-top: 10px;">
                    <div class="col-md-6">
                        <select name="preventionniste" class='form-control' data-placeholder='Sélectionner un préventionniste' onchange="masquerBoutonExportCalc()">
                            <option value=''></option>
                            {% for prev in liste_prev %}
                                <option value='{{ prev.ID_PREVENTIONNISTE }}'
                                    {% if app.request.query.get('preventionniste') == prev.ID_PREVENTIONNISTE %}selected{% endif %}>
                                    {{ prev.NOM_UTILISATEURINFORMATIONS }} {{ prev.PRENOM_UTILISATEURINFORMATIONS }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
                <div class='row' style="margin-top: 15px;">
                    <div class='col-md-6'>
                        <input type="text" name='permis' class='form-control'
                               value="{{ app.request.query.get('permis', '') }}"
                               placeholder="Numéro de permis" onkeypress="masquerBoutonExportCalc()" />
                    </div>
                </div>
            </div>
            <div class='col-md-5'>
                <div class='row'>
                    <div class='col-md-2'>Création</div>
                    <div class='col-md-1'>du</div>
                    <div class='col-md-4'>
                        <input type='text' name='date-creation-start' value='{{ date_creation_start }}' class='datepicker form-control' onchange="masquerBoutonExportCalc()" onkeypress="masquerBoutonExportCalc()">
                    </div>
                    <div class='col-md-1'>au</div>
                    <div class="col-md-4">
                        <input type='text' name='date-creation-end' value='{{ date_creation_end }}' class='datepicker form-control' onchange="masquerBoutonExportCalc()" onkeypress="masquerBoutonExportCalc()">
                    </div>
                </div>
                <div class='row' style="margin-top: 4px;">
                    <div class='col-md-2'>Réception</div>
                    <div class='col-md-1'>du</div>
                    <div class="col-md-4">
                        <input type='text' name='date-reception-start' value='{{ date_reception_start }}' class='datepicker form-control' onchange="masquerBoutonExportCalc()" onkeypress="masquerBoutonExportCalc()"/>
                    </div>
                    <div class='col-md-1'>au</div>
                    <div class="col-md-4">
                        <input type='text' name='date-reception-end' value='{{ date_reception_end }}' class='datepicker form-control' onchange="masquerBoutonExportCalc()" onkeypress="masquerBoutonExportCalc()"/>
                    </div>
                </div>
                <div class='row' style="margin-top: 4px;">
                    <div class='col-md-2'>Réponse</div>
                    <div class='col-md-1'>du</div>
                    <div class="col-md-4">
                        <input type='text' name='date-reponse-start' value='{{ date_reponse_start }}' class='datepicker form-control' onchange="masquerBoutonExportCalc()" onkeypress="masquerBoutonExportCalc()"/>
                    </div>
                    <div class='col-md-1'>au</div>
                    <div class="col-md-4">
                        <input type='text' name='date-reponse-end' value='{{ date_reponse_end }}' class='datepicker form-control' onchange="masquerBoutonExportCalc()" onkeypress="masquerBoutonExportCalc()"/>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% if results is not null and results.totalCount > 0 %}
        <div style='display:inline-block;width: 100%;'>
            <div class='pull-left'>
                <p class='text-muted'><small>Nombre total d'éléments : {{ results.totalCount }}</small></p>
            </div>
            {% if is_allowed_export_calc %}
            <div class='pull-right'>
                {% if results.totalCount <= 10000 %}
                    <input type='submit' class='btn btn-success' id='exporter' name='Exporter' value='Export Calc'>
                {% else %}
                    <small style='font-weight:bold;color:red;'>La fonctionnalité d'export Calc est limitée à 10 000 éléments</small>
                {% endif %}
            </div>
            {% endif %}
        </div>

        <table class='table table-condensed'>
            <tr>
                <th>Etablissement</th>
                <th>Objet</th>
                <th>Date</th>
                <th>Préventionnistes</th>
                <th>Pièces jointes</th>
            </tr>
            {% for item in results.items %}
                {{ include('search/results/_dossier_tab.html.twig', {item: item}) }}
            {% endfor %}
        </table>
        <br/>
        <div style='clear: both'></div>
        {{ include('search/_pagination.html.twig', {pagination: results}) }}
    {% elseif results is not null %}
        <p class='text-muted'><small>Aucun résultat disponible.</small></p>
    {% endif %}
</form>

<script>
    $(document).ready(function() {

        // Gestion des selects → TomSelect
        const tsDossierMultiConfig = { plugins: ['remove_button'], maxOptions: null };
        new TomSelect("select[name='types[]']", Object.assign({}, tsDossierMultiConfig, { placeholder: 'Types' }));
        new TomSelect("select[name='commissions[]']", Object.assign({}, tsDossierMultiConfig, { placeholder: 'Commissions' }));
        new TomSelect("select[name='groupements_territoriaux[]']", Object.assign({}, tsDossierMultiConfig, { placeholder: 'Groupements territoriaux' }));
        new TomSelect("select[name='avisCommission[]']", Object.assign({}, tsDossierMultiConfig, { placeholder: 'Avis de la commission' }));
        new TomSelect("select[name='avisRapporteur[]']", Object.assign({}, tsDossierMultiConfig, { placeholder: 'Avis du rapporteur' }));
        {% if platau_active %}
        new TomSelect("select[name='provenance']", Object.assign({}, tsDossierMultiConfig, { placeholder: 'Provenance' }));
        {% endif %}
        new TomSelect("select[name='commune']", { allowEmptyOption: true, placeholder: 'Sélectionner une commune' });
        const tsVoie = new TomSelect("select[name='voie']", { allowEmptyOption: true, placeholder: 'Sélectionner une voie' });
        const tsNumero = new TomSelect("select[name='numero']", { allowEmptyOption: true, placeholder: 'Sélectionner un numéro' });
        new TomSelect("select[name='preventionniste']", { allowEmptyOption: true, placeholder: 'Sélectionner un préventionniste' });

        $('select[name=commune]').change(function(){
            var selectedValue = $(this).val()
            if (selectedValue != ""){
                $.ajax({
                    url: "{{ path('api_adresse_get_voies') }}",
                    type: 'post',
                    data: {
                        code_insee: selectedValue
                    },
                    success: function (result) {
                        tsVoie.clear(true);
                        tsVoie.clearOptions();
                        tsVoie.addOption({ value: '', text: '' });
                        $.each(result.response, function (i, voie) {
                            tsVoie.addOption({ value: voie.ID_RUE, text: voie.LIBELLE_RUE });
                        });
                        tsVoie.refreshOptions(false);
                    }
                });
            }
        });

        $('select[name=voie]').change(function(){
            var selectedValue = $(this).val()
            if (selectedValue != ""){
                $.ajax({
                    url: "{{ path('api_adresse_get_numeros') }}",
                    type: 'post',
                    data: {
                        id_rue: selectedValue
                    },
                    success: function (result) {
                        tsNumero.clear(true);
                        tsNumero.clearOptions();
                        tsNumero.addOption({ value: '', text: '' });
                        $.each(result.response, function (i, numero) {
                            tsNumero.addOption({ value: numero.NUMERO_ADRESSE, text: numero.NUMERO_ADRESSE });
                        });
                        tsNumero.refreshOptions(false);
                    }
                });
            }
        });

        $(".datepicker").datepicker({
            dateFormat:"dd/mm/yy",
            monthNames: ["Janvier", "Février", "Mars", "Avril", "Mai", "Juin", "Juillet", "Août", "Septembre", "Octobre", "Novembre", "Décembre"],
            dayNamesMin: ["Di","Lu","Ma","Me","Je","Ve","Sa"],
            firstDay: 1,
            changeMonth: true,
            onClose: function(selectedDate) {
                var name = $(this).attr("name");
                var lastPart = name.split("-").pop();
                var startName = name.slice(0, -lastPart.length);
                var minMaxDate = "minDate";
                var nameSuffix = "end";
                if (lastPart === "end") {
                    minMaxDate = "maxDate";
                    nameSuffix = "start";
                }
                var finalName = ".datepicker[name='" + startName + nameSuffix + "']";
                $(finalName).datepicker("option", minMaxDate, selectedDate);
            }
        });

        $("a.pj").click(function(e){
            e.preventDefault();
            var rowvalue = $(this).find('i').attr('id').substring(6);
            $('#rowpj'+rowvalue).toggle();
        });
    });

    function masquerBoutonExportCalc ()
    {
        $('#exporter').css('visibility', 'hidden');
        $('#exporter').parent().css('visibility', 'hidden');
    }

    function afficherBoutonExportCalc ()
    {
        $('#exporter').css('visibility', 'visible');
        $('#exporter').parent().css('visibility', 'visible');
    }
</script>
{% endblock %}
