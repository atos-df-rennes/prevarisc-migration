{#
  Élément <li> de résultat dossier dans une liste du tableau de bord.
  Port direct de search/results/dossier.phtml.
  Variable : item (array)
#}
{% set date_text = '' %}
{% set date = '' %}
{% if item.DATECOMM_DOSSIER is not empty %}
    {% set date_str = item.DATECOMM_DOSSIER|slice(0, 10) %}
    {% set date = date_str != '0000-00-00' ? date_str|date('d/m/Y') : '00/00/0000' %}
    {% set date_text = 'ayant pour date de passage en commission le' %}
{% elseif item.DATEVISITE_DOSSIER is not empty %}
    {% set date_str = item.DATEVISITE_DOSSIER|slice(0, 10) %}
    {% set date = date_str != '0000-00-00' ? date_str|date('d/m/Y') : '00/00/0000' %}
    {% set date_text = 'ayant pour date de visite le' %}
{% elseif item.DATEINSERT_DOSSIER is not empty %}
    {% set date_str = item.DATEINSERT_DOSSIER|slice(0, 10) %}
    {% set date = date_str != '0000-00-00' ? date_str|date('d/m/Y') : '00/00/0000' %}
    {% set date_text = 'créé le' %}
{% endif %}

{% set objet = '' %}
{% if item.OBJET_DOSSIER is not empty %}
    {% set objet = item.OBJET_DOSSIER|length > 70 ? item.OBJET_DOSSIER|slice(0, 70) ~ '(...)' : item.OBJET_DOSSIER %}
    {% if item.NB_URBA is not empty %}
        {% set objet = objet ~ ' - ' ~ item.NB_URBA %}
    {% endif %}
{% elseif item.NB_URBA is not empty %}
    {% set objet = item.NB_URBA %}
{% endif %}

{% set fulltext_parts = [item.LIBELLE_DOSSIERTYPE, item.LIBELLE_DOSSIERNATURE] %}
{% if objet is not empty %}{% set fulltext_parts = fulltext_parts|merge([objet]) %}{% endif %}
{% set fulltext = fulltext_parts|join(' - ') %}

<li class="dossier" id="{{ item.ID_DOSSIER }}">

    <div class="pull-left">
        <span class="doss-nom">
            {% if item.VERROU_DOSSIER == 1 %}
                <span class="glyphicon glyphicon-lock" aria-hidden="true"></span>
            {% endif %}
            {% if item.NB_PJ > 0 %}
                <a href="{{ path('dossier_pieces_jointes', {id: item.ID_DOSSIER}) }}">
                    <span class="glyphicon glyphicon-file" aria-hidden="true"></span>
                </a>
            {% endif %}
            <a href="{{ path('dossier_index', {id: item.ID_DOSSIER}) }}" title="{{ fulltext|e('html_attr') }}">
                {% if item.LIBELLE_ETABLISSEMENTINFORMATIONS is not empty %}
                    [{{ item.LIBELLE_ETABLISSEMENTINFORMATIONS }}]&nbsp;
                {% endif %}
                {{ fulltext }}
            </a>
        </span>

    </div>

    <div style="clear: both"></div>

    <div class="pull-left mt-2">
        <span class="label label-default">
            <span class="glyphicon glyphicon-calendar" aria-hidden="true"></span>&nbsp;{{ date_text }} {{ date }}
        </span>

        {% if item.DATE_REPONSE_ATTENDUE is not empty %}
            {% set temps = platau_temps_restant(item.DATE_REPONSE_ATTENDUE) %}
            {% if temps is not empty %}
                <span class="label label-{{ platau_couleur_temps_restant(item.DATE_REPONSE_ATTENDUE) }} ml-2">
                    <span class="glyphicon glyphicon-time" aria-hidden="true"></span>&nbsp;Temps restant : {{ temps }}
                </span>
            {% endif %}
        {% endif %}

        {% if item.IS_NEW is defined and item.IS_NEW %}
            <span class="label label-danger">
                <span class="glyphicon glyphicon-folder-open" aria-hidden="true"></span>&nbsp;Nouveau dossier !
            </span>
        {% endif %}
        {% if item.HAS_NEW_PJ is defined and item.HAS_NEW_PJ %}
            <span class="label label-warning">
                <span class="glyphicon glyphicon-share" aria-hidden="true"></span>&nbsp;Nouvelles pièces !
            </span>
        {% endif %}
    </div>

    <div style="clear: both"></div>

    <div class="pull-left mt-3">
        {% if item.ID_PLATAU is not empty %}
            <span class="label label-info">CONSULTATION PLATAU : {{ item.ID_PLATAU }}</span>
        {% endif %}
        {% if item.ID_PLATAU is not empty and item.INCOMPLET_DOSSIER is empty %}
            <span class="label label-info">EN ATTENTE DE PEC</span>
        {% endif %}

        {{ item|dossier_avis_badge }}

        {% if item.ALERTE_RECEPTION_TRAVAUX > 0 %}
            <span class="avis" style="background-color: #3a87ad;">Présence d'un dossier de reception de travaux</span>
        {% endif %}
        {% if item.ECHEANCIER_TRAVAUX > 0 %}
            <span class="avis" style="background-color: #3a87ad;">Fait l'objet d'un échéancier de travaux</span>
        {% endif %}
    </div>

    <div style="clear: both"></div>
</li>
