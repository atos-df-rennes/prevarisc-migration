{% extends 'layouts/admin.html.twig' %}

{% form_theme form '_form_theme.html.twig' %}

{% set rappelReg = app.request.get('rappelReg') %}

{% if rappelReg is null %}
    {% set title = 'Ajout d\'un nouveau rappel réglementaire' %}
{% else %}
    {% set title = 'Modification d\'un rappel réglementaire existant' %}
{% endif %}

{% block title %}Administration / Gestion des prescriptions / Gestion des rappels réglementaires / {{ title }}{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-md-12">
            <a href="/gestion-prescriptions">Gestion des prescriptions types</a> <i class="glyphicon glyphicon-chevron-right"></i> <a href="{{ path('admin_prescriptions_rappels') }}">Gestion des rappels réglementaires</a>
            <i class="glyphicon glyphicon-chevron-right"></i>{{ title }}
        </div>
    </div>

    <h3 class="page-header">{{ title }}</h3>

    {{ form_start(form) }}
    <div class="row text-right mb-4">
        <div class="col-sm-12">
            <a class="btn btn-default" href="{{ path('admin_prescriptions_rappels') }}">
                {% if rappelReg is null %}
                    Annuler l'ajout
                {% else %}
                    Annuler la modification
                {% endif %}
            </a>
            <input type="submit" class="btn btn-success" value="Sauvegarder" />
        </div>
    </div>

    {{ form_row(form.type) }}
    {{ form_row(form.visible) }}

    {{ form_row(form.libelle) }}

    {% do form.associations.setRendered %}
    <fieldset>
        <legend>Associations</legend>

        <ul id="prescription_reglementaire_associations"
            class="list-unstyled mt-4"
            data-prototype="{{ form_widget(form.associations.vars.prototype)|e }}"
            data-widget-tags="{{ '<li></li>'|e }}"
            data-widget-counter="{{ form.associations|length }}">
            {% for associationField in form.associations %}
                <li>
                    {{ form_errors(associationField) }}
                    {{ form_widget(associationField) }}
                </li>
            {% endfor %}
        </ul>

        <div class="text-center">
            <button type="button"
                class="btn btn-default add-another-collection-widget"
                data-list-selector="#prescription_reglementaire_associations">Ajouter une association</button>
        </div>
    </fieldset>

    {{ form_end(form) }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/formulaire/add-collection-widget.js') }}"></script>
{% endblock %}