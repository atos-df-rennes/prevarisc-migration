{% extends 'layouts/admin.html.twig' %}

{% block title %}
    Administration / Gestion des documents consultés
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="text/javascript">
        $(document).ready(function() {
            $(".createDocumentConsulte").click(function() {
                $('#documentConsulteModalLabel').text("Ajouter un document consulté");
                $.ajax({
                    type: "GET",
                    url: "/admin/documents-consultes/add",
                    success: function(msg) {
                        $('#documentConsulteModal .modal-body').html(msg);
                    },
                });
            });
            $(".editDocumentConsulte").click(function() {
                const id = $(this).data("doc-id");
                $('#documentConsulteModalLabel').text("Modifier un document consulté");
                $.ajax({
                    type: "GET",
                    url: "/admin/documents-consultes/" + id + "/edit",
                    success: function(msg) {
                        $('#documentConsulteModal .modal-body').html(msg);
                    },
                });
            });
        });
    </script>
{% endblock %}

{% block body %}
    <h3 class="page-header">Gestion des documents consultés</h3>

    <button id="createDocumentConsulte" class="btn btn-primary mb-4 createDocumentConsulte" data-toggle="modal" data-target="#documentConsulteModal">
        <span class="glyphicon glyphicon-plus" aria-hidden="true"></span>&nbsp;Ajouter un document consulté
    </button>

    <ul class="list-unstyled container-fluid sortDocumentConsulte" id="sortableDocuments">
        {% for doc in documents %}
            <li class="row" style="margin-top:15px; margin-bottom:10px;" id="doc_{{ doc.id }}">
                <div class="col-xs-8">
                    <span class="glyphicon glyphicon-file" aria-hidden="true"></span>
                    {% if doc.visible %}
                        <img src='{{ asset('images/visible.gif') }}' alt='visible' />
                    {% else %}
                        <img src='{{ asset('images/nonvisible.gif') }}' alt='non visible' />
                    {% endif %}

                    {{ doc.libelle }}
                </div>
                <div class="col-xs-3 col-xs-offset-1">
                    <div class="row">
                        <div class="col-xs-6">
                            <button class="editDocumentConsulte btn btn-default btn-block"
                                    data-doc-id="{{ doc.id }}"
                                    data-toggle="modal"
                                    data-target="#documentConsulteModal">
                                <span class="glyphicon glyphicon-pencil" aria-hidden="true"></span> Éditer
                            </button>
                        </div>
                    </div>
                </div>
            </li>
        {% else %}
            <li>Aucun document consulté trouvé.</li>
        {% endfor %}
    </ul>

    {{ include('documents_consultes/_modal.html.twig') }}
{% endblock %}
