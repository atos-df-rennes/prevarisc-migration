<?xml version="1.0" encoding="utf-8" ?>
<kml xmlns="http://www.opengis.net/kml/2.2">
    <Document>
        <Folder>
            <name>{{ libelle }}</name>
            <Style id="etablissement">
                <IconStyle>
                    <Icon>
                        <href>{{ image_url }}</href>
                    </Icon>
                </IconStyle>
            </Style>
            <Placemark>
                <styleUrl>#etablissement</styleUrl>
                <description>
                    <![CDATA[
                    <strong>{{ libelle }}</strong><br>
                    {{ adresse.numero }} {{ adresse.rue ? adresse.rue.libelle : '' }}<br>
                    {{ adresse.complement }}<br>
                    {{ adresse.commune ? adresse.commune.codePostal : '' }} {{ adresse.commune ? adresse.commune.libelle : '' }}
                    ]]>
                </description>
                <Point><coordinates>{{ adresse.longitude }},{{ adresse.latitude }}</coordinates></Point>
            </Placemark>
        </Folder>
    </Document>
</kml>
