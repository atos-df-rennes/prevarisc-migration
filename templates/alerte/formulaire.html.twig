{# Template pour formulaire d'alerte email (modale Bootstrap 3) #}
{# Équivalent legacy : changement/alerteform.phtml #}

<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal" aria-label="Fermer">
        <span aria-hidden="true">&times;</span>
    </button>
    <h4 class="modal-title">Alerter par email</h4>
</div>

<div class="modal-body">
    {# Message affiché quand aucun destinataire (initialement ou après retrait) #}
    <div id="mail-no-destinataires" {% if emails is not empty %}style="display: none;"{% endif %}>
        <div class="alert alert-warning">
            <h4><span class="glyphicon glyphicon-warning-sign" aria-hidden="true"></span> Aucun destinataire</h4>
            <p>Aucun utilisateur n'a été trouvé pour l'envoi par mail de cette alerte.</p>
            <p>Pour y remédier, vérifiez que les utilisateurs concernés ont les droits requis pour les alertes par email.</p>
            <p>Si tous les destinataires ont été retirés, fermez cette fenêtre et recliquez sur "Alerter".</p>
        </div>
    </div>

    {# Formulaire affiché quand il y a des destinataires #}
    <form id="formAlerte" method="POST" {% if emails is empty %}style="display: none;"{% endif %} action="{{ path('alerte_envoyer') }}" >
        <div class="form-group">
            <label class="control-label">À :</label>
            <div class="bcc-rcpt">
                {% for destinataire in destinataires %}
                    <span id="dst_{{ destinataire.id }}" class="label label-info">
                        {{ destinataire.nom }}, {{ destinataire.prenom }}
                        <a href="#" class="remove-dst" data-id="{{ destinataire.id }}" data-email="{{ destinataire.mail }}">
                            <span class="glyphicon glyphicon-remove" aria-hidden="true"></span>
                        </a>
                    </span>
                {% endfor %}
            </div>
            <input type="hidden" name="emails" id="mail-emails-dst" value="{{ emails }}" />
            <input type="hidden" name="etablissement" value="{{ etablissementId }}" />
            <input type="hidden" name="type" value="{{ typeChangement }}" />
        </div>

        <div class="form-group">
            <label for="alerte-objet" class="control-label">Objet :</label>
            <input type="text" class="form-control" name="objet" id="alerte-objet" value="{{ objet }}" required />
        </div>

        <div class="form-group">
            <label for="alerte-message" class="control-label">Message :</label>
            <textarea name="message" id="alerte-message" class="form-control tinymce-editor" rows="10">{{ message }}</textarea>
        </div>
    </form>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-default" data-dismiss="modal">Annuler</button>
    <button type="button" class="btn btn-primary" id="btn-envoyer-alerte" {% if emails is empty %}style="display: none;"{% endif %}>
        <span class="glyphicon glyphicon-send" aria-hidden="true"></span> Envoyer
    </button>
</div>

<script type="text/javascript">
$(document).ready(function() {
    // Initialiser TinyMCE sur le textarea si formulaire visible
    {% if emails is not empty %}
    tinymce.init({
        selector: '#alerte-message',
        height: 220,
        menubar: false,
        statusbar: false,
        toolbar: false,
        plugins: [
            'advlist autolink lists link image charmap print preview anchor',
            'searchreplace visualblocks code fullscreen',
            'insertdatetime media table contextmenu paste code'
        ],
        language: 'fr_FR'
    });
    {% endif %}

    // Retirer un destinataire
    $('.remove-dst').on('click', function(e) {
        e.preventDefault();
        var userId = $(this).data('id');
        var email = $(this).data('email');

        // Retirer de la liste des emails
        var emails = $('#mail-emails-dst').val().split(';');
        var index = emails.indexOf(email);
        if (index > -1) {
            emails.splice(index, 1);
        }
        $('#mail-emails-dst').val(emails.join(';'));

        // Retirer visuellement
        $('#dst_' + userId).remove();

        // Si plus de destinataires, afficher message et masquer formulaire + bouton
        if (emails.length === 0 || (emails.length === 1 && emails[0] === '')) {
            $('#formAlerte').hide();
            $('#mail-no-destinataires').show();
            $('#btn-envoyer-alerte').hide();
        }
    });

    // Envoi du formulaire
    $('#btn-envoyer-alerte').on('click', function() {
        var $btn = $(this);
        var originalHtml = $btn.html();

        // Récupérer contenu TinyMCE
        var message = tinymce.get('alerte-message').getContent();

        // Désactiver bouton pendant envoi
        $btn.prop('disabled', true)
            .html('<span class="glyphicon glyphicon-hourglass" aria-hidden="true"></span> Envoi en cours...');

        $.ajax({
            url: '{{ path('alerte_envoyer') }}',
            type: 'POST',
            data: {
                emails: $('#mail-emails-dst').val(),
                objet: $('#alerte-objet').val(),
                message: message
            },
            dataType: 'json',
            success: function(response) {
                if (response.success) {
                    // Toast succès
                    $('#main_content').prepend(
                        '<div class="alert alert-success alert-dismissible" role="alert">' +
                        '<button type="button" class="close" data-dismiss="alert" aria-label="Fermer">' +
                        '<span aria-hidden="true">&times;</span></button>' +
                        '<span class="glyphicon glyphicon-ok" aria-hidden="true"></span> ' +
                        response.message +
                        '</div>'
                    );

                    // Fermer modale
                    $('#modal-alerte').modal('hide');
                } else {
                    // Toast erreur
                    alert('Erreur : ' + response.message);
                    $btn.prop('disabled', false).html(originalHtml);
                }
            },
            error: function(xhr) {
                alert('Erreur lors de l\'envoi de l\'email. Veuillez réessayer.');
                $btn.prop('disabled', false).html(originalHtml);
            }
        });
    });
});
</script>
