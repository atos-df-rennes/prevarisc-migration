{# Modale Bootstrap 3 pour alertes email - Structure complète avec états (BLOC 17 Part 3B) #}

<div class="modal fade" id="modalAlerte" tabindex="-1" role="dialog" aria-labelledby="modalAlerteLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            {# État : Chargement #}
            <div id="alerte-loading" class="modal-body text-center" style="display: none;">
                <span class="glyphicon glyphicon-refresh spinning" aria-hidden="true"></span> Chargement...
            </div>

            {# État : Erreur #}
            <div id="alerte-error" style="display: none;">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Fermer">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    <h4 class="modal-title">Erreur</h4>
                </div>
                <div class="modal-body">
                    <div class="alert alert-danger">Erreur lors du chargement du formulaire.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Fermer</button>
                </div>
            </div>

            {# État : Contenu formulaire (chargé dynamiquement) #}
            <div id="alerte-content">
                {# Contenu chargé via AJAX depuis /symfony/alerte/formulaire #}
            </div>
        </div>
    </div>
</div>
