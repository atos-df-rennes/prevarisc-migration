<form action="{{ path('admin_formulaires_import') }}" enctype="multipart/form-data" method="post">
    <div id="import-configuration" class="modal fade" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h4 class="modal-title">Import d'une configuration</h4>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label class="control-label" for="configuration-file">Fichier de configuration</label>
                        <input id="configuration-file" name="configuration-file" type="file" class="form-control" />
                    </div>

                    <div class="form-group">
                        <div class="checkbox">
                            <label>
                                <input name="delete-existing-configuration" type="checkbox" />
                                Supprimer la configuration existante
                            </label>
                        </div>
                        <span class="help-block">
                            La suppression de la configuration existante entrainera également la suppression de toutes les données associées
                        </span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-default" data-dismiss="modal" aria-hidden="true">Annuler</button>
                    <button type="submit" class="btn btn-success">Importer la configuration</button>
                </div>
            </div>
        </div>
    </div>
</form>
