{% extends 'layouts/admin.html.twig' %}

{% block title %}Administration / Gestion des formulaires personnalisés / Modifier un champ{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    <link href="{{ asset('css/formulaire-bs3/formulaire.css') }}" rel="stylesheet" />
    <link href="{{ asset('css/formulaire-bs3/edit-table.css') }}" rel="stylesheet" />
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script src="{{ asset('js/formulaire/handle-type-champ.js') }}"></script>
    <script src="{{ asset('js/formulaire/champ.js') }}"></script>
    <script src="{{ asset('js/formulaire/ordonnancement/ordonnancement.js') }}"></script>
    <script src="{{ asset('js/formulaire/ordonnancement/Sortable.min.js') }}"></script>
    <script src="{{ asset('js/formulaire/add-collection-widget.js') }}"></script>

    <script type="text/javascript">
        document.addEventListener('DOMContentLoaded', function() {
            const listValuesContainer = document.getElementById('list-values-container');
            if (!listValuesContainer) return;

            const getValuesOrder = () => {
                return Array.from(listValuesContainer.children).map((el, idx) => ({
                    idx: idx,
                    ID: el.id
                }));
            };

            const updateAllValuesIdx = (list) => {
                list.forEach((val) => {
                    $.ajax({
                        type: "POST",
                        url: "{{ path('admin_formulaires_order_champ_valeur_liste') }}",
                        data: { ID: val.ID, idx: val.idx },
                        datatype: 'json'
                    });
                });
            };

            new Sortable(listValuesContainer, {
                handle: '.tdMove',
                animation: 100,
                onEnd: function () {
                    const newList = getValuesOrder();
                    updateAllValuesIdx(newList);
                }
            });
        });
    </script>
{% endblock %}

