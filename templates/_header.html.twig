<script type="module">
    import { initTomSelectEtablissement } from '{{ asset('js/modules/tom-select-etablissement.js') }}';

    const labelField = document.getElementById('nav-main-search-label');
    const searchForm = document.getElementById('nav-main-search-form');

    const navSearch = initTomSelectEtablissement(
        '#nav-main-search-field',
        '{{ path('api_etablissements_search') }}',
        {
            placeholder: 'Rechercher ...',
            // Le texte saisi alimente le champ « label » : une soumission sans sélection
            // bascule vers la page de recherche avancée, comme le legacy.
            onType: (str) => { labelField.value = str; },
            onSelect: (value) => {
                if (value) {
                    window.location.href = Routing.generate('etablissement_informations', {id: value});
                }
            },
        }
    );

    // Sans sélection, on soumet le formulaire avec le texte saisi.
    searchForm.addEventListener('submit', function () {
        if (!navSearch.getValue()) {
            labelField.value = navSearch.control_input.value.trim();
        }
    });
</script>
