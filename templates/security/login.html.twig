<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Connexion — Prévarisc</title>
        <link href="{{ asset('css/bootstrap-3.min.css') }}" rel="stylesheet">
        <link href="{{ asset('css/login.css') }}" rel="stylesheet">
    </head>
    <body class="login">
        <div class="wrapper">
            <div class="block">

                {# ─── Messages flash (erreurs d'authentification depuis onAuthenticationFailure) ─── #}
                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ type }} text-center" style="max-width: 350px; margin: 0 auto 15px auto;">
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endfor %}

                {# ─── Erreur retournée par AuthenticationUtils (tentative précédente) ─── #}
                {% if error %}
                    <div class="alert alert-danger text-center" style="max-width: 350px; margin: 0 auto 15px auto;">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                <div class="well">

                    <h3>Prévarisc</h3>

                    {% if sso_enabled %}
                        {# ─── Mode SSO (CAS ou NTLM) : pas de formulaire ─── #}
                        <p class="text-muted">
                            <span class="glyphicon glyphicon-lock"></span>
                            Connexion SSO en cours…
                        </p>
                        <div class="progress">
                            <div class="progress-bar progress-bar-striped active" style="width: 100%;"></div>
                        </div>
                    {% else %}
                        {# ─── Mode formulaire standard ─── #}
                        <form action="{{ path('session_login') }}" method="post">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                            <div class="form-group">
                                <input
                                    type="text"
                                    id="_username"
                                    name="_username"
                                    class="form-control"
                                    placeholder="Nom d'utilisateur"
                                    value="{{ last_username }}"
                                    required
                                    autofocus
                                >
                            </div>

                            <div class="form-group">
                                <input
                                    type="password"
                                    id="_password"
                                    name="_password"
                                    class="form-control"
                                    placeholder="Mot de passe"
                                    required
                                >
                            </div>

                            <button type="submit" class="btn btn-primary btn-block">
                                <span class="glyphicon glyphicon-ok"></span>
                                Connexion
                            </button>
                        </form>
                    {% endif %}

                </div>{# /.well #}

                <footer>
                    <p>&copy; {{ 'now'|date('Y') }} Prévarisc</p>
                </footer>

            </div>{# /.block #}
        </div>{# /.wrapper #}
    </body>
</html>
