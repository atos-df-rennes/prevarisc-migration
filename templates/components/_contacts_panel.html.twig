{#
    Paramètres requis :
    - entity_id      : identifiant de l'entité parente (int)
    - contacts       : collection de contacts liés à l'entité
    - no_contacts_msg: message affiché quand il n'y a aucun contact
    - url_add_existing: URL AJAX pour charger le formulaire d'ajout de contact existant
    - url_add        : URL AJAX pour charger le formulaire de création d'un nouveau contact
    - route_delete   : nom de la route Symfony exposée JS pour supprimer un contact
    - element_lie    : type d'entité passé à la route contact_edit ('commission' ou 'groupement')
#}
<div class="mb-4 clearfix">
    <div class="pull-right btn-group" role="group">
        <button type="button" class="btn btn-primary" id="ajout-contact-existant-bouton" data-toggle="modal" data-target="#ajout-contact-existant">Ajouter un contact existant</button>
        <button type="button" class="btn btn-default" id="ajout-contact-bouton" data-toggle="modal" data-target="#ajout-contact">Ajouter un nouveau contact</button>
    </div>
</div>

{% if contacts is empty %}
    <p class="text-center text-muted">
        <span class="glyphicon glyphicon-info-sign" aria-hidden="true"></span> {{ no_contacts_msg }}
    </p>
{% else %}
    <div class="panel-list">
        {% for contact in contacts %}
            {{ include('contact/_fiche.html.twig', {can_edit: true, contact: contact}) }}
        {% endfor %}
    </div>
{% endif %}

{{ include('contact/_modal_ajout.html.twig') }}
{{ include('components/_modal_contact_existant.html.twig') }}
{{ include('contact/_modal_suppression.html.twig') }}

<script>
var CONTACTS_PANEL_CONFIG = {
    urlAddExisting: "{{ url_add_existing }}",
    urlAdd: "{{ url_add }}",
    entityId: "{{ entity_id }}",
    routeDelete: "{{ route_delete }}",
    elementLie: "{{ element_lie }}"
};
</script>
<script src="{{ asset('js/contacts-panel.js') }}"></script>
