{#
    Template d'édition des formulaires personnalisés — version Symfony Forms.

    Variables attendues :
      - form      : FormView  (construit par DescriptifFormBuilder)
      - capsule   : CapsuleRubrique|null

    Le form contient des sub-forms nommés 'rubrique_X' (RubriqueFormData),
    chacun contenant 'display' (CheckboxType) et 'champ_Y' (ChampValueType).
#}
{% form_theme form 'form/descriptif_theme.html.twig' %}

{{ form_start(form) }}

    <div class="action-buttons pull-right">
        <a class="btn btn-default" href="javascript:history.back()" data-do-not-unload>
            <span class="glyphicon glyphicon-remove" aria-hidden="true"></span>
            Annuler
        </a>
        <button type="submit" id="js-btn-enregistrer-descriptif" class="btn btn-success" data-do-not-unload>
            <span class="glyphicon glyphicon-floppy-disk" aria-hidden="true"></span>
            Enregistrer
        </button>
    </div>

    <div class="clearfix"></div>

    <h3>{{ capsule ? capsule.nom : 'Formulaire personnalisé' }}</h3>

    {% set has_rubriques = false %}
    {% for rubrique_key, rubrique_form in form %}
        {% if rubrique_key starts with 'rubrique_' %}
            {% set has_rubriques = true %}
            {% set rubrique_id = rubrique_key|replace({rubrique_: ''}) %}
            {% set is_displayed = rubrique_form.display.vars.data %}

            <div id="afficher_rubrique-{{ rubrique_id }}"
                 class="panel panel-default panel-formulaire-perso{% if not is_displayed %} hide{% endif %}">

                <div class="panel-heading" role="tab">
                    <h4 class="panel-title">
                        <a role="button"
                           class="panel-title__link{% if not rubrique_form.opened.vars.data %} collapsed{% endif %}"
                           data-toggle="collapse"
                           data-target="#rubrique-edit-body-{{ rubrique_id }}"
                           aria-expanded="{{ rubrique_form.opened.vars.data ? 'true' : 'false' }}"
                           aria-controls="rubrique-edit-body-{{ rubrique_id }}"
                           >
                            {{ rubrique_form.vars.label }}
                            <span class="pull-right caret-toggle glyphicon glyphicon-chevron-down" aria-hidden="true"></span>
                        </a>
                    </h4>
                </div>

                <div id="rubrique-edit-body-{{ rubrique_id }}" class="panel-collapse collapse{% if rubrique_form.opened.vars.data %} in{% endif %}">
                    <div class="panel-body">
                        {# Rendu caché — valeur soumise avec le formulaire ; le TOC modal (mirror checkbox) le synchronise via JS #}
                        {{ form_row(rubrique_form.display, {row_attr: {style: 'display:none'}, attr: {'data-display-checkbox': rubrique_id}}) }}
                        {{ form_row(rubrique_form.opened, {attr: {'data-opened-input': rubrique_id}}) }}

                        {% for champ_key, champ_form in rubrique_form %}
                            {% if champ_key starts with 'champ_' %}
                                <div class="control-group">
                                    <label class="control-label">
                                        <strong>{{ champ_form.vars.label }}</strong>
                                    </label>
                                    <div class="controls{% if champ_form.lignes is defined or champ_form.sousChamps is defined %} table-wrapper{% endif %}">
                                        {% if champ_form.lignes is defined %}
                                            {# Champ PARENT+tableau : rendu avec prototype Symfony CollectionType #}
                                            {% set lignes_form = champ_form.lignes %}
                                            <div class="table-responsive table-tableau table-writable">
                                                <table class="table table-hover">
                                                    <thead>
                                                        <tr>
                                                            {% if lignes_form.vars.prototype is defined %}
                                                                {% for cell in lignes_form.vars.prototype %}
                                                                    <th>{{ cell.vars.label ?? '' }}</th>
                                                                {% endfor %}
                                                            {% endif %}
                                                            <th class="colonne-edition">Édition</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody data-prototype="{{ form_widget(lignes_form.vars.prototype)|e('html_attr') }}"
                                                           data-index="{{ lignes_form|length }}">
                                                        {% for row in lignes_form %}
                                                            {{ form_widget(row) }}
                                                        {% endfor %}
                                                    </tbody>
                                                </table>
                                            </div>
                                            <div class="add-row-button-wrapper">
                                                <button type="button" class="btn btn-info btn-block addRow">
                                                    Ajouter une ligne
                                                </button>
                                            </div>
                                        {% elseif champ_form.sousChamps is defined %}
                                            {# Champ PARENT+groupe #}
                                            <div class="table-responsive table-writable">
                                                <table class="table table-hover">
                                                    <thead>
                                                        <tr>
                                                            {% for sous_champ_form in champ_form.sousChamps %}
                                                                <th>{{ sous_champ_form.vars.label ?? '' }}</th>
                                                            {% endfor %}
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr>
                                                            {% for sous_champ_form in champ_form.sousChamps %}
                                                                <td>
                                                                    {% if sous_champ_form.value is defined %}
                                                                        {{ form_widget(sous_champ_form.value) }}
                                                                    {% else %}
                                                                        {{ form_widget(sous_champ_form) }}
                                                                    {% endif %}
                                                                </td>
                                                            {% endfor %}
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        {% elseif champ_form.value is defined %}
                                            {# Champ simple #}
                                            {{ form_widget(champ_form.value) }}
                                            {{ form_errors(champ_form.value) }}
                                        {% else %}
                                            {{ form_widget(champ_form) }}
                                        {% endif %}
                                    </div>
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
            </div>
            {# Prévenir form_rest de re-rendre cette rubrique (évite doublons checkbox/form-group) #}
            {%- do rubrique_form.setRendered() -%}
        {% endif %}
    {% endfor %}

    {% if not has_rubriques %}
        <p class="text-muted"><em>Aucune rubrique configurée. Contactez un administrateur Prevarisc.</em></p>
    {% endif %}

    {# Modale de sélection des rubriques à afficher #}
    {% if has_rubriques %}
        <div id="tocModal" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="tocModalLabel">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Fermer">
                            <span aria-hidden="true">&times;</span>
                        </button>
                        <h4 class="modal-title" id="tocModalLabel">Rubriques à afficher</h4>
                    </div>
                    <div class="modal-body">
                        {% for rubrique_key, rubrique_form in form %}
                            {% if rubrique_key starts with 'rubrique_' %}
                                {% set rubrique_id = rubrique_key|replace({rubrique_: ''}) %}
                                <div class="descriptif-personnalise_rubrique">
                                    <label>
                                        {# Checkbox miroir (non soumis) — contrôle la visibilité via JS #}
                                        <input type="checkbox"
                                               data-controls-rubrique="{{ rubrique_id }}"
                                               {% if rubrique_form.display.vars.data %}checked{% endif %}>
                                        {{ rubrique_form.vars.label }}
                                    </label>
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-default" data-dismiss="modal">Fermer</button>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

{{ form_end(form) }}

{# Bouton flottant TOC #}
{% if has_rubriques %}
    <button id="show-toc"
            type="button"
            class="btn btn-default"
            title="Sélectionner les rubriques à afficher"
            data-toggle="modal"
            data-target="#tocModal">
        <span class="glyphicon glyphicon-filter" aria-hidden="true"></span>
    </button>
{% endif %}

<script type="module" src="{{ asset('js/formulaire-personnalise-edit.js') }}"></script>
