{% import _self as forms %}

{#
    Macro principale : rendu d'un formulaire d'édition avec toutes les rubriques.

    Usage :
      {% import 'components/_formulaire_personnalise_edit.html.twig' as editForms %}
      {{ editForms.form(rubriques, form_action, csrf_token_name, entity_id, capsule) }}

    @param rubriques   list<{rubrique: Rubrique, display: bool, champs: list}>
    @param form_action  string  URL cible du formulaire (route Symfony)
    @param csrf_name    string  Nom du token CSRF (ex: 'edit_descriptif_123')
    @param capsule     CapsuleRubrique|null
#}
{% macro form(rubriques, form_action, csrf_name, capsule) %}
    {% import _self as forms %}

    <form method="post" action="{{ form_action }}">
        <input type="hidden" name="_token" value="{{ csrf_token(csrf_name) }}">

        <div class="pull-right">
            <button type="submit" class="btn btn-success" data-do-not-unload>
                <span class="glyphicon glyphicon-floppy-disk" aria-hidden="true"></span>
                Enregistrer
            </button>
            <a class="btn btn-default" href="javascript:history.back()" data-do-not-unload>
                <span class="glyphicon glyphicon-remove" aria-hidden="true"></span>
                Annuler
            </a>
        </div>

        <h3>{{ capsule ? capsule.nom : 'Formulaire personnalisé' }}</h3>

        {% if rubriques is empty %}
            <p class="text-muted"><em>Aucune rubrique configurée. Contactez un administrateur Prevarisc.</em></p>
        {% else %}
            {# Sommaire des rubriques #}
            <div class="descriptif-personnalise_rubriques-infos mb-4">
                {% for item in rubriques %}
                    {% set rubrique = item.rubrique %}
                    <div class="descriptif-personnalise_rubrique">
                        <input type="hidden"
                               name="afficher_rubrique-{{ rubrique.id }}"
                               value="0">
                        <input type="checkbox"
                               id="check-afficher_rubrique-{{ rubrique.id }}"
                               name="afficher_rubrique-{{ rubrique.id }}"
                               value="1"
                               {% if item.display %}checked{% endif %}>
                        <label for="check-afficher_rubrique-{{ rubrique.id }}">
                            {% if item.display %}
                                <a href="#afficher_rubrique-{{ rubrique.id }}">{{ rubrique.nom }}</a>
                            {% else %}
                                {{ rubrique.nom }}
                            {% endif %}
                        </label>
                    </div>
                {% endfor %}
            </div>

            {% for item in rubriques %}
                {{ forms.editRubrique(item) }}
            {% endfor %}
        {% endif %}
    </form>
{% endmacro %}

{#
    Rendu d'un panneau de rubrique éditable.
    @param item {rubrique: Rubrique, display: bool, champs: list}
#}
{% macro editRubrique(item) %}
    {% import _self as forms %}
    {% set rubrique = item.rubrique %}

    <div
        id="afficher_rubrique-{{ rubrique.id }}"
        class="panel panel-default panel-formulaire-perso{% if not item.display %} hide{% endif %}"
    >
        <div class="panel-heading" role="tab">
            <h4 id="{{ rubrique.nom|lower|replace({' ': '-', "'": '-'}) }}" class="panel-title">
                <a role="button"
                   class="panel-title__link{% if not rubrique.ouverte %} collapsed{% endif %}"
                   data-toggle="collapse"
                   data-target="#rubrique-edit-body-{{ rubrique.id }}"
                   aria-expanded="{{ rubrique.ouverte ? 'true' : 'false' }}"
                   aria-controls="rubrique-edit-body-{{ rubrique.id }}">
                    {{ rubrique.nom }}
                    <span class="pull-right caret-toggle glyphicon glyphicon-chevron-down" aria-hidden="true"></span>
                </a>
            </h4>
        </div>

        <div id="rubrique-edit-body-{{ rubrique.id }}"
             class="panel-collapse collapse{% if rubrique.ouverte %} in{% endif %}">
            <div class="panel-body">
                {% if item.champs is empty %}
                    <p class="text-muted"><em>Aucun champ renseigné. Contactez un administrateur Prevarisc.</em></p>
                {% else %}
                    {% for champ_data in item.champs %}
                        {{ forms.editChampRow(champ_data) }}
                    {% endfor %}
                {% endif %}
            </div>
        </div>
    </div>
{% endmacro %}

{#
    Rendu d'une ligne de formulaire éditable (label + input).
    @param champ_data {champ: Champ, valeur: Valeur|null, lignes?: list, sous_champs?: list}
#}
{% macro editChampRow(champ_data) %}
    {% import _self as forms %}
    {% set champ = champ_data.champ %}
    <div class="control-group">
        <label class="control-label">
            <strong>{{ champ.nom }}</strong>
        </label>
        <div class="controls{% if champ.type and champ.type.id == constant('App\\Constant\\TypeChamp::PARENT') %} table-wrapper{% endif %}">
            {{ forms.editChampValeur(champ_data) }}
        </div>
    </div>
{% endmacro %}

{#
    Rendu de l'input d'édition d'un champ selon son type.
    TypeChamp : 1=Text, 2=Textarea, 3=Select, 4=Number, 5=Checkbox, 6=Parent, 7=Date
#}
{% macro editChampValeur(champ_data) %}
    {% import _self as forms %}
    {% set champ = champ_data.champ %}
    {% set valeur = champ_data.valeur ?? null %}
    {% set type_id = champ.type ? champ.type.id : null %}
    {% set champ_name = 'champ-' ~ champ.id %}

    {% if type_id == constant('App\\Constant\\TypeChamp::PARENT') %}
        {% if champ.tableau %}
            {{ forms.editTableau(champ, champ_data.lignes ?? []) }}
        {% else %}
            {{ forms.editGroupeSousChamps(champ, champ_data.sous_champs ?? []) }}
        {% endif %}

    {% elseif type_id == constant('App\\Constant\\TypeChamp::TEXT') %}
        <input type="text"
               name="{{ champ_name }}"
               value="{{ valeur ? valeur.str : '' }}">

    {% elseif type_id == constant('App\\Constant\\TypeChamp::TEXTAREA') %}
        <textarea name="{{ champ_name }}">{{ valeur ? valeur.longStr : '' }}</textarea>

    {% elseif type_id == constant('App\\Constant\\TypeChamp::SELECT') %}
        <select name="{{ champ_name }}">
            <option value="">Sélectionnez un élément</option>
            {% for valeur_liste in champ.valeursListe %}
                <option value="{{ valeur_liste.valeur }}"
                        {% if valeur and valeur.str == valeur_liste.valeur %}selected{% endif %}>
                    {{ valeur_liste.valeur }}
                </option>
            {% endfor %}
        </select>

    {% elseif type_id == constant('App\\Constant\\TypeChamp::NUMBER') %}
        <input type="number"
               name="{{ champ_name }}"
               min="0"
               value="{{ valeur ? valeur.number : '' }}">

    {% elseif type_id == constant('App\\Constant\\TypeChamp::CHECKBOX') %}
        <input type="hidden" name="{{ champ_name }}" value="0">
        <input type="checkbox"
               name="{{ champ_name }}"
               value="1"
               {% if valeur and valeur.checkbox %}checked{% endif %}>

    {% elseif type_id == constant('App\\Constant\\TypeChamp::DATE') %}
        <div class="colDate">
            <input type="text"
                   class="date"
                   name="{{ champ_name }}"
                   value="{{ valeur and valeur.date ? valeur.date|date('d/m/Y') : '' }}">
            <button type="button" class="today btn">
                <i class="icon-calendar" aria-hidden="true"></i>
                Aujourd'hui
            </button>
        </div>

    {% else %}
        <span class="text-muted"><em>Type de champ non supporté.</em></span>
    {% endif %}
{% endmacro %}

{#
    Rendu d'un tableau éditable (champ Parent avec tableau=true).
    @param champ  Champ (parent)
    @param lignes list<array<champId, Valeur>>  lignes existantes indexées par champId
#}
{% macro editTableau(champ, lignes) %}
    {% import _self as forms %}

    <div class="table-responsive table-tableau table-writable">
        <table class="table table-hover">
            <thead>
                <tr>
                    {% for enfant in champ.enfants %}
                        {% if enfant.nom %}
                            <th>{{ enfant.nom }}</th>
                        {% endif %}
                    {% endfor %}
                    <th class="colonne-edition">Édition</th>
                </tr>
            </thead>
            <tbody id="tbody-{{ champ.id }}" class="grp">
                {# Ligne template masquée (clonée par gestionTableau.js lors de l'ajout) #}
                <tr class="ligneTableau hidden">
                    {% for enfant in champ.enfants %}
                        <td>
                            {{ forms.editInputTableauCell(enfant, null, 0, champ.id, true) }}
                        </td>
                    {% endfor %}
                    <td class="colonne-edition">
                        <button type="button" class="deleteRow btn btn-danger">
                            <i class="icon-trash icon-white" aria-hidden="true"></i>
                        </button>
                    </td>
                </tr>

                {# Lignes existantes #}
                {% for ligne in lignes %}
                    <tr>
                        {% for enfant in champ.enfants %}
                            <td>
                                {% set valeur = ligne[enfant.id] ?? null %}
                                {{ forms.editInputTableauCell(enfant, valeur, null, champ.id, false) }}
                            </td>
                        {% endfor %}
                        <td class="colonne-edition">
                            <button type="button" class="deleteRow btn btn-danger">
                                <i class="icon-trash icon-white" aria-hidden="true"></i>
                            </button>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="add-row-button-wrapper">
        <button type="button" class="btn btn-info btn-block addRow" idparent="{{ champ.id }}">
            Ajouter une ligne
        </button>
    </div>
{% endmacro %}

{#
    Rendu d'une cellule de tableau éditable.

    Pour la ligne template (is_template=true)  : nom = valeur-0-{parent_id}-{champId}
      (JS remplace le 0 par Date.now() et ajoute -NULL)
    Pour une ligne existante (is_template=false) : nom = valeur-{idx}-{parent_id}-{champId}-{valeurId}

    @param enfant      Champ  (champ enfant / colonne)
    @param valeur      Valeur|null
    @param idx         int|null  (ignoré si template)
    @param parent_id   int
    @param is_template bool
#}
{% macro editInputTableauCell(enfant, valeur, idx, parent_id, is_template) %}
    {% set type_id = enfant.type ? enfant.type.id : null %}

    {% if is_template %}
        {# Nom template : valeur-0-{parent_id}-{champId}  (le 0 sera remplacé par JS) #}
        {% set input_name = 'valeur-0-' ~ parent_id ~ '-' ~ enfant.id %}
        {% set current_value = '' %}
    {% else %}
        {# Nom existant : valeur-{idx}-{parent_id}-{champId}-{valeurId} #}
        {% set valeur_id = valeur ? valeur.id : 'NULL' %}
        {% set row_idx = valeur ? valeur.idx : idx %}
        {% set input_name = 'valeur-' ~ row_idx ~ '-' ~ parent_id ~ '-' ~ enfant.id ~ '-' ~ valeur_id %}
        {% set current_value = valeur %}
    {% endif %}

    {% if type_id == constant('App\\Constant\\TypeChamp::TEXT') %}
        <input type="text"
               name="{{ input_name }}"
               value="{{ is_template ? '' : (current_value ? current_value.str : '') }}">

    {% elseif type_id == constant('App\\Constant\\TypeChamp::TEXTAREA') %}
        <textarea name="{{ input_name }}">{{ is_template ? '' : (current_value ? current_value.longStr : '') }}</textarea>

    {% elseif type_id == constant('App\\Constant\\TypeChamp::SELECT') %}
        <select name="{{ input_name }}">
            <option value="">Sélectionnez un élément</option>
            {% for valeur_liste in enfant.valeursListe %}
                <option value="{{ valeur_liste.valeur }}"
                        {% if not is_template and current_value and current_value.str == valeur_liste.valeur %}selected{% endif %}>
                    {{ valeur_liste.valeur }}
                </option>
            {% endfor %}
        </select>

    {% elseif type_id == constant('App\\Constant\\TypeChamp::NUMBER') %}
        <input type="number"
               name="{{ input_name }}"
               min="0"
               value="{{ is_template ? '' : (current_value ? current_value.number : '') }}">

    {% elseif type_id == constant('App\\Constant\\TypeChamp::CHECKBOX') %}
        <input type="hidden" name="{{ input_name }}" value="0">
        <input type="checkbox"
               name="{{ input_name }}"
               value="1"
               {% if not is_template and current_value and current_value.checkbox %}checked{% endif %}>

    {% elseif type_id == constant('App\\Constant\\TypeChamp::DATE') %}
        <div class="colDate">
            <input type="text"
                   class="date"
                   name="{{ input_name }}"
                   value="{{ (not is_template and current_value and current_value.date) ? current_value.date|date('d/m/Y') : '' }}">
            <button type="button" class="today btn">
                <i class="icon-calendar" aria-hidden="true"></i>
                Aujourd'hui
            </button>
        </div>

    {% else %}
        <input type="text" name="{{ input_name }}" value="">
    {% endif %}
{% endmacro %}

{#
    Rendu d'un groupe de sous-champs non-tableau (champ Parent avec tableau=false).
    @param champ       Champ  (parent)
    @param sous_champs list<{champ: Champ, valeur: Valeur|null}>
#}
{% macro editGroupeSousChamps(champ, sous_champs) %}
    {% import _self as forms %}
    <div class="table-responsive table-writable">
        <table class="table table-hover">
            <thead>
                <tr>
                    {% for sc in sous_champs %}
                        <th>{{ sc.champ.nom }}</th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                <tr>
                    {% for sc in sous_champs %}
                        <td>{{ forms.editChampValeur(sc) }}</td>
                    {% endfor %}
                </tr>
            </tbody>
        </table>
    </div>
{% endmacro %}
