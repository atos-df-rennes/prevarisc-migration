{% import _self as forms %}

{#
    Macro principale : rendu d'une liste de rubriques avec leurs champs et valeurs.
    Usage : {{ forms.rubriques(rubriques) }}

    @param rubriques list<{rubrique: Rubrique, display: bool, champs: list}>
#}
{% macro rubriques(rubriques) %}
    {% import _self as forms %}

    {# Liste de navigation vers les rubriques visibles #}
    {% set rubriques_visibles = rubriques|filter(item => item.display) %}
    {% if rubriques_visibles|length > 0 %}
        <h4 class="h4_subtitle">Rubriques</h4>
        <div class="descriptif-personnalise_rubriques-infos mb-4">
            {% for item in rubriques_visibles %}
                <a href="#{{ item.rubrique.nom|lower|replace({' ': '-', "'": '-'}) }}">{{ item.rubrique.nom }}</a>
            {% endfor %}
        </div>
    {% endif %}

    {% for item in rubriques %}
        {% set rubrique = item.rubrique %}
        <div
            id="afficher_rubrique-{{ rubrique.id }}"
            class="panel panel-default panel-formulaire-perso{% if not item.display %} hidden{% endif %}"
        >
            <div class="panel-heading" role="tab">
                <h4 id="{{ rubrique.nom|lower|replace({' ': '-', "'": '-'}) }}" class="panel-title">
                    <a role="button"
                       class="panel-title__link{% if not rubrique.ouverte %} collapsed{% endif %}"
                       data-toggle="collapse"
                       data-target="#rubrique-body-{{ rubrique.id }}"
                       aria-expanded="{{ rubrique.ouverte ? 'true' : 'false' }}"
                       aria-controls="rubrique-body-{{ rubrique.id }}">
                        {{ rubrique.nom }}
                        <span class="pull-right caret-toggle glyphicon glyphicon-chevron-down" aria-hidden="true"></span>
                    </a>
                </h4>
            </div>

            <div id="rubrique-body-{{ rubrique.id }}" class="panel-collapse collapse{% if rubrique.ouverte %} in{% endif %}">
                <div class="panel-body">
                    {% if item.champs is empty %}
                        <p class="text-muted"><em>Aucun champ renseigné. Contactez un administrateur Prevarisc.</em></p>
                    {% else %}
                        {% for champ_data in item.champs %}
                            {{ forms.champRow(champ_data) }}
                        {% endfor %}
                    {% endif %}
                </div>
            </div>
        </div>
    {% endfor %}
{% endmacro %}

{#
    Rendu d'une ligne de formulaire (label au-dessus, valeur en dessous).
    @param champ_data {champ: Champ, valeur: Valeur|null, lignes?: list, sous_champs?: list}
#}
{% macro champRow(champ_data) %}
    {% import _self as forms %}
    {% set champ = champ_data.champ %}
    <div class="control-group">
        <label class="control-label">
            <strong>{{ champ.nom }}</strong>
        </label>
        <div class="controls{% if champ_data.champ.type and champ_data.champ.type.id == 6 %} table-wrapper{% endif %}">
            {{ forms.champValeur(champ_data) }}
        </div>
    </div>
{% endmacro %}

{#
    Rendu de la valeur d'un champ selon son type (lecture seule).
    TypeChamp : 1=Text, 2=Textarea, 3=Select, 4=Number, 5=Checkbox, 6=Parent, 7=Date
#}
{% macro champValeur(champ_data) %}
    {% import _self as forms %}
    {% set champ = champ_data.champ %}
    {% set type_id = champ.type.id %}

    {# Type Parent (6) : tableau ou groupe de sous-champs #}
    {% if type_id == 6 %}
        {% if champ.tableau %}
            {{ forms.tableau(champ, champ_data.lignes ?? []) }}
        {% else %}
            {{ forms.groupeSousChamps(champ_data.sous_champs ?? []) }}
        {% endif %}

    {# Checkbox (5) : toujours affichée même sans valeur #}
    {% elseif type_id == 5 %}
        <input type="checkbox" disabled{% if champ_data.valeur and champ_data.valeur.checkbox %} checked{% endif %}>

    {# Champs textuels/numériques : vide si pas de valeur #}
    {% elseif champ_data.valeur is null %}
        <span class="text-muted">Aucune donnée</span>

    {% elseif type_id == 1 or type_id == 3 or type_id == 4 %}
        <span>{{ champ_data.valeur.str ?? champ_data.valeur.number }}</span>

    {% elseif type_id == 2 %}
        <span>{{ (champ_data.valeur.longStr ?? '')|nl2br }}</span>

    {% elseif type_id == 7 %}
        <span>{{ champ_data.valeur.date ? champ_data.valeur.date|date('d/m/Y') : '' }}</span>

    {% else %}
        <span class="text-muted">Aucune donnée</span>
    {% endif %}
{% endmacro %}

{#
    Rendu d'un tableau (champ Parent avec tableau=true).
    @param champ    Champ (parent)
    @param lignes   list<array<champId, Valeur>>
#}
{% macro tableau(champ, lignes) %}
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    {% for enfant in champ.enfants %}
                        {% if enfant.nom %}
                            <th>{{ enfant.nom }}</th>
                        {% endif %}
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                {% for ligne in lignes %}
                    <tr>
                        {% for enfant in champ.enfants %}
                            <td>
                                {% set valeur = ligne[enfant.id] ?? null %}
                                {% set type_id = enfant.type ? enfant.type.id : null %}
                                {% if type_id == 5 %}
                                    <input type="checkbox" disabled{% if valeur and valeur.checkbox %} checked{% endif %}>
                                {% elseif valeur is null %}
                                {% elseif type_id == 1 or type_id == 3 or type_id == 4 %}
                                    {{ valeur.str ?? valeur.number }}
                                {% elseif type_id == 2 %}
                                    {{ (valeur.longStr ?? '')|nl2br }}
                                {% elseif type_id == 7 %}
                                    {{ valeur.date ? valeur.date|date('d/m/Y') : '' }}
                                {% endif %}
                            </td>
                        {% endfor %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endmacro %}

{#
    Rendu d'un groupe de sous-champs (champ Parent sans tableau).
    @param sous_champs list<{champ: Champ, valeur: Valeur|null}>
#}
{% macro groupeSousChamps(sous_champs) %}
    {% import _self as forms %}
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    {% for sc in sous_champs %}
                        <th>{{ sc.champ.nom }}</th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                <tr>
                    {% for sc in sous_champs %}
                        <td>{{ forms.champValeur(sc) }}</td>
                    {% endfor %}
                </tr>
            </tbody>
        </table>
    </div>
{% endmacro %}
