{% extends 'layouts/dashboard.html.twig' %}

{% block title %}Dossier{% endblock %}

{# @todo: Compléter #}
{% block lateral_navigation %}
    <ul class='nav nav-tabs nav-stacked menu_dashboard'>
        <li {% if app.request.get('_route') is same as('dossier_index') %}class="active"{% endif %}>
            <a href="{{ path('dossier_index', {id: dossier.id}) }}">
                <span class="glyphicon glyphicon-info-sign" aria-hidden="true"></span>
                Informations générales
            </a>
        </li>
        <li>
            <a href="{{ '/dossier/textes-applicables/id/' ~ dossier.id }}">
                <span class="glyphicon glyphicon-align-center" aria-hidden="true"></span>
                Textes applicables
            </a>
        </li>
        <li>
            <a href="{{ '/dossier/piece-jointe/id/' ~ dossier.id }}">
                <span class="glyphicon glyphicon-share" aria-hidden="true"></span>
                Pièces jointes
            </a>
        </li>
        <li class="nav-header">Actions</li>
        <li>
            <a href="{{ '/dossier/rapport/id/' ~ dossier.id }}">
                <span class="glyphicon glyphicon-file" aria-hidden="true"></span>
                Rapport
            </a>
        </li>
        <li>
            <a id="suppressionDossier" href="#">
                <span class="glyphicon glyphicon-remove" aria-hidden="true"></span>
                Supprimer le dossier
            </a>
        </li>
    </ul>
{% endblock %}

{% block body_structure %}
    <div id="ligne_informations">
        <h2 class='page-header'>
            <p>
                <span>{{ dossier.type.libelle }}</span>

                {% if dossier.dateSuppression is not null %}
                    <span class='label label-danger'>
                        DOSSIER SUPPRIME
                    </span>
                {% endif %}
            </p>

            {% if dossier.objet or dossier.consultationPlatau is not null %}
                <p>
                    {% if dossier.objet %}
                        <small>{{ dossier.objet|nl2br }}</small>
                    {% endif %}

                    {% if dossier.consultationPlatau is not null %}
                        <strong class="dossier__identifiant-platau label label-info">CONSULTATION PLATAU : {{ dossier.consultationPlatau.identifiant }}</strong>
                    {% endif %}
                </p>
            {% endif %}

            {% if dossier.etablissements|length > 0 %}
                {{ include('layouts/dossier/_informations_etablissements.html.twig') }}
            {% endif %}
        </h2>
    </div>

    <div class="row">
        <div class="col-xs-12">
            {% block body %}{% endblock %}
        </div>
    </div>
{% endblock %}
