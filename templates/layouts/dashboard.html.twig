{% extends 'base.html.twig' %}

{% block content %}
    <div class='container-fluid'>
        <div class='row container-fluid--content-wraper'>
            <div class='col-xs-2 sidebar'>
                {{ avatar(app.user.id, constant('App\\Service\\Avatar::MEDIUM_DIRECTORY'), 'float: left; width: 50px; border: 1px solid #dfdfdf; border-radius: 50%; margin-right: 15px;') }}

                <p style="line-height:15px">
                    <strong>Bonjour {{ app.user.informations.prenom }}</strong><br />
                    <form action="{{ path('session_logout') }}" method="post" style="display:inline;">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                        <button type="submit" class="deconnexion btn btn-link" style="padding:0;vertical-align:baseline;">Déconnexion</button>
                    </form><br /><br />
                    <small class="label label-success" style="font-size: .8em">En ligne</small>
                </p>

                <hr class="clearfix" style="border: none;" />

                {% block lateral_navigation %}
                {% endblock %}
            </div>

            <div class='col-xs-10' style="margin-top: 70px;">
                {# @todo: Eventuellement à mettre dans un template partiel #}
                <noscript>
                    <ul class="list-unstyled" >
                        <li class="alert alert-danger"><strong class="alert-danger">Javascript desactivé</strong> Javascript n'est pas activé sur votre navigateur. Prevarisc ne peut fonctionner correctement sans l'activation du Javascript.</li>
                    </ul>
                </noscript>

                {% set flashes = app.flashes %}
                {% if flashes is not empty %}
                    <ul class="list-unstyled">
                        {% for label, messages in flashes %}
                            {% for message in messages %}
                                <li class="alert alert-{{ label }}">
                                    <button data-dismiss="alert" class="close">&times;</button>
                                    {{ message|raw }}
                                </li>
                            {% endfor %}
                        {% endfor %}
                    </ul>
                {% endif %}

                {% block body_structure %}{% endblock %}
            </div>
        </div>

        <button id="go-top" type="button" class="btn btn-default" style="display: none;" onclick="scrollToTop()" aria-label="Retour en haut de page">
            <span class="glyphicon glyphicon-arrow-up" aria-hidden="true"></span>
        </button>
    </div>
{% endblock %}
