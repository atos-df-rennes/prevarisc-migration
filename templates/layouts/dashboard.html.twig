{% extends 'base.html.twig' %}

{% block content %}
    <div class='container-fluid'>
        <div class='row'>
            <div class='col-xs-2 sidebar mainsidebar' style="margin-top: 20px; padding-top: 40px;">
                {# @todo: Mettre l'image #}
                <p style="line-height:15px">
                    <strong>Bonjour {{ app.user.informations.prenom }}</strong><br />
                    <a class="deconnexion" href="/session/logout">Déconnexion</a><br /><br />
                    <small class="label label-success" style="font-size: .8em">En ligne</small>
                </p>

                {% block lateral_navigation %}
                {% endblock %}
            </div>

            <div class='col-xs-10' style="margin-top: 70px;">
                {% block body_structure %}{% endblock %}
            </div>
        </div>
        <button id="go-top" type="button" class="btn btn-default" style="display: none;" onclick="scrollToTop()">
            <i class="glyphicon glyphicon-arrow-up"></i>
        </button>
    </div>

    <script>
        $(document).ready(function() {
            $(".sidebar").css('height', $(document).height() + 'px');
        });
    </script>
{% endblock %}