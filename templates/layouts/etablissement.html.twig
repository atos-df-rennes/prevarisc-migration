{% extends 'layouts/dashboard.html.twig' %}

{% block lateral_navigation %}
    {# @todo: Avoir le même affichage que l'application Zend. Ajouter les URLs pour qu'on puisse aller sur les onglets. #}
    <ul class='nav nav-tabs nav-stacked menu_dashboard'>
        <li {% if app.request.get('_route') is same as('etablissement_index') %}class="active"{% endif %}>
            <a href='{{ path('etablissement_index') }}'>
                <i class="icon-info-sign icon-black"></i>
                Général
            </a>
        </li>
        <li >
            <a href=''>
                <i class="icon-share icon-black"></i>
                Pièces jointes
            </a>
        </li>
        <li >
            <a href=''>
                <i class="icon-user icon-black"></i>
                Contacts
            </a>
        </li>
        <li >
            <a href=''>
                <i class="icon-folder-open icon-black"></i>
                Dossiers
            </a>
        </li>
        <li {% if app.request.get('_route') is same as('etablissement_historique') %}class="active"{% endif %}>
            <a class='sep' href='{{ path("etablissement_historique", {id: 10}) }}'>
                <i class="icon-repeat icon-black"></i>
                Afficher l'historique
            </a>
        </li>
        <li class="nav-header">Actions</li>
        <li>
            <a href="">
            <i class="icon-plus icon-black"></i>
            Ajouter un dossier
            </a>
        </li>

    </ul>
{% endblock %}

{% block body_structure %}
    {# @todo: Mettre le header avec l'établissement parent + nom établissement + code établissement + avis + statut #}
    <h2 class='page-header'>Etablissement</h2>

    <div class="row">
        <div class="col-xs-12">
            {% block body %}{% endblock %}
        </div>
    </div>
{% endblock %}