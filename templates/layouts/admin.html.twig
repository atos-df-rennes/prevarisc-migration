{% extends 'layouts/dashboard.html.twig' %}

{% block lateral_navigation %}
    <ul class="nav nav-tabs nav-stacked menu_dashboard">
        <li class="nav-header">Général</li>

        <li {% if app.request.get('_route') is same as('admin_index') %}class="active"{% endif %}>
            <a href="{{ path('admin_index') }}"><span class="glyphicon glyphicon-info-sign" aria-hidden="true"></span> Informations</a>
        </li>

        <li class="nav-header">Gestion des entités</li>

        <li {% if app.request.get('_route') is same as('retablir') %}class="active"{% endif %}>
            <a href='/retablir' ><span class="glyphicon glyphicon-ok" aria-hidden="true"></span> Gestion des éléments supprimés</a>
        </li>

        <li {% if app.request.get('_route') is same as('admin_utilisateurs_index')
                or app.request.get('_route') is same as('admin_utilisateurs_add')
                or app.request.get('_route') is same as('admin_utilisateurs_edit')
                or app.request.get('_route') is same as('admin_groupe_index')
                or app.request.get('_route') is same as('admin_groupe_add')
                or app.request.get('_route') is same as('admin_groupe_edit')
            %}class="active"{% endif %}
        >
            <a href="{{ path('admin_utilisateurs_index') }}"><span class="glyphicon glyphicon-user" aria-hidden="true"></span> Gestion des utilisateurs</a>
        </li>

        <li {% if app.request.get('_route') is same as('gestion-des-communes') %}class="active"{% endif %}>
            <a href='/gestion-des-communes' ><span class="glyphicon glyphicon-globe" aria-hidden="true"></span> Gestion des communes</a>
        </li>

        <li {% if app.request.get('_route') is same as('fusion-des-communes') %}class="active"{% endif %}>
            <a href='/fusion-des-communes' ><span class="glyphicon glyphicon-random" aria-hidden="true"></span> Fusion des communes</a>
        </li>

        <li {% if app.request.get('_route') is same as('couches-cartographiques') %}class="active"{% endif %}>
            <a href='/couches-cartographiques/list' ><span class="glyphicon glyphicon-map-marker" aria-hidden="true"></span> Gestion des couches cartographiques</a>
        </li>

        <li {% if app.request.get('_route') is same as('gestion-des-commissions') %}class="active"{% endif %}>
            <a href='/gestion-des-commissions' ><span class="glyphicon glyphicon-certificate" aria-hidden="true"></span> Gestion des commissions</a>
        </li>

        <li {% if app.request.get('_route') is same as('gestion-des-documents') %}class="active"{% endif %}>
            <a href='/gestion-des-documents' ><span class="glyphicon glyphicon-file" aria-hidden="true"></span> Gestion des documents</a>
        </li>

        <li {% if app.request.get('_route') is same as('gestion-prescriptions') %}class="active"{% endif %}>
            <a href='/gestion-prescriptions' ><span class="glyphicon glyphicon-flag" aria-hidden="true"></span> Gestion des prescriptions</a>
        </li>

        <li {% if app.request.get('_route') is same as('gestion-textes-applicables') %}class="active"{% endif %}>
            <a href='/gestion-textes-applicables' ><span class="glyphicon glyphicon-align-center" aria-hidden="true"></span> Gestion des textes applicables</a>
        </li>

        <li class="nav-header">Paramétrage du logiciel</li>

        <li {% if app.request.get('_route') is same as('tableau-des-periodicites') %}class="active"{% endif %}>
            <a href='/tableau-des-periodicites' ><span class="glyphicon glyphicon-th" aria-hidden="true"></span> Tableau des périodicités</a>
        </li>

        <li {% if app.request.get('_route') is same as('groupement') %}class="active"{% endif %}>
            <a href='/groupement' ><span class="glyphicon glyphicon-tags" aria-hidden="true"></span> Groupements de communes</a>
        </li>

        <li {% if app.request.get('_route') is same as('changement') %}class="active"{% endif %}>
            <a href='/changement' ><span class="glyphicon glyphicon-bell" aria-hidden="true"></span> Messages des alertes</a>
        </li>

        <li {% if app.request.get('_route') is same as('formulaire') %}class="active"{% endif %}>
            <a href='/formulaire' ><span class="glyphicon glyphicon-tasks" aria-hidden="true"></span> Formulaires</a>
        </li>
    </ul>
{% endblock %}

{% block body_structure %}
    <h2 class='page-header'>Administration</h2>

    <div class="row">
        <div class="col-xs-12">
            {% block body %}{% endblock %}
        </div>
    </div>
{% endblock %}
