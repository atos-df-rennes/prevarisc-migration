{% extends 'layouts/dashboard.html.twig' %}

{% block lateral_navigation %}
    <ul class="nav nav-tabs nav-stacked menu_dashboard">
        <li class="nav-header">Général</li>

        <li {% if app.request.get('_route') is same as('admin_index') %}class="active"{% endif %}>
            <a href="{{ path('admin_index') }}"><span class="glyphicon glyphicon-info-sign" aria-hidden="true"></span> Informations</a>
        </li>

        <li class="nav-header">Gestion des entités</li>

        <li {% if app.request.get('_route') is same as('admin_elements_supprimes') %}class="active"{% endif %}>
            <a href="{{ path('admin_elements_supprimes') }}"><span class="glyphicon glyphicon-ok" aria-hidden="true"></span> Gestion des éléments supprimés</a>
        </li>

        <li {% if app.request.get('_route') is same as('admin_utilisateurs_index')
                or app.request.get('_route') is same as('admin_utilisateurs_add')
                or app.request.get('_route') is same as('admin_utilisateurs_edit')
                or app.request.get('_route') is same as('admin_groupe_index')
                or app.request.get('_route') is same as('admin_groupe_add')
                or app.request.get('_route') is same as('admin_groupe_edit')
                or app.request.get('_route') is same as('admin_groupe_manage_privileges')
            %}class="active"{% endif %}
        >
            <a href="{{ path('admin_utilisateurs_index') }}"><span class="glyphicon glyphicon-user" aria-hidden="true"></span> Gestion des utilisateurs</a>
        </li>

        <li {% if app.request.get('_route') is same as('admin_communes') %}class="active"{% endif %}>
            <a href="{{ path('admin_communes') }}"><span class="glyphicon glyphicon-globe" aria-hidden="true"></span> Gestion des communes</a>
        </li>

        <li {% if app.request.get('_route') is same as('admin_fusion_des_communes') %}class="active"{% endif %}>
            <a href="{{ path('admin_fusion_des_communes') }}"><span class="glyphicon glyphicon-random" aria-hidden="true"></span> Fusion des communes</a>
        </li>

        <li {% if app.request.get('_route') is same as('couches_cartographiques') %}class="active"{% endif %}>
            <a href="{{ path('couches_cartographiques') }}"><span class="glyphicon glyphicon-map-marker" aria-hidden="true"></span> Gestion des couches cartographiques</a>
        </li>

        <li {% if app.request.get('_route') is same as('gestion-des-commissions') %}class="active"{% endif %}>
            <a href='/gestion-des-commissions'><span class="glyphicon glyphicon-certificate" aria-hidden="true"></span> Gestion des commissions</a>
        </li>

        <li {% if app.request.get('_route') is same as('admin_documents') %}class="active"{% endif %}>
            <a href="{{ path('admin_documents') }}"><span class="glyphicon glyphicon-file" aria-hidden="true"></span> Gestion des documents</a>
        </li>

        <li {% if app.request.get('_route') is same as('gestion-prescriptions') %}class="active"{% endif %}>
            <a href='/gestion-prescriptions'><span class="glyphicon glyphicon-flag" aria-hidden="true"></span> Gestion des prescriptions</a>
        </li>

        <li {% if app.request.get('_route') is same as('admin_textes_applicables') %}class="active"{% endif %}>
            <a href='{{ path('admin_textes_applicables') }}'><span class="glyphicon glyphicon-align-center" aria-hidden="true"></span> Gestion des textes applicables</a>
        </li>

        <li {% if app.request.get('_route') is same as('admin_documents_consultes') %}class="active"{% endif %}>
            <a href='{{ path('admin_documents_consultes') }}'><span class="glyphicon glyphicon-align-center" aria-hidden="true"></span> Gestion des documents consultés</a>
        </li>

        <li {% if app.request.get('_route') is same as('admin_documents_manquants') %}class="active"{% endif %}>
            <a href='{{ path('admin_documents_manquants') }}'><span class="glyphicon glyphicon-align-center" aria-hidden="true"></span>
                Gestion des documents manquants</a>
        </li>

        <li class="nav-header">Paramétrage du logiciel</li>

        <li {% if app.request.get('_route') is same as('admin_tableau_des_periodicites') %}class="active"{% endif %}>
            <a href="{{ path('admin_tableau_des_periodicites') }}"><span class="glyphicon glyphicon-th" aria-hidden="true"></span> Tableau des périodicités</a>
        </li>

        <li {% if app.request.get('_route') is same as('groupement') %}class="active"{% endif %}>
            <a href='/groupement'><span class="glyphicon glyphicon-tags" aria-hidden="true"></span> Groupements de communes</a>
        </li>

        <li {% if app.request.get('_route') is same as('admin_changement') %}class="active"{% endif %}>
            <a href="{{ path('admin_changement') }}"><span class="glyphicon glyphicon-bell" aria-hidden="true"></span> Messages des alertes</a>
        </li>

        <li {% if app.request.get('_route') is same as('formulaire') %}class="active"{% endif %}>
            <a href='/formulaire'><span class="glyphicon glyphicon-tasks" aria-hidden="true"></span> Formulaires</a>
        </li>
    </ul>
{% endblock %}

{% block body_structure %}
    <h2 class='page-header'>Administration</h2>

    <div class="row">
        <div class="col-xs-12">
            {% block body %}{% endblock %}
        </div>
    </div>
{% endblock %}
