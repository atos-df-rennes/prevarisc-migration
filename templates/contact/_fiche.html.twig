<div class="panel panel-default mb-0">
    <div class="panel-heading clearfix">
        <h4 class="panel-title pull-left mt-2">
            <span class="glyphicon glyphicon-user" aria-hidden="true"></span> {{ contact.nom ~ ' ' ~ contact.prenom }}
            {% if contact.fonction or contact.societe %}
                <small>
                    {% if contact.fonction %}
                        {{ contact.fonction.libelle }}
                    {% endif %}
                    {% if contact.societe %}
                        {% if contact.fonction %} - {% endif %}{{ contact.societe }}
                    {% endif %}
                </small>
            {% endif %}
        </h4>
        {% if can_edit %}
            <div class="btn-group btn-group-sm pull-right" role="group">
                <button type="button" class="btn btn-default edit-contact-button" data-toggle="modal" data-target="#ajout-contact" data-contact-id="{{ contact.id }}" title="Modifier">
                    <span class="glyphicon glyphicon-pencil" aria-hidden="true"></span>
                </button>
                <button type="button" class="btn btn-danger delete-contact-button" data-contact-id="{{ contact.id }}" title="Supprimer">
                    <span class="glyphicon glyphicon-trash" aria-hidden="true"></span>
                </button>
            </div>
        {% endif %}
    </div>
    <div class="panel-body">
        {% if contact.telephoneFixe or contact.telephonePortable or contact.telephoneFax or contact.mail or contact.siteWeb or contact.numeroAdresse or contact.rueAdresse or contact.codePostalAdresse or contact.villeAdresse or contact.observations %}
            <dl class="dl-horizontal" style="margin-bottom: 0;">
                {% if contact.telephoneFixe or contact.telephonePortable %}
                    <dt><span class="glyphicon glyphicon-phone" aria-hidden="true"></span> Téléphone</dt>
                    <dd>
                        {{ contact.telephoneFixe }}
                        {% if contact.telephonePortable %}
                            {% if contact.telephoneFixe %}<br>{% endif %}{{ contact.telephonePortable }}
                        {% endif %}
                    </dd>
                {% endif %}

                {% if contact.telephoneFax %}
                    <dt><span class="glyphicon glyphicon-print" aria-hidden="true"></span> Fax</dt>
                    <dd>{{ contact.telephoneFax }}</dd>
                {% endif %}

                {% if contact.mail %}
                    <dt><span class="glyphicon glyphicon-envelope" aria-hidden="true"></span> Courriel</dt>
                    <dd><a href="mailto:{{ contact.mail }}">{{ contact.mail }}</a></dd>
                {% endif %}

                {% if contact.siteWeb %}
                    <dt><span class="glyphicon glyphicon-globe" aria-hidden="true"></span> Site web</dt>
                    {% if contact.siteWeb starts with 'http://' or contact.siteWeb starts with 'https://' %}
                        <dd><a href="{{ contact.siteWeb }}" target="_blank">{{ contact.siteWeb }}</a></dd>
                    {% else %}
                        {# URL avec schéma non autorisé : affichage en texte brut sans lien #}
                        <dd>{{ contact.siteWeb }}</dd>
                    {% endif %}
                {% endif %}

                {% if contact.numeroAdresse or contact.rueAdresse or contact.codePostalAdresse or contact.villeAdresse %}
                    <dt><span class="glyphicon glyphicon-home" aria-hidden="true"></span> Adresse</dt>
                    <dd>
                        {{ contact.numeroAdresse }} {{ contact.rueAdresse }}
                        {% if contact.numeroAdresse or contact.rueAdresse %}<br>{% endif %}
                        {{ contact.codePostalAdresse }} {{ contact.villeAdresse }}
                    </dd>
                {% endif %}

                {% if contact.observations %}
                    <dt><span class="glyphicon glyphicon-comment" aria-hidden="true"></span> Observations</dt>
                    <dd>{{ contact.observations }}</dd>
                {% endif %}
            </dl>
        {% else %}
            <p class="text-center mb-0">
                Aucune information renseignée
            </p>
        {% endif %}
    </div>
</div>
