<!-- Modale pour supprimer un contact -->
<div id="dialog-delete-contact" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="deleteContactLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title" id="deleteContactLabel">Supprimer le contact</h4>
            </div>
            <div class="modal-body">
                <p>
                    <span class="glyphicon glyphicon-alert" style="float:left; margin: 0 7px 20px 0;"></span>
                    Voulez-vous vraiment supprimer ce contact ?
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Annuler</button>
                <button type="button" id="delete-contact" class="btn btn-danger">Supprimer</button>
            </div>
        </div>
    </div>
</div>