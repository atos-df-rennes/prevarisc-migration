includes:
    - phpstan-baseline.neon

parameters:
    phpVersion: 70100
    level: 10
    paths:
        - src
    excludePaths:
        analyseAndScan:
            - src/Kernel.php
            - src/Repository
    symfony:
        containerXmlPath: var/cache/dev/srcApp_KernelDevDebugContainer.xml
    ignoreErrors:
        -
            identifier: property.onlyRead
            paths:
                - src/Entity
        -
            identifier: missingType.generics
        -
            # PHPExcel 1.8 a des @param string incorrects pour des paramètres int (colonne 0-based)
            message: '#Parameter .* of method PHPExcel_Worksheet::(setCellValueByColumnAndRow|getStyleByColumnAndRow)\(\) expects string, .* given#'
            identifier: argument.type