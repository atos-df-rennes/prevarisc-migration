includes:
    - phpstan-baseline.neon

parameters:
    phpVersion: 70100
    level: 10
    treatPhpDocTypesAsCertain: false
    paths:
        - src
    excludePaths:
        analyseAndScan:
            - src/Kernel.php
            - src/Repository
    symfony:
        containerXmlPath: var/cache/dev/srcApp_KernelDevDebugContainer.xml
    ignoreErrors:
        -
            identifier: property.onlyRead
            paths:
                - src/Entity
        -
            identifier: missingType.generics
